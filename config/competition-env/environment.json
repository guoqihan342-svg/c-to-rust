    "java": {
      "distribution": "OpenJDK",
      "version": "21.0.10",
      "vendor": "bisheng_jdk_enterprise"
    },
    "maven": {
      "version": "3.9.11",
      "maven_home": "/usr/local/maven3"
    },
    "rustc": "1.96.0",
    "cargo": "1.96.0",
    "gcc": "13.3.0",
    "g++": "13.3.0",
    "make": "4.3"
  },
  "unavailable_tools": {
    "go": "not_installed",
    "cmake": "not_found"
  },
  "optional_tools": {
    "clang": {
      "default_required": false,
      "env_var": "CLANG_PATH",
      "command": "clang -Xclang -ast-dump=json -fsyntax-only",
      "required_for": [
        "auto_migrate.py --competition-clang-lane"
      ],
      "missing_status": "missing_clang_path"
    }
  },
  "optional_lanes": {
    "competition_clang": {
      "default_enabled": false,
      "auto_migrate_flag": "--competition-clang-lane",
      "feature": "clang-lowering-report",
      "requires_env": [
        "CLANG_PATH"
      ],
      "ignored_env_for_ast_dump": [
        "LIBCLANG_PATH"
      ],
      "missing_status": "missing_clang_path"
    }
  },
  "dependency_admission_policy": {
    "schema_version": 1,
    "status": "enforced",
    "source_of_truth": "config/competition-env/environment.json",
    "applies_to": {
      "manifest_paths": [
        "crates/c2r-translator/Cargo.toml",
        "validation/l2_slices/Cargo.toml",
        "flashDB_rust/Cargo.toml"
      ],
      "default_paths_must_not_require": [
        "go",
        "cmake",
        "clang"
      ],
      "rust_toolchain": "stable-1.96.0",
      "python": "3.12.3",
      "node": "v24.13.0"
    },
    "admission_rule": {
      "required_risk_basis": [
        "semantic_risk",
        "generation_quality_risk",
        "maintainability_risk"
      ],
      "required_environment_fit": [
        "compatible_with_rust_1_96",
        "does_not_require_unavailable_tool",
        "uses_configured_mirrors"
      ],
      "default_decision": "not_approved_until_documented"
    },
    "approved_direct_dependencies": {
      "rust": {
        "serde": {
          "admission": "approved",
          "risk_basis": [
            "machine_readable_validation_and_translation_evidence"
          ],
          "environment_fit": [
            "rust_1_96_compatible",
            "uses_configured_cargo_mirror",
            "does_not_require_go_cmake_or_default_clang"
          ]
        },
        "serde_json": {
          "admission": "approved",
          "risk_basis": [
            "machine_readable_validation_and_translation_evidence"
          ],
          "environment_fit": [
            "rust_1_96_compatible",
            "uses_configured_cargo_mirror",
            "does_not_require_go_cmake_or_default_clang"
          ]
        }
      }
    },
    "candidate_dependencies": {
      "libclang": {
        "admission": "not_approved",
        "required_before_use": [
          "prove it removes a concrete semantic frontend risk not covered by CLANG_PATH AST dump JSON",
          "prove competition profile fit and keep default non-clang gates working"
        ]
      },
      "bindgen": {
        "admission": "not_approved",
        "required_before_use": [
          "prove generated bindings remove a concrete ABI or header modeling risk",
          "prove no default dependency on clang, libclang, cmake, or go"
        ]
      },
      "syn": {
        "admission": "not_approved",
        "required_before_use": [
          "prove it removes a concrete Rust generation-quality or maintainability risk",
          "record direct-dependency justification separate from serde_derive transitive use"
        ]
      },
      "quote": {
        "admission": "not_approved",
        "required_before_use": [
          "prove it removes a concrete Rust generation-quality or maintainability risk",
          "record direct-dependency justification separate from serde_derive transitive use"
        ]
      },
      "tracing": {
        "admission": "not_approved",
        "required_before_use": [
          "prove it removes a concrete observability or maintainability risk",
          "record runtime/logging impact for competition validation"
        ]
      },
      "anyhow": {
        "admission": "not_approved",
        "required_before_use": [
          "prove it removes a concrete error-reporting maintainability risk",
          "show it does not weaken structured evidence errors or fail-closed reasons"
        ]
      }
    }
  },
  "adaptation_policy": [
    "Do not require Go for build, test, validation, or migration gates.",
    "Do not require CMake in default competition gates; use Cargo, Python, gcc/g++, and GNU Make paths.",
    "Keep Rust code compatible with stable Rust 1.96.0 and avoid nightly-only features.",
    "Use Python 3.12-compatible scripts and avoid dependencies that require a newer Python runtime.",
    "Use Node/npm scripts compatible with Node v24.13.0 and npm 11.6.2.",
    "Use the configured Huawei mirrors for package-manager access in competition jobs.",
    "Record this profile id and environment.json hash in generated validation evidence when a run is performed in the competition environment."
  ]
}
