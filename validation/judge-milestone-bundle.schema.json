{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Judge milestone bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_kind",
    "status",
    "blockers",
    "judge_entrypoints_run_report",
    "summary",
    "claim_boundary",
    "claim_scope",
    "proof_classes",
    "proof_class_rollup",
    "publishability",
    "semantic_evidence_rollup",
    "core_translation_quality",
    "harness_architecture_summary",
    "route_governance_metrics",
    "evidence_cost_retention",
    "entrypoints",
    "workflow_metrics",
    "unsafe_reduction_scope",
    "opencode_runtime",
    "opencode_evidence_policy",
    "must_not_claim",
    "known_gaps",
    "reproduction_commands",
    "retention_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_kind": {
      "const": "judge-milestone-bundle"
    },
    "status": {
      "enum": ["passed", "blocked"]
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "judge_entrypoints_run_report": {
      "$ref": "#/definitions/artifactRef"
    },
    "readiness_report": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/definitions/artifactRef"}
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["report_kind", "external_milestone_claim_ready", "claim_scope", "blockers", "readiness"],
      "properties": {
        "report_kind": {"const": "judge-milestone-bundle-summary"},
        "external_milestone_claim_ready": {"type": "boolean"},
        "claim_scope": {"$ref": "#/definitions/claimScope"},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "readiness": {
          "type": "object",
          "additionalProperties": true,
          "required": ["all_entrypoints_executed", "executed_count", "configured_count", "validation_status"],
          "properties": {
            "all_entrypoints_executed": {"type": "boolean"},
            "executed_count": {"type": "integer", "minimum": 0},
            "configured_count": {"type": "integer", "minimum": 0},
            "validation_status": {"type": "string"}
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "semantic_gate",
        "generated_draft_semantic_pass",
        "translation_coverage_numerator",
        "bundle_is_semantic_gate",
        "source_semantic_gate"
      ],
      "properties": {
        "semantic_gate": {"const": false},
        "generated_draft_semantic_pass": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "bundle_is_semantic_gate": {"const": false},
        "source_semantic_gate": {"type": "boolean"}
      }
    },
    "claim_scope": {
      "$ref": "#/definitions/claimScope"
    },
    "proof_classes": {
      "$ref": "#/definitions/proofClasses"
    },
    "proof_class_rollup": {
      "$ref": "#/definitions/proofClasses"
    },
    "publishability": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "all_entrypoints_run_publishable",
        "focused_run",
        "competition_exact_publishable",
        "target_artifacts_regenerable"
      ],
      "properties": {
        "all_entrypoints_run_publishable": {"type": "boolean"},
        "focused_run": {"type": "boolean"},
        "competition_exact_publishable": {"type": "boolean"},
        "target_artifacts_regenerable": {"type": "boolean"}
      }
    },
    "semantic_evidence_rollup": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "translator_generated_semantic_pass_count",
        "generated_draft_semantic_pass",
        "translation_coverage_numerator",
        "accepted_evidence_counts_as_translator_coverage"
      ],
      "properties": {
        "accepted_evidence_semantic_pass_count": {"type": "integer", "minimum": 0},
        "translator_generated_semantic_pass_count": {"const": 0},
        "generated_draft_semantic_pass": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "source_generated_draft_semantic_pass": {"type": "boolean"},
        "source_translation_coverage_numerator": {"type": "integer", "minimum": 0},
        "accepted_evidence_counts_as_translator_coverage": {"const": false}
      }
    },
    "core_translation_quality": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "sources",
        "final_gate_statuses",
        "semantic_pass_count",
        "translation_coverage_numerator",
        "generated_draft_semantic_pass",
        "unsafe_reduction"
      ],
      "properties": {
        "report_kind": {"const": "core-translation-quality-rollup"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "final_gate_statuses": {"type": "array", "items": {"type": "string"}},
        "semantic_pass_count": {"type": "integer", "minimum": 0},
        "translation_coverage_numerator": {"const": 0},
        "generated_draft_semantic_pass": {"const": false},
        "unsafe_reduction": {"$ref": "#/definitions/unsafeReduction"}
      }
    },
    "harness_architecture_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "sources",
        "graph_nodes",
        "worker_count",
        "repair_round_cap",
        "roles",
        "chat_output_is_evidence",
        "semantic_gate"
      ],
      "properties": {
        "report_kind": {"const": "harness-architecture-summary"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "graph_runtime": {"type": ["string", "null"]},
        "graph_nodes": {"type": "array", "items": {"type": "string"}},
        "worker_count": {"type": "integer", "minimum": 0},
        "repair_round_cap": {"type": "integer", "minimum": 0, "maximum": 5},
        "roles": {"type": "array", "items": {"type": "string"}},
        "checkpoint_backend": {"type": ["string", "null"]},
        "chat_output_is_evidence": {"const": false},
        "semantic_gate": {"const": false}
      }
    },
    "route_governance_metrics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["report_kind", "sources", "rollup", "boundary"],
      "properties": {
        "report_kind": {"const": "route-governance-metrics-rollup"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "rollup": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "source_count",
            "translation_coverage_numerator",
            "accepted_evidence_semantic_pass_count",
            "tracked_route_decision_artifacts",
            "tracked_slice_gate_contexts",
            "all_retention_policies_present",
            "all_target_artifacts_reproducible"
          ],
          "properties": {
            "source_count": {"type": "integer", "minimum": 0},
            "translation_coverage_numerator": {"const": 0},
            "accepted_evidence_semantic_pass_count": {"type": "integer", "minimum": 0},
            "tracked_route_decision_artifacts": {"type": "integer", "minimum": 0},
            "tracked_slice_gate_contexts": {"type": "integer", "minimum": 0},
            "s2_workflow_run_count": {"type": "integer", "minimum": 0},
            "s2_unsafe_reduction": {"type": "object"},
            "all_retention_policies_present": {"type": "boolean"},
            "all_target_artifacts_reproducible": {"type": "boolean"}
          }
        },
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "evidence_cost_retention": {
      "type": "object",
      "additionalProperties": true,
      "required": ["report_kind", "sources", "rollup", "boundary"],
      "properties": {
        "report_kind": {"const": "evidence-cost-retention-rollup"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "rollup": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "source_count",
            "artifact_count",
            "total_bytes",
            "pipeline_count",
            "runtime_ms",
            "retention_classes",
            "all_sources_passed",
            "portability_issue_count"
          ],
          "properties": {
            "source_count": {"type": "integer", "minimum": 0},
            "artifact_count": {"type": "integer", "minimum": 0},
            "total_bytes": {"type": "integer", "minimum": 0},
            "pipeline_count": {"type": "integer", "minimum": 0},
            "runtime_ms": {
              "type": "object",
              "additionalProperties": true,
              "required": ["observation_count", "total", "max"],
              "properties": {
                "observation_count": {"type": "integer", "minimum": 0},
                "total": {"type": "integer", "minimum": 0},
                "max": {"type": "integer", "minimum": 0}
              }
            },
            "retention_classes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true,
                "required": ["file_count", "total_bytes"],
                "properties": {
                  "file_count": {"type": "integer", "minimum": 0},
                  "total_bytes": {"type": "integer", "minimum": 0}
                }
              }
            },
            "all_sources_passed": {"type": "boolean"},
            "portability_issue_count": {"type": "integer", "minimum": 0},
            "diagnostic_host_metadata_count": {"type": "integer", "minimum": 0}
          }
        },
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {"type": "object"}
    },
    "workflow_metrics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["report_kind", "sources", "rollup"],
      "properties": {
        "report_kind": {"const": "workflow-metrics-rollup"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "rollup": {"type": "object"}
      }
    },
    "unsafe_reduction_scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope", "all_sources_measured", "measured_units", "total_units"],
      "properties": {
        "scope": {"enum": ["none", "partial", "all"]},
        "all_sources_measured": {"type": "boolean"},
        "measured_units": {"type": "integer", "minimum": 0},
        "total_units": {"type": "integer", "minimum": 0}
      }
    },
    "opencode_runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "enabled_entrypoint_count",
        "worker_count",
        "all_contracts_executed",
        "chat_output_is_evidence_false",
        "semantic_gate_false"
      ],
      "properties": {
        "report_kind": {"const": "opencode-runtime-rollup"},
        "enabled_entrypoint_count": {"type": "integer", "minimum": 0},
        "worker_count": {"type": "integer", "minimum": 0},
        "all_contracts_executed": {"type": "boolean"},
        "chat_output_is_evidence_false": {"type": "boolean"},
        "semantic_gate_false": {"type": "boolean"}
      }
    },
    "opencode_evidence_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "boundary_fields_explicit",
        "chat_output_is_evidence_false",
        "semantic_gate_false",
        "session_evidence_role",
        "logs_evidence_role",
        "semantic_gate"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "boundary_fields_explicit": {"type": "boolean"},
        "chat_output_is_evidence_false": {"type": "boolean"},
        "semantic_gate_false": {"type": "boolean"},
        "session_evidence_role": {"const": "command_contract_audit_only"},
        "logs_evidence_role": {"const": "diagnostic_only"},
        "semantic_gate": {"const": false}
      }
    },
    "must_not_claim": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "allOf": [
        {"contains": {"const": "accepted_evidence_is_not_translator_generated_coverage"}},
        {"contains": {"const": "bundle_status_passed_is_not_project_level_translation_success"}},
        {"contains": {"const": "local_simulation_is_not_competition_exact"}}
      ]
    },
    "known_gaps": {
      "type": "array",
      "items": {"type": "object"},
      "minItems": 1
    },
    "reproduction_commands": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_judge_entrypoints", "build_bundle", "entrypoints"],
      "properties": {
        "run_judge_entrypoints": {"type": "string", "minLength": 1},
        "build_bundle": {"type": "string", "minLength": 1},
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "command"],
            "properties": {
              "id": {"type": ["string", "null"]},
              "command": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["report_kind", "bundle_role", "target_artifacts", "committed_manifests", "claim_boundary"],
      "properties": {
        "report_kind": {"const": "milestone-retention-policy"},
        "bundle_role": {"const": "external-review-index"}
      }
    }
  },
  "definitions": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claimScope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "external_review_index_ready",
        "semantic_acceptance_ready",
        "competition_exact_ready",
        "translator_generated_coverage_ready"
      ],
      "properties": {
        "external_review_index_ready": {"type": "boolean"},
        "semantic_acceptance_ready": {"const": false},
        "competition_exact_ready": {"type": "boolean"},
        "translator_generated_coverage_ready": {"type": "boolean"}
      }
    },
    "proofClasses": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "all",
        "highest_proof_class",
        "has_competition_exact",
        "all_entrypoints_competition_exact",
        "competition_exact_host_verified",
        "entrypoints"
      ],
      "properties": {
        "all": {
          "type": "array",
          "items": {"$ref": "#/definitions/proofClass"}
        },
        "highest_proof_class": {"$ref": "#/definitions/proofClass"},
        "has_competition_exact": {"type": "boolean"},
        "all_entrypoints_competition_exact": {"type": "boolean"},
        "competition_exact_host_verified": {"type": "boolean"},
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "proof_class", "run_id"],
            "properties": {
              "id": {"type": ["string", "null"]},
              "proof_class": {"$ref": "#/definitions/proofClass"},
              "run_id": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "proofClass": {
      "enum": [
        "unknown",
        "local-simulation",
        "wsl-local-simulation",
        "ci-approximation",
        "competition-exact"
      ]
    },
    "unsafeReduction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "baseline_total_unsafe", "current_total_unsafe", "reduced_by"],
      "properties": {
        "status": {"type": "string"},
        "baseline_total_unsafe": {"type": ["integer", "null"], "minimum": 0},
        "current_total_unsafe": {"type": ["integer", "null"], "minimum": 0},
        "reduced_by": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
