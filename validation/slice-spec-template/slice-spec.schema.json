{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Bounded Auto Translation Slice Spec",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target_id",
    "slice_id",
    "level",
    "status",
    "l1_evidence",
    "source",
    "c_boundary",
    "build_profile",
    "fixture_contract",
    "rust_boundary",
    "claim_boundary",
    "cache_invalidation_keys"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "L2",
        "L3"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "stale",
        "draft"
      ]
    },
    "l1_evidence": {
      "type": "object",
      "required": [
        "path",
        "status",
        "accepted"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "source_root",
        "source_commit",
        "repo_commit"
      ],
      "properties": {
        "source_root": {
          "type": "string"
        },
        "source_commit": {
          "type": "string",
          "minLength": 7
        },
        "repo_commit": {
          "type": "string",
          "minLength": 7
        },
        "source_file_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "translation_carrier": {
      "$ref": "#/definitions/translationCarrier"
    },
    "c_boundary": {
      "type": "object",
      "required": [
        "files",
        "functions",
        "signatures"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sourceFile"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cSignature"
          }
        },
        "direct_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dependency"
          }
        },
        "pointer_contract": {
          "$ref": "#/definitions/pointerContract"
        },
        "scalar_arithmetic_contract": {
          "$ref": "#/definitions/scalarArithmeticContract"
        }
      }
    },
    "build_profile": {
      "type": "object",
      "required": [
        "profile_id",
        "compiler_command_source",
        "include_paths",
        "defines",
        "target",
        "preprocessing_mode",
        "tool_versions",
        "clang_type_extraction"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "compiler_command_source": {
          "type": "string"
        },
        "include_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "object",
          "required": [
            "triple_or_abi",
            "endianness",
            "int_width",
            "long_width",
            "pointer_width"
          ],
          "properties": {
            "triple_or_abi": {
              "type": "string"
            },
            "endianness": {
              "enum": [
                "little",
                "big",
                "unknown"
              ]
            },
            "int_width": {
              "type": "integer"
            },
            "int_align": {
              "type": "integer"
            },
            "char_width": {
              "type": "integer"
            },
            "char_align": {
              "type": "integer"
            },
            "plain_char_signed": {
              "type": "boolean"
            },
            "short_width": {
              "type": "integer"
            },
            "short_align": {
              "type": "integer"
            },
            "long_width": {
              "type": "integer"
            },
            "long_align": {
              "type": "integer"
            },
            "long_long_width": {
              "type": "integer"
            },
            "long_long_align": {
              "type": "integer"
            },
            "pointer_width": {
              "type": "integer"
            },
            "pointer_align": {
              "type": "integer"
            }
          }
        },
        "preprocessing_mode": {
          "enum": [
            "compile_commands",
            "manual_flags",
            "generated_stub",
            "unknown"
          ]
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clang_type_extraction": {
          "type": "object",
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "fixture_contract": {
      "type": "object",
      "required": [
        "fixture_id",
        "path",
        "hash",
        "cases",
        "observable_outputs"
      ],
      "properties": {
        "fixture_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fixtureCase"
          }
        },
        "observable_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scalar_input_domain": {
          "$ref": "#/definitions/scalarInputDomain"
        }
      }
    },
    "rust_boundary": {
      "type": "object",
      "required": [
        "crate",
        "module",
        "public_api",
        "raw_pointer_policy",
        "unsafe_policy"
      ],
      "properties": {
        "crate": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "public_api": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rustApi"
          }
        },
        "raw_pointer_policy": {
          "enum": [
            "internal_only",
            "reviewed_exception",
            "blocked"
          ]
        },
        "unsafe_policy": {
          "type": "object",
          "required": [
            "max_first_party_non_test_ratio",
            "ledger_required"
          ],
          "properties": {
            "max_first_party_non_test_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            },
            "ledger_required": {
              "const": true
            }
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "accepted_metadata_differences",
        "non_goals",
        "must_not_claim"
      ],
      "properties": {
        "accepted_metadata_differences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_claim": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cache_invalidation_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "memory_model": {
      "$ref": "#/definitions/memoryModel"
    }
  },
  "definitions": {
    "translationCarrier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "carrier_function",
        "carrier_source_sha256",
        "embedding_mode",
        "frontend_contract",
        "source_text_normalization",
        "source_file_hash_mode",
        "artifact_source_hash_mode",
        "real_source",
        "claim_boundary"
      ],
      "properties": {
        "kind": {
          "const": "exact_source_fragment_wrapper"
        },
        "carrier_function": {
          "type": "string",
          "minLength": 1
        },
        "carrier_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "embedding_mode": {
          "const": "verbatim_once"
        },
        "frontend_contract": {
          "const": "live_clang_slice_source"
        },
        "source_text_normalization": {
          "const": "utf8_universal_newlines"
        },
        "source_file_hash_mode": {
          "const": "raw_bytes"
        },
        "artifact_source_hash_mode": {
          "const": "lf_stable_text"
        },
        "real_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "containing_function",
            "fragment"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "containing_function": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "line_start",
                "line_end",
                "sha256",
                "hash_mode",
                "declaration_text"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "hash_mode": {
                  "const": "trimmed_normalized_span"
                },
                "declaration_text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "fragment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "line_start",
                "line_end",
                "sha256",
                "hash_mode",
                "text"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "if_condition_header",
                    "do_while_condition_tail",
                    "conditional_block_prefix",
                    "expression_statement",
                    "return_statement"
                  ]
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "hash_mode": {
                  "const": "normalized_line_span_with_newline"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "claim_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "whole_function_semantics_verified",
            "external_callee_semantics_verified",
            "excluded_semantics"
          ],
          "properties": {
            "scope": {
              "const": "source_fragment_only"
            },
            "whole_function_semantics_verified": {
              "const": false
            },
            "external_callee_semantics_verified": {
              "const": false
            },
            "excluded_semantics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "role": {
          "enum": [
            "source",
            "header",
            "fixture",
            "generated_stub"
          ]
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "cSignature": {
      "type": "object",
      "required": [
        "function",
        "return_type",
        "parameters"
      ],
      "properties": {
        "function": {
          "type": "string"
        },
        "return_type": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "c_type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "c_type": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "input",
                  "output",
                  "inout",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "type",
            "macro",
            "constant",
            "global",
            "callee",
            "config"
          ]
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "fixtureCase": {
      "type": "object",
      "required": [
        "id",
        "input_ref",
        "expected_ref"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "input_ref": {
          "type": "string"
        },
        "expected_ref": {
          "type": "string"
        }
      }
    },
    "scalarArithmeticContract": {
      "type": "object",
      "required": [
        "wrapping_profile",
        "signed_overflow",
        "division_by_zero",
        "signed_division_overflow",
        "shift_count",
        "signed_right_shift"
      ],
      "properties": {
        "wrapping_profile": {
          "enum": [
            "not_declared",
            "fwrapv",
            "two_complement_wrapping",
            "fail_closed"
          ]
        },
        "signed_overflow": {
          "enum": [
            "not_declared",
            "runtime_precondition_no_overflow",
            "wrapping_defined_by_profile",
            "fail_closed"
          ]
        },
        "division_by_zero": {
          "enum": [
            "not_declared",
            "runtime_precondition_nonzero_divisor",
            "fail_closed"
          ]
        },
        "signed_division_overflow": {
          "enum": [
            "not_declared",
            "runtime_precondition_excludes_min_div_minus_one",
            "fail_closed"
          ]
        },
        "shift_count": {
          "enum": [
            "not_declared",
            "runtime_precondition_in_range",
            "fail_closed"
          ]
        },
        "signed_right_shift": {
          "enum": [
            "not_declared",
            "explicit_implementation_defined_contract",
            "fail_closed_without_explicit_contract"
          ]
        },
        "signed_left_shift": {
          "enum": [
            "not_declared",
            "runtime_precondition_no_overflow",
            "fail_closed"
          ]
        },
        "signed_negation": {
          "enum": [
            "not_declared",
            "runtime_precondition_no_overflow",
            "fail_closed"
          ]
        }
      }
    },
    "scalarInputDomain": {
      "type": "object",
      "required": [
        "case_source",
        "parameters",
        "covers_overflow_boundaries"
      ],
      "properties": {
        "case_source": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "excludes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "covers_overflow_boundaries": {
          "type": "boolean"
        }
      }
    },
    "rustApi": {
      "type": "object",
      "required": [
        "name",
        "visibility",
        "boundary_kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "crate",
            "private"
          ]
        },
        "boundary_kind": {
          "enum": [
            "safe_wrapper",
            "validated_buffer",
            "newtype",
            "internal_ffi",
            "reviewed_raw_pointer_exception"
          ]
        }
      }
    },
    "memoryModel": {
      "type": "object",
      "required": [
        "alias_contract",
        "ownership_contract",
        "length_companions",
        "effect_graph"
      ],
      "additionalProperties": true,
      "properties": {
        "alias_contract": {
          "$ref": "#/definitions/aliasContract"
        },
        "ownership_contract": {
          "$ref": "#/definitions/ownershipContract"
        },
        "length_companions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/lengthCompanion"
          }
        },
        "effect_graph": {
          "$ref": "#/definitions/effectGraph"
        }
      }
    },
    "aliasContract": {
      "type": "object",
      "required": [
        "decision",
        "proven",
        "requires_noalias",
        "complete_alias_safety"
      ],
      "additionalProperties": true,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "requires_noalias_contract",
            "candidate_only",
            "blocked",
            "not_applicable"
          ]
        },
        "proven": {
          "type": "boolean"
        },
        "requires_noalias": {
          "type": "boolean"
        },
        "complete_alias_safety": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ownershipContract": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "borrow_model"
      ],
      "additionalProperties": true,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "borrow_model": {
          "type": "string",
          "minLength": 1
        },
        "unsafe_boundary": {
          "type": "string"
        }
      }
    },
    "lengthCompanion": {
      "type": "object",
      "required": [
        "pointer",
        "companion",
        "contract"
      ],
      "additionalProperties": true,
      "properties": {
        "pointer": {
          "type": "string",
          "minLength": 1
        },
        "companion": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "effectGraph": {
      "type": "object",
      "required": [
        "effects",
        "edges"
      ],
      "additionalProperties": true,
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pointer_node",
              "kind",
              "expression"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "pointer_node": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "read",
                  "write",
                  "read_write",
                  "compute",
                  "call",
                  "external_read",
                  "external_write",
                  "unknown"
                ]
              },
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from_effect",
              "to_effect",
              "relationship"
            ],
            "additionalProperties": true,
            "properties": {
              "from_effect": {
                "type": "string"
              },
              "to_effect": {
                "type": "string"
              },
              "relationship": {
                "enum": [
                  "data_influences",
                  "control_depends",
                  "may_alias",
                  "requires_noalias",
                  "invalidates",
                  "bounds_checked_by",
                  "external_state"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "reads": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "external_state": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alias_sensitive": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "pointerNameSet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pointerAccess": {
      "type": "object",
      "required": [
        "name",
        "c_type"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "c_type": {
          "type": "string",
          "minLength": 1
        },
        "length_companion": {
          "type": "string"
        },
        "read_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nullability": {
          "enum": [
            "nullable",
            "non_null",
            "unknown"
          ]
        },
        "ownership_role": {
          "enum": [
            "owner",
            "borrowed",
            "observer",
            "out_param",
            "inout_param",
            "global",
            "unknown"
          ]
        },
        "mutability": {
          "enum": [
            "read_only",
            "write_only",
            "read_write",
            "unknown"
          ]
        },
        "loop_bound": {
          "type": "string"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": true
        },
        "lifetime_owner": {
          "type": "string"
        },
        "translation_rule_id": {
          "type": "string"
        }
      }
    },
    "pointerContract": {
