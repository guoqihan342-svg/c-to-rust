{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Release Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_kind",
    "status",
    "summary",
    "claim_boundary",
    "judge_entrypoints_run_report",
    "readiness_report",
    "judge_milestone_bundle",
    "milestone_release_notes",
    "competition_config_archive",
    "publication_manifest",
    "publishability",
    "harness_architecture_summary",
    "evidence_cost_retention",
    "before_after_repair_exhibit",
    "opencode_patch_boundary",
    "quantitative_evaluation",
    "progress_delta_ledger",
    "known_gaps",
    "must_not_claim",
    "reproduction_commands"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "report_kind": {"const": "public-release-packet"},
    "status": {"enum": ["passed", "blocked"]},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "entrypoint_count",
        "publication_scope",
        "readiness",
        "blockers",
        "published_artifact_ref_status",
        "proof_class_rollup",
        "workflow_metrics",
        "progress_delta_ledger"
      ],
      "properties": {
        "entrypoint_count": {"type": "integer", "minimum": 0},
        "publication_scope": {"type": "string"},
        "readiness": {"type": "object", "additionalProperties": true},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "published_artifact_ref_status": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "total_count",
            "status_counts",
            "abnormal_ref_count",
            "abnormal_refs",
            "semantic_gate",
            "translation_coverage_numerator",
            "boundary"
          ],
          "properties": {
            "total_count": {"type": "integer", "minimum": 0},
            "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "abnormal_ref_count": {"type": "integer", "minimum": 0},
            "abnormal_refs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
            "semantic_gate": {"const": false},
            "translation_coverage_numerator": {"const": 0},
            "boundary": {"type": "string", "minLength": 1}
          }
        },
        "proof_class_rollup": {"type": "object", "additionalProperties": true},
        "workflow_metrics": {
          "type": "object",
          "additionalProperties": true,
          "required": ["repair_activity", "semantic_gate", "translation_coverage_numerator", "boundary"],
          "properties": {
            "repair_activity": {"type": "object", "additionalProperties": true},
            "semantic_gate": {"const": false},
            "translation_coverage_numerator": {"const": 0},
            "boundary": {"type": "string"}
          }
        },
        "progress_delta_ledger": {
          "$ref": "#/$defs/progressDeltaLedger"
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "semantic_gate",
        "packet_is_semantic_gate",
        "generated_draft_semantic_pass",
        "translation_coverage_numerator",
        "boundary"
      ],
      "properties": {
        "semantic_gate": {"const": false},
        "packet_is_semantic_gate": {"const": false},
        "generated_draft_semantic_pass": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "boundary": {"type": "string"}
      }
    },
    "judge_entrypoints_run_report": {"$ref": "#/$defs/artifactRef"},
    "readiness_report": {"$ref": "#/$defs/artifactRef"},
    "judge_milestone_bundle": {"$ref": "#/$defs/artifactRef"},
    "milestone_release_notes": {"$ref": "#/$defs/artifactRef"},
    "competition_config_archive": {"type": "object", "additionalProperties": true, "required": ["status"]},
    "publication_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "bundle_version",
        "source_commit",
        "repo_commit",
        "target_source_pin",
        "release_tag_readiness"
      ],
      "properties": {
        "report_kind": {"const": "publication-manifest"},
        "bundle_version": {"const": 1},
        "source_commit": {"$ref": "#/$defs/commitRef"},
        "repo_commit": {"$ref": "#/$defs/commitRef"},
        "target_source_pin": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "target_id", "repository", "branch", "canonical_commit"],
          "properties": {
            "status": {"const": "passed"},
            "target_id": {"type": "string", "minLength": 1},
            "repository": {"type": "string", "minLength": 1},
            "branch": {"type": "string", "minLength": 1},
            "canonical_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "release_tag_readiness": {"$ref": "#/$defs/releaseTagReadiness"}
      }
    },
    "publishability": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "scope",
        "publication_scope",
        "external_milestone_claim_ready",
        "external_milestone",
        "blocker_count",
        "blockers",
        "all_entrypoints_run_publishable",
        "focused_run",
        "competition_exact_publishable",
        "required_agent_tool",
        "required_model",
        "opencode_glm51_required",
        "opencode_glm51_preflight_status",
        "opencode_glm51_publishable",
        "semantic_gate",
        "translation_coverage_numerator",
        "target_artifacts_regenerable"
      ],
      "properties": {
        "status": {"enum": ["blocked", "internal_preview", "external_release_ready"]},
        "scope": {"enum": ["full", "partial", "blocked"]},
        "publication_scope": {"enum": ["full", "partial", "blocked"]},
        "external_milestone_claim_ready": {"type": "boolean"},
        "external_milestone": {"type": "boolean"},
        "blocker_count": {"type": "integer", "minimum": 0},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "all_entrypoints_run_publishable": {"type": "boolean"},
        "focused_run": {"type": "boolean"},
        "competition_exact_publishable": {"type": "boolean"},
        "required_agent_tool": {"const": "opencode"},
        "required_model": {"const": "GLM-5.1"},
        "opencode_glm51_required": {"const": true},
        "opencode_glm51_preflight_status": {"type": "string", "minLength": 1},
        "opencode_glm51_publishable": {"type": "boolean"},
        "semantic_gate": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "target_artifacts_regenerable": {"type": "boolean"}
      }
    },
    "harness_architecture_summary": {
      "$ref": "#/$defs/harnessArchitectureSummary"
    },
    "evidence_cost_retention": {
      "$ref": "#/$defs/evidenceCostRetention"
    },
    "before_after_repair_exhibit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "sources",
        "rollup",
        "semantic_gate",
        "generated_draft_semantic_pass",
        "translation_coverage_numerator",
        "accepted_evidence_counts_as_translator_coverage",
        "boundary"
      ],
      "properties": {
        "report_kind": {"const": "before-after-repair-exhibit-rollup"},
        "sources": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "rollup": {"type": "object", "additionalProperties": true},
        "semantic_gate": {"const": false},
        "generated_draft_semantic_pass": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "accepted_evidence_counts_as_translator_coverage": {"const": false},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "opencode_patch_boundary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "opencode_runtime_enabled",
        "opencode_preflight_proof_summary",
        "chat_output_is_evidence",
        "semantic_gate",
        "translation_coverage_numerator",
        "boundary"
      ],
      "properties": {
        "report_kind": {"const": "opencode-patch-boundary"},
        "opencode_runtime_enabled": {"type": "boolean"},
        "opencode_preflight_proof_summary": {"$ref": "#/$defs/opencodePreflightProofSummary"},
        "chat_output_is_evidence": {"const": false},
        "semantic_gate": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "quantitative_evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["semantic_gate", "generated_draft_semantic_pass", "translation_coverage_numerator"],
      "properties": {
        "semantic_gate": {"const": false},
        "generated_draft_semantic_pass": {"const": false},
        "translation_coverage_numerator": {"const": 0}
      }
    },
    "progress_delta_ledger": {
      "$ref": "#/$defs/progressDeltaLedger"
    },
    "known_gaps": {"type": "array"},
    "must_not_claim": {"type": "array", "items": {"type": "string"}},
    "reproduction_commands": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "status", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "status": {"const": "present"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "releaseTagReadiness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "status",
        "tag_name",
        "tag_target_commit",
        "tag_matches_repo_commit",
        "remote_release_notes_status",
        "external_review_record_status",
        "external_milestone_claim_ready",
        "semantic_gate",
        "translation_coverage_numerator",
        "boundary"
      ],
      "properties": {
        "report_kind": {"const": "release-tag-readiness"},
        "status": {"const": "not_tagged"},
        "tag_name": {"type": ["string", "null"]},
        "tag_target_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "repo_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "tag_matches_repo_commit": {"const": false},
        "remote_release_notes_status": {"const": "not_published"},
        "external_review_record_status": {"const": "not_recorded"},
        "external_milestone_claim_ready": {"const": false},
        "semantic_gate": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "commitRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "commit"],
      "properties": {
        "status": {"const": "present"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "harnessArchitectureSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "sources",
        "graph_nodes",
        "worker_count",
        "repair_round_cap",
        "roles",
        "contract_matrix",
        "chat_output_is_evidence",
        "semantic_gate"
      ],
      "properties": {
        "report_kind": {"const": "harness-architecture-summary"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "graph_runtime": {"type": ["string", "null"]},
        "graph_nodes": {"type": "array", "items": {"type": "string"}},
        "worker_count": {"type": "integer", "minimum": 0},
        "repair_round_cap": {"type": "integer", "minimum": 0, "maximum": 5},
        "roles": {"type": "array", "items": {"type": "string"}},
        "checkpoint_backend": {"type": ["string", "null"]},
        "contract_matrix": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/harnessContractMatrixEntry"},
                {"properties": {"stage": {"const": "plan"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/harnessContractMatrixEntry"},
                {"properties": {"stage": {"const": "translate"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/harnessContractMatrixEntry"},
                {"properties": {"stage": {"const": "verify"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/harnessContractMatrixEntry"},
                {"properties": {"stage": {"const": "repair"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/harnessContractMatrixEntry"},
                {"properties": {"stage": {"const": "report"}}}
              ]
            }
          ],
          "items": false
        },
        "chat_output_is_evidence": {"const": false},
        "semantic_gate": {"const": false}
      }
    },
    "harnessContractMatrixEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "stage",
        "graph_nodes",
        "roles",
        "artifacts",
        "validators",
        "semantic_gate",
        "chat_output_is_evidence",
        "translation_coverage_numerator",
        "boundary"
      ],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "graph_nodes": {"type": "array", "items": {"type": "string"}},
        "roles": {"type": "array", "items": {"type": "string"}},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "validators": {"type": "array", "items": {"type": "string"}},
        "semantic_gate": {"const": false},
        "chat_output_is_evidence": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "evidenceCostRetention": {
      "type": "object",
      "additionalProperties": true,
      "required": ["report_kind", "sources", "rollup", "boundary"],
      "properties": {
        "report_kind": {"const": "evidence-cost-retention-rollup"},
        "sources": {"type": "array", "items": {"type": "object"}},
        "rollup": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "source_count",
            "artifact_count",
            "total_bytes",
            "pipeline_count",
            "runtime_ms",
            "retention_classes",
            "all_sources_passed",
            "policy_compliance",
            "portability_issue_count"
          ],
          "properties": {
            "source_count": {"type": "integer", "minimum": 0},
            "artifact_count": {"type": "integer", "minimum": 0},
            "total_bytes": {"type": "integer", "minimum": 0},
            "pipeline_count": {"type": "integer", "minimum": 0},
            "runtime_ms": {
              "type": "object",
              "additionalProperties": true,
              "required": ["observation_count", "total", "max"],
              "properties": {
                "observation_count": {"type": "integer", "minimum": 0},
                "total": {"type": "integer", "minimum": 0},
                "max": {"type": "integer", "minimum": 0}
              }
            },
            "retention_classes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true,
                "required": ["file_count", "total_bytes"],
                "properties": {
                  "file_count": {"type": "integer", "minimum": 0},
                  "total_bytes": {"type": "integer", "minimum": 0}
                }
              }
            },
            "all_sources_passed": {"type": "boolean"},
            "policy_compliance": {
              "type": "object",
              "additionalProperties": true,
              "required": ["all_sources_policy_passed", "tier_counts", "failed_gate_counts"],
              "properties": {
                "all_sources_policy_passed": {"type": "boolean"},
                "tier_counts": {
                  "type": "object",
                  "additionalProperties": {"type": "integer", "minimum": 0}
                },
                "failed_gate_counts": {
                  "type": "object",
                  "additionalProperties": {"type": "integer", "minimum": 0}
                }
              }
            },
            "portability_issue_count": {"type": "integer", "minimum": 0},
            "diagnostic_host_metadata_count": {"type": "integer", "minimum": 0}
          }
        },
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "progressDeltaLedger": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_kind",
        "semantic_gate",
        "generated_draft_semantic_pass",
        "translation_coverage_numerator",
        "capability_delta",
        "governance_delta",
        "workflow_delta",
        "boundary"
      ],
      "properties": {
        "report_kind": {"const": "progress-delta-ledger"},
        "semantic_gate": {"const": false},
        "generated_draft_semantic_pass": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "capability_delta": {"type": "object", "additionalProperties": true},
        "governance_delta": {"type": "object", "additionalProperties": true},
        "workflow_delta": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "workflow_source_count",
            "workflow_units_total",
            "workflow_units_converged",
            "repair_history_unit_count",
            "observed_repair_unit_count",
            "auto_recovered_unit_count",
            "rollback_evidence_count",
            "before_after_repair_source_count",
            "repair_delta_source_count",
            "human_interventions"
          ],
          "properties": {
            "workflow_source_count": {"type": "integer", "minimum": 0},
            "workflow_units_total": {"type": "integer", "minimum": 0},
            "workflow_units_converged": {"type": "integer", "minimum": 0},
            "repair_history_unit_count": {"type": "integer", "minimum": 0},
            "observed_repair_unit_count": {"type": "integer", "minimum": 0},
            "auto_recovered_unit_count": {"type": "integer", "minimum": 0},
            "rollback_evidence_count": {"type": "integer", "minimum": 0},
            "before_after_repair_source_count": {"type": "integer", "minimum": 0},
            "repair_delta_source_count": {"type": "integer", "minimum": 0},
            "human_interventions": {"type": "integer", "minimum": 0},
            "llm_calls": {"type": "integer", "minimum": 0}
          }
        },
        "boundary": {"type": "string"}
      }
    },
    "opencodePreflightProofSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "required_when_opencode_runtime_enabled",
        "chat_output_is_evidence",
        "semantic_gate",
        "translation_coverage_numerator",
        "opencode_run_argv_bound",
        "boundary"
      ],
      "properties": {
        "status": {"type": "string"},
        "required_when_opencode_runtime_enabled": {"type": "boolean"},
        "preflight_report": {"$ref": "#/$defs/artifactRef"},
        "run_id": {"type": "string"},
        "opencode_command": {"type": "string"},
        "opencode_model": {"type": "string"},
        "required_model": {"type": "string"},
        "model_availability_status": {"type": "string"},
        "model_listed": {"type": "boolean"},
        "model_probe_argv": {"type": "array", "items": {"type": "string"}},
        "process_returncode": {"type": "integer"},
        "model_probe_logs": {
          "type": "object",
          "additionalProperties": true,
          "required": ["stdout", "stderr"],
          "properties": {
            "stdout": {"$ref": "#/$defs/artifactRef"},
            "stderr": {"$ref": "#/$defs/artifactRef"}
          }
        },
        "contract_status": {"type": "string"},
        "marker_exists": {"type": "boolean"},
        "opencode_run_launched": {"type": "boolean"},
        "opencode_run_argv_bound": {"type": "boolean"},
        "proof_class": {"type": "string"},
        "chat_output_is_evidence": {"const": false},
        "semantic_gate": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
