{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Auto Translation Plan Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target_id",
    "slice_id",
    "level",
    "status",
    "source_commit",
    "repo_commit",
    "inputs",
    "generated_artifacts",
    "translation_summary",
    "verification_plan",
    "cache_invalidation_keys"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "target_id": {
      "type": "string"
    },
    "slice_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "L2",
        "L3"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "draft_generated",
        "blocked",
        "stale",
        "incomplete"
      ]
    },
    "source_commit": {
      "type": "string",
      "minLength": 7
    },
    "repo_commit": {
      "type": "string",
      "minLength": 7
    },
    "inputs": {
      "type": "object",
      "required": [
        "slice_spec",
        "type_map",
        "cfg",
        "pointer_graph"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/evidenceRef"
      }
    },
    "generated_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/generatedArtifact"
      }
    },
    "translation_summary": {
      "type": "object",
      "required": [
        "translation_rule_ids",
        "unsupported_node_count",
        "unsafe_candidate_count",
        "safe_public_api"
      ],
      "properties": {
        "translation_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "safe_public_api": {
          "type": "boolean"
        },
        "alias_gate": {
          "$ref": "#/definitions/aliasGateSummary"
        }
      }
    },
    "verification_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate",
          "command",
          "required_before_acceptance"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "required_before_acceptance": {
            "type": "boolean"
          }
        }
      }
    },
    "cache_invalidation_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "evidenceRef": {
      "type": "object",
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "sourceSpan": {
      "type": "object",
      "required": [
        "file",
        "line_start",
        "line_end"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "generatedArtifact": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "generator",
        "source_spans",
        "generated_spans",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "rust_draft",
            "rust_replay_test",
            "c_oracle_harness",
            "manifest_fragment",
            "other"
          ]
        },
        "generator": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "source_spans": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sourceSpan"
          }
        },
        "generated_spans": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sourceSpan"
          }
        },
        "status": {
          "enum": [
            "candidate",
            "blocked",
            "accepted_after_gates",
            "superseded"
          ]
        }
      }
    },
    "aliasGateSummary": {
      "type": "object",
      "required": [
        "decision",
        "complete_alias_safety",
        "requires_noalias"
      ],
      "additionalProperties": true,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "requires_noalias_contract",
            "candidate_only",
            "blocked",
            "not_applicable"
          ]
        },
        "complete_alias_safety": {
          "type": "boolean"
        },
        "requires_noalias": {
          "type": "boolean"
        },
        "risk_count": {
          "type": "integer",
          "minimum": 0
        },
        "risk_level": {
          "type": "string"
        },
        "evidence_source": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/safeBoundaryPrecondition"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "safeBoundaryPrecondition": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "applies_to",
        "required",
        "reason"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "noalias",
            "non_null",
            "valid_length",
            "bounds_checked",
            "initialized",
            "aligned",
            "lifetime",
            "external_state_stable",
            "exclusive_fixture_step",
            "single_threaded",
            "external_state_frozen",
            "other"
          ]
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
