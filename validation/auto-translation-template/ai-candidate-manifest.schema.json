{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "AI Candidate Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "target_id", "slice_id", "status", "ai_required_for_default_pipeline", "candidates", "cache_invalidation_keys"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "target_id": {"type": "string"},
    "slice_id": {"type": "string"},
    "status": {"enum": ["not_used", "recorded", "generated", "blocked", "stale", "incomplete"]},
    "ai_required_for_default_pipeline": {"type": "boolean"},
    "provider_invocations": {"type": "integer", "minimum": 0, "maximum": 2},
    "provider_attempts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/definitions/providerAttempt"}},
    "provider_retry": {"$ref": "#/definitions/providerRetry"},
    "provider_preflight": {"$ref": "#/definitions/providerPreflight"},
    "cache": {"$ref": "#/definitions/candidateCache"},
    "candidates": {"type": "array", "items": {"$ref": "#/definitions/candidate"}},
    "generator": {"$ref": "#/definitions/generator"},
    "bindings": {"$ref": "#/definitions/bindings"},
    "displaced_candidate": {"$ref": "#/definitions/candidateContextRef"},
    "repair": {"$ref": "#/definitions/repairReportRef"},
    "claim_boundary": {"$ref": "#/definitions/claimBoundary"},
    "failure": {"$ref": "#/definitions/failure"},
    "cache_invalidation_keys": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "required": ["schema_version", "status"],
        "properties": {
          "schema_version": {"minimum": 2},
          "status": {"enum": ["generated", "blocked"]}
        }
      },
      "then": {
        "required": ["provider_invocations", "provider_preflight"]
      }
    },
    {
      "if": {
        "required": ["schema_version", "status"],
        "properties": {
          "schema_version": {"minimum": 4},
          "status": {"enum": ["generated", "blocked"]}
        }
      },
      "then": {
        "required": ["cache"]
      }
    },
    {
      "if": {
        "required": ["schema_version", "status"],
        "properties": {
          "schema_version": {"minimum": 3},
          "status": {"enum": ["generated", "blocked"]}
        }
      },
      "then": {
        "properties": {
          "generator": {"required": ["prompt_transport"]}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "generated"}}},
      "then": {
        "required": ["generator", "bindings", "claim_boundary"],
        "properties": {
          "ai_required_for_default_pipeline": {"const": true},
          "candidates": {
            "minItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/definitions/candidate"},
                {
                  "required": ["kind", "provider_label", "model_label", "resolved_model", "competition_eligible", "evaluation_scope", "artifact", "semantic_pass"],
                  "properties": {
                    "kind": {"const": "opencode-ai"},
                    "semantic_pass": {"const": false}
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {
        "required": ["generator", "bindings", "claim_boundary", "failure"],
        "properties": {
          "ai_required_for_default_pipeline": {"const": true},
          "candidates": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "required": ["provider_invocations"],
        "properties": {"provider_invocations": {"const": 0}}
      },
      "then": {
        "oneOf": [
          {
            "required": ["provider_preflight", "failure"],
            "properties": {
              "status": {"const": "blocked"},
              "provider_preflight": {
                "properties": {"status": {"const": "blocked"}}
              },
              "failure": {
                "properties": {"kind": {"const": "context_not_provider_ready"}}
              },
              "cache": {
                "properties": {"status": {"enum": ["disabled", "not_checked"]}}
              }
            }
          },
          {
            "required": ["provider_preflight", "cache"],
            "properties": {
              "status": {"const": "generated"},
              "provider_preflight": {
                "properties": {"status": {"const": "ready"}}
              },
              "cache": {
                "properties": {"status": {"const": "hit"}}
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["provider_invocations"],
        "properties": {"provider_invocations": {"const": 1}}
      },
      "then": {
        "required": ["provider_preflight"],
        "properties": {
          "bindings": {"required": ["invocation_receipt"]},
          "provider_preflight": {
            "properties": {"status": {"const": "ready"}}
          },
          "cache": {
            "properties": {"status": {"enum": ["disabled", "miss"]}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["provider_invocations"],
        "properties": {"provider_invocations": {"const": 2}}
      },
      "then": {
        "required": ["provider_preflight", "provider_retry"],
        "properties": {
          "bindings": {"required": ["invocation_receipt"]},
          "provider_preflight": {
            "properties": {"status": {"const": "ready"}}
          },
          "cache": {
            "properties": {"status": {"enum": ["disabled", "miss"]}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["schema_version"],
        "properties": {"schema_version": {"minimum": 9}}
      },
      "then": {"required": ["provider_attempts"]}
    },
    {
      "if": {
        "required": ["schema_version", "provider_invocations"],
        "properties": {
          "schema_version": {"minimum": 9},
          "provider_invocations": {"enum": [1, 2]}
        }
      },
      "then": {
        "required": ["provider_attempts"],
        "allOf": [
          {
            "if": {"properties": {"provider_invocations": {"const": 1}}},
            "then": {"properties": {"provider_attempts": {"minItems": 1, "maxItems": 1}}}
          },
          {
            "if": {"properties": {"provider_invocations": {"const": 2}}},
            "then": {"properties": {"provider_attempts": {"minItems": 2, "maxItems": 2}}}
          }
        ]
      }
    }
  ],
  "definitions": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "providerAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_index", "reason", "raw_response", "invocation_receipt"],
      "properties": {
        "attempt_index": {"type": "integer", "minimum": 1, "maximum": 2},
        "reason": {"enum": ["initial", "provider_empty_completion_retry"]},
        "raw_response": {"$ref": "#/definitions/artifactRef"},
        "invocation_receipt": {"$ref": "#/definitions/artifactRef"},
        "session_export_identity": {"$ref": "#/definitions/artifactRef"}
      }
    },
    "providerRetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trigger", "max_retries", "initial_attempt", "retry_attempt", "result", "semantic_gate"],
      "properties": {
        "schema_version": {"const": 1},
        "trigger": {"const": "provider_empty_completion"},
        "max_retries": {"const": 1},
        "initial_attempt": {"const": 1},
        "retry_attempt": {"const": 2},
        "result": {"enum": ["generated", "blocked"]},
        "semantic_gate": {"const": false}
      }
    },
    "candidateContextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "candidate_context_only"}
      }
    },
    "repairReportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "semantic_pass"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["blocked", "stopped", "exhausted", "candidate_ready_for_common_validation"]},
        "semantic_pass": {"const": false}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "provider", "logical_model", "resolved_model", "competition_eligible", "evaluation_scope", "agent", "variant"],
      "properties": {
        "tool": {"const": "opencode"},
        "provider": {"type": "string", "minLength": 1},
        "logical_model": {"type": "string", "minLength": 1},
        "resolved_model": {"type": "string", "minLength": 1},
        "competition_eligible": {"type": "boolean"},
        "evaluation_scope": {"enum": ["competition-primary", "auxiliary-local-validation"]},
        "agent": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "prompt_transport": {"$ref": "#/definitions/promptTransport"}
      }
    },
    "promptTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file_option", "file_option_style", "message_position", "message_sha256", "inline_prompt_in_argv"],
      "properties": {
        "kind": {"const": "opencode-file-attachment-v2"},
        "file_option": {"const": "--file"},
        "file_option_style": {"const": "equals"},
        "message_position": {"const": "before_file_option"},
        "message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inline_prompt_in_argv": {"const": false}
      }
    },
    "providerPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_span_status"],
      "properties": {
        "status": {"enum": ["ready", "blocked"]},
        "source_span_status": {
          "enum": [
            "real_source_bound",
            "inline_slice_spec",
            "inline_translation_carrier_bound",
            "blocked_path_outside_source_root",
            "source_file_missing",
            "blocked_source_hash_mismatch",
            "source_span_too_large",
            "source_span_empty",
            "source_span_coordinates_missing",
            "blocked_span_hash_mismatch",
            "omitted_too_large",
            "unsupported_source_encoding",
            "source_span_unavailable",
            "blocked_translation_carrier_contract",
            "source_binding_incomplete",
            "source_root_not_ready",
            "source_file_changed_during_read",
            "invalid_context_shape"
          ]
        },
        "compile_context_status": {"const": "response_file_invalid"},
        "context_boundary_status": {"enum": ["required_callee_context_incomplete", "external_callee_source_context_incomplete"]},
        "replay_api_contract_status": {
          "enum": [
            "missing",
            "blocked_invalid_function_identifier",
            "blocked_replay_source_path",
            "blocked_replay_source_missing",
            "blocked_replay_source_too_large",
            "blocked_replay_source_unreadable",
            "blocked_replay_source_sensitive",
            "blocked_replay_call_missing",
            "binding_mismatch",
            "invalid"
          ]
        }
      }
    },
    "candidateCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["disabled", "not_checked", "miss", "hit"]},
        "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entry": {"$ref": "#/definitions/artifactRef"},
        "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "miss_reason": {"enum": ["entry_missing", "entry_invalid", "store_failed"]},
        "stored": {"type": "boolean"},
        "reason": {"const": "context_not_provider_ready"}
      },
      "oneOf": [
        {
          "properties": {"status": {"const": "disabled"}},
          "not": {
            "anyOf": [
              {"required": ["key_sha256"]},
              {"required": ["entry_sha256"]},
              {"required": ["entry"]},
              {"required": ["raw_response_sha256"]},
              {"required": ["candidate_sha256"]},
              {"required": ["miss_reason"]},
              {"required": ["stored"]},
              {"required": ["reason"]}
            ]
          }
        },
        {
          "required": ["reason"],
          "properties": {"status": {"const": "not_checked"}},
          "not": {
            "anyOf": [
              {"required": ["key_sha256"]},
              {"required": ["entry_sha256"]},
              {"required": ["entry"]},
              {"required": ["raw_response_sha256"]},
              {"required": ["candidate_sha256"]},
              {"required": ["miss_reason"]},
              {"required": ["stored"]}
            ]
          }
        },
        {
          "required": ["key_sha256", "miss_reason", "stored"],
          "properties": {"status": {"const": "miss"}},
          "not": {
            "anyOf": [
              {"required": ["entry_sha256"]},
              {"required": ["entry"]},
              {"required": ["raw_response_sha256"]},
              {"required": ["candidate_sha256"]},
              {"required": ["reason"]}
            ]
          }
        },
        {
          "required": ["key_sha256", "entry_sha256", "entry", "raw_response_sha256", "candidate_sha256"],
          "properties": {"status": {"const": "hit"}},
          "not": {
            "anyOf": [
              {"required": ["miss_reason"]},
              {"required": ["stored"]},
              {"required": ["reason"]}
            ]
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_pack", "prompt", "raw_response"],
      "properties": {
        "context_pack": {"$ref": "#/definitions/artifactRef"},
        "prompt": {"$ref": "#/definitions/artifactRef"},
        "raw_response": {"$ref": "#/definitions/artifactRef"},
        "invocation_receipt": {"$ref": "#/definitions/artifactRef"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["semantic_gate", "translation_coverage_numerator", "candidate_requires_common_validation"],
      "properties": {
        "semantic_gate": {"const": false},
        "translation_coverage_numerator": {"const": 0},
        "candidate_requires_common_validation": {"const": true}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "purpose", "prompt_scope", "input_artifact_hashes", "output_hash", "applied", "accepted_by_gates"],
      "properties": {
        "candidate_id": {"type": "string"},
        "purpose": {"enum": ["rust_draft", "patch_plan", "repair_candidate", "explanation"]},
        "kind": {"type": "string"},
        "provider_label": {"type": "string"},
        "model_label": {"type": "string"},
        "resolved_model": {"type": "string"},
        "competition_eligible": {"type": "boolean"},
        "evaluation_scope": {"enum": ["competition-primary", "auxiliary-local-validation"]},
        "prompt_scope": {"type": "array", "items": {"enum": ["slice_spec", "source_spans", "generated_replay_api_contract", "root_cause_summary", "type_map_excerpt", "cfg_excerpt", "typed_ir_excerpt", "pointer_graph_excerpt", "direct_caller_callee_facts", "external_callee_source_blocks", "verification_delta", "two_hop_expansion"]}},
        "two_hop_expansion_justification": {"type": "string"},
        "input_artifact_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
        "output_hash": {"type": "string"},
        "artifact": {"$ref": "#/definitions/artifactRef"},
        "initial_artifact": {"$ref": "#/definitions/artifactRef"},
        "initial_output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "repair": {"$ref": "#/definitions/repairReportRef"},
        "repair_rounds": {"type": "integer", "minimum": 1, "maximum": 5},
        "applied": {"type": "boolean"},
        "semantic_pass": {"type": "boolean"},
        "accepted_by_gates": {"type": "array", "items": {"type": "string"}},
        "rejected_by_gates": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
