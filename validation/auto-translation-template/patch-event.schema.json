{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Patch Event JSONL Record",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "patch_id", "target_id", "slice_id", "round", "status", "files", "reason", "expected_error_delta", "forbidden_changes", "rollback_id", "ai_usage", "verification_commands"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "patch_id": {"type": "string"},
    "target_id": {"type": "string"},
    "slice_id": {"type": "string"},
    "round": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["planned", "applied", "verified", "failed", "blocked", "rolled_back"]},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/filePatch"}},
    "reason": {"type": "string"},
    "expected_error_delta": {"type": "object", "required": ["before", "after_expected"], "properties": {"before": {"type": "array", "items": {"type": "string"}}, "after_expected": {"type": "array", "items": {"type": "string"}}}},
    "forbidden_changes": {"type": "array", "items": {"enum": ["c_oracle_contract", "fixture_expected_behavior", "accepted_metadata_differences", "public_api_outside_impact_set", "source_slice_boundary", "unsafe_budget_policy"]}},
    "rollback_id": {"type": "string"},
    "ai_usage": {"type": "object", "required": ["used"], "properties": {"used": {"type": "boolean"}, "candidate_id": {"type": "string"}}},
    "verification_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "definitions": {
    "filePatch": {"type": "object", "required": ["path", "spans"], "properties": {"path": {"type": "string"}, "spans": {"type": "array", "items": {"type": "object", "required": ["line_start", "line_end"], "properties": {"line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}}}}}}
  }
}
