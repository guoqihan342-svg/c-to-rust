{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI ContextPack",
  "type": "object",
  "required": ["schema_version", "target_id", "slice_id", "function_name", "source_root", "source", "compile_context", "c_boundary", "rust_boundary", "replay_api_contract", "bindings", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 4},
    "target_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "function_name": {"type": "string", "minLength": 1},
    "compile_context": {
      "type": "object",
      "properties": {
        "selected_entry": {
          "type": "object",
          "properties": {
            "response_files": {"$ref": "#/definitions/responseFiles"}
          }
        }
      }
    },
    "c_boundary": {
      "type": "object",
      "required": ["sha256", "truncated", "payload", "required_callee_sections", "missing_required_callee_sections"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "truncated": {"type": "boolean"},
        "payload": {"type": "object"},
        "required_callee_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["external_direct_callees", "call_expression_contract"]}
        },
        "missing_required_callee_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["external_direct_callees", "call_expression_contract", "c_boundary_truncated"]}
        }
      }
    },
    "replay_api_contract": {"$ref": "#/definitions/replayApiContract"},
    "bindings": {
      "type": "object",
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "depth": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "replayApiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_kind", "function_name", "status"],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "contract_kind": {"const": "generated_replay_rust_source"},
        "function_name": {"type": "string", "minLength": 1},
        "api_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "status": {
          "enum": [
            "bound",
            "missing",
            "blocked_invalid_function_identifier",
            "blocked_replay_source_path",
            "blocked_replay_source_missing",
            "blocked_replay_source_too_large",
            "blocked_replay_source_unreadable",
            "blocked_replay_source_sensitive",
            "blocked_replay_call_missing",
            "blocked_replay_call_plan_invalid",
            "blocked_replay_call_plan_mismatch"
          ]
        },
        "call_count": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size_bytes", "content"],
          "properties": {
            "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "content": {"type": "string", "minLength": 1}
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_defines_function", "all_call_sites_typecheck", "parameter_count_and_order", "return_type"],
          "properties": {
            "candidate_defines_function": {"const": true},
            "all_call_sites_typecheck": {"const": true},
            "parameter_count_and_order": {"const": "as_invoked_by_generated_replay"},
            "return_type": {"const": "as_constrained_by_generated_replay"}
          }
        },
        "call_plan": {"$ref": "#/definitions/replayCallPlan"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "bound"}}},
          "then": {
            "required": ["call_count", "source", "requirements"],
            "properties": {
              "function_name": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
            }
          }
        },
        {
          "if": {"properties": {"schema_version": {"const": 2}}},
          "then": {"required": ["api_name", "call_plan"]}
        }
      ]
    },
    "replayCallPlan": {
      "oneOf": [
        {"$ref": "#/definitions/boundReplayCallPlan"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "status", "reason"],
          "properties": {
            "schema_version": {"const": 1},
            "status": {"const": "blocked"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "boundReplayCallPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "source_function_name",
        "api_name",
        "visibility",
        "abi",
        "unsafe",
        "parameters",
        "c_parameter_mappings",
        "omitted_c_parameters",
        "length_parameters_retained",
        "return_type",
        "supporting_types",
        "call_args",
        "assertions",
        "fixture",
        "plan_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "bound"},
        "source_function_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "api_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "visibility": {"enum": ["pub", "pub(crate)", "private"]},
        "abi": {"enum": ["Rust", "C"]},
        "unsafe": {"type": "boolean"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/definitions/replayCallParameter"}
        },
        "c_parameter_mappings": {
          "type": "array",
          "items": {"$ref": "#/definitions/replayCParameterMapping"}
        },
        "omitted_c_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "length_parameters_retained": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "return_type": {"type": "string", "minLength": 1},
        "supporting_types": {
          "type": "array",
          "items": {"$ref": "#/definitions/replaySupportingType"}
        },
        "call_args": {
          "type": "array",
          "items": {"$ref": "#/definitions/replayCallArgument"}
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/replayAssertion"}
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "case_count", "case_ids"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "case_count": {"type": "integer", "minimum": 1},
            "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "replayCallParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "name", "rust_type", "c_parameter", "length_retained", "source"],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "rust_type": {"type": "string", "minLength": 1},
        "c_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "length_retained": {"type": "boolean"},
        "source": {"$ref": "#/definitions/replayArgumentSource"}
      }
    },
    "replayArgumentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field", "encoding"],
      "properties": {
        "kind": {"enum": ["fixture_field", "encoded_length"]},
        "field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "encoding": {"enum": ["u32", "i32", "usize", "u16", "bool", "string", "hex_bytes", "hex"]},
        "null_default": {"type": ["integer", "string", "boolean", "null"]}
      }
    },
    "replayCParameterMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "c_parameter", "c_type", "direction", "rust_parameter", "rust_type"],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "c_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "c_type": {"type": "string"},
        "direction": {"type": "string"},
        "rust_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "rust_type": {"type": "string", "minLength": 1}
      }
    },
    "replayCallArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "parameter", "source"],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "source": {"$ref": "#/definitions/replayArgumentSource"}
      }
    },
    "replayAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual", "fixture_field", "rust_type", "encoding"],
      "properties": {
        "actual": {"type": "string", "pattern": "^return(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "fixture_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "rust_type": {"type": "string", "minLength": 1},
        "encoding": {"enum": ["u32", "i32", "usize", "u16", "bool", "string"]}
      }
    },
    "replaySupportingType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "visibility", "fields"],
      "properties": {
        "kind": {"const": "struct"},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "visibility": {"enum": ["pub", "pub(crate)", "private"]},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rust_type"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "rust_type": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "responseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "depth"],
      "properties": {
        "path": {"type": "string", "pattern": "^<source-root>/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "depth": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "responseFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contract_version", "dialect", "limits", "files", "expansion_count", "unique_file_count", "total_bytes", "original_argv_sha256"],
      "properties": {
        "status": {"enum": ["expanded", "blocked"]},
        "contract_version": {"const": 1},
        "dialect": {"enum": ["gnu-v1", "unsupported"]},
        "reason": {"type": "string", "minLength": 1},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_depth", "max_files", "max_file_bytes", "max_total_bytes", "max_arguments"],
          "properties": {
            "max_depth": {"const": 4},
            "max_files": {"const": 16},
            "max_file_bytes": {"const": 65536},
            "max_total_bytes": {"const": 262144},
            "max_arguments": {"const": 4096}
          }
        },
        "files": {"type": "array", "maxItems": 16, "items": {"$ref": "#/definitions/responseFile"}},
        "expansion_count": {"type": "integer", "minimum": 0, "maximum": 17},
        "unique_file_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "expanded_argument_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 327680},
        "original_argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expanded_argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "expanded"}}}, "then": {"required": ["expanded_argument_count", "expanded_argv_sha256"]}},
        {"if": {"properties": {"status": {"const": "blocked"}}}, "then": {"required": ["reason"]}}
      ]
    }
  }
}
