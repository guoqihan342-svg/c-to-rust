{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI ContextPack",
  "type": "object",
  "required": ["schema_version", "target_id", "slice_id", "function_name", "source_root", "source", "compile_context", "c_boundary", "rust_boundary", "replay_api_contract", "bindings", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 4},
    "target_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "function_name": {"type": "string", "minLength": 1},
    "compile_context": {
      "type": "object",
      "properties": {
        "selected_entry": {
          "type": "object",
          "properties": {
            "response_files": {"$ref": "#/definitions/responseFiles"}
          }
        }
      }
    },
    "c_boundary": {
      "type": "object",
      "required": ["sha256", "truncated", "payload", "required_callee_sections", "missing_required_callee_sections"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "truncated": {"type": "boolean"},
        "payload": {"type": "object"},
        "required_callee_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["external_direct_callees", "call_expression_contract"]}
        },
        "missing_required_callee_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["external_direct_callees", "call_expression_contract", "c_boundary_truncated"]}
        }
      }
    },
    "replay_api_contract": {"$ref": "#/definitions/replayApiContract"},
    "bindings": {
      "type": "object",
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "depth": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "replayApiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_kind", "function_name", "status"],
      "properties": {
        "schema_version": {"enum": [1, 2, 3]},
        "contract_kind": {"const": "generated_replay_rust_source"},
        "function_name": {"type": "string", "minLength": 1},
        "api_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "status": {
          "enum": [
            "bound",
            "missing",
            "blocked_invalid_function_identifier",
            "blocked_replay_source_path",
            "blocked_replay_source_missing",
            "blocked_replay_source_too_large",
            "blocked_replay_source_unreadable",
            "blocked_replay_source_sensitive",
            "blocked_replay_call_missing",
            "blocked_replay_call_plan_invalid",
            "blocked_replay_call_plan_mismatch"
          ]
        },
        "call_count": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size_bytes", "content"],
          "properties": {
            "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "content": {"type": "string", "minLength": 1}
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_defines_function", "all_call_sites_typecheck", "parameter_count_and_order", "return_type"],
          "properties": {
            "candidate_defines_function": {"const": true},
            "all_call_sites_typecheck": {"const": true},
            "parameter_count_and_order": {"const": "as_invoked_by_generated_replay"},
            "return_type": {"const": "as_constrained_by_generated_replay"}
          }
        },
        "call_plan": {"$ref": "#/definitions/replayCallPlan"},
        "required_candidate_api": {"$ref": "#/definitions/requiredCandidateApi"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "bound"}}},
          "then": {
            "required": ["call_count", "source", "requirements"],
            "properties": {
              "function_name": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
            }
          }
        },
        {
          "if": {"properties": {"schema_version": {"const": 2}}},
          "then": {"required": ["api_name", "call_plan"]}
        },
        {
          "if": {"properties": {"schema_version": {"const": 3}}},
          "then": {"required": ["api_name", "call_plan", "required_candidate_api"]}
        }
      ]
    },
    "requiredCandidateApi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "api_name",
        "plan_sha256",
        "signature",
        "supporting_types_source",
        "candidate_source_contract",
        "return_lifetime_from",
        "contract_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "bound"},
        "api_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 4096},
        "supporting_types_source": {"type": "string", "maxLength": 65536},
        "candidate_source_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "type_environment",
            "supporting_types_source",
            "harness_injects_missing_types"
          ],
          "properties": {
            "mode": {"const": "self_contained"},
            "type_environment": {"const": "closed"},
            "supporting_types_source": {
              "enum": ["none", "required_exactly_once"]
            },
            "harness_injects_missing_types": {"const": false}
          }
        },
        "return_lifetime_from": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          ]
        },
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "replayCallPlan": {
      "oneOf": [
        {"$ref": "#/definitions/boundReplayCallPlan"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "status", "reason"],
          "properties": {
            "schema_version": {"const": 1},
            "status": {"const": "blocked"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "boundReplayCallPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "source_function_name",
        "api_name",
        "visibility",
        "abi",
        "unsafe",
        "parameters",
        "c_parameter_mappings",
        "omitted_c_parameters",
        "length_parameters_retained",
        "return_type",
        "supporting_types",
        "call_args",
        "assertions",
        "fixture",
        "plan_sha256"
      ],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "status": {"const": "bound"},
        "source_function_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "api_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "visibility": {"enum": ["pub", "pub(crate)", "private"]},
        "abi": {"enum": ["Rust", "C"]},
        "unsafe": {"type": "boolean"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/definitions/replayCallParameter"}
        },
        "c_parameter_mappings": {
          "type": "array",
          "items": {"$ref": "#/definitions/replayCParameterMapping"}
        },
        "omitted_c_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "length_parameters_retained": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "return_type": {"type": "string", "minLength": 1},
        "supporting_types": {
          "type": "array",
          "items": {"$ref": "#/definitions/replaySupportingType"}
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/replayBinding"}
        },
        "distinct_mutable_bindings": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        },
        "call_args": {
          "type": "array",
          "items": {"$ref": "#/definitions/replayCallArgument"}
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/replayAssertion"}
        },
        "fixture_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/replayFixtureAssertion"}
        },
        "identity_assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/definitions/replayIdentityAssertion"}
        },
        "pointer_identity_assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/definitions/replayPointerIdentityAssertion"}
        },
        "buffer_length_relations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/definitions/replayBufferLengthRelation"}
        },
        "fixture_relations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/replayFixtureRelation"}
        },
        "scripted_runtime": {"$ref": "#/definitions/replayScriptedRuntime"},
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "case_count", "case_ids"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "case_count": {"type": "integer", "minimum": 1},
            "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"schema_version": {"const": 2}}},
          "then": {"required": ["bindings", "distinct_mutable_bindings"]}
        },
        {
          "if": {"required": ["identity_assertions"]},
          "then": {"properties": {"schema_version": {"const": 2}}}
        }
      ]
    },
    "replayCallParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "name", "rust_type", "c_parameter", "length_retained", "source"],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "rust_type": {"type": "string", "minLength": 1},
        "c_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "length_retained": {"type": "boolean"},
        "source": {"$ref": "#/definitions/replayArgumentSource"}
      }
    },
    "replayArgumentSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "encoding"],
          "properties": {
            "kind": {"enum": ["fixture_field", "encoded_length"]},
            "field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "encoding": {"enum": ["u32", "u64", "i32", "usize", "u16", "bool", "string", "string_ref", "optional_string_ref", "hex_bytes", "u8_array", "hex", "i32_slice"]},
            "null_default": {"type": ["integer", "string", "boolean", "null"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding"],
          "properties": {
            "kind": {"enum": ["binding_borrow", "binding_borrow_mut", "binding_value"]},
            "binding": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "encoding"],
          "properties": {
            "kind": {"const": "fixture_field"},
            "path": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "encoding": {"enum": ["u32", "i32", "usize", "bool", "i32_slice"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding", "fixture_path"],
          "properties": {
            "kind": {"const": "nullable_byte_buffer_const_ptr"},
            "binding": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "fixture_path": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "replayCParameterMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "c_parameter", "c_type", "direction", "rust_parameter", "rust_type"],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "c_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "c_type": {"type": "string"},
        "direction": {"type": "string"},
        "rust_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "rust_type": {"type": "string", "minLength": 1}
      }
    },
    "replayCallArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "parameter", "source"],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "source": {"$ref": "#/definitions/replayArgumentSource"}
      }
    },
    "replayAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual", "fixture_field", "rust_type", "encoding"],
      "properties": {
        "actual": {"type": "string", "pattern": "^(?:return(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|binding\\.[A-Za-z_][A-Za-z0-9_]*(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|[0-9]+))*)$"},
        "fixture_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "rust_type": {"type": "string", "minLength": 1},
        "encoding": {"enum": ["u32", "u64", "i32", "usize", "u16", "bool", "string", "i32_vec"]}
      }
    },
    "replayFixtureAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_field", "encoding", "expected"],
      "properties": {
        "fixture_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "encoding": {"enum": ["u32", "u64", "i32", "usize", "bool", "string", "string_vec"]},
        "expected": {
          "oneOf": [
            {"type": ["integer", "boolean", "string"]},
            {"type": "array", "maxItems": 64, "items": {"type": "string"}}
          ]
        }
      }
    },
    "replayIdentityAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actual", "expected_binding", "mutability", "fixture_field"],
      "properties": {
        "kind": {"const": "reference_identity"},
        "actual": {"const": "return"},
        "expected_binding": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "mutability": {"enum": ["mutable", "shared"]},
        "fixture_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "replayPointerIdentityAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actual", "expected_binding", "expected_parameter", "fixture_field"],
      "properties": {
        "kind": {"const": "raw_pointer_identity"},
        "actual": {"type": "string", "pattern": "^binding\\.[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
        "expected_binding": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "expected_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "fixture_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"}
      }
    },
    "replayBufferLengthRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "buffer_binding", "length_parameter"],
      "properties": {
        "kind": {"const": "retained_length_within_nullable_buffer"},
        "buffer_binding": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "length_parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "replaySupportingType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "visibility", "fields"],
      "properties": {
        "kind": {"const": "struct"},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "visibility": {"enum": ["pub", "pub(crate)", "private"]},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rust_type"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "rust_type": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "replayBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rust_type", "mutable", "initializer"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "rust_type": {"type": "string", "minLength": 1},
        "mutable": {"type": "boolean"},
        "initializer": {
          "oneOf": [
            {"$ref": "#/definitions/replayStructInitializer"},
            {"$ref": "#/definitions/replayArrayInitializer"},
            {"$ref": "#/definitions/replayVecInitializer"},
            {"$ref": "#/definitions/replayNullableByteBufferInitializer"}
          ]
        }
      }
    },
    "replayArrayInitializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rust_type", "element_type", "length", "value"],
      "properties": {
        "kind": {"const": "array_repeat"},
        "rust_type": {"type": "string", "pattern": "^\\[(?:u32|i32); [1-9][0-9]*\\]$"},
        "element_type": {"enum": ["u32", "i32"]},
        "length": {"type": "integer", "minimum": 1, "maximum": 32},
        "value": {"type": "integer", "minimum": -2147483648, "maximum": 4294967295}
      }
    },
    "replayVecInitializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rust_type", "element_type", "length", "value"],
      "properties": {
        "kind": {"const": "vec_repeat"},
        "rust_type": {"const": "Vec<i32>"},
        "element_type": {"const": "i32"},
        "length": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "encoding", "maximum"],
          "properties": {
            "kind": {"const": "fixture_field"},
            "field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "encoding": {"const": "i32"},
            "maximum": {"type": "integer", "minimum": 1, "maximum": 4096}
          }
        },
        "value": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      }
    },
    "replayNullableByteBufferInitializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rust_type", "fixture_path", "nullability", "maximum"],
      "properties": {
        "kind": {"const": "nullable_byte_buffer"},
        "rust_type": {"const": "Vec<u8>"},
        "fixture_path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "nullability": {"const": "fixture_nullable"},
        "maximum": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "replayConstantScalarInitializer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rust_type", "encoding", "value"],
          "properties": {
            "kind": {"const": "constant_scalar"},
            "rust_type": {"const": "u32"},
            "encoding": {"const": "u32"},
            "value": {"type": "integer", "minimum": 0, "maximum": 4294967295}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rust_type", "encoding", "value"],
          "properties": {
            "kind": {"const": "constant_scalar"},
            "rust_type": {"const": "i32"},
            "encoding": {"const": "i32"},
            "value": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rust_type", "encoding", "value"],
          "properties": {
            "kind": {"const": "constant_scalar"},
            "rust_type": {"const": "usize"},
            "encoding": {"const": "usize"},
            "value": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rust_type", "encoding", "value"],
          "properties": {
            "kind": {"const": "constant_scalar"},
            "rust_type": {"const": "bool"},
            "encoding": {"const": "bool"},
            "value": {"type": "boolean"}
          }
        }
      ]
    },
    "replayNullPointerInitializer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rust_type", "mutability"],
          "properties": {
            "kind": {"const": "null_pointer"},
            "rust_type": {"const": "*const core::ffi::c_void"},
            "mutability": {"const": "shared"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rust_type", "mutability"],
          "properties": {
            "kind": {"const": "null_pointer"},
            "rust_type": {"const": "*mut core::ffi::c_void"},
            "mutability": {"const": "mutable"}
          }
        }
      ]
