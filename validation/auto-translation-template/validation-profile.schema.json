{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Validation Profile Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target_id",
    "slice_id",
    "status",
    "profile",
    "route_level",
    "goal",
    "required_gates",
    "optional_gates",
    "skipped_gates",
    "required_gate_status",
    "loop_policy",
    "tool_boundaries"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "target_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "incomplete", "blocked"]},
    "profile": {"type": "string", "minLength": 1},
    "route_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "goal": {"type": "string", "minLength": 1},
    "competition_environment": {"$ref": "#/definitions/competitionEnvironment"},
    "generated_draft_semantic_pass": {"type": "boolean"},
    "generated_draft_acceptance": {"$ref": "#/definitions/generatedDraftAcceptance"},
    "accepted_evidence_authoritative": {"type": "boolean"},
    "candidate_generation": {"$ref": "#/definitions/candidateGenerationEvidence"},
    "oracle_boundary_contract": {"$ref": "#/definitions/oracleBoundaryContract"},
    "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "optional_gates": {"type": "array", "items": {"type": "string"}},
    "skipped_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "reason"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_gate_status": {"type": "object"},
    "loop_policy": {
      "type": "object",
      "required": ["source", "fixed_project_loop_count_required"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "fixed_project_loop_count_required": {"const": false},
        "stress_loops": {}
      }
    },
    "tool_boundaries": {
      "type": "object",
      "required": ["c_ub", "rust_ub"],
      "properties": {
        "c_ub": {"type": "array", "items": {"type": "string"}},
        "rust_ub": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "required": ["oracle_boundary_contract"],
        "properties": {
          "skipped_gates": {"type": "array", "maxItems": 0}
        }
      }
    },
    {
      "if": {
        "required": ["generated_draft_semantic_pass"],
        "properties": {"generated_draft_semantic_pass": {"const": true}}
      },
      "then": {
        "required": ["generated_draft_acceptance"],
        "properties": {
          "generated_draft_acceptance": {
            "required": ["status", "generated_draft_semantic_pass", "claim_source"],
            "properties": {
              "status": {"const": "passed"},
              "generated_draft_semantic_pass": {"const": true},
              "claim_source": {"const": "generated_draft_replay_with_accepted_oracle_binding"}
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "generatedDraftAcceptance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "generated_draft_semantic_pass"],
      "properties": {
        "status": {"enum": ["passed", "blocked"]},
        "generated_draft_semantic_pass": {"type": "boolean"},
        "claim_source": {"type": "string", "minLength": 1}
      }
    },
    "oracleBoundaryContract": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "status",
        "observable_outputs",
        "fixture_representativeness",
        "compiler",
        "target",
        "sanitizer_diagnostics",
        "ub_and_implementation_defined",
        "platform_model"
      ],
      "properties": {
        "schema_version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["sufficient_for_semantic_pass", "insufficient"]},
        "observable_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "fixture_representativeness": {"$ref": "#/definitions/oracleFixtureRepresentativeness"},
        "compiler": {"$ref": "#/definitions/oracleCompilerBoundary"},
        "target": {"$ref": "#/definitions/oracleTargetBoundary"},
        "sanitizer_diagnostics": {"$ref": "#/definitions/oracleSanitizerDiagnostics"},
        "ub_and_implementation_defined": {"$ref": "#/definitions/oracleUbBoundary"},
        "platform_model": {"$ref": "#/definitions/oraclePlatformModel"},
        "insufficient_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "oracleFixtureRepresentativeness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fixture_path", "fixture_hash", "representativeness", "limitations"],
      "properties": {
        "fixture_path": {"type": "string", "minLength": 1},
        "fixture_hash": {"type": "string", "minLength": 1},
        "declared_case_count": {"type": "integer", "minimum": 0},
        "accepted_oracle_case_count": {"type": "integer", "minimum": 0},
        "case_source": {"type": "string", "minLength": 1},
        "representativeness": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "anyOf": [
        {"required": ["declared_case_count"]},
        {"required": ["accepted_oracle_case_count"]}
      ]
    },
    "oracleCompilerBoundary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["command_source", "include_paths", "defines", "flags", "tool_versions"],
      "properties": {
        "command_source": {"type": "string", "minLength": 1},
        "include_paths": {"type": "array", "items": {"type": "string"}},
        "defines": {"type": "array", "items": {"type": "string"}},
        "flags": {"type": "array", "items": {"type": "string"}},
        "tool_versions": {"type": "object"}
      }
    },
    "oracleTargetBoundary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["triple_or_abi", "endianness", "int_width", "long_width", "pointer_width", "word_size_bits"],
      "properties": {
        "triple_or_abi": {"type": "string", "minLength": 1},
        "endianness": {"type": "string", "minLength": 1},
        "int_width": {"type": ["integer", "string"]},
        "int_align": {"type": ["integer", "string"]},
        "char_width": {"type": ["integer", "string"]},
        "char_align": {"type": ["integer", "string"]},
        "plain_char_signed": {"type": ["boolean", "string"]},
        "short_width": {"type": ["integer", "string"]},
        "short_align": {"type": ["integer", "string"]},
        "long_width": {"type": ["integer", "string"]},
        "long_align": {"type": ["integer", "string"]},
        "long_long_width": {"type": ["integer", "string"]},
        "long_long_align": {"type": ["integer", "string"]},
        "pointer_width": {"type": ["integer", "string"]},
        "pointer_align": {"type": ["integer", "string"]},
        "word_size_bits": {"type": ["integer", "string"]}
      }
    },
    "oracleSanitizerDiagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sanitizer_status", "diagnostic_status", "diagnostics"],
      "properties": {
        "sanitizer_status": {"type": "string", "minLength": 1},
        "diagnostic_status": {"type": "string", "minLength": 1},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "clang_type_extraction_available": {}
      }
    },
    "oracleUbBoundary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["known_ub", "implementation_defined_behavior", "scalar_arithmetic_contract"],
      "properties": {
        "known_ub": {"type": "array", "items": {"type": "string"}},
        "implementation_defined_behavior": {"type": "array", "items": {"type": "string"}},
        "scalar_arithmetic_contract": {"type": "object"}
      }
    },
    "oraclePlatformModel": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "hardware_dependencies",
        "rtos_dependencies",
        "volatile_dependencies",
        "hardware_dependency_status",
        "rtos_dependency_status",
        "volatile_dependency_status"
      ],
      "properties": {
        "hardware_dependencies": {"type": "array", "items": {"type": "string"}},
        "rtos_dependencies": {"type": "array", "items": {"type": "string"}},
        "volatile_dependencies": {"type": "array", "items": {"type": "string"}},
        "hardware_dependency_status": {"type": "string", "minLength": 1},
        "rtos_dependency_status": {"type": "string", "minLength": 1},
        "volatile_dependency_status": {"type": "string", "minLength": 1}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1}
      }
    },
    "competitionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "path", "sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidateGenerationEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["typed_ir", "generated_draft_semantic_pass"],
      "properties": {
        "selection_policy": {"$ref": "#/definitions/candidateSelectionPolicy"},
        "selected_candidate_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "candidate_set": {
          "type": "array",
          "items": {"$ref": "#/definitions/candidateSetItem"}
        },
        "compatibility_sources": {
          "type": "array",
          "items": {"$ref": "#/definitions/compatibilitySourceEvidence"}
        },
        "primary_candidate": {"$ref": "#/definitions/primaryCandidateEvidence"},
        "typed_ir": {"$ref": "#/definitions/typedIrCandidateEvidence"},
        "c2rust_baseline": {"$ref": "#/definitions/candidateSetItem"},
        "ai": {"$ref": "#/definitions/candidateSetItem"},
        "governance_summary": {"$ref": "#/definitions/routeGovernanceSummary"},
        "generated_draft_semantic_pass": {"const": false}
      }
    },
    "candidateSelectionPolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["stage", "semantic_acceptance", "full_router"],
      "properties": {
        "stage": {"enum": ["post_generation_provenance", "p0_route_governance", "ai_primary_provenance"]},
        "selection_basis": {"type": "string", "minLength": 1},
        "semantic_acceptance": {"const": false},
        "full_router": {"const": false}
      }
    },
    "routeGovernanceSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "stage",
        "route_level",
        "route_status",
        "semantic_acceptance",
        "full_router",
        "hard_gates",
        "fallback_summary",
        "validation_gate_summary"
      ],
      "properties": {
        "stage": {"const": "p0_route_governance"},
        "route_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "route_status": {"type": "string", "minLength": 1},
        "candidate_generation_allowed": {"type": "boolean"},
        "semantic_acceptance": {"const": false},
        "full_router": {"const": false},
        "hard_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["gate_id", "status"],
            "properties": {
              "gate_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "reason": {"type": "string"}
            }
          }
        },
        "fallback_summary": {
          "type": "object",
          "additionalProperties": true
        },
        "refusal_summary": {
          "type": "object",
          "additionalProperties": true
        },
        "validation_gate_summary": {
          "type": "object",
          "additionalProperties": true,
          "required": ["generated_draft_semantic_pass", "required_acceptance_gates"],
          "properties": {
            "generated_draft_semantic_pass": {"const": false},
            "required_acceptance_gates": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "semantic_claim_source": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "candidateSetItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidate_id", "kind", "status", "role", "semantic_pass"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "unknown",
            "legacy-string-translator",
            "clang-lowered-typed-ir",
            "typed-ir",
            "c2rust-baseline",
            "opencode-ai"
          ]
        },
        "status": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "primary_rust_draft",
            "typed_ir_signal",
            "typed_ir_candidate_signal",
            "candidate_context_only",
            "baseline_or_repair_candidate_context",
            "compatibility_rust_draft",
            "ai_primary_rust_draft"
          ]
        },
        "semantic_pass": {"const": false},
        "generated_draft_semantic_pass": {"const": false},
        "correctness_role": {"enum": ["candidate_context_only", "compatibility_only"]},
        "compatibility_only": {"const": true},
        "baseline_manifest": {"$ref": "#/definitions/artifactRef"},
        "output_ref": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": true,
              "required": ["path", "status", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "status": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "fallback": {"type": "boolean"},
        "fallback_from": {"enum": ["clang-lowered-typed-ir", "legacy-string-translator"]},
        "fallback_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["baseline_manifest"]},
          "then": {"required": ["output_ref", "generated_draft_semantic_pass"]}
        },
        {
          "if": {
            "required": ["baseline_manifest"],
            "properties": {
              "baseline_manifest": {
                "properties": {"status": {"const": "generated"}}
              }
            }
          },
          "then": {
            "properties": {
              "output_ref": {
                "type": "object",
                "required": ["path", "status", "sha256"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["baseline_manifest"],
            "properties": {
              "baseline_manifest": {
                "properties": {"status": {"enum": ["skipped", "blocked"]}}
              }
            }
          },
          "then": {"properties": {"output_ref": {"type": "null"}}}
        }
      ]
    },
    "primaryCandidateEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["selected", "fallback"],
      "properties": {
        "selected": {
          "enum": ["unknown", "clang-lowered-typed-ir", "opencode-ai"]
        },
        "fallback": {"type": "boolean"},
        "fallback_from": {"enum": ["clang-lowered-typed-ir", "legacy-string-translator"]},
        "fallback_reason": {"type": "string", "minLength": 1}
      }
    },
    "compatibilitySourceEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidate_id", "selected", "fallback", "semantic_pass", "compatibility_only", "correctness_role"],
      "properties": {
        "candidate_id": {"const": "compat:legacy-string-translator"},
        "selected": {"const": "legacy-string-translator"},
        "fallback": {"type": "boolean"},
        "semantic_pass": {"const": false},
        "compatibility_only": {"const": true},
        "correctness_role": {"const": "compatibility_only"},
        "fallback_from": {"enum": ["clang-lowered-typed-ir", "legacy-string-translator"]},
        "fallback_reason": {"type": "string", "minLength": 1}
      }
    },
    "typedIrCandidateEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "source_artifact",
        "candidate_route",
        "readonly_globals",
        "readonly_globals_identity",
        "rust_draft_generated",
        "semantic_pass"
      ],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "source_artifact": {"$ref": "#/definitions/artifactRef"},
        "candidate_route": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/definitions/typedIrCandidateRoute"}
          ]
        },
        "readonly_globals": {"type": "array"},
        "readonly_globals_identity": {
          "type": "object",
          "additionalProperties": true,
          "required": ["count", "names", "sha256"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "names": {"type": "array", "items": {"type": "string"}},
            "sha256": {"type": "string", "minLength": 1}
          }
        },
        "rust_draft_generated": {"type": "boolean"},
        "semantic_pass": {"const": false},
        "reason": {"type": "string", "minLength": 1},
        "unsupported_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "generated"}}},
          "then": {
            "properties": {
              "source_artifact": {"required": ["sha256"]},
              "candidate_route": {
                "allOf": [
                  {"$ref": "#/definitions/typedIrCandidateRoute"},
                  {"properties": {"route": {"const": "GenericTypedIr"}}}
                ]
              },
              "rust_draft_generated": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "unsupported"}}},
          "then": {
            "properties": {
              "candidate_route": {
                "allOf": [
                  {"$ref": "#/definitions/typedIrCandidateRoute"},
                  {"properties": {"route": {"const": "Unsupported"}}}
                ]
              },
              "rust_draft_generated": {"const": false}
            }
          }
        }
      ]
    },
    "typedIrCandidateRoute": {
      "type": "object",
      "additionalProperties": true,
      "required": ["route", "candidate_generator", "deprecated"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "route": {"enum": ["GenericTypedIr", "Unsupported"]},
        "candidate_generator": {"enum": ["GenericTypedIrEmitter", "None"]},
        "token_cost": {"type": "integer", "minimum": 0},
        "deprecated": {"const": false},
        "suggested_required_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "fallback": {
          "anyOf": [
            {"type": "null"},
            {"enum": ["GenericTypedIr", "Unsupported"]}
          ]
        },
        "replacement": {
          "anyOf": [
            {"type": "null"},
            {"enum": ["GenericTypedIr", "Unsupported"]}
          ]
        },
        "delete_when": {
          "type": "array",
          "maxItems": 0
        }
      },
      "allOf": [
        {
          "if": {"properties": {"route": {"const": "GenericTypedIr"}}},
          "then": {
            "properties": {
              "candidate_generator": {"const": "GenericTypedIrEmitter"}
            }
          }
        }
      ]
    }
  }
}
