{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Validation Profile Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target_id",
    "slice_id",
    "status",
    "profile",
    "route_level",
    "goal",
    "required_gates",
    "optional_gates",
    "skipped_gates",
    "required_gate_status",
    "loop_policy",
    "tool_boundaries"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "target_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "incomplete", "blocked"]},
    "profile": {"type": "string", "minLength": 1},
    "route_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "goal": {"type": "string", "minLength": 1},
    "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "optional_gates": {"type": "array", "items": {"type": "string"}},
    "skipped_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "reason"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_gate_status": {"type": "object"},
    "loop_policy": {
      "type": "object",
      "required": ["source", "fixed_project_loop_count_required"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "fixed_project_loop_count_required": {"const": false},
        "stress_loops": {}
      }
    },
    "tool_boundaries": {
      "type": "object",
      "required": ["c_ub", "rust_ub"],
      "properties": {
        "c_ub": {"type": "array", "items": {"type": "string"}},
        "rust_ub": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "skipped_gates": {"type": "array", "maxItems": 0}
        }
      }
    }
  ]
}
