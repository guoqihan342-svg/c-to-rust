{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Validation Profile Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target_id",
    "slice_id",
    "status",
    "profile",
    "route_level",
    "goal",
    "required_gates",
    "optional_gates",
    "skipped_gates",
    "required_gate_status",
    "loop_policy",
    "tool_boundaries"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "target_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "incomplete", "blocked"]},
    "profile": {"type": "string", "minLength": 1},
    "route_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "goal": {"type": "string", "minLength": 1},
    "competition_environment": {"$ref": "#/definitions/competitionEnvironment"},
    "generated_draft_semantic_pass": {"const": false},
    "accepted_evidence_authoritative": {"type": "boolean"},
    "candidate_generation": {"$ref": "#/definitions/candidateGenerationEvidence"},
    "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "optional_gates": {"type": "array", "items": {"type": "string"}},
    "skipped_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "reason"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_gate_status": {"type": "object"},
    "loop_policy": {
      "type": "object",
      "required": ["source", "fixed_project_loop_count_required"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "fixed_project_loop_count_required": {"const": false},
        "stress_loops": {}
      }
    },
    "tool_boundaries": {
      "type": "object",
      "required": ["c_ub", "rust_ub"],
      "properties": {
        "c_ub": {"type": "array", "items": {"type": "string"}},
        "rust_ub": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "skipped_gates": {"type": "array", "maxItems": 0}
        }
      }
    }
  ],
  "definitions": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1}
      }
    },
    "competitionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "path", "sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidateGenerationEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["typed_ir"],
      "properties": {
        "primary_candidate": {"$ref": "#/definitions/primaryCandidateEvidence"},
        "typed_ir": {"$ref": "#/definitions/typedIrCandidateEvidence"},
        "generated_draft_semantic_pass": {"const": false}
      }
    },
    "primaryCandidateEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["selected", "fallback"],
      "properties": {
        "selected": {
          "enum": ["unknown", "legacy-string-translator", "clang-lowered-typed-ir"]
        },
        "fallback": {"type": "boolean"},
        "fallback_from": {"enum": ["clang-lowered-typed-ir", "legacy-string-translator"]},
        "fallback_reason": {"type": "string", "minLength": 1}
      }
    },
    "typedIrCandidateEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "source_artifact",
        "candidate_route",
        "readonly_globals",
        "readonly_globals_identity",
        "rust_draft_generated",
        "semantic_pass"
      ],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "source_artifact": {"$ref": "#/definitions/artifactRef"},
        "candidate_route": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/definitions/typedIrCandidateRoute"}
          ]
        },
        "readonly_globals": {"type": "array"},
        "readonly_globals_identity": {
          "type": "object",
          "additionalProperties": true,
          "required": ["count", "names", "sha256"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "names": {"type": "array", "items": {"type": "string"}},
            "sha256": {"type": "string", "minLength": 1}
          }
        },
        "rust_draft_generated": {"type": "boolean"},
        "semantic_pass": {"const": false},
        "reason": {"type": "string", "minLength": 1},
        "unsupported_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "generated"}}},
          "then": {
            "properties": {
              "source_artifact": {"required": ["sha256"]},
              "candidate_route": {
                "allOf": [
                  {"$ref": "#/definitions/typedIrCandidateRoute"},
                  {"properties": {"route": {"const": "GenericTypedIr"}}}
                ]
              },
              "rust_draft_generated": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "unsupported"}}},
          "then": {
            "properties": {
              "candidate_route": {
                "allOf": [
                  {"$ref": "#/definitions/typedIrCandidateRoute"},
                  {"properties": {"route": {"const": "Unsupported"}}}
                ]
              },
              "rust_draft_generated": {"const": false}
            }
          }
        }
      ]
    },
    "typedIrCandidateRoute": {
      "type": "object",
      "additionalProperties": true,
      "required": ["route", "candidate_generator", "deprecated"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "route": {"enum": ["GenericTypedIr", "Unsupported"]},
        "candidate_generator": {"enum": ["GenericTypedIrEmitter", "None"]},
        "token_cost": {"type": "integer", "minimum": 0},
        "deprecated": {"const": false},
        "suggested_required_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "fallback": {
          "anyOf": [
            {"type": "null"},
            {"enum": ["GenericTypedIr", "Unsupported"]}
          ]
        },
        "replacement": {
          "anyOf": [
            {"type": "null"},
            {"enum": ["GenericTypedIr", "Unsupported"]}
          ]
        },
        "delete_when": {
          "type": "array",
          "maxItems": 0
        }
      },
      "allOf": [
        {
          "if": {"properties": {"route": {"const": "GenericTypedIr"}}},
          "then": {
            "properties": {
              "candidate_generator": {"const": "GenericTypedIrEmitter"}
            }
          }
        }
      ]
    }
  }
}
