{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "C2Rust Baseline Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target_id",
    "slice_id",
    "status",
    "reason",
    "correctness_role",
    "fallback_oracle",
    "validation_impact",
    "source_commit",
    "slice_spec",
    "build_profile_hash",
    "commands",
    "selected_command",
    "reference_tree",
    "output",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "target_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["generated", "skipped", "blocked", "stale", "incomplete"]},
    "reason": {"type": "string", "minLength": 1},
    "correctness_role": {"const": "candidate_context_only"},
    "fallback_oracle": {"const": "original_c_oracle_required"},
    "validation_impact": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "minLength": 7},
    "slice_spec": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1}
      }
    },
    "build_profile_hash": {"type": "string", "minLength": 1},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "available", "version_status", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "available": {"type": "boolean"},
          "version_status": {"type": "string", "minLength": 1},
          "version": {"type": "string"}
        }
      }
    },
    "selected_command": {
      "anyOf": [
        {"type": "null"},
        {"type": "object"}
      ]
    },
    "reference_tree": {
      "type": "object",
      "required": ["path", "status", "cargo_toml"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["present", "missing"]},
        "cargo_toml": {"type": "string"},
        "diagnostic_only": {"type": "boolean"}
      }
    },
    "output": {
      "anyOf": [
        {"type": "null"},
        {"type": "object"}
      ]
    },
    "compile": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "status",
            "attempted",
            "semantic_pass",
            "candidate_output",
            "command",
            "artifact",
            "diagnostics"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "rustc_not_found",
                "compile_timeout",
                "compile_error"
              ]
            },
            "attempted": {"type": "boolean"},
            "semantic_pass": {"const": false},
            "candidate_output": {
              "type": "object",
              "required": ["path", "status", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "status": {"const": "generated"},
                "sha256": {"type": "string", "minLength": 1}
              }
            },
            "command": {
              "type": "object",
              "required": [
                "argv",
                "working_directory",
                "stdout_log",
                "stderr_log",
                "timeout_seconds",
                "exit_status",
                "returncode"
              ],
              "properties": {
                "argv": {"type": "array", "items": {"type": "string"}},
                "working_directory": {"type": "string"},
                "stdout_log": {"type": "string", "minLength": 1},
                "stderr_log": {"type": "string", "minLength": 1},
                "timeout_seconds": {"type": "integer", "minimum": 1},
                "exit_status": {
                  "enum": ["passed", "failed", "not_executed", "timeout", "error"]
                },
                "returncode": {
                  "anyOf": [
                    {"type": "null"},
                    {"type": "integer"}
                  ]
                }
              }
            },
            "artifact": {
              "anyOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "required": ["path", "status", "sha256"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "status": {"const": "compiled"},
                    "sha256": {"type": "string", "minLength": 1}
                  }
                }
              ]
            },
            "diagnostics": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "must_not_claim": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "tool_probe": {
      "type": "object",
      "required": ["os_name", "path_search", "probed_at", "diagnostic_only"],
      "properties": {
        "os_name": {"type": "string", "minLength": 1},
        "path_search": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "probed_at": {"type": "string", "minLength": 1},
        "diagnostic_only": {"type": "boolean"},
        "environment_profile_hash": {"type": "string"},
        "competition_environment_identity": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "generated"}}},
      "then": {
        "required": ["compile", "generation"],
        "properties": {
          "selected_command": {"type": "object"},
          "output": {
            "type": "object",
            "required": ["path", "status", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "status": {"const": "generated"},
              "sha256": {"type": "string", "minLength": 1}
            }
          },
          "compile": {"type": "object"},
          "generation": {
            "type": "object",
            "required": ["compile_commands", "command", "generated_files"],
            "properties": {
              "compile_commands": {
                "type": "object",
                "required": ["path", "sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "minLength": 1}
                }
              },
              "command": {
                "type": "object",
                "required": [
                  "argv",
                  "working_directory",
                  "stdout_log",
                  "stderr_log",
                  "timeout_seconds",
                  "exit_status",
                  "returncode"
                ],
                "properties": {
                  "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                  "working_directory": {"type": "string", "minLength": 1},
                  "stdout_log": {"type": "string", "minLength": 1},
                  "stderr_log": {"type": "string", "minLength": 1},
                  "timeout_seconds": {"type": "integer", "minimum": 1},
                  "exit_status": {"const": "passed"},
                  "returncode": {"const": 0}
                }
              },
              "generated_files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["skipped", "blocked"]}}},
      "then": {
        "properties": {
          "output": {"type": "null"},
          "compile": {"type": "null"}
        }
      }
    }
  ]
}
