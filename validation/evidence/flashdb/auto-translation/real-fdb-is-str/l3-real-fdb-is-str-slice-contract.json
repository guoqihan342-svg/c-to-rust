        "c_source": "static bool fdb_is_str(uint8_t *value, size_t len)\n{\n#define __is_print(ch)       ((unsigned int)((ch) - ' ') < 127u - ' ')\n    size_t i;\n\n    for (i = 0; i < len; i++) {\n        if (!__is_print(value[i])) {\n            return false;\n        }\n    }\n    return true;\n}",
