{
    "schema_version":  1,
    "level":  "L3",
    "target_id":  "flashdb",
    "slice_id":  "kvdb-compact-overwrite",
    "status":  "frozen",
    "included_behavior":  [
                              "same-key overwrite keeps latest visible value",
                              "kv.get latest value before compact",
                              "kv.entries live sorted entries after overwrite",
                              "kv.compact returns success and metadata image hash only",
                              "post-compact kv.get and kv.entries remain unchanged",
                              "kv.reopen after compact preserves latest visible values",
                              "kv.delete removes overwritten key",
                              "post-delete kv.get returns null"
                          ],
    "excluded_behavior":  [
                              "native FlashDB GC execution",
                              "sector state transitions",
                              "tombstone relocation",
                              "byte-for-byte flash image equivalence",
                              "power-loss or crash recovery",
                              "capacity-pressure compaction",
                              "wear-leveling",
                              "TSDB behavior",
                              "binary/blob value encoding"
                          ],
    "rust_public_api_impact_set":  [
                                       "KvDb::set",
                                       "KvDb::get",
                                       "KvDb::entries",
                                       "KvDb::compact",
                                       "KvDb::open",
                                       "KvDb::delete",
                                       "replay::run_replay",
                                       "replay::run_diff"
                                   ],
    "c_oracle_operations":  [
                                "kv.set",
                                "kv.get",
                                "kv.entries",
                                "kv.compact",
                                "kv.reopen",
                                "kv.delete"
                            ],
