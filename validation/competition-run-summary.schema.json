{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Competition run summary",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": 2}
        }
      },
      "then": {
        "required": ["ai_translation_metrics"]
      }
    }
  ],
  "required": [
    "schema_version",
    "run_id",
    "proof_class",
    "profile_id",
    "profile_sha256",
    "clang_source",
    "cargo_mirror_activation",
    "elapsed_seconds",
    "translator_version",
    "slices",
    "unsafe_budget",
    "workflow_metrics",
    "command_log",
    "artifact_roots",
    "final_gate"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "proof_class": {
      "type": "string",
      "enum": [
        "competition-exact",
        "ci-approximation",
        "wsl-local-simulation",
        "local-simulation"
      ]
    },
    "profile_id": {
      "type": "string",
      "enum": [
        "huawei-competition-ubuntu-24.04"
      ]
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clang_source": {
      "type": "string",
      "enum": [
        "CLANG_PATH",
        "vendored",
        "missing"
      ]
    },
    "cargo_mirror_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "config_file"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "CARGO_HOME"
          ]
        },
        "path": {
          "type": "string",
          "enum": [
            "config/competition-env/cargo"
          ]
        },
        "config_file": {
          "type": "string",
          "enum": [
            "config/competition-env/cargo/config.toml"
          ]
        },
        "runtime_status": {
          "type": "string",
          "enum": [
            "active",
            "bypassed_for_local_cache"
          ]
        },
        "runtime_source": {
          "type": "string",
          "enum": [
            "competition_profile",
            "C2R_LOCAL_CARGO_HOME"
          ]
        },
        "offline": {
          "type": "boolean"
        }
      }
    },
    "provider_circuit_breaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "threshold",
        "consecutive_failures",
        "failure_kind",
        "requested_slice_specs",
        "attempted_slice_specs",
        "skipped_slice_specs",
        "observations"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["closed", "open"]
        },
        "threshold": {
          "type": "integer",
          "const": 2
        },
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "failure_kind": {
          "enum": [null, "provider_timeout"]
        },
        "requested_slice_specs": {
          "type": "integer",
          "minimum": 0
        },
        "attempted_slice_specs": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_slice_specs": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit_id", "failure_kind"],
            "properties": {
              "unit_id": {"type": "string", "minLength": 1},
              "failure_kind": {"const": "provider_timeout"}
            }
          }
        }
      }
    },
    "elapsed_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "translator_version": {
      "type": "string",
      "minLength": 1
    },
    "command_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "typed_ir_generated",
        "compiled",
        "semantic_pass",
        "refused",
        "blocked",
        "failed"
      ],
      "properties": {
        "attempted": {
          "type": "integer",
          "minimum": 0
        },
        "typed_ir_generated": {
          "type": "integer",
          "minimum": 0
        },
        "compiled": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_pass": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unsafe_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total_first_party_non_test_unsafe",
        "ratio"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "total_first_party_non_test_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "workflow_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ai_translation_metrics": {
      "$ref": "#/definitions/aiTranslationMetrics"
    },
    "artifact_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "competition_exact_host_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competition_exact_host_attested",
        "required_agent_tool",
        "required_agent",
        "required_model",
        "required_variant",
        "opencode_model_availability"
      ],
      "properties": {
        "competition_exact_host_attested": {
          "type": "boolean"
        },
        "required_agent_tool": {
          "type": "string",
          "enum": [
            "opencode"
          ]
        },
        "required_agent": {
          "type": "string",
          "enum": [
            "c2rust-migrator"
          ]
        },
        "required_model": {
          "type": "string",
          "enum": [
            "GLM-5.1"
          ]
        },
        "required_variant": {
          "type": "string",
          "enum": [
            "max"
          ]
        },
        "opencode_model_availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "required_model",
            "model_listed",
            "opencode_command",
            "argv",
            "process_returncode",
            "logs",
            "stdout_sha256",
            "stderr_sha256"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available"
              ]
            },
            "required_model": {
              "type": "string",
              "enum": [
                "GLM-5.1"
              ]
            },
            "model_listed": {
              "type": "boolean"
            },
            "opencode_command": {
              "type": "string",
              "enum": [
                "opencode"
              ]
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "process_returncode": {
              "type": "integer"
            },
            "logs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stdout",
                "stderr"
              ],
              "properties": {
                "stdout": {
                  "type": "string",
                  "minLength": 1
                },
                "stderr": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "stdout_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "stderr_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "summaries"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "summaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "status",
              "proof_class",
              "attempted",
              "semantic_pass",
              "failed",
              "slices"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "assignment_request": {
                "type": "string",
                "minLength": 1
              },
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "slice_id": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "type": "string",
                "minLength": 1
              },
              "source_repo_root": {
                "type": "string",
                "minLength": 1
              },
              "source_repository": {
                "type": "string",
                "minLength": 1
              },
              "source_branch": {
                "type": "string",
                "minLength": 1
              },
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "source_commit": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "require_source_commit": {
                "type": "string",
                "minLength": 1
              },
              "slice_specs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "blocked"
                ]
              },
              "proof_class": {
                "type": "string",
                "minLength": 1
              },
              "attempted": {
                "type": "integer",
                "minimum": 0
              },
              "semantic_pass": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "slices": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempted",
                  "typed_ir_generated",
                  "compiled",
                  "semantic_pass",
                  "refused",
                  "blocked",
                  "failed"
                ],
                "properties": {
                  "attempted": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "typed_ir_generated": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "compiled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "semantic_pass": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "refused": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "final_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "validator": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "aiArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "sha256": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "status": {"enum": ["present", "missing"]}
      }
    },
    "aiCountingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "funnel", "terminal", "semantic_acceptance", "historical_evidence"],
      "properties": {
        "unit": {"const": "slice"},
        "funnel": {"const": "cumulative_verified_stages"},
        "terminal": {"const": "mutually_exclusive"},
        "semantic_acceptance": {"const": "fresh_ai_candidate_common_validation_only"},
        "historical_evidence": {"const": "excluded_from_ai_success"}
      }
    },
    "aiExecutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_mode",
        "fresh_translation_requires_ai_first_candidate",
        "accepted_evidence_revalidation_shortcut",
        "opencode_command",
        "model",
        "agent",
        "variant",
        "timeout_seconds",
        "resolution",
        "competition_exact_contract"
      ],
      "properties": {
        "direct_mode": {"enum": ["none", "fresh_ai_translation", "accepted_evidence_revalidation"]},
        "fresh_translation_requires_ai_first_candidate": {"const": true},
        "accepted_evidence_revalidation_shortcut": {"const": true},
        "opencode_command": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opencode_command", "model", "agent", "variant", "timeout_seconds"],
          "properties": {
            "opencode_command": {"enum": ["cli", "profile", "default"]},
            "model": {"enum": ["cli", "profile", "default"]},
            "agent": {"enum": ["cli", "profile", "default"]},
            "variant": {"enum": ["cli", "profile", "default"]},
            "timeout_seconds": {"enum": ["cli", "profile", "default"]}
          }
        },
        "competition_exact_contract": {"type": "boolean"}
      }
    },
    "aiTerminalCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_acceptance", "blocked", "refused", "not_invoked", "historical_evidence", "abnormal"],
      "properties": {
        "semantic_acceptance": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "refused": {"type": "integer", "minimum": 0},
        "not_invoked": {"type": "integer", "minimum": 0},
        "historical_evidence": {"type": "integer", "minimum": 0},
        "abnormal": {"type": "integer", "minimum": 0}
      }
    },
    "aiRouterSourceCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opencode-ai", "typed-ir", "c2rust-repair", "c2rust-baseline"],
      "properties": {
        "opencode-ai": {"type": "integer", "minimum": 0},
        "typed-ir": {"type": "integer", "minimum": 0},
        "c2rust-repair": {"type": "integer", "minimum": 0},
        "c2rust-baseline": {"type": "integer", "minimum": 0}
      }
    },
    "aiRouterTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_inputs",
        "unique",
        "deduplicated",
        "selected_by_source",
        "deterministic_fallbacks",
        "no_selection",
        "repair_rounds"
      ],
      "properties": {
        "candidate_inputs": {"type": "integer", "minimum": 0},
        "unique": {"type": "integer", "minimum": 0},
        "deduplicated": {"type": "integer", "minimum": 0},
        "selected_by_source": {"$ref": "#/definitions/aiRouterSourceCounts"},
        "deterministic_fallbacks": {"type": "integer", "minimum": 0},
        "no_selection": {"type": "integer", "minimum": 0},
        "repair_rounds": {"type": "integer", "minimum": 0}
      }
    },
    "aiRouterUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "auto_manifest_sha256",
        "router_sha256",
        "candidate_inputs",
        "unique",
        "deduplicated",
        "selected_by_source",
        "deterministic_fallbacks",
        "no_selection",
        "repair_rounds",
        "selected_source",
        "selected_candidate_sha256"
      ],
      "properties": {
        "status": {"enum": ["not_applicable", "verified"]},
        "auto_manifest_sha256": {
          "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]
        },
        "router_sha256": {
          "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]
        },
        "candidate_inputs": {"type": "integer", "minimum": 0},
        "unique": {"type": "integer", "minimum": 0},
        "deduplicated": {"type": "integer", "minimum": 0},
        "selected_by_source": {"$ref": "#/definitions/aiRouterSourceCounts"},
        "deterministic_fallbacks": {"type": "integer", "minimum": 0, "maximum": 1},
        "no_selection": {"type": "integer", "minimum": 0, "maximum": 1},
        "repair_rounds": {"type": "integer", "minimum": 0, "maximum": 5},
        "selected_source": {
          "anyOf": [
            {"type": "null"},
            {"enum": ["opencode-ai", "typed-ir", "c2rust-repair", "c2rust-baseline"]}
          ]
        },
        "selected_candidate_sha256": {
          "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]
        }
      }
    },
    "aiMetricUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_key",
        "unit_id",
        "target_id",
        "slice_id",
        "source",
        "execution_mode",
        "auto_migrate_step",
        "artifacts",
        "invocations",
        "generated",
        "applied",
        "selected",
        "rustc_pass",
        "semantic_acceptance",
        "blocked",
        "refused",
        "repair_rounds",
        "router",
        "classification",
        "abnormal_reasons"
      ],
      "properties": {
        "unit_key": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "minLength": 1},
        "target_id": {
          "anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "slice_id": {
          "anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "source": {"enum": ["direct", "worker"]},
        "execution_mode": {
          "enum": [
            "fresh_ai_translation",
            "accepted_evidence_revalidation",
            "pre_translation_failure",
            "worker_unbound"
          ]
        },
        "auto_migrate_step": {
          "anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "route", "profile", "final"],
          "properties": {
            "manifest": {"$ref": "#/definitions/aiArtifactRef"},
            "route": {"$ref": "#/definitions/aiArtifactRef"},
            "profile": {"$ref": "#/definitions/aiArtifactRef"},
            "final": {"$ref": "#/definitions/aiArtifactRef"}
          }
        },
        "worker_summary": {"$ref": "#/definitions/aiArtifactRef"},
        "invocations": {"type": "integer", "minimum": 0},
        "generated": {"type": "boolean"},
        "applied": {"type": "boolean"},
        "selected": {"type": "boolean"},
        "rustc_pass": {"type": "boolean"},
        "semantic_acceptance": {"type": "boolean"},
        "blocked": {"type": "boolean"},
        "refused": {"type": "boolean"},
        "repair_rounds": {"type": "integer", "minimum": 0},
        "router": {"$ref": "#/definitions/aiRouterUnit"},
        "classification": {
          "enum": ["semantic_acceptance", "blocked", "refused", "not_invoked", "historical_evidence", "abnormal"]
        },
        "abnormal_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "aiTranslationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "counting_boundary",
        "execution_policy",
        "units_total",
        "invocations",
        "generated",
        "applied",
        "selected",
        "rustc_pass",
        "semantic_acceptance",
        "blocked",
        "refused",
        "repair_rounds",
        "not_invoked",
        "historical_evidence",
        "abnormal",
        "terminal_classifications",
        "router_totals",
        "units"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "counting_boundary": {"$ref": "#/definitions/aiCountingBoundary"},
        "execution_policy": {"$ref": "#/definitions/aiExecutionPolicy"},
        "units_total": {"type": "integer", "minimum": 0},
        "invocations": {"type": "integer", "minimum": 0},
        "generated": {"type": "integer", "minimum": 0},
        "applied": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0},
        "rustc_pass": {"type": "integer", "minimum": 0},
        "semantic_acceptance": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "refused": {"type": "integer", "minimum": 0},
        "repair_rounds": {"type": "integer", "minimum": 0},
        "not_invoked": {"type": "integer", "minimum": 0},
        "historical_evidence": {"type": "integer", "minimum": 0},
        "abnormal": {"type": "integer", "minimum": 0},
        "terminal_classifications": {"$ref": "#/definitions/aiTerminalCounts"},
        "router_totals": {"$ref": "#/definitions/aiRouterTotals"},
        "units": {
          "type": "array",
          "items": {"$ref": "#/definitions/aiMetricUnit"}
        }
      }
    }
  }
}
