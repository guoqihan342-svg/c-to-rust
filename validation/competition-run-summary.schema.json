{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Competition run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "proof_class",
    "profile_id",
    "profile_sha256",
    "clang_source",
    "cargo_mirror_activation",
    "elapsed_seconds",
    "translator_version",
    "slices",
    "unsafe_budget",
    "workflow_metrics",
    "artifact_roots",
    "final_gate"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "proof_class": {
      "type": "string",
      "enum": [
        "competition-exact",
        "ci-approximation",
        "wsl-local-simulation",
        "local-simulation"
      ]
    },
    "profile_id": {
      "type": "string",
      "enum": [
        "huawei-competition-ubuntu-24.04"
      ]
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clang_source": {
      "type": "string",
      "enum": [
        "CLANG_PATH",
        "vendored",
        "missing"
      ]
    },
    "cargo_mirror_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "config_file"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "CARGO_HOME"
          ]
        },
        "path": {
          "type": "string",
          "enum": [
            "config/competition-env/cargo"
          ]
        },
        "config_file": {
          "type": "string",
          "enum": [
            "config/competition-env/cargo/config.toml"
          ]
        }
      }
    },
    "elapsed_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "translator_version": {
      "type": "string",
      "minLength": 1
    },
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "typed_ir_generated",
        "compiled",
        "semantic_pass",
        "refused",
        "blocked",
        "failed"
      ],
      "properties": {
        "attempted": {
          "type": "integer",
          "minimum": 0
        },
        "typed_ir_generated": {
          "type": "integer",
          "minimum": 0
        },
        "compiled": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_pass": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unsafe_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total_first_party_non_test_unsafe",
        "ratio"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "total_first_party_non_test_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "workflow_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "competition_exact_host_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competition_exact_host_attested",
        "required_agent_tool",
        "required_agent",
        "required_model",
        "required_variant",
        "opencode_model_availability"
      ],
      "properties": {
        "competition_exact_host_attested": {
          "type": "boolean"
        },
        "required_agent_tool": {
          "type": "string",
          "enum": [
            "opencode"
          ]
        },
        "required_agent": {
          "type": "string",
          "enum": [
            "c2rust-migrator"
          ]
        },
        "required_model": {
          "type": "string",
          "enum": [
            "GLM-5.1"
          ]
        },
        "required_variant": {
          "type": "string",
          "enum": [
            "max"
          ]
        },
        "opencode_model_availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "required_model",
            "model_listed",
            "opencode_command",
            "argv",
            "process_returncode",
            "logs",
            "stdout_sha256",
            "stderr_sha256"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available"
              ]
            },
            "required_model": {
              "type": "string",
              "enum": [
                "GLM-5.1"
              ]
            },
            "model_listed": {
              "type": "boolean"
            },
            "opencode_command": {
              "type": "string",
              "enum": [
                "opencode"
              ]
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "process_returncode": {
              "type": "integer"
            },
            "logs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stdout",
                "stderr"
              ],
              "properties": {
                "stdout": {
                  "type": "string",
                  "minLength": 1
                },
                "stderr": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "stdout_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "stderr_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "summaries"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "summaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "status",
              "proof_class",
              "attempted",
              "semantic_pass",
              "failed",
              "slices"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "assignment_request": {
                "type": "string",
                "minLength": 1
              },
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "slice_id": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "type": "string",
                "minLength": 1
              },
              "source_repo_root": {
                "type": "string",
                "minLength": 1
              },
              "source_repository": {
                "type": "string",
                "minLength": 1
              },
              "source_branch": {
                "type": "string",
                "minLength": 1
              },
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "source_commit": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "require_source_commit": {
                "type": "string",
                "minLength": 1
              },
              "slice_specs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "blocked"
                ]
              },
              "proof_class": {
                "type": "string",
                "minLength": 1
              },
              "attempted": {
                "type": "integer",
                "minimum": 0
              },
              "semantic_pass": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "slices": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempted",
                  "typed_ir_generated",
                  "compiled",
                  "semantic_pass",
                  "refused",
                  "blocked",
                  "failed"
                ],
                "properties": {
                  "attempted": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "typed_ir_generated": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "compiled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "semantic_pass": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "refused": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "final_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "validator": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
