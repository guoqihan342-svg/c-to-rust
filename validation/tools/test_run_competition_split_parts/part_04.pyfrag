                out_root / "evidence",
                "demo",
                "refused-slice",
                semantic_pass=False,
                status="refused",
            )
            write_final_verification(
                out_root / "evidence",
                "demo",
                "blocked-slice",
                semantic_pass=False,
                status="blocked",
            )
            fake_runner = FakeCommandRunner()

            result = module.run_competition(
                slice_specs=[refused_spec, blocked_spec],
