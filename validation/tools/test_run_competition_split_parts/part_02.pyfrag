                    "auto_recovery_rate": 1.0,
                    "human_interventions": 0,
                    "always_compiles": True,
                    "always_equivalent": True,
                    "fail_closed_count": 0,
                    "wall_clock_seconds": 4,
                    "llm_calls": 2,
                    "per_unit_statuses": [
                        {
                            "unit_id": "demo/demo-add-one",
                            "source": "worker-summary",
                            "status": "converged",
                            "compiled": True,
                            "semantic_pass": True,
                            "refused": False,
                            "blocked": False,
                            "failed": False,
                            "repair_rounds": 2,
                            "auto_recovered": True,
                            "llm_calls": 2,
                            "repair_history": {
                                "patch_events_path": "workers/worker-a/logs/repair-history.jsonl",
                                "patch_events_sha256": lf_stable_sha256(repair_history_path),
                                "statuses": ["failed", "verified"],
                                "rollback_ids": ["rollback-1"],
                                "verified": True,
                            },
                        }
                    ],
                },
            )

