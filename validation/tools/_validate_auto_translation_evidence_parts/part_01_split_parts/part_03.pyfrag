

def validate_ai_repair_binding(
    manifest: dict[str, Any],
    candidate: dict[str, Any],
    *,
    evidence_dir: Path,
    prefix: str,
) -> None:
    repair_ref = candidate.get("repair")
    top_level_ref = manifest.get("repair")
    if repair_ref is None and top_level_ref is None:
        return
    if repair_ref is not None and top_level_ref is not None:
        raise SystemExit("AI manifest repair binding cannot be both candidate-ready and top-level blocked")
    binding = repair_ref if repair_ref is not None else top_level_ref
    if not isinstance(binding, dict):
        raise SystemExit("AI manifest repair binding must be an object")
    report_path = evidence_dir / f"{prefix}-ai-repair-report.json"
    if binding.get("path") != report_path.name:
        raise SystemExit("AI manifest repair report path drift")
    if not report_path.is_file() or binding.get("sha256") != sha256(report_path):
        raise SystemExit("AI manifest repair report sha256 drift")
    report = load_json(report_path)
    if binding.get("status") != report.get("status"):
        raise SystemExit("AI manifest repair report status drift")
    if binding.get("semantic_pass") is not False:
        raise SystemExit("AI manifest repair report cannot claim semantic_pass")
    boundary = report.get("claim_boundary")
    if not isinstance(boundary, dict) or (
        boundary.get("semantic_gate") is not False
        or boundary.get("semantic_pass") is not False
        or boundary.get("translation_coverage_numerator") != 0
    ):
        raise SystemExit("AI repair report claim boundary drift")
    rounds = report.get("rounds")
    if not isinstance(rounds, list) or len(rounds) > 5:
        raise SystemExit("AI repair report round count exceeds hard limit")

    if repair_ref is None:
        if report.get("status") == "candidate_ready_for_common_validation":
            raise SystemExit("ready AI repair report must bind the selected candidate")
        return
    if report.get("status") != "candidate_ready_for_common_validation":
        raise SystemExit("selected repaired candidate requires ready repair report")
    if candidate.get("repair_rounds") != len(rounds) or not rounds:
        raise SystemExit("AI repaired candidate round count drift")
    final_candidate = report.get("final_candidate")
    artifact = candidate.get("artifact")
    if not isinstance(final_candidate, dict) or not isinstance(artifact, dict):
        raise SystemExit("AI repaired candidate artifact binding missing")
    if final_candidate.get("sha256") != artifact.get("sha256") or candidate.get("output_hash") != artifact.get("sha256"):
        raise SystemExit("AI repaired candidate final sha256 drift")
    initial_artifact = candidate.get("initial_artifact")
    initial_output_hash = candidate.get("initial_output_hash")
    if not isinstance(initial_artifact, dict) or initial_artifact.get("sha256") != initial_output_hash:
        raise SystemExit("AI repaired candidate initial artifact binding drift")
