

def validate_generated_draft_acceptance_gate(
    evidence_dir: Path,
    prefix: str,
    slice_spec: dict[str, Any],
    route: dict[str, Any],
    profile: dict[str, Any],
    auto_manifest: dict[str, Any],
    l3_manifest: dict[str, Any],
    final: dict[str, Any],
    test_translation: dict[str, Any],
) -> None:
    if route.get("policy", {}).get("generated_draft_semantic_pass") is True:
        raise SystemExit("route_decision.policy.generated_draft_semantic_pass must be false")

    containers = {
        "validation_profile": profile,
        "auto_manifest.claim_boundary": auto_manifest.get("claim_boundary", {}),
        "l3_manifest.claim_boundary": l3_manifest.get("claim_boundary", {}),
        "final_verification": final,
        "test_translation": test_translation,
    }
    claims: dict[str, dict[str, Any]] = {}
    for label, container in containers.items():
        if not isinstance(container, dict):
            raise SystemExit(f"{label} generated draft claim container must be an object")
        flag = container.get("generated_draft_semantic_pass")
        acceptance = container.get("generated_draft_acceptance")
        if flag is True:
            validate_generated_draft_acceptance_payload(
                acceptance,
                evidence_dir,
                prefix,
                slice_spec,
                route,
                label,
            )
            claims[label] = acceptance
        elif flag not in {False, None}:
            raise SystemExit(f"{label}.generated_draft_semantic_pass must be boolean")
        elif generated_draft_acceptance_passed(acceptance):
            raise SystemExit(f"{label}.generated_draft_acceptance passed without generated_draft_semantic_pass=true")

    if not claims:
        return
    missing = sorted(set(containers) - set(claims))
    if missing:
        raise SystemExit(f"generated_draft_acceptance drift across artifacts; missing claims: {', '.join(missing)}")
    canonical = json.dumps(next(iter(claims.values())), sort_keys=True)
    for label, acceptance in claims.items():
        if json.dumps(acceptance, sort_keys=True) != canonical:
            raise SystemExit(f"generated_draft_acceptance drift across artifacts at {label}")


def validate_generated_draft_acceptance_payload(
    acceptance: Any,
    evidence_dir: Path,
    prefix: str,
    slice_spec: dict[str, Any],
    route: dict[str, Any],
    label: str,
) -> None:
    if not isinstance(acceptance, dict):
        raise SystemExit(f"{label}.generated_draft_acceptance must be an object")
    if acceptance.get("status") != "passed":
        raise SystemExit(f"{label}.generated_draft_acceptance.status must be passed")
    if acceptance.get("generated_draft_semantic_pass") is not True:
        raise SystemExit(f"{label}.generated_draft_acceptance.generated_draft_semantic_pass must be true")
    if acceptance.get("claim_source") != "generated_draft_replay_with_accepted_oracle_binding":
        raise SystemExit(f"{label}.generated_draft_acceptance.claim_source drift")
    if acceptance.get("target_id") != slice_spec.get("target_id"):
        raise SystemExit(f"{label}.generated_draft_acceptance.target_id drift")
    if acceptance.get("slice_id") != slice_spec.get("slice_id"):
        raise SystemExit(f"{label}.generated_draft_acceptance.slice_id drift")
    if acceptance.get("source_commit") != source_commit(slice_spec):
        raise SystemExit(f"{label}.generated_draft_acceptance.source_commit drift")
    if acceptance.get("generated_draft_replay_pass") is not True:
        raise SystemExit(f"{label}.generated_draft_acceptance.generated_draft_replay_pass must be true")
    replay_execution = acceptance.get("replay_execution")
    if not isinstance(replay_execution, dict) or replay_execution.get("status") != "passed":
        raise SystemExit(f"{label}.generated_draft_acceptance.replay_execution.status must be passed")

    draft_path = evidence_dir / f"{prefix}-rust-draft.rs"
    draft_ref_path = require_file_ref(
        acceptance.get("rust_draft"),
        f"{label}.generated_draft_acceptance.rust_draft",
        require_status=True,
    )
    if draft_ref_path.resolve() != draft_path.resolve():
        raise SystemExit(f"{label}.generated_draft_acceptance.rust_draft path drift")
    if acceptance["rust_draft"].get("status") != "accepted_after_gates":
        raise SystemExit(f"{label}.generated_draft_acceptance.rust_draft status drift")
    candidate_generation = route.get("candidate_generation", {})
    selected_candidate_id = candidate_generation.get("selected_candidate_id")
    selected_candidate = next(
        (
            candidate
            for candidate in candidate_generation.get("candidate_set", [])
            if isinstance(candidate, dict) and candidate.get("candidate_id") == selected_candidate_id
        ),
        None,
    )
    if not isinstance(selected_candidate, dict):
        raise SystemExit(f"{label}.generated_draft_acceptance requires selected generated candidate")
    draft_sha = sha256(draft_path)
    if selected_candidate.get("kind") == "opencode-ai":
        selected_generated = (
            selected_candidate.get("status") == "generated"
            and selected_candidate.get("applied") is True
        )
        expected_draft_sha = selected_candidate.get("rust_draft_sha256")
    else:
        typed_ir = candidate_generation.get("typed_ir", {})
        selected_generated = (
            isinstance(typed_ir, dict)
            and typed_ir.get("status") == "generated"
            and typed_ir.get("rust_draft_generated") is True
        )
        expected_draft_sha = typed_ir.get("rust_draft_sha256") if isinstance(typed_ir, dict) else None
    if not selected_generated:
        raise SystemExit(f"{label}.generated_draft_acceptance requires selected generated draft")
    if selected_candidate.get("kind") == "opencode-ai":
        if acceptance.get("selected_candidate_id") != selected_candidate_id:
            raise SystemExit(f"{label}.generated_draft_acceptance selected_candidate_id drift")
    elif acceptance.get("selected_candidate_id") is not None and acceptance.get("selected_candidate_id") != selected_candidate_id:
        raise SystemExit(f"{label}.generated_draft_acceptance selected_candidate_id drift")
    if expected_draft_sha != draft_sha:
        raise SystemExit(f"{label}.generated_draft_acceptance rust_draft_sha256 drift")

    rust_check_path = evidence_dir / "rust-check.json"
    rust_check_ref = acceptance.get("rust_check")
    require_ref(
        rust_check_ref,
        rust_check_path,
        f"{label}.generated_draft_acceptance.rust_check",
    )
    if (
        isinstance(rust_check_ref, dict)
        and not rust_check_ref.get("sha256")
        and acceptance.get("unsafe_gate_source") == "generated_draft_unsafe_gates"
    ):
        if rust_check_ref.get("binding_mode") != "field_bound":
            raise SystemExit(
                f"{label}.generated_draft_acceptance.rust_check missing field_bound binding_mode"
            )
        if not isinstance(rust_check_ref.get("cycle_boundary"), str) or not rust_check_ref["cycle_boundary"]:
            raise SystemExit(
                f"{label}.generated_draft_acceptance.rust_check missing cycle_boundary"
            )
    if load_json(rust_check_path).get("status") != "passed":
        raise SystemExit(f"{label}.generated_draft_acceptance requires rust_check.status=passed")

    refs = acceptance.get("accepted_evidence_refs")
    if not isinstance(refs, dict):
        raise SystemExit(f"{label}.generated_draft_acceptance.accepted_evidence_refs must be an object")
    expected_statuses = {
        "c_oracle": {"passed"},
        "rust_report": {"passed"},
        "schema_diff": {"passed"},
        "negative_diff": {"passed", "expected_failed"},
        "unsafe_scan": {"passed"},
        "unsafe_ledger": {"passed"},
    }
    for key, allowed_statuses in expected_statuses.items():
        ref = refs.get(key)
        ref_label = f"{label}.generated_draft_acceptance.accepted_evidence_refs.{key}"
        if isinstance(ref, dict) and ref.get("sha256"):
            resolved = require_file_ref(ref, ref_label, require_status=True)
        else:
            if not isinstance(ref, dict) or not ref.get("path") or not ref.get("status"):
                raise SystemExit(f"{ref_label} missing path/status reference")
            resolved = resolve_ref_path(str(ref["path"]))
            if not resolved.exists() or not resolved.is_file():
                raise SystemExit(f"{ref_label} points to missing file: {resolved}")
            try:
                resolved.resolve().relative_to(evidence_dir.resolve())
            except ValueError:
                raise SystemExit(f"{ref_label} missing sha256 for external accepted evidence")
        status = str(ref.get("status"))
        if status not in allowed_statuses:
            raise SystemExit(f"{label}.generated_draft_acceptance.accepted_evidence_refs.{key} status drift")
        payload = load_json(resolved)
        if payload.get("status") != status:
            raise SystemExit(f"{label}.generated_draft_acceptance.accepted_evidence_refs.{key} payload status drift")
        if key == "negative_diff" and not mutation_detected(payload):
            raise SystemExit(f"{label}.generated_draft_acceptance negative_diff mutation not detected")
    binding = acceptance.get("accepted_evidence_binding")
    if isinstance(binding, dict) and binding.get("generated_draft_semantic_pass") is True:
        raise SystemExit(f"{label}.generated_draft_acceptance accepted_evidence_binding cannot claim generated_draft_semantic_pass")


def accepted_evidence_authoritative_artifacts_claimed(route: dict[str, Any], auto_manifest: dict[str, Any]) -> bool:
    binding = auto_manifest.get("accepted_evidence_binding", {})
    claim = auto_manifest.get("claim_boundary", {})
    return (
        l4_refuses_candidate_generation(route)
        and route.get("policy", {}).get("accepted_evidence_authoritative") is True
        and route.get("policy", {}).get("generated_draft_semantic_pass") is False
        and binding.get("status") == "accepted"
        and binding.get("generated_draft_semantic_pass") is False
        and claim.get("accepted_evidence_authoritative") is True
        and claim.get("generated_draft_semantic_pass") in {False, True}
    )


def accepted_evidence_authoritative_manifest(
    route: dict[str, Any],
    auto_manifest: dict[str, Any],
    slice_spec: dict[str, Any],
) -> bool:
    return (
        slice_spec.get("claim_boundary", {}).get("accepted_evidence_authoritative") is True
        and accepted_evidence_authoritative_artifacts_claimed(route, auto_manifest)
    )


def accepted_evidence_authoritative_semantic_pass(
    route: dict[str, Any],
    profile: dict[str, Any],
    manifest: dict[str, Any],
    final: dict[str, Any],
    slice_spec: dict[str, Any],
) -> bool:
    manifest_claim = manifest.get("claim_boundary", {})
    profile_generated_ok = (
        profile.get("generated_draft_semantic_pass") is False
        or generated_draft_acceptance_passed(profile.get("generated_draft_acceptance"))
    )
    manifest_generated_ok = (
        manifest_claim.get("generated_draft_semantic_pass") is False
        or generated_draft_acceptance_passed(manifest_claim.get("generated_draft_acceptance"))
    )
    final_generated_ok = (
        final.get("generated_draft_semantic_pass") is False
        or generated_draft_acceptance_passed(final.get("generated_draft_acceptance"))
    )
    return (
        slice_spec.get("claim_boundary", {}).get("accepted_evidence_authoritative") is True
        and l4_refuses_candidate_generation(route)
        and route.get("policy", {}).get("accepted_evidence_authoritative") is True
        and route.get("policy", {}).get("generated_draft_semantic_pass") is False
        and profile.get("accepted_evidence_authoritative") is True
        and profile_generated_ok
        and manifest_claim.get("accepted_evidence_authoritative") is True
        and manifest_generated_ok
        and final.get("accepted_evidence_authoritative") is True
        and final_generated_ok
    )


def validate_l4_refused_has_no_candidate_artifact_status(
    evidence_dir: Path,
    prefix: str,
    auto_manifest: dict[str, Any],
    auto_manifest_path: Path,
) -> None:
    documents = [
        (auto_manifest_path, auto_manifest),
        (evidence_dir / f"{prefix}-auto-translation-plan.json", load_json(evidence_dir / f"{prefix}-auto-translation-plan.json")),
        (
            evidence_dir / f"{prefix}-test-translation-generated.json",
