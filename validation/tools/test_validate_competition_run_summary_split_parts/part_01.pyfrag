            metrics["per_unit_statuses"][0]["auto_recovered"] = True
            metrics["per_unit_statuses"][0]["repair_history"] = {
                "patch_events_path": patch_events_path.name,
                "patch_events_sha256": lf_stable_sha256(patch_events_path),
