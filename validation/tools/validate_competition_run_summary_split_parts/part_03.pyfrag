

def lf_stable_file_bytes(path: Path) -> bytes:
    data = path.read_bytes()
    if not should_normalize_lf_for_hash(path):
        return data
    return data.replace(b"\r\n", b"\n").replace(b"\r", b"\n")


def sha256(path: Path) -> str:
    return hashlib.sha256(lf_stable_file_bytes(path)).hexdigest()


def is_sha256(value: str) -> bool:
    return len(value) == 64 and all(character in "0123456789abcdef" for character in value)


def validate_final_gate(summary: dict[str, Any]) -> None:
    status = summary["final_gate"]["status"]
    semantic_pass = int(summary["slices"]["semantic_pass"])
    if status == "passed" and semantic_pass < 1:
        raise SystemExit("competition run summary final_gate passed requires slices.semantic_pass >= 1")
    validator = summary["final_gate"]["validator"]
    if status == "passed" and "--require-semantic-pass" not in validator:
        raise SystemExit("competition run summary final_gate passed requires --require-semantic-pass validator")


def validate_slice_counts(summary: dict[str, Any]) -> None:
    slices = summary["slices"]
    attempted = int(slices["attempted"])
    terminal = int(slices["semantic_pass"]) + int(slices["refused"]) + int(slices["blocked"]) + int(slices["failed"])
    if terminal > attempted:
        raise SystemExit("competition run summary terminal slice counts exceed slices.attempted")
    if int(slices["compiled"]) > attempted:
        raise SystemExit("competition run summary slices.compiled exceeds slices.attempted")
    if summary.get("schema_version", 1) == 1 and int(slices["compiled"]) > int(slices["typed_ir_generated"]):
        raise SystemExit("competition run summary slices.compiled exceeds slices.typed_ir_generated")
    if int(slices["typed_ir_generated"]) > attempted:
        raise SystemExit("competition run summary slices.typed_ir_generated exceeds slices.attempted")


def validate_workers(summary: dict[str, Any]) -> None:
    workers = summary.get("workers")
    if workers is None:
        return
    summaries = workers["summaries"]
    if int(workers["count"]) != len(summaries):
        raise SystemExit("competition run summary workers.count does not match workers.summaries length")
    seen_paths: set[str] = set()
    for index, worker in enumerate(summaries):
        validate_worker_summary_path(worker["path"], index=index, seen_paths=seen_paths)
        if worker["proof_class"] != summary["proof_class"]:
            raise SystemExit(f"competition run summary workers.summaries[{index}].proof_class does not match summary")
        slices = worker["slices"]
        for key in ["attempted", "semantic_pass", "failed"]:
            if int(worker[key]) != int(slices[key]):
                raise SystemExit(f"competition run summary workers.summaries[{index}].{key} does not match slices.{key}")
        for path_key in ["assignment_request", "source_repo_root", "source_file"]:
            if path_key in worker and not is_repo_relative_posix_path(worker[path_key]):
                raise SystemExit(
                    f"competition run summary workers.summaries[{index}].{path_key} must be repo-relative POSIX"
                )
        for spec_index, slice_spec in enumerate(worker.get("slice_specs", [])):
            if not is_repo_relative_posix_path(slice_spec):
                raise SystemExit(
                    f"competition run summary workers.summaries[{index}].slice_specs[{spec_index}] must be repo-relative POSIX"
                )
        if "source_sha256" in worker and not is_sha256(str(worker["source_sha256"])):
            raise SystemExit(f"competition run summary workers.summaries[{index}].source_sha256 must be a sha256")
        if worker["status"] != "passed" and summary["final_gate"]["status"] == "passed":
            raise SystemExit("competition run summary final_gate passed with failed worker summary")


def validate_worker_summary_path(value: str, *, index: int, seen_paths: set[str]) -> None:
    if not isinstance(value, str) or not is_repo_relative_posix_path(value):
        raise SystemExit(
            f"competition run summary workers.summaries[{index}].worker summary path must be repo-relative POSIX"
        )
    parts = PurePosixPath(value).parts
    worker_relative = (
        len(parts) == 4
        and parts[0] == "workers"
        and parts[2] == "summary"
        and parts[3] == "competition-run-summary.json"
    )
    nested_run_relative = (
        len(parts) >= 5
        and parts[-4] == "workers"
        and parts[-2] == "summary"
        and parts[-1] == "competition-run-summary.json"
    )
    if not worker_relative and not nested_run_relative:
        raise SystemExit(
            "competition run summary worker summary path must match "
            "workers/<worker-id>/summary/competition-run-summary.json"
        )
    if value in seen_paths:
        raise SystemExit(f"competition run summary duplicate worker summary path: {value}")
    seen_paths.add(value)


def nonnegative_count(value: Any) -> int | None:
    if isinstance(value, bool):
        return None
    return value if isinstance(value, int) and value >= 0 else None


def repo_relative(path: Path, repo_root: Path) -> str:
    try:
        return path.resolve().relative_to(repo_root.resolve()).as_posix()
    except ValueError:
        return path.as_posix()

AI_METRIC_COUNT_FIELDS = (
    "invocations",
    "generated",
    "applied",
    "selected",
    "rustc_pass",
    "semantic_acceptance",
    "blocked",
    "refused",
    "repair_rounds",
    "not_invoked",
    "historical_evidence",
    "abnormal",
)
AI_TERMINAL_CLASSIFICATIONS = (
    "semantic_acceptance",
    "blocked",
    "refused",
    "not_invoked",
    "historical_evidence",
    "abnormal",
)
AI_EVIDENCE_KEYS = ("manifest", "route", "profile", "final")
AI_FRESH_MODE = "fresh_ai_translation"
AI_ACCEPTED_MODE = "accepted_evidence_revalidation"

from validation.tools._competition_ai_router_metrics import (
    empty_router_unit,
    recompute_fresh_router_unit,
    router_totals as recompute_router_totals,
)


def validate_ai_translation_metrics(
    summary: dict[str, Any],
    *,
    summary_path: Path,
    repo_root: Path,
) -> None:
    if summary.get("schema_version") != 2:
        return
    metrics = summary.get("ai_translation_metrics")
    if not isinstance(metrics, dict):
        raise SystemExit("competition run summary schema_version=2 requires ai_translation_metrics")
    expected = recompute_ai_translation_metrics(
        metrics,
        summary=summary,
        summary_path=summary_path,
        repo_root=repo_root,
    )
    if metrics != expected:
        raise SystemExit("competition run summary ai_translation_metrics does not match artifact recomputation")


def recompute_ai_translation_metrics(
    metrics: dict[str, Any],
    *,
    summary: dict[str, Any],
    summary_path: Path,
    repo_root: Path,
) -> dict[str, Any]:
    policy = metrics.get("execution_policy")
    if not isinstance(policy, dict):
        raise SystemExit("ai_translation_metrics.execution_policy must be an object")
    validate_ai_counting_boundary(metrics.get("counting_boundary"))
    validate_ai_execution_policy_shape(policy, summary=summary)
    raw_units = metrics.get("units")
    if not isinstance(raw_units, list):
        raise SystemExit("ai_translation_metrics.units must be an array")
    command_entries = load_ai_command_entries(summary, summary_path=summary_path, repo_root=repo_root)
    evaluated = [
        evaluate_ai_metric_unit(
            unit,
            policy=policy,
            command_entries=command_entries,
            summary_path=summary_path,
            repo_root=repo_root,
        )
        for unit in raw_units
    ]
    units_total = len(evaluated)
    attempted = summary.get("slices", {}).get("attempted")
    if attempted != units_total:
        raise SystemExit("ai_translation_metrics.units_total must equal slices.attempted")
    validate_ai_unit_keys(evaluated)
    validate_ai_execution_mode_rollup(evaluated, policy)

    terminal = {
        classification: sum(unit["classification"] == classification for unit in evaluated)
        for classification in AI_TERMINAL_CLASSIFICATIONS
    }
    result = {
        "schema_version": 1,
        "counting_boundary": {
            "unit": "slice",
            "funnel": "cumulative_verified_stages",
            "terminal": "mutually_exclusive",
            "semantic_acceptance": "fresh_ai_candidate_common_validation_only",
            "historical_evidence": "excluded_from_ai_success",
        },
        "execution_policy": policy,
        "units_total": units_total,
        "invocations": sum(unit["invocations"] for unit in evaluated),
        "generated": sum(unit["generated"] for unit in evaluated),
        "applied": sum(unit["applied"] for unit in evaluated),
        "selected": sum(unit["selected"] for unit in evaluated),
        "rustc_pass": sum(unit["rustc_pass"] for unit in evaluated),
        "semantic_acceptance": terminal["semantic_acceptance"],
        "blocked": terminal["blocked"],
        "refused": terminal["refused"],
        "repair_rounds": sum(unit["repair_rounds"] for unit in evaluated),
        "not_invoked": terminal["not_invoked"],
        "historical_evidence": terminal["historical_evidence"],
        "abnormal": terminal["abnormal"],
        "terminal_classifications": terminal,
        "router_totals": recompute_router_totals(evaluated),
        "units": evaluated,
    }
    validate_ai_funnel_invariants(result)
    return result


def evaluate_ai_metric_unit(
    raw_unit: Any,
    *,
    policy: dict[str, Any],
    command_entries: list[dict[str, Any]],
    summary_path: Path,
    repo_root: Path,
) -> dict[str, Any]:
    if not isinstance(raw_unit, dict):
        raise SystemExit("ai_translation_metrics.units entries must be objects")
    unit = ai_metric_unit_projection(raw_unit)
    reasons: list[str] = []
    payloads: dict[str, dict[str, Any] | None] = {}
    paths: dict[str, Path | None] = {}
    for key in AI_EVIDENCE_KEYS:
        payloads[key], paths[key], artifact_reasons = load_bound_ai_metric_artifact(
            unit["artifacts"].get(key),
            key=key,
            summary_path=summary_path,
            repo_root=repo_root,
        )
        reasons.extend(artifact_reasons)

    validate_ai_artifact_identities(unit, payloads, reasons)
    validate_ai_cross_bindings(payloads, paths, summary_path=summary_path, repo_root=repo_root, reasons=reasons)
    execution_mode = validate_ai_unit_execution_binding(
        unit,
        policy=policy,
        command_entries=command_entries,
        summary_path=summary_path,
        repo_root=repo_root,
        reasons=reasons,
    )
    if execution_mode == "pre_translation_failure":
        reasons.append("pre_translation_failure_has_no_ai_evidence")
    if execution_mode == "worker_unbound":
        reasons.append("worker_execution_mode_unbound")

    outcome = {
        **unit,
        "invocations": 0,
        "generated": False,
        "applied": False,
        "selected": False,
        "rustc_pass": False,
        "semantic_acceptance": False,
        "blocked": False,
        "refused": False,
        "repair_rounds": 0,
        "classification": "abnormal",
        "abnormal_reasons": sorted(set(reasons)),
        "router": empty_router_unit(),
    }
    if reasons:
        return outcome

    manifest = payloads["manifest"] or {}
    route = payloads["route"] or {}
    profile = payloads["profile"] or {}
    final = payloads["final"] or {}
    if execution_mode == AI_ACCEPTED_MODE:
        if manifest.get("status") not in {"not_used", "recorded"}:
            outcome["abnormal_reasons"] = ["accepted_evidence_revalidation_contains_ai_invocation"]
            return outcome
        outcome["classification"] = "historical_evidence"
        outcome["abnormal_reasons"] = []
        return outcome
    if execution_mode != AI_FRESH_MODE:
        outcome["abnormal_reasons"] = ["unsupported_ai_execution_mode"]
        return outcome

    generation = validate_fresh_ai_manifest(
        manifest,
        manifest_path=paths["manifest"],
        policy=policy,
        summary_path=summary_path,
        repo_root=repo_root,
    )
    if generation["reasons"]:
        outcome["abnormal_reasons"] = generation["reasons"]
        return outcome
    outcome["invocations"] = generation["invocations"]
    outcome["repair_rounds"] = generation["repair_rounds"]
    if manifest.get("status") == "blocked":
        outcome["blocked"] = True
        outcome["classification"] = "blocked"
        outcome["abnormal_reasons"] = []
        return outcome

    candidate = generation["candidate"]
    outcome["generated"] = candidate is not None
    outcome["applied"] = ai_candidate_is_applied(candidate, manifest_path=paths["manifest"])
    router_unit, router_reasons = recompute_fresh_router_unit(
        ai_manifest_path=paths["manifest"],
        target_id=unit["target_id"],
        slice_id=unit["slice_id"],
        repo_root=repo_root,
        hash_file=sha256,
    )
    outcome["router"] = router_unit
    if router_reasons:
        outcome["abnormal_reasons"] = router_reasons
        return outcome
    outcome["invocations"] += router_unit["repair_rounds"]
    outcome["repair_rounds"] += router_unit["repair_rounds"]
    candidate_artifact = candidate.get("artifact") if isinstance(candidate, dict) else None
    candidate_sha = candidate_artifact.get("sha256") if isinstance(candidate_artifact, dict) else None
    selected_ai = (
        router_unit["selected_source"] == "opencode-ai"
        and router_unit["selected_candidate_sha256"] == candidate_sha
    )
    outcome["selected"] = outcome["applied"] and selected_ai
    outcome["rustc_pass"] = outcome["selected"]
    outcome["semantic_acceptance"] = outcome["selected"]

    if outcome["semantic_acceptance"]:
        outcome["classification"] = "semantic_acceptance"
    elif router_unit["deterministic_fallbacks"] or router_unit["no_selection"]:
        outcome["refused"] = True
        outcome["classification"] = "refused"
    elif route.get("status") == "refused" or final.get("status") == "refused":
        outcome["refused"] = True
        outcome["classification"] = "refused"
    elif outcome["invocations"] > 0:
        outcome["blocked"] = True
        outcome["classification"] = "blocked"
    else:
        outcome["classification"] = "not_invoked"
    outcome["abnormal_reasons"] = []
    return outcome


def ai_metric_unit_projection(unit: dict[str, Any]) -> dict[str, Any]:
    required = ["unit_key", "unit_id", "source", "execution_mode", "artifacts"]
    missing = [key for key in required if key not in unit]
    if missing:
        raise SystemExit("ai_translation_metrics unit missing fields: " + ", ".join(missing))
    projected = {key: unit.get(key) for key in required}
    projected["target_id"] = unit.get("target_id")
    projected["slice_id"] = unit.get("slice_id")
    projected["auto_migrate_step"] = unit.get("auto_migrate_step")
    if "worker_summary" in unit:
        projected["worker_summary"] = unit.get("worker_summary")
    return projected


def validate_ai_funnel_invariants(metrics: dict[str, Any]) -> None:
    ordered = [
        metrics["semantic_acceptance"],
        metrics["rustc_pass"],
        metrics["selected"],
        metrics["applied"],
        metrics["generated"],
        metrics["invocations"],
    ]
    if ordered != sorted(ordered):
        raise SystemExit("ai_translation_metrics cumulative funnel is inconsistent")
    if metrics["repair_rounds"] > metrics["invocations"]:
        raise SystemExit("ai_translation_metrics repair_rounds cannot exceed invocations")
    if sum(metrics["terminal_classifications"].values()) != metrics["units_total"]:
        raise SystemExit("ai_translation_metrics terminal classifications must be mutually exclusive and exhaustive")


def validate_ai_unit_keys(units: list[dict[str, Any]]) -> None:
    keys = [unit.get("unit_key") for unit in units]
    if not all(isinstance(key, str) and key for key in keys) or len(set(keys)) != len(keys):
        raise SystemExit("ai_translation_metrics unit_key values must be unique non-empty strings")


def validate_ai_counting_boundary(value: Any) -> None:
    expected = {
        "unit": "slice",
        "funnel": "cumulative_verified_stages",
        "terminal": "mutually_exclusive",
        "semantic_acceptance": "fresh_ai_candidate_common_validation_only",
        "historical_evidence": "excluded_from_ai_success",
    }
    if value != expected:
        raise SystemExit("ai_translation_metrics.counting_boundary does not match the fail-closed contract")
