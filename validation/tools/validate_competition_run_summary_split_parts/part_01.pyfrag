

def validate_translation_before_after_units_projection(
    units: list[Any],
    evidence_units: list[tuple[str, dict[str, Any]]],
) -> None:
    projected_by_unit_id: dict[str, dict[str, Any]] = {}
    for projected in units:
        if not isinstance(projected, dict):
            raise SystemExit("workflow metrics artifact translation_before_after.units entries must be objects")
        unit_id = projected.get("unit_id")
        if not isinstance(unit_id, str) or not unit_id:
            raise SystemExit("workflow metrics artifact translation_before_after.units entries require unit_id")
        if unit_id in projected_by_unit_id:
            raise SystemExit("workflow metrics artifact translation_before_after.units contains duplicate unit_id")
        projected_by_unit_id[unit_id] = projected

    for unit_id, evidence in evidence_units:
        projected = projected_by_unit_id.get(unit_id)
        if not isinstance(projected, dict):
            raise SystemExit("workflow metrics artifact translation_before_after.units does not match per-unit evidence")
        if projected.get("status") != evidence.get("status"):
            raise SystemExit("workflow metrics artifact translation_before_after.units does not match per-unit evidence")
        if projected.get("unsafe_reduction") != evidence.get("unsafe_reduction"):
            raise SystemExit("workflow metrics artifact translation_before_after.units does not match per-unit evidence")


def validate_per_unit_statuses(
    metrics: dict[str, Any],
    *,
    summary_path: Path,
    repo_root: Path,
) -> None:
    for index, unit in enumerate(metrics["per_unit_statuses"]):
        if not isinstance(unit, dict):
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}] must be an object")
        root_cause = unit.get("root_cause_key")
        if root_cause is not None and (not isinstance(root_cause, str) or not root_cause):
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}].root_cause_key must be a non-empty string")
        contract_verification = unit.get("opencode_contract_verification")
        if contract_verification is not None:
            if not isinstance(contract_verification, dict) or not isinstance(contract_verification.get("status"), str):
                raise SystemExit(
                    f"workflow metrics per_unit_statuses[{index}].opencode_contract_verification.status "
                    "must be a string"
                )
        before_after = unit.get("translation_before_after")
        if before_after is not None:
            validate_translation_before_after_unit(
                before_after,
                unit=unit,
                index=index,
                summary_path=summary_path,
                repo_root=repo_root,
            )
        if "repair_rounds" not in unit:
            continue
        repair_rounds = unit["repair_rounds"]
        if not isinstance(repair_rounds, int) or repair_rounds < 1:
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}].repair_rounds must be a positive integer")
        if repair_rounds > REPAIR_ROUND_CAP:
            raise SystemExit(
                f"workflow metrics per_unit_statuses[{index}].repair_rounds must be between 1 and {REPAIR_ROUND_CAP}"
            )
        if not isinstance(unit.get("auto_recovered"), bool):
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}].auto_recovered must be boolean")
        repair_history = unit.get("repair_history")
        if not isinstance(repair_history, dict):
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}] missing repair_history")
        patch_events_ref = repair_history.get("patch_events_path")
        patch_events_sha = repair_history.get("patch_events_sha256")
        if not isinstance(patch_events_ref, str) or not is_repo_relative_posix_path(patch_events_ref):
            raise SystemExit(
                f"workflow metrics per_unit_statuses[{index}].repair_history.patch_events_path "
                "must be repo-relative POSIX"
            )
        if not isinstance(patch_events_sha, str) or len(patch_events_sha) != 64:
            raise SystemExit(
                f"workflow metrics per_unit_statuses[{index}].repair_history.patch_events_sha256 must be sha256"
            )
        patch_events_path = resolve_summary_artifact(
            patch_events_ref,
            summary_path=summary_path,
            repo_root=repo_root,
        )
        if patch_events_path is None:
            raise SystemExit(
                f"workflow metrics per_unit_statuses[{index}].repair_history.patch_events_path does not exist: "
                f"{patch_events_ref}"
            )
        if sha256(patch_events_path) != patch_events_sha:
            raise SystemExit(
                f"workflow metrics per_unit_statuses[{index}].repair_history.patch_events_sha256 does not match"
            )
        statuses = repair_history.get("statuses")
        if not isinstance(statuses, list) or not all(isinstance(status, str) for status in statuses):
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}].repair_history.statuses must be strings")
        rollback_ids = repair_history.get("rollback_ids")
        if not isinstance(rollback_ids, list) or not all(isinstance(item, str) for item in rollback_ids):
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}].repair_history.rollback_ids must be strings")
        verified = repair_history.get("verified")
        if not isinstance(verified, bool):
            raise SystemExit(f"workflow metrics per_unit_statuses[{index}].repair_history.verified must be boolean")
        if unit["auto_recovered"] and (not verified or "verified" not in statuses):
            raise SystemExit(
                f"workflow metrics per_unit_statuses[{index}] auto_recovered requires verified repair history"
            )


def validate_translation_before_after_unit(
    evidence: Any,
    *,
    unit: dict[str, Any],
    index: int,
    summary_path: Path,
    repo_root: Path,
) -> None:
    if not isinstance(evidence, dict):
        raise SystemExit(f"workflow metrics per_unit_statuses[{index}].translation_before_after must be an object")
    status = evidence.get("status")
    if status != "bound":
        raise SystemExit(f"workflow metrics per_unit_statuses[{index}].translation_before_after.status must be bound")
    artifact_paths: dict[str, Path] = {}
    for key in ["baseline", "final", "oracle_evidence", "accepted_patch"]:
        artifact_paths[key] = validate_before_after_artifact_ref(
            evidence.get(key),
            key=key,
            unit=unit,
            index=index,
            summary_path=summary_path,
            repo_root=repo_root,
        )
    patch_log = evidence.get("patch_log")
    if patch_log is not None:
        artifact_paths["patch_log"] = validate_before_after_artifact_ref(
            patch_log,
            key="patch_log",
            unit=unit,
            index=index,
            summary_path=summary_path,
            repo_root=repo_root,
        )
    baseline_verification = evidence.get("baseline_verification")
    if baseline_verification is not None:
        baseline_verification_path = validate_before_after_artifact_ref(
            baseline_verification,
            key="baseline_verification",
            unit=unit,
            index=index,
            summary_path=summary_path,
            repo_root=repo_root,
        )
        validate_before_after_baseline_verification(
            baseline_verification,
            baseline_verification_path,
            index=index,
        )
    unsafe_reduction = evidence.get("unsafe_reduction")
    if not isinstance(unsafe_reduction, dict) or unsafe_reduction.get("status") != "measured":
        raise SystemExit(
            f"workflow metrics per_unit_statuses[{index}].translation_before_after.unsafe_reduction "
            "must be measured"
        )
    baseline = nonnegative_count(unsafe_reduction.get("baseline_total_unsafe"))
    current = nonnegative_count(unsafe_reduction.get("current_total_unsafe"))
    reduced_by = nonnegative_count(unsafe_reduction.get("reduced_by"))
    if baseline is None or current is None or reduced_by is None:
        raise SystemExit(
            f"workflow metrics per_unit_statuses[{index}].translation_before_after.unsafe_reduction "
            "requires nonnegative baseline/current/reduced_by"
        )
    if baseline - current != reduced_by or reduced_by <= 0:
        raise SystemExit(
            f"workflow metrics per_unit_statuses[{index}].translation_before_after.unsafe_reduction "
            "must strictly reduce unsafe"
        )
    claim_boundary = evidence.get("claim_boundary")
    if (
        isinstance(claim_boundary, dict)
        and claim_boundary.get("semantic_claim_source")
        == "c2rust_safety_transform_replay_with_accepted_c_oracle"
    ):
        validate_c2rust_safety_before_after(
            evidence,
            artifact_paths=artifact_paths,
            unit=unit,
            index=index,
            summary_path=summary_path,
            repo_root=repo_root,
        )


def validate_c2rust_safety_before_after(
    evidence: dict[str, Any],
    *,
    artifact_paths: dict[str, Path],
    unit: dict[str, Any],
    index: int,
    summary_path: Path,
    repo_root: Path,
) -> None:
    prefix = f"workflow metrics per_unit_statuses[{index}].translation_before_after.c2rust_safety"
    verification_path = artifact_paths.get("oracle_evidence")
    if verification_path is None:
        raise SystemExit(f"{prefix}.verification artifact is required")
    try:
        report = json.loads(verification_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"{prefix}.verification artifact must be JSON") from exc
    if not isinstance(report, dict):
        raise SystemExit(f"{prefix}.verification artifact must be an object")
    required_values = {
        "report_kind": "c2rust-crc32-safety-verification",
        "target_id": evidence.get("target_id"),
        "slice_id": evidence.get("slice_id"),
        "status": "passed",
        "semantic_pass": True,
        "semantic_claim_source": "c2rust_safety_transform_replay_with_accepted_c_oracle",
        "candidate_source": "c2rust-function-level-safety-transform",
    }
    for key, expected in required_values.items():
        if report.get(key) != expected:
            raise SystemExit(f"{prefix}.{key} does not match the bound C2Rust safety contract")

    claim = report.get("claim_boundary")
    if not isinstance(claim, dict):
        raise SystemExit(f"{prefix}.claim_boundary must be an object")
    if (
        claim.get("scope") != "function_level_c2rust_plus_repair_candidate"
        or claim.get("generated_draft_semantic_pass") is not False
        or claim.get("translation_coverage_numerator") != 0
        or claim.get("whole_project_migration") is not False
    ):
        raise SystemExit(f"{prefix}.claim_boundary exceeds the function-level candidate scope")

    report_artifacts = report.get("artifacts")
    if not isinstance(report_artifacts, dict):
        raise SystemExit(f"{prefix}.artifacts must be an object")
    for evidence_key, report_key in {
        "baseline": "baseline",
        "final": "candidate",
        "accepted_patch": "accepted_patch",
        "patch_log": "repair_history",
    }.items():
        expected_ref = evidence.get(evidence_key)
        actual_ref = report_artifacts.get(report_key)
        if not same_path_sha_ref(actual_ref, expected_ref):
            raise SystemExit(f"{prefix}.artifacts.{report_key} does not match translation_before_after.{evidence_key}")

    for key in ["baseline_manifest", "baseline_output"]:
        validate_c2rust_safety_nested_ref(
            report.get(key),
            key=key,
            prefix=prefix,
            unit=unit,
            summary_path=summary_path,
            repo_root=repo_root,
        )
    nested_paths: dict[str, Path] = {}
    for key in ["c_oracle", "fixture", "replay_source", "replay_stdout", "replay_stderr"]:
        nested_paths[key] = validate_c2rust_safety_nested_ref(
            report_artifacts.get(key),
            key=f"artifacts.{key}",
            prefix=prefix,
            unit=unit,
            summary_path=summary_path,
            repo_root=repo_root,
        )

    rustc = report.get("rustc")
    if not isinstance(rustc, dict) or not isinstance(rustc.get("version"), str) or not rustc["version"]:
        raise SystemExit(f"{prefix}.rustc version is required")
    for key in ["baseline_compile", "candidate_compile", "replay_compile"]:
        compile_gate = rustc.get(key)
        if (
            not isinstance(compile_gate, dict)
            or compile_gate.get("status") != "passed"
            or compile_gate.get("returncode") != 0
        ):
            raise SystemExit(f"{prefix}.rustc.{key} must be passed")
    replay = report.get("replay")
    if (
        not isinstance(replay, dict)
        or replay.get("status") != "passed"
        or replay.get("returncode") != 0
        or not isinstance(replay.get("case_count"), int)
        or replay["case_count"] <= 0
        or not isinstance(replay.get("cases"), list)
        or len(replay["cases"]) != replay["case_count"]
    ):
        raise SystemExit(f"{prefix}.replay must bind passed non-empty cases")
    schema_diff = report.get("schema_diff")
    if (
        not isinstance(schema_diff, dict)
        or schema_diff.get("status") != "passed"
        or schema_diff.get("first_mismatch") is not None
        or schema_diff.get("case_count") != replay["case_count"]
    ):
        raise SystemExit(f"{prefix}.schema_diff must pass for every replay case")
    negative_diff = report.get("negative_diff")
    if (
        not isinstance(negative_diff, dict)
        or negative_diff.get("status") != "expected_failed"
        or negative_diff.get("expected_failure") is not True
        or negative_diff.get("mutation_detected") is not True
        or not isinstance(negative_diff.get("first_mismatch"), dict)
    ):
        raise SystemExit(f"{prefix}.negative_diff must detect the injected mutation")
    if report.get("unsafe_reduction") != evidence.get("unsafe_reduction"):
        raise SystemExit(f"{prefix}.unsafe_reduction must match translation_before_after")

    c_execution = report.get("c_oracle_execution")
    validate_c2rust_real_c_execution(
        c_execution,
        report_artifacts=report_artifacts,
        prefix=prefix,
        unit=unit,
        summary_path=summary_path,
        repo_root=repo_root,
    )
    c_oracle_payload = json.loads(nested_paths["c_oracle"].read_text(encoding="utf-8"))
    oracle_cases = c_oracle_payload.get("cases") if isinstance(c_oracle_payload, dict) else None
    if not isinstance(oracle_cases, list):
        raise SystemExit(f"{prefix}.artifacts.c_oracle cases are required")
    expected_cases = [
        {"id": case.get("id"), "return_code": case.get("return_code"), "status": "passed"}
        for case in oracle_cases
        if isinstance(case, dict)
    ]
    if replay["cases"] != expected_cases:
        raise SystemExit(f"{prefix}.replay cases must match the bound C oracle cases")
    replay_stdout = nested_paths["replay_stdout"].read_text(encoding="utf-8")
    replay_stdout_cases = []
    for line in replay_stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 2:
            raise SystemExit(f"{prefix}.artifacts.replay_stdout contains an invalid line")
        try:
            return_code = int(parts[1])
        except ValueError as exc:
            raise SystemExit(f"{prefix}.artifacts.replay_stdout contains an invalid return code") from exc
        replay_stdout_cases.append({"id": parts[0], "return_code": return_code, "status": "passed"})
    if replay_stdout_cases != replay["cases"]:
        raise SystemExit(f"{prefix}.replay cases do not match replay_stdout")
    if schema_diff != {
        "status": "passed",
        "case_count": len(expected_cases),
        "compared_fields": ["return_code"],
        "first_mismatch": None,
    }:
        raise SystemExit(f"{prefix}.schema_diff does not match recomputed C/Rust cases")
    if not expected_cases:
        raise SystemExit(f"{prefix}.negative_diff requires a non-empty case set")
    expected_negative_mismatch = {
        "id": expected_cases[0]["id"],
        "field": "return_code",
        "expected": expected_cases[0]["return_code"],
        "actual": expected_cases[0]["return_code"] ^ 1,
    }
    if negative_diff.get("first_mismatch") != expected_negative_mismatch:
        raise SystemExit(f"{prefix}.negative_diff does not match the deterministic mutation")

    baseline_rust = artifact_paths["baseline"].read_text(encoding="utf-8").replace("\r\n", "\n")
    final_rust = artifact_paths["final"].read_text(encoding="utf-8").replace("\r\n", "\n")
    baseline_unsafe_count = c2rust_crc32_unsafe_count(baseline_rust)
    final_unsafe_count = c2rust_crc32_unsafe_count(final_rust)
    recomputed_unsafe = {
        "status": "measured",
        "baseline_total_unsafe": baseline_unsafe_count,
        "current_total_unsafe": final_unsafe_count,
        "reduced_by": baseline_unsafe_count - final_unsafe_count,
        "ratio": 0.0
        if baseline_unsafe_count == 0
        else final_unsafe_count / baseline_unsafe_count,
    }
    if recomputed_unsafe != evidence.get("unsafe_reduction"):
        raise SystemExit(f"{prefix}.unsafe_reduction does not match rescanned baseline/final")
    expected_patch = "".join(
        difflib.unified_diff(
            baseline_rust.splitlines(keepends=True),
            final_rust.splitlines(keepends=True),
            fromfile=evidence["baseline"]["path"],
            tofile=evidence["final"]["path"],
            n=0,
        )
    )
    actual_patch = artifact_paths["accepted_patch"].read_text(encoding="utf-8").replace("\r\n", "\n")
    if actual_patch != expected_patch:
        raise SystemExit(f"{prefix}.accepted_patch does not match deterministic baseline/final diff")
