

def validate_ai_cross_bindings(
    payloads: dict[str, dict[str, Any] | None],
    paths: dict[str, Path | None],
    *,
    summary_path: Path,
    repo_root: Path,
    reasons: list[str],
) -> None:
    manifest = payloads.get("manifest")
    route = payloads.get("route")
    profile = payloads.get("profile")
    final = payloads.get("final")
    if not all(isinstance(payload, dict) for payload in [manifest, route, profile, final]):
        return
    validate_nested_ai_ref(final.get("route_decision"), paths["route"], paths["final"], "final_route", summary_path, repo_root, reasons)
    validate_nested_ai_ref(final.get("validation_profile"), paths["profile"], paths["final"], "final_profile", summary_path, repo_root, reasons)
    if manifest.get("status") == "generated":
        route_ref = route.get("source_artifacts", {}).get("ai_candidate_manifest")
        profile_ref = profile.get("candidate_generation", {}).get("ai", {}).get("source_artifact")
        validate_nested_ai_ref(route_ref, paths["manifest"], paths["route"], "route_manifest", summary_path, repo_root, reasons)
        validate_nested_ai_ref(profile_ref, paths["manifest"], paths["profile"], "profile_manifest", summary_path, repo_root, reasons)
    else:
        validate_nested_ai_ref(manifest.get("route_decision"), paths["route"], paths["manifest"], "manifest_route", summary_path, repo_root, reasons)
        validate_nested_ai_ref(manifest.get("validation_profile"), paths["profile"], paths["manifest"], "manifest_profile", summary_path, repo_root, reasons)


def validate_nested_ai_ref(
    ref: Any,
    expected_path: Path | None,
    owner_path: Path | None,
    label: str,
    summary_path: Path,
    repo_root: Path,
    reasons: list[str],
) -> None:
    if expected_path is None or owner_path is None or not isinstance(ref, dict):
        reasons.append(f"{label}_binding_missing")
        return
    path_ref = ref.get("path")
    expected_sha = ref.get("sha256")
    if not isinstance(path_ref, str) or not is_repo_relative_posix_path(path_ref) or not is_sha256(str(expected_sha)):
        reasons.append(f"{label}_binding_invalid")
        return
    resolved = resolve_nested_ai_artifact(path_ref, owner_path=owner_path, summary_path=summary_path, repo_root=repo_root)
    if resolved is None or resolved.resolve() != expected_path.resolve() or expected_sha != sha256(expected_path):
        reasons.append(f"{label}_binding_drift")


def resolve_nested_ai_artifact(
    value: str,
    *,
    owner_path: Path,
    summary_path: Path,
    repo_root: Path,
) -> Path | None:
    candidates = [repo_root / value, owner_path.parent / value]
    summary_candidate = resolve_summary_artifact(value, summary_path=summary_path, repo_root=repo_root)
    if summary_candidate is not None:
        candidates.append(summary_candidate)
    for candidate in candidates:
        if candidate.is_file():
            return candidate.resolve()
    return None


def validate_fresh_ai_manifest(
    manifest: dict[str, Any],
    *,
    manifest_path: Path | None,
    policy: dict[str, Any],
    summary_path: Path,
    repo_root: Path,
) -> dict[str, Any]:
    reasons: list[str] = []
    recomputed_prompt_scope: list[str] | None = None
    schema_version = manifest.get("schema_version")
    if (
        not isinstance(schema_version, int)
        or isinstance(schema_version, bool)
        or schema_version < 8
    ):
        reasons.append("ai_manifest_schema_version_stale_for_fresh_run")
    try:
        jsonschema.Draft7Validator(load_json(AI_CANDIDATE_MANIFEST_SCHEMA_PATH)).validate(manifest)
    except (OSError, UnicodeError, json.JSONDecodeError, jsonschema.ValidationError, jsonschema.SchemaError):
        reasons.append("ai_manifest_schema_invalid")
    generator = manifest.get("generator")
    try:
        expected_identity = resolve_model_identity(policy["model"])
    except (KeyError, ValueError):
        expected_identity = None
    expected_generator = {
        "tool": "opencode",
        "provider": expected_identity.provider_label if expected_identity is not None else None,
        "logical_model": expected_identity.logical_model if expected_identity is not None else None,
        "resolved_model": policy["model"],
        "competition_eligible": (
            expected_identity.competition_eligible if expected_identity is not None else None
        ),
        "evaluation_scope": expected_identity.evaluation_scope if expected_identity is not None else None,
        "agent": policy["agent"],
        "variant": policy["variant"],
    }
    if (
        isinstance(manifest.get("schema_version"), int)
        and not isinstance(manifest.get("schema_version"), bool)
        and manifest["schema_version"] >= 3
    ):
        expected_generator["prompt_transport"] = prompt_transport_contract()
    if not isinstance(generator, dict) or any(generator.get(key) != value for key, value in expected_generator.items()):
        reasons.append("ai_manifest_generator_does_not_match_execution_policy")
    if manifest.get("ai_required_for_default_pipeline") is not True:
        reasons.append("ai_manifest_does_not_require_default_ai_pipeline")
    status = manifest.get("status")
    if status not in {"generated", "blocked"}:
        reasons.append("ai_first_manifest_not_invoked")
    cache_required = (
        isinstance(schema_version, int)
        and not isinstance(schema_version, bool)
        and schema_version >= 4
        and status in {"generated", "blocked"}
    )
    cache = manifest.get("cache")
    cache_status = cache.get("status") if isinstance(cache, dict) else None
    expected_cache_payload = None
    expected_cache_key = None
    cache_entry_payload = None
    cache_response_bytes = None
    if cache_required and cache_status not in {"disabled", "not_checked", "miss", "hit"}:
        reasons.append("ai_manifest_cache_evidence_invalid")
    cache_hit = cache_required and cache_status == "hit"
    provider_accounting_required = (
        isinstance(manifest.get("schema_version"), int)
        and not isinstance(manifest.get("schema_version"), bool)
        and manifest["schema_version"] >= 2
        and status in {"generated", "blocked"}
    )
    explicit_provider_accounting = (
        "provider_invocations" in manifest or "provider_preflight" in manifest
    )
    complete_provider_accounting = all(
        key in manifest for key in ("provider_invocations", "provider_preflight")
    )
    if provider_accounting_required and not complete_provider_accounting:
        reasons.append("ai_manifest_provider_accounting_missing")
    validate_provider_accounting = (
        provider_accounting_required or explicit_provider_accounting
    )
    provider_invocations = manifest.get(
        "provider_invocations",
        0 if provider_accounting_required else 1,
    )
    provider_preflight = manifest.get("provider_preflight")
    if (
        isinstance(provider_invocations, bool)
        or not isinstance(provider_invocations, int)
        or provider_invocations not in {0, 1}
    ):
        reasons.append("ai_manifest_provider_invocations_invalid")
        provider_invocations = 0
    if validate_provider_accounting:
        preflight_status = (
            provider_preflight.get("status") if isinstance(provider_preflight, dict) else None
        )
        source_span_status = (
            provider_preflight.get("source_span_status")
            if isinstance(provider_preflight, dict)
            else None
        )
        compile_context_status = (
            provider_preflight.get("compile_context_status")
            if isinstance(provider_preflight, dict)
            else None
        )
        blocked_by_compile_context = (
            preflight_status == "blocked"
            and source_span_status in READY_SOURCE_SPAN_STATUSES
            and compile_context_status == "response_file_invalid"
        )
        context_boundary_status = (
            provider_preflight.get("context_boundary_status")
            if isinstance(provider_preflight, dict)
            else None
        )
        blocked_by_context_boundary = (
            preflight_status == "blocked"
            and source_span_status in READY_SOURCE_SPAN_STATUSES
            and context_boundary_status == "required_callee_context_incomplete"
        )
        replay_api_contract_status = (
            provider_preflight.get("replay_api_contract_status")
            if isinstance(provider_preflight, dict)
            else None
        )
        blocked_by_replay_contract = (
            preflight_status == "blocked"
            and source_span_status in READY_SOURCE_SPAN_STATUSES
            and isinstance(replay_api_contract_status, str)
            and replay_api_contract_status != "bound"
        )
        if (
            preflight_status not in {"ready", "blocked"}
            or not isinstance(source_span_status, str)
            or not source_span_status
        ):
            reasons.append("ai_manifest_provider_preflight_invalid")
        elif (
            preflight_status == "ready"
            and source_span_status not in READY_SOURCE_SPAN_STATUSES
        ) or (
            preflight_status == "blocked"
            and source_span_status not in BLOCKED_SOURCE_SPAN_STATUSES
            and not blocked_by_compile_context
            and not blocked_by_context_boundary
            and not blocked_by_replay_contract
        ):
            reasons.append("ai_manifest_provider_preflight_source_status_mismatch")
        if provider_invocations == 0:
            failure = manifest.get("failure")
            blocked_without_call = (
                status == "blocked"
                and preflight_status == "blocked"
                and isinstance(failure, dict)
                and failure.get("kind") == "context_not_provider_ready"
                and not cache_hit
            )
            generated_from_cache = (
                status == "generated"
                and preflight_status == "ready"
                and cache_hit
            )
            if not (blocked_without_call or generated_from_cache):
                reasons.append("ai_manifest_zero_invocation_preflight_invalid")
        elif preflight_status != "ready" or cache_hit:
            reasons.append("ai_manifest_invoked_preflight_not_ready")
    if manifest_path is None:
        reasons.append("ai_manifest_path_missing")
    else:
        bindings = manifest.get("bindings")
        for key in ["context_pack", "prompt", "raw_response"]:
            ref = bindings.get(key) if isinstance(bindings, dict) else None
            if not nested_ai_ref_is_hash_bound(ref, owner_path=manifest_path, summary_path=summary_path, repo_root=repo_root):
                reasons.append(f"ai_manifest_{key}_binding_invalid")
        if provider_invocations == 1:
            reasons.extend(
                validate_ai_invocation_receipt(
                    bindings.get("invocation_receipt") if isinstance(bindings, dict) else None,
                    bindings=bindings,
                    manifest_path=manifest_path,
                    summary_path=summary_path,
                    repo_root=repo_root,
                    policy=policy,
                )
            )
        if validate_provider_accounting and isinstance(bindings, dict):
            context_ref = bindings.get("context_pack")
            context_path = (
                resolve_nested_ai_artifact(
                    context_ref.get("path"),
                    owner_path=manifest_path,
                    summary_path=summary_path,
                    repo_root=repo_root,
                )
                if isinstance(context_ref, dict) and isinstance(context_ref.get("path"), str)
                else None
            )
            try:
                context_payload = load_json(context_path) if context_path is not None else None
            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                context_payload = None
            if not isinstance(context_payload, dict):
                reasons.append("ai_manifest_provider_preflight_context_unreadable")
            else:
                if context_payload.get("schema_version") != 4:
                    reasons.append("ai_context_pack_schema_invalid")
                else:
                    try:
                        jsonschema.Draft7Validator(
                            load_json(AI_CONTEXT_PACK_SCHEMA_PATH)
                        ).validate(context_payload)
                    except (
                        OSError,
                        UnicodeError,
                        json.JSONDecodeError,
                        jsonschema.ValidationError,
                        jsonschema.SchemaError,
                    ):
                        reasons.append("ai_context_pack_schema_invalid")
                replay_binding_status = (
                    validate_replay_api_contract_binding(context_payload, context_path)
                    if context_path is not None
                    else "binding_unreadable"
                )
                if blocked_by_replay_contract:
                    if replay_binding_status != replay_api_contract_status:
                        reasons.append("ai_context_replay_api_contract_binding_invalid")
                elif replay_binding_status != "bound":
                    reasons.append("ai_context_replay_api_contract_binding_invalid")
                recomputed_preflight = evaluate_provider_readiness(context_payload)
                if (
                    isinstance(schema_version, int)
                    and not isinstance(schema_version, bool)
                    and schema_version >= 5
                ):
                    recomputed_prompt_scope = prompt_scope_for_context(context_payload)
                    prompt_ref = bindings.get("prompt")
                    prompt_path = (
                        resolve_nested_ai_artifact(
                            prompt_ref.get("path"),
                            owner_path=manifest_path,
                            summary_path=summary_path,
                            repo_root=repo_root,
                        )
                        if isinstance(prompt_ref, dict)
                        and isinstance(prompt_ref.get("path"), str)
                        else None
                    )
                    try:
                        actual_prompt = prompt_path.read_bytes() if prompt_path is not None else None
                    except OSError:
                        actual_prompt = None
                    if actual_prompt != render_prompt(context_payload).encode("utf-8"):
                        reasons.append("ai_manifest_prompt_context_mismatch")
                if provider_preflight != recomputed_preflight:
                    reasons.append("ai_manifest_provider_preflight_context_mismatch")
                recomputed_invocations = int(
                    recomputed_preflight["status"] == "ready" and not cache_hit
                )
                if provider_invocations != recomputed_invocations:
                    reasons.append("ai_manifest_provider_invocations_context_mismatch")
            if cache_required and cache_status in {"hit", "miss"}:
                try:
                    expected_cache_payload = cache_key_payload(
                        context_ref.get("sha256") if isinstance(context_ref, dict) else None,
                        prompt_sha256=(
                            bindings.get("prompt", {}).get("sha256")
                            if isinstance(bindings.get("prompt"), dict)
                            else None
                        ),
                        resolved_model=policy["model"],
                        agent=policy["agent"],
                        agent_definition_sha256=agent_definition_sha256(
                            policy["agent"],
                            REPO_ROOT,
                        ),
                        variant=policy["variant"],
                    )
                    expected_cache_key = cache_key_sha256(expected_cache_payload)
                except (TypeError, ValueError):
                    expected_cache_payload = None
                    expected_cache_key = None
                if not isinstance(cache, dict) or cache.get("key_sha256") != expected_cache_key:
                    reasons.append("ai_manifest_cache_key_mismatch")
                raw_response_ref = bindings.get("raw_response")
                if cache_hit and (
                    not isinstance(raw_response_ref, dict)
                    or cache.get("raw_response_sha256") != raw_response_ref.get("sha256")
                ):
                    reasons.append("ai_manifest_cache_response_binding_mismatch")
                if cache_hit:
                    entry_ref = cache.get("entry") if isinstance(cache, dict) else None
                    if not nested_ai_ref_is_hash_bound(
                        entry_ref,
                        owner_path=manifest_path,
                        summary_path=summary_path,
                        repo_root=repo_root,
                    ):
                        reasons.append("ai_manifest_cache_entry_binding_invalid")
                    elif entry_ref.get("sha256") != cache.get("entry_sha256"):
                        reasons.append("ai_manifest_cache_entry_sha_mismatch")
                    else:
                        entry_path = resolve_nested_ai_artifact(
                            entry_ref.get("path"),
                            owner_path=manifest_path,
                            summary_path=summary_path,
                            repo_root=repo_root,
                        )
                        try:
                            cache_entry_payload = load_json(entry_path)
                        except (OSError, UnicodeError, json.JSONDecodeError):
                            cache_entry_payload = None
                            reasons.append("ai_manifest_cache_entry_unreadable")
                    raw_response_path = (
                        resolve_nested_ai_artifact(
                            raw_response_ref.get("path"),
                            owner_path=manifest_path,
                            summary_path=summary_path,
                            repo_root=repo_root,
                        )
                        if isinstance(raw_response_ref, dict)
                        and isinstance(raw_response_ref.get("path"), str)
                        else None
                    )
                    try:
                        cache_response_bytes = raw_response_path.read_bytes() if raw_response_path is not None else None
                        reparsed = parse_candidate_response(cache_response_bytes.decode("utf-8")) if cache_response_bytes is not None else None
                    except (OSError, UnicodeError, ValueError):
                        reparsed = None
                    reparsed_source = (
                        reparsed.get("candidate", {}).get("source")
                        if isinstance(reparsed, dict)
                        else None
                    )
                    if (
                        not isinstance(reparsed_source, str)
                        or hashlib.sha256(reparsed_source.encode("utf-8")).hexdigest()
                        != cache.get("candidate_sha256")
                    ):
                        reasons.append("ai_manifest_cache_response_reparse_mismatch")
    candidates = manifest.get("candidates")
    if not isinstance(candidates, list):
        reasons.append("ai_manifest_candidates_invalid")
        candidates = []
    rust_candidates = [candidate for candidate in candidates if isinstance(candidate, dict) and candidate.get("purpose") == "rust_draft"]
    repair_candidates = [candidate for candidate in candidates if isinstance(candidate, dict) and candidate.get("purpose") == "repair_candidate"]
    if status == "blocked" and candidates:
        reasons.append("blocked_ai_manifest_must_not_contain_candidates")
    if status == "generated" and len(rust_candidates) != 1:
        reasons.append("generated_ai_manifest_requires_one_rust_draft")
    candidate = rust_candidates[0] if len(rust_candidates) == 1 else None
    expected_candidate_identity = (
        {
            "candidate_id": expected_identity.candidate_id,
            "provider_label": expected_identity.provider_label,
            "model_label": expected_identity.logical_model,
            "resolved_model": expected_identity.resolved_model,
            "competition_eligible": expected_identity.competition_eligible,
            "evaluation_scope": expected_identity.evaluation_scope,
        }
        if expected_identity is not None
        else None
    )
    if candidate is not None and (
        expected_candidate_identity is None
        or any(
            candidate.get(key) != value
            for key, value in expected_candidate_identity.items()
        )
    ):
        reasons.append("ai_candidate_model_identity_mismatch")
    if candidate is not None and (
        candidate.get("competition_eligible") is not True
        or candidate.get("evaluation_scope") != "competition-primary"
    ):
        reasons.append("ai_candidate_not_competition_eligible")
    if (
        status == "generated"
        and isinstance(schema_version, int)
        and not isinstance(schema_version, bool)
        and schema_version >= 5
        and candidate is not None
        and recomputed_prompt_scope is not None
        and candidate.get("prompt_scope") != recomputed_prompt_scope
    ):
        reasons.append("ai_manifest_prompt_scope_context_mismatch")
    if cache_hit:
        artifact = candidate.get("artifact") if isinstance(candidate, dict) else None
        initial_artifact = candidate.get("initial_artifact") if isinstance(candidate, dict) else None
        cache_artifact = initial_artifact if isinstance(initial_artifact, dict) else artifact
        if (
            not isinstance(cache, dict)
            or not isinstance(cache_artifact, dict)
            or cache.get("candidate_sha256") != cache_artifact.get("sha256")
        ):
            reasons.append("ai_manifest_cache_candidate_binding_mismatch")
        elif (
            manifest_path is not None
            and expected_cache_payload is not None
            and expected_cache_key is not None
            and cache_entry_payload is not None
            and cache_response_bytes is not None
        ):
            candidate_path = resolve_nested_ai_artifact(
                cache_artifact.get("path"),
                owner_path=manifest_path,
                summary_path=summary_path,
                repo_root=repo_root,
            )
            try:
                candidate_bytes = candidate_path.read_bytes()
                validate_cache_entry(
                    cache_entry_payload,
                    expected_cache_payload,
                    expected_cache_key,
                    cache_response_bytes,
                    candidate_bytes,
                )
            except (OSError, UnicodeError, TypeError, ValueError):
                reasons.append("ai_manifest_cache_entry_content_mismatch")
    if candidate is not None and manifest_path is not None:
        validate_ai_candidate_artifacts(candidate, manifest_path, summary_path, repo_root, reasons)
    valid_repairs = 0
    seen_rounds: set[int] = set()
    for repair in repair_candidates:
        round_value = repair.get("round")
        bindings = repair.get("bindings")
        raw_response = bindings.get("raw_response") if isinstance(bindings, dict) else None
        if (
            not isinstance(round_value, int)
            or isinstance(round_value, bool)
            or round_value < 1
            or round_value in seen_rounds
            or manifest_path is None
            or not nested_ai_ref_is_hash_bound(raw_response, owner_path=manifest_path, summary_path=summary_path, repo_root=repo_root)
        ):
            reasons.append("ai_repair_round_is_not_hash_bound")
            continue
        seen_rounds.add(round_value)
        validate_ai_candidate_artifacts(repair, manifest_path, summary_path, repo_root, reasons)
        valid_repairs += 1
    bound_repair = candidate.get("repair") if isinstance(candidate, dict) else None
    top_level_repair = manifest.get("repair")
    if bound_repair is not None and top_level_repair is not None:
        reasons.append("ai_repair_binding_is_ambiguous")
    elif bound_repair is not None or top_level_repair is not None:
        repair_rounds, repair_reasons = validate_bound_ai_repair_report(
            bound_repair if bound_repair is not None else top_level_repair,
            manifest_path=manifest_path,
            summary_path=summary_path,
            repo_root=repo_root,
            candidate=candidate if bound_repair is not None else None,
            expected_generator=manifest.get("generator"),
            require_transport=(
                isinstance(manifest.get("schema_version"), int)
                and not isinstance(manifest.get("schema_version"), bool)
                and manifest["schema_version"] >= 3
            ),
        )
        valid_repairs += repair_rounds
        reasons.extend(repair_reasons)
    return {
        "candidate": candidate,
        "repair_rounds": valid_repairs,
        "invocations": provider_invocations + valid_repairs if status in {"generated", "blocked"} else 0,
        "cache_hits": int(cache_hit and status == "generated"),
        "reasons": sorted(set(reasons)),
    }


def validate_ai_invocation_receipt(
    ref: Any,
    *,
    bindings: dict[str, Any] | None,
    manifest_path: Path,
    summary_path: Path,
    repo_root: Path,
    policy: dict[str, Any],
) -> list[str]:
    reasons: list[str] = []
    if not nested_ai_ref_is_hash_bound(
        ref,
        owner_path=manifest_path,
        summary_path=summary_path,
        repo_root=repo_root,
    ):
        return ["ai_invocation_receipt_binding_invalid"]
    receipt_path = resolve_nested_ai_artifact(
        ref["path"],
        owner_path=manifest_path,
        summary_path=summary_path,
        repo_root=repo_root,
    )
    try:
        receipt = load_json(receipt_path) if receipt_path is not None else None
    except (OSError, UnicodeError, json.JSONDecodeError):
        receipt = None
    if not isinstance(receipt, dict):
        return ["ai_invocation_receipt_unreadable"]
    try:
        jsonschema.Draft7Validator(
            load_json(AI_INVOCATION_RECEIPT_SCHEMA_PATH)
        ).validate(receipt)
    except (
        OSError,
        UnicodeError,
        json.JSONDecodeError,
        jsonschema.ValidationError,
        jsonschema.SchemaError,
    ):
        return ["ai_invocation_receipt_schema_invalid"]
    prompt_ref = bindings.get("prompt") if isinstance(bindings, dict) else None
    response_ref = bindings.get("raw_response") if isinstance(bindings, dict) else None
    prompt_path = (
        resolve_nested_ai_artifact(
            prompt_ref.get("path"),
            owner_path=manifest_path,
            summary_path=summary_path,
            repo_root=repo_root,
        )
        if isinstance(prompt_ref, dict) and isinstance(prompt_ref.get("path"), str)
        else None
    )
    response_path = (
        resolve_nested_ai_artifact(
            response_ref.get("path"),
            owner_path=manifest_path,
            summary_path=summary_path,
            repo_root=repo_root,
        )
        if isinstance(response_ref, dict) and isinstance(response_ref.get("path"), str)
        else None
    )
    try:
        response_text = response_path.read_text(encoding="utf-8") if response_path is not None else ""
    except (OSError, UnicodeError):
        response_text = ""
    observed_sessions = session_ids_from_jsonl(response_text)
    expected_model = policy.get("model")
    provider_id, separator, model_id = (
        expected_model.partition("/") if isinstance(expected_model, str) else ("", "", "")
    )
    expected = {
        "schema_version": 1,
        "provider_id": provider_id if separator else None,
        "model_id": model_id if separator else None,
        "resolved_model": expected_model,
        "agent": policy.get("agent"),
        "variant": policy.get("variant"),
        "prompt_sha256": prompt_ref.get("sha256") if isinstance(prompt_ref, dict) else None,
        "raw_response_sha256": response_ref.get("sha256") if isinstance(response_ref, dict) else None,
        "session_id": observed_sessions[0] if len(observed_sessions) == 1 else "unavailable",
        "session_ids": observed_sessions,
        "prompt_transport": prompt_transport_contract(),
        "invocation_contract": invocation_contract(
            resolved_model=expected_model,
            agent=policy.get("agent"),
            variant=policy.get("variant"),
        ),
    }
    if any(receipt.get(key) != value for key, value in expected.items()):
        reasons.append("ai_invocation_receipt_identity_mismatch")
    source = receipt.get("source")
    if source not in {"opencode-session-export", "runner-contract"}:
        reasons.append("ai_invocation_receipt_source_invalid")
    session_id = receipt.get("session_id")
    if len(observed_sessions) > 1 or (observed_sessions and session_id not in observed_sessions):
        reasons.append("ai_invocation_receipt_session_mismatch")
    if source == "opencode-session-export" and (
        len(observed_sessions) != 1
        or receipt.get("opencode_version") in {None, "", "unattested"}
    ):
        reasons.append("ai_invocation_receipt_session_export_invalid")
    elif source == "runner-contract" and receipt.get("opencode_version") != "unattested":
        reasons.append("ai_invocation_receipt_runner_contract_invalid")
    export_evidence = validate_session_export_identity(
        receipt.get("session_export_identity"),
        receipt=receipt,
        receipt_path=receipt_path,
        summary_path=summary_path,
        repo_root=repo_root,
    )
    if source == "opencode-session-export" and export_evidence is None:
        reasons.append("ai_invocation_receipt_session_export_identity_invalid")
    proof_class = None
    try:
        proof_class = load_json(summary_path).get("proof_class") if summary_path.is_file() else None
    except (OSError, UnicodeError, json.JSONDecodeError):
        pass
    if proof_class == "competition-exact" and (
        source != "opencode-session-export"
        or len(observed_sessions) != 1
        or receipt.get("opencode_version") in {None, "", "unattested"}
    ):
        reasons.append("ai_invocation_receipt_not_provider_attested")
    elif proof_class == "competition-exact" and not validate_live_opencode_session_identity(
        receipt,
        opencode_command=policy.get("opencode_command", "opencode"),
        expected_export_sha256=(
            export_evidence.get("session_export_sha256")
            if isinstance(export_evidence, dict)
            else None
        ),
        prompt_path=prompt_path,
        response_text=response_text,
    ):
        reasons.append("ai_invocation_receipt_live_session_mismatch")
    return reasons


def validate_session_export_identity(
    ref: Any,
    *,
    receipt: dict[str, Any],
    receipt_path: Path,
    summary_path: Path,
    repo_root: Path,
) -> dict[str, Any] | None:
    if receipt.get("source") != "opencode-session-export":
        return {} if ref is None else None
    if not nested_ai_ref_is_hash_bound(
        ref,
        owner_path=receipt_path,
        summary_path=summary_path,
        repo_root=repo_root,
    ):
        return None
    path = resolve_nested_ai_artifact(
        ref["path"],
        owner_path=receipt_path,
        summary_path=summary_path,
        repo_root=repo_root,
    )
    try:
        evidence = load_json(path) if path is not None else None
        jsonschema.Draft7Validator(
            load_json(AI_SESSION_EXPORT_IDENTITY_SCHEMA_PATH)
        ).validate(evidence)
    except (
        OSError,
        UnicodeError,
        json.JSONDecodeError,
        jsonschema.ValidationError,
        jsonschema.SchemaError,
    ):
        return None
    identity = evidence.get("identity") if isinstance(evidence, dict) else None
    return evidence if isinstance(identity, dict) and all(
        identity.get(key) == receipt.get(key)
        for key in (
            "session_id",
            "provider_id",
            "model_id",
            "agent",
            "variant",
            "opencode_version",
        )
    ) else None


def validate_live_opencode_session_identity(
    receipt: dict[str, Any],
    *,
    opencode_command: Any,
    expected_export_sha256: Any,
    prompt_path: Path | None,
    response_text: str,
) -> bool:
    if (
        opencode_command != "opencode"
        or not isinstance(expected_export_sha256, str)
        or prompt_path is None
    ):
        return False
    try:
        completed = subprocess.run(
            ["opencode", "export", receipt["session_id"]],
            check=False,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=30,
        )
        payload = json.loads(completed.stdout) if completed.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return False
    if hashlib.sha256(completed.stdout.encode("utf-8")).hexdigest() != expected_export_sha256:
        return False
    identity = parse_session_identity_export(payload, receipt["session_id"])
    if identity is None or not all(
        identity.get(key) == receipt.get(key)
        for key in (
            "session_id",
            "provider_id",
            "model_id",
            "agent",
            "variant",
            "opencode_version",
        )
    ):
        return False
    messages = payload.get("messages") if isinstance(payload, dict) else None
    if not isinstance(messages, list):
        return False
    assistant_fragments: list[str] = []
    user_texts: list[str] = []
    file_urls: list[str] = []
    for message in messages:
        info = message.get("info") if isinstance(message, dict) else None
        parts = message.get("parts") if isinstance(message, dict) else None
        role = info.get("role") if isinstance(info, dict) else None
        if not isinstance(parts, list):
            continue
        for part in parts:
            if not isinstance(part, dict):
                continue
            if (
                role == "assistant"
                and part.get("type") == "text"
                and isinstance(part.get("text"), str)
            ):
                assistant_fragments.append(part["text"])
            elif (
                role == "user"
                and part.get("type") == "text"
                and isinstance(part.get("text"), str)
            ):
                user_texts.append(part["text"])
            elif (
                role == "user"
                and part.get("type") == "file"
                and isinstance(part.get("url"), str)
            ):
                file_urls.append(part["url"])
    if "".join(assistant_fragments) != assistant_text_from_jsonl(response_text):
        return False
    joined_user_text = "\n".join(user_texts)
    if PROMPT_FILE_MESSAGE not in joined_user_text or len(file_urls) != 1:
        return False
    try:
        prompt_lines = prompt_path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return False
    for line in prompt_lines[:3]:
        fragment = line[:512]
        if fragment and fragment not in joined_user_text:
            return False
    parsed_url = urlparse(file_urls[0])
    if parsed_url.scheme != "file" or parsed_url.netloc not in {"", "localhost"}:
        return False
    file_path = unquote(parsed_url.path)
    if re.match(r"^/[A-Za-z]:/", file_path):
        file_path = file_path[1:]
    return Path(file_path).resolve() == prompt_path.resolve()


def validate_bound_ai_repair_report(
    ref: Any,
    *,
    manifest_path: Path | None,
    summary_path: Path,
    repo_root: Path,
    candidate: dict[str, Any] | None,
    require_transport: bool,
    expected_generator: Any = None,
) -> tuple[int, list[str]]:
    reasons: list[str] = []
    if manifest_path is None or not nested_ai_ref_is_hash_bound(
        ref,
        owner_path=manifest_path,
        summary_path=summary_path,
        repo_root=repo_root,
    ):
        return 0, ["ai_repair_report_binding_invalid"]
    report_path = resolve_nested_ai_artifact(
        ref["path"],
        owner_path=manifest_path,
        summary_path=summary_path,
        repo_root=repo_root,
    )
    if report_path is None:
        return 0, ["ai_repair_report_missing"]
    report = load_json(report_path)
    try:
        owner_manifest = load_json(manifest_path)
    except (OSError, UnicodeError, json.JSONDecodeError):
        owner_manifest = None
    owner_bindings = owner_manifest.get("bindings") if isinstance(owner_manifest, dict) else None
    context_ref = owner_bindings.get("context_pack") if isinstance(owner_bindings, dict) else None
    context_path = (
        resolve_nested_ai_artifact(
            context_ref.get("path"),
            owner_path=manifest_path,
            summary_path=summary_path,
            repo_root=repo_root,
        )
        if isinstance(context_ref, dict) and isinstance(context_ref.get("path"), str)
        else None
    )
    try:
        context_payload = load_json(context_path) if context_path is not None else None
    except (OSError, UnicodeError, json.JSONDecodeError):
        context_payload = None
    if require_transport:
        reasons.extend(
            validate_repair_context_and_prompts(
                context_payload,
                context_path=context_path,
                report=report,
                report_path=report_path,
            )
        )
        generator = report.get("generator")
        if report.get("schema_version") != 3:
            reasons.append("ai_repair_report_schema_version_invalid")
        if (
            not isinstance(generator, dict)
            or generator.get("prompt_transport") != prompt_transport_contract()
        ):
            reasons.append("ai_repair_report_prompt_transport_invalid")
        generator_keys = (
            "tool",
            "provider",
            "logical_model",
            "resolved_model",
            "competition_eligible",
            "evaluation_scope",
            "agent",
            "variant",
        )
        if isinstance(expected_generator, dict) and (
            not isinstance(generator, dict)
            or any(generator.get(key) != expected_generator.get(key) for key in generator_keys)
        ):
            reasons.append("ai_repair_report_generator_mismatch")
    if ref.get("status") != report.get("status") or ref.get("semantic_pass") is not False:
        reasons.append("ai_repair_report_status_or_claim_drift")
    boundary = report.get("claim_boundary")
    if not isinstance(boundary, dict) or (
        boundary.get("semantic_gate") is not False
        or boundary.get("semantic_pass") is not False
        or boundary.get("translation_coverage_numerator") != 0
    ):
        reasons.append("ai_repair_report_claim_boundary_invalid")
    rounds = report.get("rounds")
    if not isinstance(rounds, list) or not 1 <= len(rounds) <= 5:
        return 0, sorted(set([*reasons, "ai_repair_report_round_count_invalid"]))
    for round_record in rounds:
        bindings = round_record.get("bindings") if isinstance(round_record, dict) else None
        if not isinstance(bindings, dict):
            reasons.append("ai_repair_round_bindings_missing")
            continue
        for key in ("failure_facts", "prompt"):
            if not nested_ai_ref_is_hash_bound(
                bindings.get(key),
                owner_path=report_path,
                summary_path=summary_path,
                repo_root=repo_root,
            ):
                reasons.append(f"ai_repair_round_{key}_binding_invalid")
        for key in ("raw_response", "repair_artifact", "candidate", "validation_result"):
            value = bindings.get(key)
            if value is not None and not nested_ai_ref_is_hash_bound(
                value,
                owner_path=report_path,
                summary_path=summary_path,
                repo_root=repo_root,
            ):
                reasons.append(f"ai_repair_round_{key}_binding_invalid")
    if candidate is not None:
        if report.get("status") != "candidate_ready_for_common_validation":
            reasons.append("selected_ai_repair_report_not_ready")
        final_candidate = report.get("final_candidate")
        artifact = candidate.get("artifact")
        if not isinstance(final_candidate, dict) or not isinstance(artifact, dict) or (
            final_candidate.get("sha256") != artifact.get("sha256")
        ):
            reasons.append("selected_ai_repair_final_candidate_drift")
        if candidate.get("repair_rounds") != len(rounds):
            reasons.append("selected_ai_repair_round_count_drift")
    elif report.get("status") == "candidate_ready_for_common_validation":
        reasons.append("ready_ai_repair_report_not_bound_to_candidate")
    return len(rounds), sorted(set(reasons))


def validate_ai_candidate_artifacts(
    candidate: dict[str, Any],
    manifest_path: Path,
    summary_path: Path,
    repo_root: Path,
    reasons: list[str],
) -> None:
    if candidate.get("kind") != "opencode-ai" or candidate.get("semantic_pass") is not False:
        reasons.append("ai_candidate_claim_boundary_invalid")
    artifact = candidate.get("artifact")
    if not nested_ai_ref_is_hash_bound(artifact, owner_path=manifest_path, summary_path=summary_path, repo_root=repo_root):
        reasons.append("ai_candidate_artifact_binding_invalid")
    elif candidate.get("output_hash") != artifact.get("sha256"):
        reasons.append("ai_candidate_output_hash_mismatch")
    if candidate.get("applied") is True:
        applied = candidate.get("applied_artifact")
        if not nested_ai_ref_is_hash_bound(applied, owner_path=manifest_path, summary_path=summary_path, repo_root=repo_root):
            reasons.append("ai_candidate_applied_artifact_binding_invalid")
        elif applied.get("sha256") != artifact.get("sha256") or candidate.get("rust_draft_sha256") != applied.get("sha256"):
            reasons.append("ai_candidate_applied_hash_mismatch")


def nested_ai_ref_is_hash_bound(
    ref: Any,
    *,
    owner_path: Path,
    summary_path: Path,
    repo_root: Path,
) -> bool:
    if not isinstance(ref, dict):
        return False
    path_ref = ref.get("path")
    expected_sha = ref.get("sha256")
    if not isinstance(path_ref, str) or not is_repo_relative_posix_path(path_ref) or not is_sha256(str(expected_sha)):
        return False
    resolved = resolve_nested_ai_artifact(path_ref, owner_path=owner_path, summary_path=summary_path, repo_root=repo_root)
    return resolved is not None and sha256(resolved) == expected_sha


def ai_candidate_is_applied(candidate: Any, *, manifest_path: Path | None) -> bool:
    if not isinstance(candidate, dict) or manifest_path is None or candidate.get("applied") is not True:
        return False
    artifact = candidate.get("artifact")
    applied = candidate.get("applied_artifact")
    return (
        isinstance(artifact, dict)
        and isinstance(applied, dict)
        and artifact.get("sha256") == applied.get("sha256")
        and candidate.get("output_hash") == applied.get("sha256")
        and candidate.get("rust_draft_sha256") == applied.get("sha256")
    )


def ai_candidate_is_selected(
    candidate: Any,
    manifest: dict[str, Any],
    route: dict[str, Any],
    profile: dict[str, Any],
) -> bool:
    if not isinstance(candidate, dict):
        return False
    candidate_id = candidate.get("candidate_id")
    route_generation = route.get("candidate_generation")
    profile_generation = profile.get("candidate_generation")
    if not isinstance(route_generation, dict) or not isinstance(profile_generation, dict):
        return False
    route_ai = route_generation.get("ai")
    profile_ai = profile_generation.get("ai")
    route_primary = route_generation.get("primary_candidate")
    return (
        isinstance(candidate_id, str)
        and manifest.get("selected_candidate_id") == candidate_id
        and route_generation.get("selected_candidate_id") == candidate_id
        and profile_generation.get("selected_candidate_id") == candidate_id
        and isinstance(route_ai, dict)
        and isinstance(profile_ai, dict)
        and route_ai.get("candidate_id") == candidate_id
        and profile_ai.get("candidate_id") == candidate_id
        and route_ai.get("kind") == "opencode-ai"
        and profile_ai.get("kind") == "opencode-ai"
        and route_ai.get("applied") is True
        and profile_ai.get("applied") is True
        and isinstance(route_primary, dict)
        and route_primary.get("selected") == "opencode-ai"
    )


def ai_candidate_rustc_passes(candidate: Any, profile: dict[str, Any], final: dict[str, Any]) -> bool:
    if not isinstance(candidate, dict) or final.get("rust_check_status") != "passed":
        return False
    acceptance = profile.get("generated_draft_acceptance")
    rust_check = acceptance.get("rust_check") if isinstance(acceptance, dict) else None
    rust_draft = acceptance.get("rust_draft") if isinstance(acceptance, dict) else None
    return (
        isinstance(rust_check, dict)
        and rust_check.get("status") == "passed"
        and isinstance(rust_draft, dict)
        and rust_draft.get("sha256") == candidate.get("rust_draft_sha256")
    )


def ai_candidate_semantically_accepted(candidate: Any, profile: dict[str, Any], final: dict[str, Any]) -> bool:
    if not isinstance(candidate, dict) or profile.get("accepted_evidence_authoritative") is not False:
        return False
    acceptance = profile.get("generated_draft_acceptance")
    if not isinstance(acceptance, dict):
        return False
    claim_source = acceptance.get("claim_source")
    return (
        profile.get("status") == "passed"
        and profile.get("generated_draft_semantic_pass") is True
        and acceptance.get("status") == "passed"
        and acceptance.get("generated_draft_semantic_pass") is True
        and acceptance.get("selected_candidate_id") == candidate.get("candidate_id")
        and acceptance.get("accepted_evidence_binding") is None
        and isinstance(claim_source, str)
        and "accepted" not in claim_source.lower()
        and final.get("status") == "passed"
        and final.get("validation_profile_status") == "passed"
        and final.get("semantic_pass") is True
    )


if __name__ == "__main__":
    raise SystemExit(main())
