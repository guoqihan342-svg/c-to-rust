    }
    workflow_metrics_path = REPO_ROOT / refs["workflow_metrics"]["path"]
    workflow_metrics = json.loads(workflow_metrics_path.read_text(encoding="utf-8"))
    workflow_metrics["unsafe_reduction"] = {
