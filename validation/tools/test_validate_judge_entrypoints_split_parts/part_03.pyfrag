                },
            },
        },
        "evidence_artifact_refs": {
            "competition_run_summary": artifact_ref("target/out/summary/competition-run-summary.json", "2"),
            "workflow_metrics": artifact_ref("target/out/summary/workflow-metrics.json", "3"),
