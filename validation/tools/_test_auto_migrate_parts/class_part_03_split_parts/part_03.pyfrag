    def test_compile_only_pointer_stub_erases_pointee_without_semantic_claim(self) -> None:
        module = load_auto_migrate_module()
        spec = {
            "schema_version": 1,
            "target_id": "neutral",
            "slice_id": "pointer-adapter",
            "level": "L3",
            "function_name": "translate_packet",
            "fixture_hash": "pointer-adapter-fixture",
            "c_boundary": {
                "direct_dependencies": [
                    {"kind": "callee", "name": "exchange_bytes"},
                ],
                "external_direct_callees": [
                    {
                        "name": "exchange_bytes",
                        "signature_ref": "sig-exchange-bytes",
                        "definition_status": "real_source_bound",
                        "stub_boundary": "compile_only",
                    }
                ],
                "signatures": [
                    {
                        "id": "sig-exchange-bytes",
                        "role": "external_direct_callee",
                        "function": "exchange_bytes",
                        "return_type": "int",
                        "definition_status": "real_source_bound",
                        "parameters": [
                            {"name": "source", "c_type": "const unsigned char *"},
                            {"name": "destination", "c_type": "void *"},
                        ],
                    }
                ],
            },
        }
        draft = """\
pub struct PacketEnvelope { pub status: u32 }
pub fn translate_packet(source: *const core::ffi::c_void, output: &mut PacketEnvelope) -> i32 {
    exchange_bytes(source, &mut output.status)
}
"""
        misleading_type_name_signature = module.rust_check_declared_callee_signature(
            {
                "name": "inspect_packet",
                "return_type": "int",
                "parameters": [
                    {"name": "packet", "c_type": "struct construction_packet *"},
                ],
            },
            erase_pointer_pointees=True,
        )
        self.assertIn("packet: *mut C2rPointee1", misleading_type_name_signature)
        with tempfile.TemporaryDirectory(prefix="auto-migrate-pointer-erased-stub-") as tmp:
            draft_path = Path(tmp) / "draft.rs"
            draft_path.write_text(draft, encoding="utf-8")
            context = module.external_direct_callee_context(spec, None)

            changed = module.inject_external_callee_stubs(draft_path, context, spec)
            rust_check = module.rust_check_once(draft_path)

            self.assertTrue(changed)
            self.assertEqual(rust_check["returncode"], 0, rust_check["stderr"])
            updated = draft_path.read_text(encoding="utf-8")
            self.assertIn(
                "fn exchange_bytes<C2rPointee1, C2rPointee2>(source: *const C2rPointee1, destination: *mut C2rPointee2) -> i32",
                updated,
            )
            bindings = module.rust_check_external_binding_report(context)["bindings"]
            self.assertEqual(len(bindings), 1)
            self.assertEqual(bindings[0]["allowed_use"], "rustc_compile_only")
            self.assertEqual(
                bindings[0]["adapter_kind"],
                "compile_only_pointer_pointee_erasure",
            )
            self.assertFalse(bindings[0]["semantics_verified"])
            self.assertFalse(module.inject_external_callee_stubs(draft_path, context, spec))
            self.assertEqual(updated.count("fn exchange_bytes<"), 1)

    def test_compile_only_external_preflight_reports_required_api_mismatch(self) -> None:
        module = load_auto_migrate_module()
        spec = {
            "schema_version": 1,
            "target_id": "neutral",
            "slice_id": "packet-preflight",
            "level": "L3",
            "function_name": "translate_packet",
            "fixture_hash": "packet-preflight-fixture",
            "fixture_contract": {
                "observable_outputs": ["return_code"],
                "cases": [],
            },
        }
        with tempfile.TemporaryDirectory(prefix="auto-migrate-api-preflight-") as tmp:
            evidence_dir = Path(tmp)
            (evidence_dir / "l3-packet-preflight-rust-draft.rs").write_text(
                """\
fn inspect_bytes<T>(_source: *const T) -> i32 { 0 }
pub fn translate_packet(source: *const core::ffi::c_void) -> i32 {
    inspect_bytes(source)
}
""",
                encoding="utf-8",
            )
            (evidence_dir / "l3-packet-preflight-rust-replay-test-draft.rs").write_text(
                """\
#[test]
fn replay_packet_preflight_fixture_contract() {
    let actual: i32 = translate_packet("payload");
    let _missing: MissingReplayType = translate_packet("payload");
    assert_eq!(actual, 0i32);
}
""",
                encoding="utf-8",
            )
            replay = {
                "schema_version": 1,
                "status": "recorded",
                "generated_draft_replay_pass": False,
                "generated_draft_semantic_pass": False,
            }
            result = module.run_generated_rust_replay(
                spec,
                evidence_dir,
                replay,
                {
                    "status": "passed",
                    "rust_check_harness_only_bindings": {
                        "status": "emitted",
                        "allowed_use": "rustc_compile_only",
                        "semantics_verified": False,
                        "bindings": [
                            {
                                "name": "inspect_bytes",
                                "status": "generated_compile_only",
                                "allowed_use": "rustc_compile_only",
                                "signature": "fn inspect_bytes<T>(source: *const T) -> i32",
                                "semantics_verified": False,
                            }
                        ],
                    },
                },
            )

            preflight = result["candidate_replay_compile_preflight"]
            self.assertEqual(result["status"], "not_applicable")
            self.assertEqual(preflight["status"], "failed")
            self.assertEqual(preflight["reason"], "candidate_replay_api_compile_failed")
            self.assertNotEqual(preflight["compile_returncode"], 0)
            self.assertFalse(preflight["execution_allowed"])
            self.assertFalse(preflight["semantics_verified"])
            self.assertIn("--json=diagnostic-short", preflight["compile_command"])
            diagnostics = (evidence_dir / preflight["stderr_log"]).read_text(encoding="utf-8")
            self.assertIn("mismatched types", diagnostics)
            self.assertIn("cannot find type `MissingReplayType`", diagnostics)
            self.assertFalse(result["generated_draft_replay_pass"])
            self.assertFalse(result["generated_draft_semantic_pass"])
