            (evidence_dir / "l3-mixed-external-auto-translation-plan.json").write_text(
                json.dumps({"translation_summary": {"translation_rule_ids": ["clang-lowered-typed-ir"]}}),
                encoding="utf-8",
            )
            replay = {
                "schema_version": 1,
                "status": "recorded",
                "generated_draft_replay_pass": False,
                "generated_draft_semantic_pass": False,
            }

            skipped_replay = module.run_generated_rust_replay(
                spec,
                evidence_dir,
                replay,
                {
                    "status": "passed",
                    "rust_check_harness_only_bindings": {
                        "status": "emitted",
