    def test_real_fdb_kv_set_opaque_blob_cannot_enable_fixture_value_stub(self) -> None:
        module = load_auto_migrate_module()
        spec_path = REPO_ROOT / "validation" / "slice-specs" / "flashdb-real-fdb-kv-set.json"
        spec = json.loads(spec_path.read_text(encoding="utf-8"))
        draft = """#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct FdbBlob {
    pub _c2r_opaque: u8,
}

pub fn fdb_kv_set(db: *mut core::ffi::c_void, key: *const core::ffi::c_void, value: Option<&[i8]>) -> i32 {
    let mut blob: FdbBlob = FdbBlob { _c2r_opaque: 0u8 };
    if value.is_some() {
        return fdb_kv_set_blob(db, key, fdb_blob_make(&mut blob, value.unwrap().as_ptr() as *const core::ffi::c_void, value.unwrap().iter().position(|&byte| byte == 0).expect("C strlen precondition violated")));
    } else {
        return fdb_kv_del(db, key);
    }
}
"""
        with tempfile.TemporaryDirectory(prefix="auto-migrate-real-fdb-kv-set-opaque-blob-") as tmp:
            draft_path = Path(tmp) / "l3-real-fdb-kv-set-rust-draft.rs"
            draft_path.write_text(draft, encoding="utf-8")
            context = module.external_direct_callee_context(spec, None)

            changed = module.inject_external_callee_stubs(draft_path, context, spec)
            rust_check = module.rust_check_once(draft_path)

            self.assertTrue(changed)
            self.assertNotEqual(rust_check["returncode"], 0, rust_check["stderr"])
            rewritten = draft_path.read_text(encoding="utf-8")
            self.assertNotIn("7i32", rewritten)
            self.assertNotIn("fixture model", rewritten)
            bindings = {
                item["name"]: item
                for item in module.rust_check_external_binding_report(context)["bindings"]
            }
            self.assertNotIn("fdb_blob_make", bindings)
            self.assertEqual(bindings["fdb_kv_set_blob"]["status"], "generated_compile_only")
            self.assertEqual(bindings["fdb_kv_del"]["status"], "generated_compile_only")

    def test_declared_external_context_generates_compile_only_stub_when_fixture_model_absent(self) -> None:
        module = load_auto_migrate_module()
        spec = {
            "schema_version": 1,
            "target_id": "flashdb",
            "slice_id": "real-fdb-kv-del",
            "level": "L3",
            "function_name": "fdb_kv_del",
            "fixture_hash": "real-fdb-kv-del-fixture",
            "c_boundary": {
                "direct_dependencies": [
                    {"kind": "callee", "name": "FDB_INFO"},
                    {"kind": "callee", "name": "db_name"},
                ],
                "signatures": [
                    {
                        "function": "fdb_kv_del",
                        "return_type": "fdb_err_t",
                        "parameters": [
                            {"name": "db", "c_type": "fdb_kvdb_t", "direction": "input"},
                            {"name": "key", "c_type": "const char *", "direction": "input"},
                        ],
                    },
                    {
                        "id": "sig-fdb-info",
                        "role": "external_direct_callee",
                        "function": "FDB_INFO",
                        "return_type": "void",
                        "definition_status": "declared_external_direct_callee",
                        "parameters": [
                            {"name": "fmt", "c_type": "const char *"},
                            {"name": "name", "c_type": "const char *"},
                        ],
                    },
                    {
                        "id": "sig-db-name",
                        "role": "external_direct_callee",
                        "function": "db_name",
                        "return_type": "const char *",
                        "definition_status": "real_source_bound",
                        "parameters": [{"name": "db", "c_type": "fdb_kvdb_t"}],
                    },
                ],
            },
        }
        draft = """\
pub fn fdb_kv_del(db: *mut core::ffi::c_void, _key: *const core::ffi::c_void) -> i32 {
    FDB_INFO(b"bad\\0".as_ptr().cast::<core::ffi::c_char>(), db_name(db));
    7i32
}
"""
        with tempfile.TemporaryDirectory(prefix="auto-migrate-declared-external-stub-") as tmp:
            draft_path = Path(tmp) / "l3-real-fdb-kv-del-rust-draft.rs"
            draft_path.write_text(draft, encoding="utf-8")
            context = module.external_direct_callee_context(spec, None)

            changed = module.inject_external_callee_stubs(draft_path, context, spec)
            rust_check = module.rust_check_once(draft_path)

            self.assertTrue(changed)
            self.assertEqual(rust_check["returncode"], 0, rust_check["stderr"])
            updated = draft_path.read_text(encoding="utf-8")
            self.assertIn(
                "fn FDB_INFO<C2rPointee1, C2rPointee2>(fmt: *const C2rPointee1, name: *const C2rPointee2) -> ()",
                updated,
            )
            bindings = {
                item["name"]: item
                for item in module.rust_check_external_binding_report(context)["bindings"]
            }
            self.assertEqual(bindings["FDB_INFO"]["status"], "generated_compile_only")
            self.assertEqual(bindings["FDB_INFO"]["allowed_use"], "rustc_compile_only")
            self.assertEqual(
                bindings["FDB_INFO"]["adapter_kind"],
                "compile_only_pointer_pointee_erasure",
            )
            self.assertFalse(bindings["FDB_INFO"]["semantics_verified"])

