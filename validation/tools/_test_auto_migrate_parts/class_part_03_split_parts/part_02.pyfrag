            )
            self.assertFalse(skipped_replay["generated_draft_replay_pass"])
            self.assertFalse(skipped_replay["generated_draft_semantic_pass"])

    def test_explicit_ignored_non_observable_void_contract_replay_runs(self) -> None:
        module = load_auto_migrate_module()
        spec = {
            "schema_version": 1,
            "target_id": "otherdb",
            "slice_id": "void-log-replay-contract",
            "level": "L3",
            "function_name": "delete_key",
            "fixture_hash": "void-log-replay-contract-fixture",
            "fixture_contract": {
                "observable_outputs": ["return_code"],
                "cases": [
                    {
                        "id": "returns-seven",
                        "input_ref": "inline",
                        "expected_ref": "inline",
                        "inputs": {"crc": 0, "buf": [1, 2, 3], "size": 3},
                        "expected_outputs": {"return_code": 7},
                    }
                ],
            },
            "c_boundary": {
                "direct_dependencies": [
                    {"kind": "callee", "name": "LOG_INFO"},
                ],
                "external_direct_callees": [
                    {
                        "name": "LOG_INFO",
                        "signature_ref": "sig-log-info",
                        "definition_status": "declared_external_direct_callee",
                        "replay_contract": {
                            "kind": "ignored_non_observable_void",
                            "observable_outputs": ["return_code"],
                            "reason": "logging is outside this fixture's observable output contract",
                        },
                    }
                ],
                "signatures": [
                    {
                        "function": "delete_key",
                        "return_type": "unsigned int",
                        "parameters": [
                            {"name": "crc", "c_type": "unsigned int", "direction": "input"},
                            {"name": "buf", "c_type": "const unsigned char *", "direction": "input"},
                            {"name": "size", "c_type": "size_t", "direction": "input"},
                        ],
                    },
                    {
                        "id": "sig-log-info",
                        "role": "external_direct_callee",
                        "function": "LOG_INFO",
                        "return_type": "void",
                        "definition_status": "declared_external_direct_callee",
                        "parameters": [
                            {"name": "message", "c_type": "const char *"},
                        ],
                    },
                ],
            },
        }
        with tempfile.TemporaryDirectory(prefix="auto-migrate-explicit-void-noop-replay-") as tmp:
            evidence_dir = Path(tmp)
            spec_path = evidence_dir / "void-log-replay-contract.json"
            spec_path.write_text(json.dumps(spec), encoding="utf-8")
            draft_path = evidence_dir / "l3-void-log-replay-contract-rust-draft.rs"
            draft_path.write_text(
                """\
pub fn delete_key(crc: u32, buf: &'static [u8], size: usize) -> u32 {
    let _ = (crc, buf, size);
    LOG_INFO(b"ignored\\0".as_ptr().cast::<core::ffi::c_char>());
    7u32
}
""",
                encoding="utf-8",
            )
            (evidence_dir / "l3-void-log-replay-contract-auto-translation-plan.json").write_text(
                json.dumps({"translation_summary": {"translation_rule_ids": ["clang-lowered-typed-ir"]}}),
                encoding="utf-8",
            )
            context = module.external_direct_callee_context(spec, None)

            changed = module.inject_external_callee_stubs(draft_path, context, spec)
            rust_check = module.rust_check_once(draft_path)
            replay = module.generate_rust_replay_test_draft(spec, evidence_dir, spec_path)
            replay = module.run_generated_rust_replay(
                spec,
                evidence_dir,
                replay,
                {
                    "status": "passed",
                    "rust_check_harness_only_bindings": module.rust_check_external_binding_report(context),
                },
            )

            self.assertTrue(changed)
            self.assertEqual(rust_check["returncode"], 0, rust_check["stderr"])
            draft = draft_path.read_text(encoding="utf-8")
            self.assertIn(
                "fn LOG_INFO(message: *const core::ffi::c_char) -> ()",
                draft,
            )
            self.assertIn("ignored non-observable void external callee", draft)
            bindings = {
                item["name"]: item
                for item in module.rust_check_external_binding_report(context)["bindings"]
            }
            self.assertEqual(bindings["LOG_INFO"]["status"], "declared_ignored_non_observable_void")
            self.assertEqual(bindings["LOG_INFO"]["allowed_use"], "fixture_bound_rust_replay_only")
            self.assertFalse(bindings["LOG_INFO"]["semantics_verified"])
            self.assertEqual(replay["status"], "passed")
            self.assertTrue(replay["generated_draft_replay_pass"])
            self.assertFalse(replay["generated_draft_semantic_pass"])

