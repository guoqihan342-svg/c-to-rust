            self.assertTrue(changed)
            self.assertEqual(context["blocked_count"], 0)
            self.assertEqual(rust_check["returncode"], 0, rust_check["stderr"])
            bindings = {
                item["name"]: item
                for item in module.rust_check_external_binding_report(context)["bindings"]
            }
            self.assertEqual(bindings["db_init_ok"]["status"], "generated_compile_only")
            self.assertEqual(bindings["db_name"]["status"], "generated_compile_only")
            self.assertEqual(bindings["db_lock"]["status"], "generated_compile_only")
            self.assertEqual(bindings["del_kv"]["status"], "generated_compile_only")
            self.assertEqual(bindings["db_unlock"]["status"], "generated_compile_only")
            replay_source = (
                evidence_dir / "l3-real-fdb-kv-del-rust-replay-test-draft.rs"
            ).read_text(encoding="utf-8")
            self.assertIn("KvDbFixture = KvDbFixture { init_ok: false", replay_source)
            self.assertIn('fdb_kv_del(&actual_uninit_delete_0_db, "boot_count")', replay_source)
            self.assertNotIn("db_marker", replay_source)
            self.assertEqual(replay["status"], "not_applicable")
            self.assertEqual(
                replay["skip_reason"],
                "compile_only_external_bindings_not_executable",
            )
            self.assertFalse(replay["generated_draft_replay_pass"])
            self.assertFalse(replay["generated_draft_semantic_pass"])
