            "fixture_hash": "mixed-external-fixture",
            "fixture_contract": {
                "observable_outputs": ["return_code"],
                "cases": [],
            },
        }
        with tempfile.TemporaryDirectory(prefix="auto-migrate-mixed-compile-only-replay-") as tmp:
            evidence_dir = Path(tmp)
            (evidence_dir / "l3-mixed-external-rust-draft.rs").write_text(
                """\
fn FDB_INFO() { unimplemented!("compile-only external callee") }
pub fn mixed_external() -> i32 {
    FDB_INFO();
    7i32
}
""",
                encoding="utf-8",
            )
            (evidence_dir / "l3-mixed-external-rust-replay-test-draft.rs").write_text(
                """\
#[test]
fn replay_mixed_external_fixture_contract() {
    assert_eq!(mixed_external(), 7i32);
}
""",
                encoding="utf-8",
            )
            (evidence_dir / "l3-mixed-external-auto-translation-plan.json").write_text(
                json.dumps({"translation_summary": {"translation_rule_ids": ["clang-lowered-typed-ir"]}}),
                encoding="utf-8",
            )
            replay = {
                "schema_version": 1,
                "status": "recorded",
                "generated_draft_replay_pass": False,
                "generated_draft_semantic_pass": False,
            }

            skipped_replay = module.run_generated_rust_replay(
                spec,
                evidence_dir,
                replay,
                {
                    "status": "passed",
                    "rust_check_harness_only_bindings": {
                        "status": "emitted",
                        "allowed_use": "mixed",
                        "semantics_verified": False,
                        "bindings": [
                            {
                                "name": "FDB_INFO",
                                "status": "generated_compile_only",
                                "allowed_use": "rustc_compile_only",
                                "signature": "fn FDB_INFO() -> ()",
                                "semantics_verified": False,
