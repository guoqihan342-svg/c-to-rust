                item["name"]: item
                for item in module.rust_check_external_binding_report(context)["bindings"]
            }
            self.assertEqual(bindings["FDB_INFO"]["status"], "generated_compile_only")
            self.assertEqual(bindings["FDB_INFO"]["allowed_use"], "rustc_compile_only")
            self.assertFalse(bindings["FDB_INFO"]["semantics_verified"])

    def test_mixed_generated_compile_only_external_binding_skips_replay(self) -> None:
        module = load_auto_migrate_module()
        spec = {
            "schema_version": 1,
            "target_id": "otherdb",
