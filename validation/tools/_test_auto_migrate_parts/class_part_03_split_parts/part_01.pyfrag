            draft_path.write_text(
                """\
pub fn delete_key(crc: u32, buf: &'static [u8], size: usize) -> u32 {
    let _ = (crc, buf, size);
    LOG_INFO(b"ignored\\0".as_ptr().cast::<core::ffi::c_char>());
    7u32
}
""",
                encoding="utf-8",
            )
            (evidence_dir / "l3-void-log-replay-contract-auto-translation-plan.json").write_text(
                json.dumps({"translation_summary": {"translation_rule_ids": ["clang-lowered-typed-ir"]}}),
