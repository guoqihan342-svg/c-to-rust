    def test_declared_external_callees_accept_project_agnostic_opaque_signatures(self) -> None:
        module = load_auto_migrate_module()
        spec = {
            "target_id": "otherdb",
            "slice_id": "opaque-set",
            "function_name": "opaque_set",
            "fixture_hash": "opaque-set-fixture",
            "c_boundary": {
                "direct_dependencies": [
                    {"kind": "callee", "name": "otherdb_set_blob"},
                    {"kind": "callee", "name": "otherdb_del"},
                ],
                "signatures": [
                    {
                        "id": "sig-otherdb-set-blob",
                        "role": "external_direct_callee",
                        "function": "otherdb_set_blob",
                        "return_type": "other_err_t",
                        "definition_status": "real_source_bound",
                        "source_ref": "src/otherdb.c#otherdb_set_blob",
                        "parameters": [
                            {"name": "db", "c_type": "otherdb_t"},
                            {"name": "key", "c_type": "const char*"},
                            {"name": "blob", "c_type": "other_blob_t"},
                        ],
                    },
                    {
                        "id": "sig-otherdb-del",
                        "role": "external_direct_callee",
                        "function": "otherdb_del",
                        "return_type": "other_err_t",
                        "definition_status": "real_source_bound",
                        "source_ref": "src/otherdb.c#otherdb_del",
                        "parameters": [
                            {"name": "db", "c_type": "otherdb_t"},
                            {"name": "key", "c_type": "const char*"},
                        ],
                    },
                ],
            },
        }

        context = module.external_direct_callee_context(spec, None)

        self.assertEqual(context["status"], "recorded")
        self.assertEqual(context["declared_count"], 2)
        self.assertEqual(context["blocked_count"], 0)
        declared = {item["name"]: item for item in context["declared"]}
        for name in ("otherdb_set_blob", "otherdb_del"):
            self.assertEqual(declared[name]["stub_kind"], "compile_only")
            self.assertEqual(
                declared[name]["stub_boundary"],
                "declared_external_direct_callee_context_only",
            )
            self.assertEqual(
                declared[name]["stub_generation"],
                "not_emitted_declared_signature_context",
            )
            self.assertEqual(declared[name]["return_rust_type"], "i32")
            self.assertEqual(declared[name]["unsupported_reasons"], [])
        self.assertEqual(
            declared["otherdb_set_blob"]["parameters"][0]["rust_type"],
            "*mut core::ffi::c_void",
        )
        self.assertEqual(
            declared["otherdb_set_blob"]["parameters"][1]["rust_type"],
            "*const core::ffi::c_char",
        )
        self.assertEqual(
            declared["otherdb_set_blob"]["parameters"][2]["rust_type"],
            "*mut core::ffi::c_void",
        )

