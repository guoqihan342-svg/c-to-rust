                route["candidate_generation"]["typed_ir"]["rust_draft_sha256"],
            )
            self.assertEqual(final["generated_draft_acceptance"], acceptance)
            self.assertTrue(replay["generated_draft_replay_pass"])
            self.assertTrue(replay["generated_draft_semantic_pass"])
            self.assertEqual(replay["evidence_links"]["rust_draft"]["status"], "accepted_after_gates")
            self.assertIn("let actual = call_expression_chain(case.input_value);", replay_draft)
            self.assertIn('assert_eq!(actual, case.return_value, "{} return_value drifted", case.id);', replay_draft)
            self.assertIn('assert_eq!(case.status, "ok", "{} fixture status drifted", case.id);', replay_draft)
            self.assertEqual(rust_report["status"], "passed")
            self.assertTrue(rust_report["semantic_pass"])
            self.assertTrue(capability["capability_delta"][0]["semantic_pass"])

            validation = subprocess.run(
                [
                    sys.executable,
                    str(VALIDATOR),
                    "--target-id",
                    "demo",
                    "--slice-id",
                    "call-expression",
                    "--slice-spec",
                    str(spec_path),
                    "--evidence-root",
                    str(out_root),
                    "--require-semantic-pass",
                ],
                cwd=REPO_ROOT,
                text=True,
                capture_output=True,
            )
            self.assertEqual(
                validation.returncode,
                0,
                f"stdout:\n{validation.stdout}\nstderr:\n{validation.stderr}",
            )

    def test_store_add_one_generated_replay_accepts_exact_out0_draft(self) -> None:
        spec_path = REPO_ROOT / "validation" / "slice-specs" / "demo-store-add-one.json"
        with tempfile.TemporaryDirectory(prefix="auto-migrate-store-add-one-") as tmp:
            out_root = Path(tmp) / "evidence"

            result = subprocess.run(
                [
                    sys.executable,
                    str(AUTO_MIGRATE),
                    "--slice-spec",
                    str(spec_path),
                    "--out-root",
                    str(out_root),
                    "--emit-clang-lowering-report",
                    "--accept-existing-evidence",
                ],
                cwd=REPO_ROOT,
                text=True,
                capture_output=True,
            )

            self.assertEqual(
                result.returncode,
                0,
                f"stdout:\n{result.stdout}\nstderr:\n{result.stderr}",
            )
            manifest = json.loads(result.stdout)
            evidence_dir = out_root / "demo" / "auto-translation" / "store-add-one"
            prefix = "l3-store-add-one"
            route = json.loads((evidence_dir / f"{prefix}-route-decision.json").read_text(encoding="utf-8"))
            profile = json.loads((evidence_dir / f"{prefix}-validation-profile.json").read_text(encoding="utf-8"))
            final = json.loads((evidence_dir / f"{prefix}-final-verification.json").read_text(encoding="utf-8"))
            replay = json.loads((evidence_dir / f"{prefix}-test-translation-generated.json").read_text(encoding="utf-8"))
            rust_report = json.loads((evidence_dir / f"{prefix}-rust-report.json").read_text(encoding="utf-8"))
            capability = json.loads((evidence_dir / f"{prefix}-capability-delta.json").read_text(encoding="utf-8"))
            replay_draft = (evidence_dir / f"{prefix}-rust-replay-test-draft.rs").read_text(encoding="utf-8")

            self.assertEqual(manifest["status"], "accepted_evidence_bound")
            self.assertEqual(route["candidate_generation"]["typed_ir"]["status"], "generated")
            self.assertTrue(route["candidate_generation"]["typed_ir"]["rust_draft_generated"])
            self.assertTrue(profile["generated_draft_semantic_pass"])
            self.assertTrue(final["generated_draft_semantic_pass"])
            self.assertTrue(manifest["claim_boundary"]["generated_draft_semantic_pass"])
            acceptance = profile["generated_draft_acceptance"]
            self.assertEqual(acceptance["status"], "passed")
            self.assertTrue(acceptance["generated_draft_semantic_pass"])
            self.assertEqual(
                acceptance["rust_draft"]["sha256"],
                route["candidate_generation"]["typed_ir"]["rust_draft_sha256"],
            )
            self.assertEqual(final["generated_draft_acceptance"], acceptance)
            self.assertTrue(replay["generated_draft_replay_pass"])
            self.assertTrue(replay["generated_draft_semantic_pass"])
            self.assertEqual(replay["evidence_links"]["rust_draft"]["status"], "accepted_after_gates")
            self.assertIn("let mut out = [0i32; 1];", replay_draft)
            self.assertIn("let actual = store_add_one(case.value, &mut out);", replay_draft)
            self.assertIn('assert_eq!(actual, case.return_code, "{} return_code drifted", case.id);', replay_draft)
            self.assertIn('assert_eq!(out[0], case.out0, "{} out0 drifted", case.id);', replay_draft)
            self.assertEqual(rust_report["status"], "passed")
            self.assertTrue(rust_report["semantic_pass"])
            self.assertTrue(capability["capability_delta"][0]["semantic_pass"])

            validation = subprocess.run(
                [
                    sys.executable,
                    str(VALIDATOR),
                    "--target-id",
                    "demo",
                    "--slice-id",
                    "store-add-one",
                    "--slice-spec",
                    str(spec_path),
                    "--evidence-root",
                    str(out_root),
                    "--require-semantic-pass",
                ],
                cwd=REPO_ROOT,
                text=True,
                capture_output=True,
            )
            self.assertEqual(
                validation.returncode,
                0,
                f"stdout:\n{validation.stdout}\nstderr:\n{validation.stderr}",
            )
