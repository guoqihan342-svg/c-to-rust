    r"/mnt/[A-Za-z]/[^\s\"'`,;)]*|"
    r"/home/[^\s\"'`,;)]*|/Users/[^\s\"'`,;)]*|/tmp/[^\s\"'`,;)]*|/var/[^\s\"'`,;)]*|"
    r"\\\\wsl\$\\[^\s\"'`,;)]*|"
