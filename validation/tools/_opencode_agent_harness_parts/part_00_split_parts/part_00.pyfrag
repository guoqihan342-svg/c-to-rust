    r"/mnt/[A-Za-z]/[^\s\"'`,;)]*|"
    r"/home/[^\s\"'`,;)]*|/Users/[^\s\"'`,;)]*|/tmp/[^\s\"'`,;)]*|/var/[^\s\"'`,;)]*|"
    r"\\\\wsl\$\\[^\s\"'`,;)]*|"
    r"//wsl\$/[^\s\"'`,;)]*|"
    r"\\\\wsl\.localhost\\[^\s\"'`,;)]*|"
    r"//wsl\.localhost/[^\s\"'`,;)]*"
    r")"
)
OPENCODE_WORKER_EVIDENCE_FIELDS = (
