def validate_replay_call_plan_v2(plan: dict[str, Any]) -> None:
    if not isinstance(plan, dict) or plan.get("schema_version") != 2 or plan.get("status") != "bound":
        raise ValueError("ReplayCallPlan v2 must be bound")
    _identifier(plan.get("source_function_name"), "source function")
    _identifier(plan.get("api_name"), "Rust API")
    if plan.get("visibility") not in {"pub", "pub(crate)", "private"}:
        raise ValueError("ReplayCallPlan v2 visibility is invalid")
    if plan.get("abi") not in {"Rust", "C"} or not isinstance(plan.get("unsafe"), bool):
        raise ValueError("ReplayCallPlan v2 ABI or unsafe policy is invalid")
    return_type = _rust_type(plan.get("return_type"), "return type")
    bindings = _normalize_bindings(plan.get("bindings"))
    if bindings != plan.get("bindings"):
        raise ValueError("ReplayCallPlan v2 bindings are not canonical")
    binding_by_name = {item["name"]: item for item in bindings}
    if len(binding_by_name) != len(bindings):
        raise ValueError("ReplayCallPlan v2 binding names are duplicated")
    supporting_types = _normalize_supporting_types(plan.get("supporting_types"))
    if supporting_types != plan.get("supporting_types"):
        raise ValueError("ReplayCallPlan v2 supporting types are not canonical")

    parameters = plan.get("parameters")
    call_args = plan.get("call_args")
    if not isinstance(parameters, list) or not isinstance(call_args, list):
        raise ValueError("ReplayCallPlan v2 parameters are invalid")
    normalized_parameters: list[dict[str, Any]] = []
    for position, item in enumerate(parameters):
        if not isinstance(item, dict) or item.get("position") != position:
            raise ValueError("ReplayCallPlan v2 parameter order is invalid")
        name = _identifier(item.get("name"), "Rust parameter")
        source = _normalize_binding_source(item.get("source"), binding_by_name)
        rust_type = _rust_type(item.get("rust_type"), "parameter type")
        if source.get("encoding") == "i32_slice" and rust_type != "&[i32]":
            raise ValueError("ReplayCallPlan v2 i32 slice parameter type is invalid")
        normalized_parameters.append(
            {
                "position": position,
                "name": name,
                "rust_type": rust_type,
                "c_parameter": _identifier(item.get("c_parameter"), "C parameter"),
                "length_retained": item.get("length_retained"),
                "source": source,
            }
        )
        if not isinstance(item.get("length_retained"), bool):
            raise ValueError("ReplayCallPlan v2 length retention is invalid")
    if normalized_parameters != parameters:
        raise ValueError("ReplayCallPlan v2 parameters are not canonical")
    if call_args != [
        {"position": item["position"], "parameter": item["name"], "source": item["source"]}
        for item in parameters
    ]:
        raise ValueError("ReplayCallPlan v2 call arguments drifted")
    identity_assertions = plan.get("identity_assertions")
    if identity_assertions is not None:
        normalized_identity_assertions = _normalize_identity_assertions(
            identity_assertions, binding_by_name, return_type
        )
        if normalized_identity_assertions != identity_assertions:
            raise ValueError("ReplayCallPlan v2 identity assertions are not canonical")
        _validate_identity_borrow(
            normalized_identity_assertions[0], parameters, return_type
        )
    pointer_identity_assertions = plan.get("pointer_identity_assertions")
    normalized_pointer_identity_assertions = None
    if pointer_identity_assertions is not None:
        normalized_pointer_identity_assertions = _normalize_pointer_identity_assertions(
            pointer_identity_assertions, binding_by_name, parameters
        )
        if normalized_pointer_identity_assertions != pointer_identity_assertions:
            raise ValueError("ReplayCallPlan v2 pointer identity assertions are not canonical")
    buffer_length_relations = plan.get("buffer_length_relations")
    normalized_buffer_length_relations = None
    if buffer_length_relations is not None:
        normalized_buffer_length_relations = _normalize_buffer_length_relations(
            buffer_length_relations, binding_by_name, parameters
        )
        if normalized_buffer_length_relations != buffer_length_relations:
            raise ValueError("ReplayCallPlan v2 buffer length relations are not canonical")
    _validate_buffer_capability_closure(
        bindings,
        parameters,
        normalized_pointer_identity_assertions,
        normalized_buffer_length_relations,
    )
    _validate_mappings(plan.get("c_parameter_mappings"), parameters)
    if plan.get("omitted_c_parameters") != []:
        raise ValueError("ReplayCallPlan v2 omitted C parameters are unsupported")
    expected_lengths = [item["name"] for item in parameters if item["length_retained"]]
    if plan.get("length_parameters_retained") != expected_lengths:
        raise ValueError("ReplayCallPlan v2 retained lengths drifted")
    pairs = _normalize_pairs(plan.get("distinct_mutable_bindings"), "distinct mutable bindings")
    if pairs != plan.get("distinct_mutable_bindings"):
        raise ValueError("ReplayCallPlan v2 distinct bindings are not canonical")
    for left, right in pairs:
        if left not in binding_by_name or right not in binding_by_name or left == right:
            raise ValueError("ReplayCallPlan v2 distinct binding is invalid")

    scripted_runtime = plan.get("scripted_runtime")
    if scripted_runtime is not None:
        normalized_runtime = _normalize_scripted_runtime(scripted_runtime)
        if normalized_runtime != scripted_runtime:
            raise ValueError("ReplayCallPlan v2 scripted runtime is not canonical")
    fixture_assertions = plan.get("fixture_assertions")
    if fixture_assertions is not None:
        normalized_fixture_assertions = _normalize_v2_fixture_assertions(
            fixture_assertions
        )
        if normalized_fixture_assertions != fixture_assertions:
            raise ValueError("ReplayCallPlan v2 fixture assertions are not canonical")
    fixture_relations = plan.get("fixture_relations")
    if fixture_relations is not None:
        normalized_fixture_relations = _normalize_fixture_relations(fixture_relations)
        if normalized_fixture_relations != fixture_relations:
            raise ValueError("ReplayCallPlan v2 fixture relations are not canonical")

    assertions = _normalize_assertions(plan.get("assertions"), binding_by_name)
    if assertions != plan.get("assertions"):
        raise ValueError("ReplayCallPlan v2 assertions are not canonical")
    if supporting_types != _supporting_types_from_bindings(bindings):
        raise ValueError("ReplayCallPlan v2 supporting types drifted from initializers")
    _validate_fixture_identity(plan.get("fixture"))
    if not re.fullmatch(r"[0-9a-f]{64}", str(plan.get("plan_sha256") or "")):
        raise ValueError("ReplayCallPlan v2 sha256 is invalid")
    if _plan_sha256(plan) != plan["plan_sha256"]:
        raise ValueError("ReplayCallPlan v2 sha256 drifted")


def render_replay_call_plan_v2(plan: dict[str, Any], cases: list[dict[str, Any]]) -> str:
    validate_replay_call_plan_v2(plan)
    if [item["id"] for item in cases] != plan["fixture"]["case_ids"]:
        raise ValueError("ReplayCallPlan v2 fixture identities drifted")
    lines: list[str] = []
    for index, case in enumerate(cases):
        case_ident = _safe_ident(case["id"])
        inputs = _case_input_values(case)
        local_names: dict[str, str] = {}
        lines.append("    {\n")
        lines.append(f"        let case_id = {json.dumps(case['id'])};\n")
        runtime = plan.get("scripted_runtime")
        if isinstance(runtime, dict):
            lines.append("        // Fixture-only scripted callee controls; callee semantics are not verified.\n")
            for stimulus in runtime["stimuli"]:
                literal = _scripted_stimulus_literal(stimulus, inputs)
                helper = _scripted_runtime_helper(stimulus["channel"], stimulus["kind"])
                lines.append(f"        {helper}({literal});\n")
            for channel in runtime["reset_channels"]:
                helper = _scripted_runtime_helper(channel, "reset")
                lines.append(f"        {helper}();\n")
        for binding in plan["bindings"]:
            local_name = f"actual_{case_ident}_{index}_{binding['name']}"
            local_names[binding["name"]] = local_name
            mutable = "mut " if binding["mutable"] else ""
            literal = _initializer_literal(binding["initializer"], inputs)
            lines.append(f"        let {mutable}{local_name}: {binding['rust_type']} = {literal};\n")
        expected_buffer_pointers: dict[int, str] = {}
        for pointer_index, assertion in enumerate(plan.get("pointer_identity_assertions", [])):
            parameter = next(
                item for item in plan["parameters"]
                if item["name"] == assertion["expected_parameter"]
            )
            pointer_name = f"expected_pointer_identity_{case_ident}_{index}_{pointer_index}"
            pointer_expression = _nullable_buffer_pointer_expression(
                parameter["source"], local_names, inputs
            )
            lines.append(
                f"        let {pointer_name}: *const core::ffi::c_void = {pointer_expression};\n"
            )
            expected_buffer_pointers[pointer_index] = pointer_name
        for relation in plan.get("buffer_length_relations", []):
            lines.append(
                _render_buffer_length_relation(
                    relation, plan["parameters"], local_names, inputs, case["id"]
                )
            )
        identity = (plan.get("identity_assertions") or [None])[0]
        expected_identity_pointer = None
        if isinstance(identity, dict):
            binding_name = identity["expected_binding"]
            binding = next(item for item in plan["bindings"] if item["name"] == binding_name)
            expected_identity_pointer = f"expected_identity_{case_ident}_{index}"
            pointer_type = (
                f"*mut {binding['rust_type']}"
                if identity["mutability"] == "mutable"
                else f"*const {binding['rust_type']}"
            )
            pointer_constructor = (
                f"core::ptr::from_mut(&mut {local_names[binding_name]})"
                if identity["mutability"] == "mutable"
                else f"core::ptr::from_ref(&{local_names[binding_name]})"
            )
            lines.append(
                f"        let {expected_identity_pointer}: {pointer_type} = {pointer_constructor};\n"
            )
        arguments = [
            _binding_argument(item["source"], local_names, inputs)
            for item in plan["parameters"]
        ]
        call = f"{plan['api_name']}({', '.join(arguments)})"
        if plan["unsafe"]:
            call = f"unsafe {{ {call} }}"
        lines.append(f"        let actual_return: {plan['return_type']} = {call};\n")
        if isinstance(identity, dict):
            expected = _identity_fixture_expected(identity, case)
            actual_identity = f"actual_identity_{case_ident}_{index}"
            actual_pointer = (
                "core::ptr::from_mut(actual_return)"
                if identity["mutability"] == "mutable"
                else "core::ptr::from_ref(actual_return)"
            )
            lines.append(
                f"        let {actual_identity}: bool = core::ptr::eq({actual_pointer}, {expected_identity_pointer});\n"
            )
            lines.append(
                f"        assert_eq!({actual_identity}, {expected}, \"{{}} {identity['fixture_field']} drifted\", case_id);\n"
            )
        for pointer_index, assertion in enumerate(plan.get("pointer_identity_assertions", [])):
            expected = case.get("expected")
            if (
                not isinstance(expected, dict)
                or expected.get(assertion["fixture_field"]) != assertion["expected_parameter"]
            ):
                raise ValueError("ReplayCallPlan v2 pointer identity fixture drifted")
            actual = _actual_expression(assertion["actual"], local_names)
            observed = f"observed_pointer_identity_{case_ident}_{index}_{pointer_index}"
            lines.append(
                f"        let {observed}: bool = core::ptr::eq(({actual}).cast_const(), "
                f"{expected_buffer_pointers[pointer_index]});\n"
            )
            lines.append(
                f"        assert_eq!({observed}, true, \"{{}} {assertion['fixture_field']} drifted\", case_id);\n"
            )
        for assertion_index, assertion in enumerate(plan["assertions"]):
            actual = _actual_expression(assertion["actual"], local_names)
            observed = f"observed_{case_ident}_{index}_{assertion_index}"
            expected = _encoded_literal(case["expected"][assertion["fixture_field"]], assertion["encoding"])
            lines.append(f"        let {observed}: {assertion['rust_type']} = {actual};\n")
            lines.append(
                f"        assert_eq!({observed}, {expected}, \"{{}} {assertion['fixture_field']} drifted\", case_id);\n"
            )
        for assertion in plan.get("fixture_assertions", []):
            actual = _encoded_literal(
                case["expected"][assertion["fixture_field"]], assertion["encoding"]
            )
            expected = _encoded_literal(assertion["expected"], assertion["encoding"])
            lines.append(
                f"        assert_eq!({actual}, {expected}, \"{{}} {assertion['fixture_field']} metadata drifted\", case_id);\n"
            )
        for relation in plan.get("fixture_relations", []):
            left, right = _fixture_relation_literals(relation, case)
            lines.append(
                f"        assert_eq!({left}, {right}, \"{{}} fixture relation {relation['kind']} drifted\", case_id);\n"
            )
        if isinstance(runtime, dict):
            for probe_index, probe in enumerate(runtime["probes"]):
                observed = f"observed_probe_{case_ident}_{index}_{probe_index}"
                expected = _scripted_probe_expected_literal(probe, case["expected"])
                helper = _scripted_runtime_helper(probe["channel"], probe["kind"])
                lines.append(
                    f"        let {observed}: {probe['rust_type']} = {helper}();\n"
                )
                label = ",".join(_scripted_expected_fields(probe["expected"]))
                lines.append(
                    f"        assert_eq!({observed}, {expected}, \"{{}} {label} drifted\", case_id);\n"
                )
        lines.append("    }\n")
    return "".join(lines)


def _matching_signature(spec: dict[str, Any], function_name: str) -> dict[str, Any]:
    signatures = spec.get("c_boundary", {}).get("signatures")
    matches = [
        item for item in signatures or [] if isinstance(item, dict) and item.get("function") == function_name
    ]
    if len(matches) != 1:
        raise ValueError("record constant-state requires exactly one matching C signature")
    return matches[0]


def _public_api_name(spec: dict[str, Any]) -> str:
    entries = [
        item for item in spec.get("rust_boundary", {}).get("public_api") or [] if isinstance(item, dict)
    ]
    if len(entries) != 1:
        raise ValueError("record constant-state requires exactly one Rust public API")
    return _identifier(entries[0].get("name"), "Rust API")


def _normalize_initializer(value: Any, types: dict[str, dict[str, Any]]) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValueError("record initializer must be an object")
    rust_type = _identifier(value.get("record_type"), "record initializer type")
    fields = value.get("fields")
    if not isinstance(fields, list) or not fields:
        raise ValueError("record initializer fields are required")
    normalized_fields: list[dict[str, Any]] = []
    type_fields: list[dict[str, str]] = []
    for field in fields:
        if not isinstance(field, dict):
            raise ValueError("record initializer field must be an object")
        name = _identifier(field.get("name"), "record field")
        if isinstance(field.get("record"), dict):
            child = _normalize_initializer(field["record"], types)
            field_value = child
            field_type = child["rust_type"]
        else:
            fixture_field = _identifier(field.get("fixture_field"), "initializer fixture field")
            field_type = _rust_type(field.get("rust_type"), "initializer field type")
            if field_type not in {"u32", "usize", "bool"}:
                raise ValueError("record-state initializer leaf type is unsupported")
            field_value = {
                "kind": "fixture_field",
                "field": fixture_field,
                "encoding": field_type,
            }
        normalized_fields.append({"name": name, "value": field_value})
        type_fields.append({"name": name, "rust_type": field_type})
    names = [item["name"] for item in normalized_fields]
    if len(names) != len(set(names)):
        raise ValueError("record initializer fields must be unique")
    type_contract = {"kind": "struct", "name": rust_type, "visibility": "pub", "fields": type_fields}
    if rust_type in types and types[rust_type] != type_contract:
        raise ValueError("record supporting type definitions conflict")
    types[rust_type] = type_contract
    return {"kind": "struct", "rust_type": rust_type, "fields": normalized_fields}


def _initializer_paths(value: dict[str, Any], prefix: tuple[str, ...] = ()) -> set[tuple[str, ...]]:
    result: set[tuple[str, ...]] = set()
    for field in value["fields"]:
        path = (*prefix, field["name"])
        if field["value"]["kind"] == "struct":
            result.update(_initializer_paths(field["value"], path))
        else:
            result.add(path)
    return result


def _initializer_type_at_path(value: Any, path: tuple[str, ...]) -> str:
    if not isinstance(value, dict) or not path:
        raise ValueError("record interior initializer path is invalid")
    fields = value.get("fields")
    if not isinstance(fields, list):
        raise ValueError("record interior initializer fields are missing")
    field = next(
        (item for item in fields if isinstance(item, dict) and item.get("name") == path[0]),
        None,
    )
    if field is None or not isinstance(field.get("record"), dict):
        raise ValueError("record interior projection does not select a nested record")
    if len(path) == 1:
        return _identifier(field["record"].get("record_type"), "projected record type")
    return _initializer_type_at_path(field["record"], path[1:])


def _legacy_initializer_paths(
    value: Any, prefix: tuple[str, ...] = ()
) -> set[tuple[str, ...]]:
    if not isinstance(value, dict) or not isinstance(value.get("fields"), list):
        raise ValueError("record initializer fields are missing")
    result: set[tuple[str, ...]] = set()
    for field in value["fields"]:
        if not isinstance(field, dict):
            raise ValueError("record initializer field is invalid")
        name = _identifier(field.get("name"), "record initializer field")
        path = (*prefix, name)
        if isinstance(field.get("record"), dict):
            result.update(_legacy_initializer_paths(field["record"], path))
        else:
            result.add(path)
    return result


def _normalize_bindings(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value:
        raise ValueError("ReplayCallPlan v2 bindings are required")
    types: dict[str, dict[str, Any]] = {}
    result = []
    for item in value:
        if not isinstance(item, dict):
            raise ValueError("ReplayCallPlan v2 binding is invalid")
        rust_type = _rust_type(item.get("rust_type"), "binding type")
        initializer = _normalize_plan_initializer(item.get("initializer"), types)
        if initializer["kind"] in {
            "constant_scalar",
            "null_pointer",
            "optional_non_null_none",
            "owned_string",
            "fixture_enum_constant",
        }:
            raise ValueError("ReplayCallPlan v2 initializer leaf cannot be a binding root")
        if rust_type != initializer["rust_type"]:
            if initializer["kind"] == "vec_repeat":
                raise ValueError("ReplayCallPlan v2 vector binding type is invalid")
            raise ValueError("ReplayCallPlan v2 binding initializer type is invalid")
        result.append(
            {
                "name": _identifier(item.get("name"), "binding"),
                "rust_type": rust_type,
                "mutable": item.get("mutable"),
                "initializer": initializer,
            }
        )
        if not isinstance(item.get("mutable"), bool):
            raise ValueError("ReplayCallPlan v2 binding mutability is invalid")
    return result


def _normalize_plan_initializer(value: Any, types: dict[str, dict[str, Any]]) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValueError("ReplayCallPlan v2 initializer must be an object")
    if value.get("kind") == "owned_string":
        return _normalize_owned_string_initializer(value)
    if value.get("kind") == "fixture_enum_constant":
        return _normalize_fixture_enum_constant_initializer(value)
    if value.get("kind") == "nullable_byte_buffer":
        return _normalize_nullable_byte_buffer_initializer(value)
    if value.get("kind") == "array_repeat":
        length = value.get("length")
        scalar = value.get("value")
        if (
            value.get("element_type") not in {"u32", "i32"}
            or not isinstance(length, int)
            or not 1 <= length <= 32
            or not _value_matches(scalar, value.get("element_type"))
            or value.get("rust_type") != f"[{value.get('element_type')}; {length}]"
        ):
            raise ValueError("ReplayCallPlan v2 array initializer is invalid")
        return {
            "kind": "array_repeat",
            "rust_type": value["rust_type"],
            "element_type": value["element_type"],
            "length": length,
            "value": scalar,
        }
    if value.get("kind") == "vec_repeat":
        length = value.get("length")
        if (
            value.get("rust_type") != "Vec<i32>"
            or value.get("element_type") != "i32"
            or not _is_i32(value.get("value"))
            or not isinstance(length, dict)
            or length.get("kind") != "fixture_field"
            or length.get("encoding") != "i32"
            or not isinstance(length.get("maximum"), int)
            or isinstance(length.get("maximum"), bool)
            or not 1 <= length["maximum"] <= 4096
        ):
            raise ValueError("ReplayCallPlan v2 vector initializer is invalid")
        return {
            "kind": "vec_repeat",
            "rust_type": "Vec<i32>",
            "element_type": "i32",
            "length": {
                "kind": "fixture_field",
                "field": _identifier(length.get("field"), "vector length fixture field"),
                "encoding": "i32",
                "maximum": length["maximum"],
            },
            "value": value["value"],
        }
    if value.get("kind") == "constant_scalar":
        encoding = value.get("encoding")
        rust_type = value.get("rust_type")
        scalar = value.get("value")
        if (
            encoding not in SCALAR_INITIALIZER_ENCODINGS
            or rust_type != encoding
            or not _value_matches(scalar, encoding)
        ):
            raise ValueError("ReplayCallPlan v2 constant scalar initializer is invalid")
        return {
            "kind": "constant_scalar",
            "rust_type": rust_type,
            "encoding": encoding,
            "value": scalar,
        }
    if value.get("kind") == "null_pointer":
        mutability = value.get("mutability")
        rust_type = value.get("rust_type")
        if NULL_POINTER_RUST_TYPES.get(mutability) != rust_type:
            raise ValueError("ReplayCallPlan v2 null pointer initializer is invalid")
        return {
            "kind": "null_pointer",
            "rust_type": rust_type,
            "mutability": mutability,
        }
    if value.get("kind") == "optional_non_null_none":
        rust_type = value.get("rust_type")
        if (
            set(value) != {"kind", "rust_type"}
            or rust_type != "Option<core::ptr::NonNull<core::ffi::c_void>>"
        ):
            raise ValueError("ReplayCallPlan v2 optional non-null initializer is invalid")
        return {
            "kind": "optional_non_null_none",
            "rust_type": rust_type,
        }
    if value.get("kind") != "struct":
        raise ValueError("ReplayCallPlan v2 initializer kind is unsupported")
    rust_type = _identifier(value.get("rust_type"), "initializer type")
    fields = value.get("fields")
    if not isinstance(fields, list) or not fields:
        raise ValueError("ReplayCallPlan v2 initializer fields are required")
    normalized = []
    type_fields = []
    for item in fields:
        if not isinstance(item, dict):
            raise ValueError("ReplayCallPlan v2 initializer field is invalid")
        name = _identifier(item.get("name"), "initializer field")
        child = item.get("value")
        if isinstance(child, dict) and child.get("kind") in {
            "struct",
            "constant_scalar",
            "null_pointer",
            "optional_non_null_none",
            "owned_string",
            "fixture_enum_constant",
        }:
            child_value = _normalize_plan_initializer(child, types)
            child_type = child_value["rust_type"]
        elif isinstance(child, dict) and child.get("kind") == "fixture_field":
            if child.get("encoding") not in {"u32", "usize", "bool"}:
                raise ValueError("ReplayCallPlan v2 fixture initializer encoding is invalid")
            child_value = {
                "kind": "fixture_field",
                "encoding": child["encoding"],
            }
            has_field = "field" in child
            has_path = "path" in child
            if has_field == has_path:
                raise ValueError("ReplayCallPlan v2 fixture initializer reference is invalid")
            if has_field:
                child_value["field"] = _fixture_key(
                    child.get("field"), "fixture initializer field"
                )
            else:
                child_value["path"] = _fixture_path(
                    child.get("path"), "fixture initializer path"
                )
            child_type = child["encoding"]
        else:
            raise ValueError("ReplayCallPlan v2 initializer value is invalid")
        normalized.append({"name": name, "value": child_value})
        type_fields.append({"name": name, "rust_type": child_type})
    type_contract = {"kind": "struct", "name": rust_type, "visibility": "pub", "fields": type_fields}
    if rust_type in types and types[rust_type] != type_contract:
        raise ValueError("ReplayCallPlan v2 initializer type definitions conflict")
    types[rust_type] = type_contract
    return {"kind": "struct", "rust_type": rust_type, "fields": normalized}


def _normalize_supporting_types(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        raise ValueError("ReplayCallPlan v2 supporting types must be an array")
    result = []
    for item in value:
        if not isinstance(item, dict) or item.get("kind") != "struct":
            raise ValueError("ReplayCallPlan v2 supporting type is invalid")
        fields = item.get("fields")
        if not isinstance(fields, list) or not fields:
            raise ValueError("ReplayCallPlan v2 supporting fields are required")
        result.append(
            {
                "kind": "struct",
                "name": _identifier(item.get("name"), "supporting type"),
                "visibility": item.get("visibility"),
                "fields": [
                    {
                        "name": _identifier(field.get("name"), "supporting field"),
                        "rust_type": _rust_type(field.get("rust_type"), "supporting field type"),
                    }
                    for field in fields
                    if isinstance(field, dict)
                ],
            }
        )
        if item.get("visibility") not in {"pub", "pub(crate)", "private"} or len(result[-1]["fields"]) != len(fields):
            raise ValueError("ReplayCallPlan v2 supporting type drifted")
    return result


def _normalize_binding_source(value: Any, bindings: dict[str, dict[str, Any]]) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValueError("ReplayCallPlan v2 argument source is unsupported")
    kind = value.get("kind")
    if kind == "fixture_field" and value.get("encoding") in {
        "string_ref",
        "optional_string_ref",
    }:
        return _normalize_string_argument_source(value)
    if kind == "nullable_byte_buffer_const_ptr":
        return _normalize_buffer_pointer_source(value, bindings)
    if kind in {"binding_borrow", "binding_borrow_mut", "binding_value"}:
        binding = _identifier(value.get("binding"), "argument binding")
        if binding not in bindings:
            raise ValueError("ReplayCallPlan v2 binding source is invalid")
        if kind == "binding_borrow_mut" and bindings[binding]["mutable"] is not True:
            raise ValueError("ReplayCallPlan v2 mutable binding source is invalid")
        if kind in {"binding_borrow", "binding_value"} and bindings[binding]["mutable"] is not False:
            raise ValueError("ReplayCallPlan v2 value binding source is invalid")
        return {"kind": kind, "binding": binding}
    if kind == "fixture_field" and value.get("encoding") in {
        "u32",
        "i32",
        "usize",
        "bool",
        "i32_slice",
    }:
        result = {
            "kind": "fixture_field",
            "encoding": value["encoding"],
        }
        has_field = "field" in value
        has_path = "path" in value
        if has_field == has_path:
            raise ValueError("ReplayCallPlan v2 argument fixture reference is invalid")
        if has_field:
            result["field"] = _identifier(value.get("field"), "argument fixture field")
        else:
            result["path"] = _fixture_path(value.get("path"), "argument fixture path")
        return result
    raise ValueError("ReplayCallPlan v2 argument source is unsupported")


def _validate_mappings(value: Any, parameters: list[dict[str, Any]]) -> None:
    if not isinstance(value, list) or len(value) != len(parameters):
        raise ValueError("ReplayCallPlan v2 C mappings are invalid")
    for parameter, mapping in zip(parameters, value, strict=True):
        if (
            not isinstance(mapping, dict)
            or mapping.get("position") != parameter["position"]
            or mapping.get("c_parameter") != parameter["c_parameter"]
            or mapping.get("rust_parameter") != parameter["name"]
            or mapping.get("rust_type") != parameter["rust_type"]
            or not isinstance(mapping.get("c_type"), str)
            or not isinstance(mapping.get("direction"), str)
        ):
            raise ValueError("ReplayCallPlan v2 C mappings drifted")


def _normalize_assertions(value: Any, bindings: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value:
        raise ValueError("ReplayCallPlan v2 assertions are required")
    result = []
    fields: set[str] = set()
    for item in value:
        if not isinstance(item, dict) or not ACTUAL_RE.fullmatch(str(item.get("actual") or "")):
            raise ValueError("ReplayCallPlan v2 assertion actual is invalid")
        actual = item["actual"]
        if actual.startswith("binding."):
            parts = actual.split(".")
            binding = bindings.get(parts[1])
            if binding is None or not _binding_observation_exists(binding["initializer"], parts[2:]):
                raise ValueError("ReplayCallPlan v2 assertion binding path is invalid")
        encoding = item.get("encoding")
        if encoding not in {"u32", "i32", "usize", "bool", "i32_vec"}:
            raise ValueError("ReplayCallPlan v2 assertion encoding is unsupported")
        rust_type = _rust_type(item.get("rust_type"), "assertion type")
        if encoding == "i32_vec" and rust_type != "Vec<i32>":
            raise ValueError("ReplayCallPlan v2 i32 vector assertion type is invalid")
        if actual.startswith("binding.") and len(actual.split(".")) == 2:
            if encoding != "i32_vec" or rust_type != "Vec<i32>":
                raise ValueError("ReplayCallPlan v2 whole binding assertion type is invalid")
        fixture_field = _fixture_key(item.get("fixture_field"), "assertion fixture field")
        if fixture_field in fields:
            raise ValueError("ReplayCallPlan v2 assertion fixture fields must be unique")
        result.append(
            {
                "actual": actual,
                "fixture_field": fixture_field,
                "rust_type": rust_type,
                "encoding": encoding,
            }
        )
        fields.add(fixture_field)
    return result
