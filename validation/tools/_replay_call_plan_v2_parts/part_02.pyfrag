def _validate_fixture_cases(
    fixture: dict[str, Any],
    bindings: list[dict[str, Any]],
    parameters: list[dict[str, Any]],
    assertions: list[dict[str, Any]],
    *,
    expected_return: tuple[str, bool],
    expected_states: dict[str, int],
) -> None:
    if not isinstance(fixture.get("cases"), list) or not fixture["cases"]:
        raise ValueError("record constant-state fixture cases are required")
    input_fields = {
        field["value"]["field"]
        for binding in bindings
        for field in _leaf_fields(binding["initializer"])
        if field["value"]["kind"] == "fixture_field"
    }
    input_fields.update(
        item["source"]["field"]
        for item in parameters
        if item["source"]["kind"] == "fixture_field"
    )
    output_fields = {item["fixture_field"] for item in assertions}
    for case in fixture["cases"]:
        inputs = case.get("inputs")
        outputs = case.get("expected")
        if not isinstance(inputs, dict) or not isinstance(outputs, dict):
            raise ValueError("record constant-state fixture case is incomplete")
        if any(not _is_u32(inputs.get(field)) for field in input_fields):
            raise ValueError("record constant-state fixture input must be u32")
        if set(outputs) != output_fields:
            raise ValueError("record constant-state expected outputs drifted")
        if (
            outputs.get(expected_return[0]) is not expected_return[1]
            or any(
                not _is_u32(outputs.get(item["fixture_field"]))
                for item in assertions[1:]
            )
            or any(outputs.get(field) != value for field, value in expected_states.items())
        ):
            raise ValueError("record-state expected output types drifted")


def _validate_stats_fixture_cases(
    fixture: dict[str, Any],
    binding: dict[str, Any],
    assertions: list[dict[str, Any]],
    *,
    require_true_return: bool,
) -> None:
    cases = fixture.get("cases")
    if not isinstance(cases, list) or not cases:
        raise ValueError("record stats fixture cases are required")
    input_contracts = [
        (field["value"]["field"], field["value"]["encoding"])
        for field in _leaf_fields(binding["initializer"])
        if field["value"]["kind"] == "fixture_field"
    ]
    output_contracts = {
        item["fixture_field"]: item["encoding"] for item in assertions
    }
    return_field = assertions[0]["fixture_field"]
    for case in cases:
        inputs = case.get("inputs")
        outputs = case.get("expected")
        if not isinstance(inputs, dict) or not isinstance(outputs, dict):
            raise ValueError("record stats fixture case is incomplete")
        if any(not _value_matches(inputs.get(field), encoding) for field, encoding in input_contracts):
            raise ValueError("record stats fixture input type drifted")
        if set(outputs) != set(output_contracts) or any(
            not _value_matches(outputs.get(field), encoding)
            for field, encoding in output_contracts.items()
        ):
            raise ValueError("record stats expected output type drifted")
        if require_true_return and outputs.get(return_field) is not True:
            raise ValueError("record stats return value drifted")


def _leaf_fields(initializer: dict[str, Any]) -> list[dict[str, Any]]:
    result = []
    for field in initializer["fields"]:
        if field["value"]["kind"] == "struct":
            result.extend(_leaf_fields(field["value"]))
        else:
            result.append(field)
    return result


def _validate_fixture_identity(value: Any) -> None:
    if not isinstance(value, dict) or not isinstance(value.get("case_count"), int) or value["case_count"] < 1:
        raise ValueError("ReplayCallPlan v2 fixture binding is invalid")
    if not isinstance(value.get("path"), str) or not re.fullmatch(r"[0-9a-f]{64}", str(value.get("sha256") or "")):
        raise ValueError("ReplayCallPlan v2 fixture identity is invalid")
    case_ids = value.get("case_ids")
    if not isinstance(case_ids, list) or len(case_ids) != value["case_count"] or len(case_ids) != len(set(case_ids)):
        raise ValueError("ReplayCallPlan v2 fixture cases are invalid")
    if any(not isinstance(item, str) or not item for item in case_ids):
        raise ValueError("ReplayCallPlan v2 fixture case id is invalid")


def _initializer_literal(initializer: dict[str, Any], inputs: dict[str, Any]) -> str:
    if initializer["kind"] == "array_repeat":
        value = _encoded_literal(initializer["value"], initializer["element_type"])
        return f"[{value}; {initializer['length']}]"
    if initializer["kind"] == "vec_repeat":
        value = _encoded_literal(initializer["value"], "i32")
        length = initializer["length"]
        concrete_length = inputs.get(length["field"])
        if (
            not _is_i32(concrete_length)
            or concrete_length < 0
            or concrete_length > length["maximum"]
        ):
            raise ValueError("ReplayCallPlan v2 vector length fixture is out of bounds")
        return f"vec![{value}; {concrete_length}usize]"
    if initializer["kind"] == "constant_scalar":
        return _encoded_literal(initializer["value"], initializer["encoding"])
    if initializer["kind"] == "null_pointer":
        return (
            "core::ptr::null_mut()"
            if initializer["mutability"] == "mutable"
            else "core::ptr::null()"
        )
    fields = []
    for field in initializer["fields"]:
        value = field["value"]
        literal = (
            _encoded_literal(_fixture_initializer_value(value, inputs), value["encoding"])
            if value["kind"] == "fixture_field"
            else _initializer_literal(value, inputs)
        )
        fields.append(f"{field['name']}: {literal}")
    return f"{initializer['rust_type']} {{ " + ", ".join(fields) + " }"


def _fixture_initializer_value(reference: dict[str, Any], inputs: dict[str, Any]) -> Any:
    if "field" in reference:
        if reference["field"] not in inputs:
            raise ValueError("ReplayCallPlan v2 fixture initializer field is missing")
        return inputs[reference["field"]]
    current: Any = inputs
    for segment in reference["path"]:
        if not isinstance(current, dict) or segment not in current:
            raise ValueError("ReplayCallPlan v2 fixture initializer path is missing")
        current = current[segment]
    return current


def _binding_argument(
    source: dict[str, Any], names: dict[str, str], inputs: dict[str, Any]
) -> str:
    if source["kind"] == "binding_borrow_mut":
        return "&mut " + names[source["binding"]]
    if source["kind"] == "binding_borrow":
        return "&" + names[source["binding"]]
    if source["kind"] == "binding_value":
        return names[source["binding"]]
    if source["kind"] == "fixture_field":
        return _encoded_literal(inputs.get(source["field"]), source["encoding"])
    raise ValueError("ReplayCallPlan v2 argument source is unsupported")


def _actual_expression(actual: str, names: dict[str, str]) -> str:
    if actual == "return":
        return "actual_return"
    parts = actual.split(".")
    expression = names[parts[1]]
    for segment in parts[2:]:
        expression += f"[{segment}]" if segment.isdigit() else f".{segment}"
    return expression


def _encoded_literal(value: Any, encoding: str) -> str:
    if encoding == "u32" and _is_u32(value):
        return f"{value}u32"
    if encoding == "i32" and _is_i32(value):
        return f"{value}i32"
    if encoding == "usize" and _is_usize(value):
        return f"{value}usize"
    if encoding == "bool" and isinstance(value, bool):
        return "true" if value else "false"
    if encoding == "string" and isinstance(value, str):
        return json.dumps(value, ensure_ascii=True)
    if (
        encoding in {"i32_slice", "i32_vec"}
        and isinstance(value, list)
        and len(value) <= MAX_DYNAMIC_I32_ITEMS
        and all(_is_i32(item) for item in value)
    ):
        values = ", ".join(_encoded_literal(item, "i32") for item in value)
        if encoding == "i32_vec" and not value:
            return "vec![0i32; 0usize]"
        return ("&[" if encoding == "i32_slice" else "vec![") + values + "]"
    raise ValueError(f"value does not match ReplayCallPlan v2 encoding {encoding}")


def _normalize_fixture_relations(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value:
        raise ValueError("ReplayCallPlan v2 fixture relations are required")
    result: list[dict[str, Any]] = []
    semantic_keys: set[tuple[Any, ...]] = set()
    for item in value:
        if not isinstance(item, dict):
            raise ValueError("ReplayCallPlan v2 fixture relation is invalid")
        kind = item.get("kind")
        if kind == "equal":
            left = _normalize_fixture_ref(item.get("left"), {"i32", "i32_vec", "string", "usize"})
            right = _normalize_fixture_ref(item.get("right"), {"i32", "i32_vec", "string", "usize"})
            if left["encoding"] != right["encoding"]:
                raise ValueError("ReplayCallPlan v2 equal relation encodings drifted")
            normalized = {"kind": kind, "left": left, "right": right}
            refs = sorted((_fixture_ref_key(left), _fixture_ref_key(right)))
            semantic_key = (kind, *refs)
        elif kind == "length_equals":
            collection = _normalize_fixture_ref(item.get("collection"), {"i32_vec"})
            length = _normalize_fixture_ref(item.get("length"), {"i32", "usize"})
            normalized = {"kind": kind, "collection": collection, "length": length}
            semantic_key = (kind, _fixture_ref_key(collection), _fixture_ref_key(length))
        elif kind == "numeric_equal":
            left = _normalize_fixture_ref(item.get("left"), {"i32", "usize"})
            right = _normalize_fixture_ref(item.get("right"), {"i32", "usize"})
            normalized = {"kind": kind, "left": left, "right": right}
            refs = sorted((_fixture_ref_key(left), _fixture_ref_key(right)))
            semantic_key = (kind, *refs)
        else:
            raise ValueError("ReplayCallPlan v2 fixture relation kind is unsupported")
        relation_refs = [
            ref
            for key, ref in normalized.items()
            if key != "kind" and isinstance(ref, dict)
        ]
        if len({_fixture_ref_location(ref) for ref in relation_refs}) != len(relation_refs):
            raise ValueError("ReplayCallPlan v2 fixture relation fields must be distinct")
        if semantic_key in semantic_keys:
            raise ValueError("ReplayCallPlan v2 fixture relations must be unique")
        semantic_keys.add(semantic_key)
        result.append(normalized)
    return result


def _normalize_fixture_ref(value: Any, encodings: set[str]) -> dict[str, str]:
    if not isinstance(value, dict) or value.get("section") not in {"inputs", "expected"}:
        raise ValueError("ReplayCallPlan v2 fixture relation reference is invalid")
    if value.get("encoding") not in encodings:
        raise ValueError("ReplayCallPlan v2 fixture relation encoding is invalid")
    return {
        "section": value["section"],
        "field": _identifier(value.get("field"), "fixture relation field"),
        "encoding": value["encoding"],
    }


def _fixture_ref_key(value: dict[str, str]) -> tuple[str, str, str]:
    return value["section"], value["field"], value["encoding"]


def _fixture_ref_location(value: dict[str, str]) -> tuple[str, str]:
    return value["section"], value["field"]


def _fixture_ref_value(reference: dict[str, str], case: dict[str, Any]) -> Any:
    section = _case_input_values(case) if reference["section"] == "inputs" else case.get("expected")
    if not isinstance(section, dict) or reference["field"] not in section:
        raise ValueError("ReplayCallPlan v2 fixture relation field is missing")
    value = section[reference["field"]]
    if not _value_matches(value, reference["encoding"]):
        raise ValueError("ReplayCallPlan v2 fixture relation value drifted")
    return value


def _fixture_relation_literals(
    relation: dict[str, Any], case: dict[str, Any]
) -> tuple[str, str]:
    kind = relation["kind"]
    if kind == "length_equals":
        collection = _fixture_ref_value(relation["collection"], case)
        length = _fixture_ref_value(relation["length"], case)
        if relation["length"]["encoding"] == "i32" and length < 0:
            raise ValueError("ReplayCallPlan v2 fixture relation i32 length must be non-negative")
        if len(collection) != length:
            raise ValueError("ReplayCallPlan v2 fixture relation drifted")
        collection_literal = _encoded_literal(collection, "i32_vec")
        return f"{collection_literal}.len()", f"{length}usize"
    left = _fixture_ref_value(relation["left"], case)
    right = _fixture_ref_value(relation["right"], case)
    if kind == "numeric_equal":
        if (
            relation["left"]["encoding"] == "i32" and left < 0
        ) or (
            relation["right"]["encoding"] == "i32" and right < 0
        ):
            raise ValueError("ReplayCallPlan v2 numeric relation i32 must be non-negative")
        if left != right:
            raise ValueError("ReplayCallPlan v2 fixture relation drifted")
        return f"{left}usize", f"{right}usize"
    if left != right:
        raise ValueError("ReplayCallPlan v2 fixture relation drifted")
    encoding = relation["left"]["encoding"]
    return _encoded_literal(left, encoding), _encoded_literal(right, encoding)


def _normalize_v2_fixture_assertions(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value:
        raise ValueError("ReplayCallPlan v2 fixture assertions are required")
    result: list[dict[str, Any]] = []
    fields: set[str] = set()
    for item in value:
        if not isinstance(item, dict):
            raise ValueError("ReplayCallPlan v2 fixture assertion is invalid")
        fixture_field = _identifier(
            item.get("fixture_field"), "fixture assertion field"
        )
        encoding = item.get("encoding")
        if encoding not in {"u32", "i32", "usize", "bool", "string"}:
            raise ValueError("ReplayCallPlan v2 fixture assertion encoding is unsupported")
        if fixture_field in fields:
            raise ValueError("ReplayCallPlan v2 fixture assertion fields must be unique")
        _encoded_literal(item.get("expected"), encoding)
        result.append(
            {
                "fixture_field": fixture_field,
                "encoding": encoding,
                "expected": item.get("expected"),
            }
        )
        fields.add(fixture_field)
    return result


def _normalize_pairs(value: Any, label: str) -> list[list[str]]:
    if not isinstance(value, list):
        raise ValueError(f"{label} must be an array")
    result = []
    for item in value:
        if not isinstance(item, list) or len(item) != 2:
            raise ValueError(f"{label} pair is invalid")
        left = _identifier(item[0], label)
        right = _identifier(item[1], label)
        pair = sorted([left, right])
        if pair[0] == pair[1]:
            raise ValueError(f"{label} pair must be distinct")
        result.append(pair)
    result.sort()
    if len(result) != len({tuple(item) for item in result}):
        raise ValueError(f"{label} pairs must be unique")
    return result


def _field_path(value: Any, label: str) -> tuple[str, ...]:
    if not isinstance(value, list) or not value:
        raise ValueError(f"{label} is required")
    return tuple(_identifier(item, label) for item in value)


def _identifier(value: Any, label: str) -> str:
    if not isinstance(value, str) or not IDENTIFIER_RE.fullmatch(value):
        raise ValueError(f"{label} identifier is invalid")
    return value


def _fixture_key(value: Any, label: str) -> str:
    if not isinstance(value, str) or not FIXTURE_KEY_RE.fullmatch(value):
        raise ValueError(f"{label} is invalid")
    return value


def _fixture_path(value: Any, label: str) -> list[str]:
    if not isinstance(value, list) or not value:
        raise ValueError(f"{label} is invalid")
    return [_fixture_key(item, label) for item in value]


def _rust_type(value: Any, label: str) -> str:
    if (
        not isinstance(value, str)
        or not value
        or (
            value not in NULL_POINTER_RUST_TYPES.values()
            and not RUST_TYPE_RE.fullmatch(value)
        )
    ):
        raise ValueError(f"Rust {label} is invalid")
    return value


def _normalize_c_type(value: Any) -> str:
    return " ".join(str(value or "").replace(" *", "*").split())


def _safe_ident(value: str) -> str:
    result = re.sub(r"[^A-Za-z0-9_]", "_", value)
    return result if result and not result[0].isdigit() else f"case_{result}"


def _is_u32(value: Any) -> bool:
    return not isinstance(value, bool) and isinstance(value, int) and 0 <= value <= 2**32 - 1


def _is_i32(value: Any) -> bool:
    return not isinstance(value, bool) and isinstance(value, int) and -(2**31) <= value <= 2**31 - 1


def _is_usize(value: Any) -> bool:
    return not isinstance(value, bool) and isinstance(value, int) and 0 <= value <= 2**64 - 1


def _value_matches(value: Any, encoding: str) -> bool:
    if encoding == "u32":
        return _is_u32(value)
    if encoding == "i32":
        return _is_i32(value)
    if encoding == "usize":
        return _is_usize(value)
    if encoding == "bool":
        return isinstance(value, bool)
    if encoding == "string":
        return isinstance(value, str)
    if encoding in {"i32_slice", "i32_vec"}:
        return (
            isinstance(value, list)
            and len(value) <= MAX_DYNAMIC_I32_ITEMS
            and all(_is_i32(item) for item in value)
        )
    return False


def _plan_sha256(plan: dict[str, Any]) -> str:
    payload = {key: value for key, value in plan.items() if key != "plan_sha256"}
    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode(
        "utf-8"
    )
    return hashlib.sha256(encoded).hexdigest()


__all__ = [
    "build_scripted_external_plan",
    "build_record_interior_u32_constant_state_plan",
    "build_record_owner_stats_sequence_plan",
    "build_record_owner_usize_wrapping_add_plan",
    "build_record_reset_add_while_continue_plan",
    "build_record_u32_constant_state_plan",
    "render_replay_call_plan_v2",
    "validate_replay_call_plan_v2",
]
