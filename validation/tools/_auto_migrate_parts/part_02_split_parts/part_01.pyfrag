_C2R_NESTED_PARTS_DIR = (
    Path(__file__).with_name("_auto_migrate_parts")
    / "part_02_split_parts"
    / "part_01_parts"
)
for _C2R_NESTED_PART_NAME in (
    "part_00.pyfrag",
    "part_01.pyfrag",
    "part_02.pyfrag",
    "part_03.pyfrag",
    "part_04.pyfrag",
    "part_05.pyfrag",
    "part_06.pyfrag",
    "part_07.pyfrag",
    "part_08.pyfrag",
):
    _C2R_NESTED_PART_PATH = _C2R_NESTED_PARTS_DIR / _C2R_NESTED_PART_NAME
    exec(
        compile(
            _C2R_NESTED_PART_PATH.read_text(encoding="utf-8"),
            str(_C2R_NESTED_PART_PATH),
            "exec",
        ),
        globals(),
    )
for _C2R_NESTED_TEMP_NAME in (
    "_C2R_NESTED_PARTS_DIR",
    "_C2R_NESTED_PART_NAME",
    "_C2R_NESTED_PART_PATH",
):
    globals().pop(_C2R_NESTED_TEMP_NAME, None)
del _C2R_NESTED_TEMP_NAME
def run_rust_check(
    evidence_dir: Path,
    skip: bool,
    spec: dict[str, Any],
    *,
    allow_self_heal: bool = True,
) -> tuple[dict[str, Any], dict[str, Any]]:
    path = next(evidence_dir.glob("l3-*-rust-draft.rs"), None)
    slice_id = required_str(spec, "slice_id")
    external_context = external_direct_callee_context(spec, load_plan_call_expressions(evidence_dir, slice_id))
    if skip or path is None:
        payload = {
            "schema_version": 1,
            "status": "skipped",
            "errors": [],
            "command": None,
            "external_callee_context": rust_check_external_context(external_context),
            "rust_check_harness_only_bindings": rust_check_external_binding_report(external_context),
        }
        patch = write_no_patch_required(spec, evidence_dir, path)
    else:
        original_draft = path.read_bytes()
        stub_contract_error = None
        candidate_context = candidate_external_callee_context(external_context, set())
        try:
            first = rust_check_once(path)
            write_log_text(evidence_dir / "rust-check-initial.stdout.log", first["stdout"])
            write_log_text(evidence_dir / "rust-check-initial.stderr.jsonl", first["stderr"])
            required_callees = unresolved_declared_external_callee_names(
                first, external_context
            )
            candidate_text = path.read_text(encoding="utf-8-sig")
            candidate_owned_callees = {
                str(callee.get("name") or "")
                for callee in external_context.get("declared", [])
                if callee.get("name")
                and rust_function_declared(
                    candidate_text,
                    rust_identifier(str(callee["name"])),
                )
            }
            required_callees.update(candidate_owned_callees)
            candidate_context = candidate_external_callee_context(
                external_context, required_callees
            )
            final = first
            if candidate_context["status"] == "recorded" and (
                first["returncode"] != 0 or candidate_owned_callees
            ):
                try:
                    inject_external_callee_stubs(path, candidate_context, spec)
                except ValueError as error:
                    stub_contract_error = str(error)
                if stub_contract_error is None and first["returncode"] != 0:
                    final = rust_check_once(path)
                elif stub_contract_error is not None:
                    final = {
                        "command": None,
                        "returncode": 1,
                        "stdout": "",
                        "stderr": stub_contract_error,
                        "errors": [{
                            "level": "error",
                            "message": stub_contract_error,
                            "code": {"code": "external_callee_stub_contract_failed"},
                        }],
                    }
        finally:
            path.write_bytes(original_draft)
        patch = write_no_patch_required(spec, evidence_dir, path)
        if final["returncode"] != 0 and allow_self_heal and stub_contract_error is None:
            final, patch = run_safe_self_heal_loop(spec, evidence_dir, path, final)
        if final["returncode"] != 0 and patch["status"] != "blocked":
            patch = write_blocked_patch(
                spec,
                evidence_dir,
                path,
                final["errors"],
                round_number=REPAIR_ROUND_LIMIT,
                append_events=patch.get("self_heal_applied") is True,
            )
        write_log_text(evidence_dir / "rust-check.stdout.log", final["stdout"])
        write_log_text(evidence_dir / "rust-check.stderr.jsonl", final["stderr"])
        payload = {
            "schema_version": 1,
            "status": "passed" if final["returncode"] == 0 else "failed",
            "command": final["command"],
            "error_count": len(final["errors"]),
            "errors": final["errors"],
            "external_callee_context": rust_check_external_context(candidate_context),
            "candidate_external_resolution": {
                "status": candidate_context["status"],
                "source": "rustc_unresolved_function_diagnostics",
                "required_names": candidate_context["candidate_required_names"],
                "declared_spec_names": candidate_context["declared_spec_names"],
            },
            "rust_check_harness_only_bindings": rust_check_external_binding_report(
                candidate_context
            ),
            "external_callee_stub_contract": {
                "status": "failed" if stub_contract_error is not None else "passed",
                "reason": stub_contract_error,
            },
            "self_healing": {
                "status": patch["status"],
                "patch_events": patch["patch_events"],
                "blocked_repairs": patch["blocked_repairs"],
            },
        }
