def rust_replay_scripted_external_record_u32_call_bool_state_cases_source(
    spec: dict[str, Any],
    fixture_binding: dict[str, Any],
) -> str:
    contract = scripted_external_record_u32_call_bool_state_replay_contract(
        spec, fixture_binding
    )
    if contract is None:
        return "    // TODO: bind scripted record external fixture cases.\n"
    external = contract["external_callee"]
    state_output = contract["state_output"]
    return_contract = contract["return"]
    function_name = safe_ident(required_str(spec, "function_name"))
    blocks: list[str] = [
        "    // Fixture-only record stimulus; real external callee semantics are not verified.\n"
    ]
    for case_binding in fixture_binding["case_bindings"]:
        payload = oracle_fixture_input_payload(spec, case_binding)
        expected = case_binding["expected_outputs"]
        case_id = str(case_binding.get("id") or "case")
        local_names: dict[str, str] = {}
        declarations: list[str] = []
        call_arguments: list[str] = []
        for argument in contract["entry_arguments"]:
            parameter = safe_ident(str(argument["parameter"]))
            local_name = f"actual_{safe_ident(case_id)}_{parameter}"
            local_names[str(argument["parameter"])] = local_name
            mutable = "mut " if argument["pass_mode"] == "mutable_ref" else ""
            initializer = scripted_record_rust_initializer(argument["initializer"], payload)
            declarations.append(f"        let {mutable}{local_name} = {initializer};\n")
            call_arguments.append(
                f"&mut {local_name}"
                if argument["pass_mode"] == "mutable_ref"
                else local_name
            )
        expected_args = [
            int(value) for value in expected[str(external["call_args_output"])]
        ]
        expected_args_literal = ", ".join(f"{value}u32" for value in expected_args)
        state_local = local_names[str(state_output["parameter"])]
        state_expression = (
            f"{state_local}.{'.'.join(str(field) for field in state_output['field_path'])}"
        )
        blocks.extend(
            [
                "    {\n",
                f"        let case_id = {rust_string_literal(case_id)};\n",
                f"        __c2r_scripted_external_set_return({int(payload[str(external['return_fixture_field'])])}u32);\n",
                "        __c2r_scripted_external_reset_calls();\n",
                *declarations,
                f"        let actual_return = {function_name}({', '.join(call_arguments)});\n",
                f"        assert_eq!(actual_return, {str(bool(expected[str(return_contract['fixture_field'])])).lower()}, \"{{}} return drifted\", case_id);\n",
                f"        assert_eq!({state_expression}, {int(expected[str(state_output['fixture_field'])])}u32, \"{{}} state drifted\", case_id);\n",
                f"        assert_eq!(__c2r_scripted_external_call_count(), {int(expected[str(external['call_count_output'])])}usize, \"{{}} external call count drifted\", case_id);\n",
                f"        assert_eq!(__c2r_scripted_external_call_args(), [{expected_args_literal}], \"{{}} external call arguments drifted\", case_id);\n",
                "    }\n",
            ]
        )
    return "".join(blocks)


def scripted_record_rust_initializer(
    initializer: dict[str, Any],
    payload: dict[str, Any],
) -> str:
    fields: list[str] = []
    for field in initializer["fields"]:
        if "fixture_field" in field:
            value = f"{int(payload[str(field['fixture_field'])])}u32"
        else:
            value = scripted_record_rust_initializer(field["record"], payload)
        fields.append(f"{safe_ident(str(field['name']))}: {value}")
    return f"{safe_ident(str(initializer['record_type']))} {{ " + ", ".join(fields) + " }"
