def rust_replay_single_i32_return_value_case_literal(
    spec: dict[str, Any], case_binding: dict[str, Any]
) -> str | None:
    case_payload = oracle_fixture_input_payload(spec, case_binding)
    if not isinstance(case_payload, dict):
        return None
    expected_outputs = case_binding.get("expected_outputs")
    if not isinstance(expected_outputs, dict):
        return None
    parameter_name = single_i32_parameter_name(spec)
    input_value = case_payload.get(parameter_name)
    expected_return = expected_outputs.get("return_value")
    status = expected_outputs.get("status")
    if not is_i32_value(input_value) or not is_i32_value(expected_return):
        return None
    if status != "ok":
        return None
    return (
        "        FixtureCase { "
        f"id: {rust_string_literal(case_binding.get('id') or 'case')}, "
        f"{safe_ident(parameter_name)}: {int(input_value)}i32, "
        f"return_value: {int(expected_return)}i32, "
        f"status: {rust_string_literal(status)} "
        "},\n"
    )


def single_u64_return_value_replay_supported(spec: dict[str, Any]) -> bool:
    if behavior_fields(spec) != ["return_value", "status"]:
        return False
    signature = c_function_signature(spec)
    if normalize_c_type(str(signature.get("return_type") or "")) != "unsigned long":
        return False
    parameters = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    if len(parameters) != 1:
        return False
    parameter = parameters[0]
    return (
        parameter.get("direction") == "input"
        and normalize_c_type(str(parameter.get("c_type") or "")) == "unsigned long"
    )


