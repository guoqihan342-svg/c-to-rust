def run_generated_rust_replay(
    spec: dict[str, Any],
    evidence_dir: Path,
    replay: dict[str, Any],
    rust_check: dict[str, Any],
) -> dict[str, Any]:
    slice_id = required_str(spec, "slice_id")
    replay_path = evidence_dir / f"l3-{slice_id}-rust-replay-test-draft.rs"
    draft_path = evidence_dir / f"l3-{slice_id}-rust-draft.rs"
    if rust_check.get("status") != "passed":
        return replay
    if rust_check_has_harness_only_external_bindings(rust_check):
        replay["status"] = "not_applicable"
        replay["skip_reason"] = "compile_only_external_bindings_not_executable"
        replay["not_applicable_reason"] = "compile_only_external_bindings_not_executable"
        replay["generated_draft_replay_pass"] = False
        replay["generated_draft_semantic_pass"] = False
        replay["known_gaps"] = [
            "Rust-check harness-only external callee bindings are compile-only and must not be executed as replay proof."
        ]
        write_json(evidence_dir / f"l3-{slice_id}-test-translation-generated.json", replay)
        return replay
    if not generated_rust_replay_supported(spec, evidence_dir):
        return replay
    try:
        call_continue_safety = call_continue_generated_rust_safety(spec, draft_path)
        reset_add_safety = reset_add_generated_rust_safety(spec, draft_path)
        projection_safety = interior_projection_generated_rust_safety(spec, draft_path)
    except ValueError as error:
        return record_generated_rust_replay_safety_failure(
            spec,
            evidence_dir,
            replay,
            error,
        )
    external_context = external_direct_callee_context(
        spec,
        load_plan_call_expressions(evidence_dir, slice_id),
    )
    if external_context["status"] == "recorded":
        with tempfile.TemporaryDirectory(prefix="c2r-generated-replay-input-") as replay_input_dir:
            replay_draft_path = Path(replay_input_dir) / draft_path.name
            replay_draft_path.write_text(draft_path.read_text(encoding="utf-8-sig"), encoding="utf-8")
            inject_external_callee_stubs(replay_draft_path, external_context, spec)
            result = run_generated_rust_replay_once(replay_draft_path, replay_path)
    else:
        result = run_generated_rust_replay_once(draft_path, replay_path)
    write_text(evidence_dir / "generated-rust-replay-compile.stdout.log", result["compile_stdout"])
    write_text(evidence_dir / "generated-rust-replay-compile.stderr.jsonl", result["compile_stderr"])
    write_text(evidence_dir / "generated-rust-replay.stdout.log", result["run_stdout"])
    write_text(evidence_dir / "generated-rust-replay.stderr.log", result["run_stderr"])
    passed = result["status"] == "passed"
    replay["status"] = "passed" if passed else "failed"
    replay["generated_draft_replay_pass"] = passed
    replay["generated_draft_semantic_pass"] = False
    if call_continue_safety is not None:
        contract = call_continue_state_replay_contract(spec)
        replay["fixture_state_model"] = call_continue_fixture_state_model(contract)
        replay["safe_mutable_projection"] = call_continue_safety
        replay["fixture_external_stub"] = {
            "kind": CALL_CONTINUE_STATE_KIND,
            "scope": "fixture_only",
            "semantics_verified": False,
        }
    elif reset_add_safety is not None:
        contract = record_interior_projection_u32_reset_add_while_continue_state_replay_contract(spec)
        replay["fixture_state_model"] = reset_add_fixture_state_model(contract)
        replay["safe_mutable_projection"] = reset_add_safety
    elif projection_safety is not None:
        replay["fixture_state_model"] = {
            "kind": RECORD_INTERIOR_PROJECTION_U32_CONSTANT_STATE_KIND,
            "scope": "fixture_only",
            "operation": "constant_assign",
            "value": 0,
            "projection_mode": "owner_interior_mutable",
            "pointer_root_count": 1,
        }
        replay["safe_mutable_projection"] = projection_safety
    elif record_u32_field_scalar_wrapping_add_state_replay_contract(spec) is not None:
        contract = record_u32_field_scalar_wrapping_add_state_replay_contract(spec)
        replay["fixture_state_model"] = {
            "kind": RECORD_U32_FIELD_SCALAR_WRAPPING_ADD_STATE_KIND,
            "scope": "fixture_only",
            "operation": "wrapping_add",
            "record_field": contract["state_update"]["record_field"],
            "scalar": contract["state_update"]["scalar"],
        }
    elif record_u32_field_postfix_increment_state_replay_contract(spec) is not None:
        replay["fixture_state_model"] = {
            "kind": RECORD_U32_FIELD_POSTFIX_INCREMENT_STATE_KIND,
            "scope": "fixture_only",
            "operation": "wrapping_add",
            "increment": 1,
        }
    elif record_u32_field_constant_state_replay_contract(spec) is not None:
        replay["fixture_state_model"] = {
            "kind": RECORD_U32_FIELD_CONSTANT_STATE_KIND,
            "scope": "fixture_only",
            "operation": "constant_assign",
            "value": 0,
        }
    elif record_u32_field_wrapping_add_state_replay_contract(spec) is not None:
        replay["fixture_state_model"] = {
            "kind": RECORD_U32_FIELD_WRAPPING_ADD_STATE_KIND,
            "scope": "fixture_only",
            "operation": "wrapping_add",
        }
    elif record_owner_interior_u32_to_usize_wrapping_add_state_replay_contract(spec) is not None:
        replay["fixture_state_model"] = record_owner_interior_usize_add_fixture_state_model()
    elif record_owner_interior_stats_sequence_state_replay_contract(spec) is not None:
        replay["fixture_state_model"] = record_owner_interior_stats_sequence_fixture_state_model()
    elif record_owner_interior_guarded_stats_sequence_state_replay_contract(spec) is not None:
        replay["fixture_state_model"] = (
            record_owner_interior_guarded_stats_sequence_fixture_state_model()
        )
    elif scripted_external_record_u32_sequence_do_while_state_replay_contract(spec) is not None:
        replay["fixture_external_stub"] = {
            "kind": SCRIPTED_EXTERNAL_RECORD_U32_SEQUENCE_DO_WHILE_STATE_KIND,
            "scope": "fixture_only",
            "semantics_verified": False,
        }
    elif scripted_external_record_u32_call_bool_state_replay_contract(spec) is not None:
        replay["fixture_external_stub"] = {
            "kind": SCRIPTED_EXTERNAL_RECORD_U32_CALL_BOOL_STATE_KIND,
            "scope": "fixture_only",
            "semantics_verified": False,
        }
    elif scripted_external_u32_call_bool_out_replay_contract(spec) is not None:
        replay["fixture_external_stub"] = {
            "kind": SCRIPTED_EXTERNAL_U32_CALL_BOOL_OUT_KIND,
            "scope": "fixture_only",
            "semantics_verified": False,
        }
    replay["replay_execution"] = {
        "status": result["status"],
        "phase": result["phase"],
        "compile_command": result["compile_command"],
        "compile_returncode": result["compile_returncode"],
        "run_command": result["run_command"],
        "run_returncode": result["run_returncode"],
        "stdout_log": rel(evidence_dir / "generated-rust-replay.stdout.log"),
        "stderr_log": rel(evidence_dir / "generated-rust-replay.stderr.log"),
    }
    replay["known_gaps"] = [
        "Generated Rust replay passed committed fixture cases; C oracle, schema diff, negative diff, unsafe, and final verification gates are still required."
    ]
    for mapping in replay.get("translation_mappings", []):
        if isinstance(mapping, dict):
            mapping["status"] = "passed" if passed else "failed"
    write_json(evidence_dir / f"l3-{slice_id}-test-translation-generated.json", replay)
    return replay


def record_generated_rust_replay_safety_failure(
    spec: dict[str, Any],
    evidence_dir: Path,
    replay: dict[str, Any],
    error: ValueError,
) -> dict[str, Any]:
    slice_id = required_str(spec, "slice_id")
    diagnostic = str(error).strip()[:512] or "generated Rust safety contract rejected the candidate"
    replay["status"] = "failed"
    replay["generated_draft_replay_pass"] = False
    replay["generated_draft_semantic_pass"] = False
    replay["replay_safety"] = {
        "status": "failed",
        "kind": "generated_rust_safety_contract_failed",
        "diagnostic": diagnostic,
        "semantic_gate": False,
    }
    replay["replay_execution"] = {
        "status": "failed",
        "phase": "safety",
        "compile_command": None,
        "compile_returncode": None,
        "run_command": None,
        "run_returncode": None,
        "stdout_log": None,
        "stderr_log": None,
    }
    replay["known_gaps"] = [
        "Generated Rust failed the bounded safety syntax contract before replay compilation."
    ]
    for mapping in replay.get("translation_mappings", []):
        if isinstance(mapping, dict):
            mapping["status"] = "failed"
    write_json(evidence_dir / f"l3-{slice_id}-test-translation-generated.json", replay)
    return replay


def rust_check_has_harness_only_external_bindings(rust_check: dict[str, Any]) -> bool:
    report = rust_check.get("rust_check_harness_only_bindings")
    if not isinstance(report, dict):
        return False
    return any(
        isinstance(binding, dict)
        and (
            binding.get("status") in {"harness_only", "generated_compile_only"}
            or binding.get("allowed_use") == "rustc_compile_only"
        )
        for binding in report.get("bindings", [])
    )


def generated_rust_replay_supported(spec: dict[str, Any], evidence_dir: Path) -> bool:
    call_plan_status = build_replay_call_plan(spec, REPO_ROOT).get("status")
    if call_plan_status == "blocked":
        return False
    declarative_call_plan_ready = call_plan_status == "bound"
    if (
        behavior_fields(spec) != ["return_code"]
        and not declarative_call_plan_ready
    ):
        return False
    slice_id = required_str(spec, "slice_id")
    plan_path = evidence_dir / f"l3-{slice_id}-auto-translation-plan.json"
    draft_path = evidence_dir / f"l3-{slice_id}-rust-draft.rs"
    replay_path = evidence_dir / f"l3-{slice_id}-rust-replay-test-draft.rs"
    if not plan_path.exists() or not draft_path.exists() or not replay_path.exists():
        return False
    plan = read_json(plan_path)
    rule_ids = plan.get("translation_summary", {}).get("translation_rule_ids", [])
    return "clang-lowered-typed-ir" in rule_ids or ai_generated_candidate_replay_supported(
        evidence_dir,
        slice_id,
        draft_path,
    )


def ai_generated_candidate_replay_supported(
    evidence_dir: Path,
    slice_id: str,
    draft_path: Path,
) -> bool:
    manifest_path = evidence_dir / f"l3-{slice_id}-ai-candidate-manifest.json"
    if manifest_path.is_symlink() or not manifest_path.is_file() or draft_path.is_symlink():
        return False
    try:
        manifest = read_json(manifest_path)
        candidates = manifest.get("candidates")
        candidate = candidates[0] if isinstance(candidates, list) and len(candidates) == 1 else None
        applied = candidate.get("applied_artifact") if isinstance(candidate, dict) else None
        draft_sha = sha256(draft_path)
    except (OSError, ValueError, json.JSONDecodeError):
        return False
    return bool(
        manifest.get("schema_version") in {8, 9}
        and manifest.get("slice_id") == slice_id
        and manifest.get("status") == "generated"
        and isinstance(candidate, dict)
        and manifest.get("selected_candidate_id") == candidate.get("candidate_id")
        and candidate.get("applied") is True
        and candidate.get("rust_draft_sha256") == draft_sha
        and isinstance(applied, dict)
        and applied.get("path") == draft_path.name
        and applied.get("sha256") == draft_sha
    )


def run_generated_rust_replay_once(draft_path: Path, replay_path: Path) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="c2r-generated-replay-") as build_dir_text:
        build_dir = Path(build_dir_text)
        combined_path = build_dir / "generated_replay.rs"
        exe_path = build_dir / "generated_replay.exe"
        combined_path.write_text(
            draft_path.read_text(encoding="utf-8-sig")
            + "\n"
            + replay_path.read_text(encoding="utf-8-sig"),
            encoding="utf-8",
        )
        compile_cmd = [
            "rustc",
            "--edition=2021",
            "--test",
            "--error-format=json",
            str(combined_path),
            "-o",
            str(exe_path),
        ]
        compile_result = subprocess.run(
            compile_cmd,
            cwd=REPO_ROOT,
            text=True,
            encoding="utf-8",
            errors="replace",
            capture_output=True,
        )
        aliases = {
            str(build_dir): "<generated-replay>",
            str(REPO_ROOT): ".",
        }
        compile_stdout = stable_process_text(compile_result.stdout, aliases)
        compile_stderr = stable_process_text(compile_result.stderr, aliases)
        stable_compile_command = (
            "rustc --edition=2021 --test --error-format=json "
            "<generated-replay.rs> -o <generated-replay-executable>"
        )
        if compile_result.returncode != 0:
            return {
                "status": "failed",
                "phase": "compile",
                "compile_command": stable_compile_command,
                "compile_returncode": compile_result.returncode,
                "compile_stdout": compile_stdout,
                "compile_stderr": compile_stderr,
                "run_command": None,
                "run_returncode": None,
                "run_stdout": "",
                "run_stderr": "",
            }
        run_cmd = [str(exe_path), "--nocapture"]
        run_result = subprocess.run(
            run_cmd,
            cwd=REPO_ROOT,
            text=True,
            encoding="utf-8",
            errors="replace",
            capture_output=True,
        )
        return {
            "status": "passed" if run_result.returncode == 0 else "failed",
            "phase": "run",
            "compile_command": stable_compile_command,
            "compile_returncode": compile_result.returncode,
            "compile_stdout": compile_stdout,
            "compile_stderr": compile_stderr,
            "run_command": "<generated-replay-executable> --nocapture",
            "run_returncode": run_result.returncode,
            "run_stdout": stable_process_text(run_result.stdout, aliases),
            "run_stderr": stable_process_text(run_result.stderr, aliases),
        }
