def rust_replay_record_u32_field_constant_state_cases_source(
    spec: dict[str, Any], fixture_binding: dict[str, Any]
) -> str:
    contract = record_u32_field_constant_state_replay_contract(spec, fixture_binding)
    if contract is None:
        return "    // TODO: bind record field constant-state fixture cases.\n"
    state = contract["state_output"]
    result = contract["return"]
    function_name = safe_ident(required_str(spec, "function_name"))
    blocks = ["    // Exact nested u32 record-field constant-state fixture replay.\n"]
    for case_binding in fixture_binding["case_bindings"]:
        payload = oracle_fixture_input_payload(spec, case_binding)
        expected = case_binding["expected_outputs"]
        case_id = str(case_binding.get("id") or "case")
        local_names: dict[str, str] = {}
        declarations: list[str] = []
        call_arguments: list[str] = []
        for entry in contract["entry_arguments"]:
            parameter = safe_ident(str(entry["parameter"]))
            local_name = f"actual_{safe_ident(case_id)}_{parameter}"
            local_names[str(entry["parameter"])] = local_name
            declarations.append(
                f"        let mut {local_name} = "
                f"{scripted_record_rust_initializer(entry['initializer'], payload)};\n"
            )
            call_arguments.append(f"&mut {local_name}")
        state_expression = (
            f"{local_names[str(state['parameter'])]}."
            + ".".join(str(field) for field in state["field_path"])
        )
        expected_state = int(expected[str(state["fixture_field"])])
        expected_return = str(bool(expected[str(result["fixture_field"])])).lower()
        blocks.extend(
            [
                "    {\n",
                f"        let case_id = {rust_string_literal(case_id)};\n",
                *declarations,
                f"        let actual_return = {function_name}({', '.join(call_arguments)});\n",
                f"        assert_eq!({state_expression}, {expected_state}u32, \"{{}} constant state drifted\", case_id);\n",
                f"        assert_eq!(actual_return, {expected_return}, \"{{}} return drifted\", case_id);\n",
                "    }\n",
            ]
        )
    return "".join(blocks)
