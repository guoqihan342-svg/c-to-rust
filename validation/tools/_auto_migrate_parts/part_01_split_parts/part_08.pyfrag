def c_oracle_record_u32_field_constant_state_execution_source(
    spec: dict[str, Any], fixture_binding: dict[str, Any]
) -> dict[str, Any]:
    contract = record_u32_field_constant_state_replay_contract(spec, fixture_binding)
    if contract is None:
        return {"declarations": "", "statements": ""}
    state = contract["state_output"]
    update = contract["state_update"]
    result = contract["return"]
    statements: list[str] = []
    for case_binding in fixture_binding["case_bindings"]:
        payload = oracle_fixture_input_payload(spec, case_binding)
        expected = case_binding["expected_outputs"]
        case_id = str(case_binding.get("id") or "case")
        case_ident = c_safe_ident(case_id)
        local_names: dict[str, str] = {}
        declarations: list[str] = []
        call_arguments: list[str] = []
        for entry in contract["entry_arguments"]:
            parameter = str(entry["parameter"])
            local_name = f"actual_{case_ident}_{parameter}"
            local_names[parameter] = local_name
            declarations.append(
                f"  struct {entry['rust_type']} {local_name} = "
                f"{scripted_record_c_initializer(entry['initializer'], payload)};\n"
            )
            call_arguments.append(f"&{local_name}")
        state_expression = (
            f"{local_names[str(state['parameter'])]}."
            + ".".join(str(field) for field in state["field_path"])
        )
        expected_state = int(expected[str(state["fixture_field"])])
        expected_return = "true" if expected[str(result["fixture_field"])] else "false"
        actual_return = f"actual_{case_ident}_return"
        statements.append(
            f"{''.join(declarations)}"
            f"  bool {actual_return} = {required_str(spec, 'function_name')}({', '.join(call_arguments)});\n"
            f"  if ({actual_return} != {expected_return}) {{\n"
            f"    fprintf(stderr, {c_string_literal(case_id + ' return mismatch\\n')});\n"
            "    return 1;\n"
            "  }\n"
            f"  puts({c_string_literal('fixture case ' + case_id + ' ' + str(result['fixture_field']) + ' matched')});\n"
            f"  if ({state_expression} != {c_integer_literal('uint32_t', expected_state)}) {{\n"
            f"    fprintf(stderr, {c_string_literal(case_id + ' constant state mismatch\\n')});\n"
            "    return 1;\n"
            "  }\n"
            f"  puts({c_string_literal('fixture case ' + case_id + ' ' + str(state['fixture_field']) + ' matched')});\n"
        )
    return {
        "declarations": "",
        "definitions_after_target": "",
        "statements": "".join(statements),
        "fixture_state_model": {
            "kind": RECORD_U32_FIELD_CONSTANT_STATE_KIND,
            "scope": "fixture_only",
            "operation": "constant_assign",
            "value": int(update["value"]),
        },
    }
