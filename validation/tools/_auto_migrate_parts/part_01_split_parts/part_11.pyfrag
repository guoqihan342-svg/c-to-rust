def c_oracle_record_interior_projection_u32_reset_add_while_continue_state_execution_source(
    spec: dict[str, Any], fixture_binding: dict[str, Any]
) -> dict[str, Any]:
    contract = record_interior_projection_u32_reset_add_while_continue_state_replay_contract(
        spec, fixture_binding
    )
    if contract is None:
        return {"declarations": "", "statements": ""}
    owner_name = contract["owner_parameter"]
    reset = contract["reset_state"]
    add = contract["add_state"]
    result = contract["return"]
    statements: list[str] = []
    for case_binding in fixture_binding["case_bindings"]:
        payload = oracle_fixture_input_payload(spec, case_binding)
        expected = case_binding["expected_outputs"]
        case_id = str(case_binding.get("id") or "case")
        case_ident = c_safe_ident(case_id)
        locals_by_parameter: dict[str, str] = {}
        declarations: list[str] = []
        call_arguments: list[str] = []
        for entry in contract["entry_arguments"]:
            parameter = str(entry["parameter"])
            local_name = f"actual_{case_ident}_{parameter}"
            locals_by_parameter[parameter] = local_name
            declarations.append(
                f"  struct {entry['rust_type']} {local_name} = "
                f"{scripted_record_c_initializer(entry['initializer'], payload)};\n"
            )
            call_arguments.append(f"&{local_name}")
        owner_local = locals_by_parameter[owner_name]
        reset_expression = owner_local + "." + ".".join(reset["owner_field_path"])
        add_expression = owner_local + "." + ".".join(add["owner_field_path"])
        actual_return = f"actual_{case_ident}_return"
        expected_return = "true" if expected[result["fixture_field"]] else "false"
        statements.extend(
            [
                *declarations,
                f"  bool {actual_return} = {required_str(spec, 'function_name')}"
                f"({', '.join(call_arguments)});\n",
                f"  if ({actual_return} != {expected_return}) {{\n",
                f"    fprintf(stderr, {c_string_literal(case_id + ' return mismatch\\n')});\n",
                "    return 1;\n",
                "  }\n",
                f"  puts({c_string_literal('fixture case ' + case_id + ' ' + str(result['fixture_field']) + ' matched')});\n",
                f"  if ({reset_expression} != "
                f"{c_integer_literal('uint32_t', int(expected[reset['fixture_field']]))}) {{\n",
                f"    fprintf(stderr, {c_string_literal(case_id + ' reset state mismatch\\n')});\n",
                "    return 1;\n",
                "  }\n",
                f"  puts({c_string_literal('fixture case ' + case_id + ' ' + str(reset['fixture_field']) + ' matched')});\n",
                f"  if ({add_expression} != "
                f"{c_integer_literal('uint32_t', int(expected[add['fixture_field']]))}) {{\n",
                f"    fprintf(stderr, {c_string_literal(case_id + ' add state mismatch\\n')});\n",
                "    return 1;\n",
                "  }\n",
                f"  puts({c_string_literal('fixture case ' + case_id + ' ' + str(add['fixture_field']) + ' matched')});\n",
            ]
        )
    return {
        "declarations": "",
        "definitions_after_target": "",
        "statements": "".join(statements),
        "fixture_state_model": reset_add_fixture_state_model(contract),
    }
