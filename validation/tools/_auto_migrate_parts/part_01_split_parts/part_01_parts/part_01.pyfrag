def c_oracle_signature_supports_return_code_call(
    spec: dict[str, Any],
    signature: dict[str, Any],
) -> bool:
    if signature.get("return_type") != "uint32_t":
        return False
    if behavior_fields(spec) != ["return_code"]:
        return False
    parameters = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    if len(parameters) != 3:
        return False
    expected = [
        ("crc", "uint32_t"),
        ("buf", "const void *"),
        ("size", "size_t"),
    ]
    actual = [
        (str(item.get("name") or ""), normalize_c_type(str(item.get("c_type") or "")))
        for item in parameters
    ]
    return actual == expected


def c_oracle_signature_supports_i32_return_value_call(
    spec: dict[str, Any],
    signature: dict[str, Any],
) -> bool:
    if normalize_c_type(str(signature.get("return_type") or "")) != "int":
        return False
    if behavior_fields(spec) != ["return_value", "status"]:
        return False
    parameters = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    if len(parameters) != 1:
        return False
    parameter = parameters[0]
    return parameter.get("direction") == "input" and normalize_c_type(str(parameter.get("c_type") or "")) == "int"


def c_oracle_i32_return_value_execution_source(
    spec: dict[str, Any],
    fixture_binding: dict[str, Any],
) -> dict[str, str]:
    statements: list[str] = []
    for case_binding in fixture_binding.get("case_bindings", []):
        if not isinstance(case_binding, dict):
            continue
        case_source = c_oracle_i32_return_value_case_execution_source(spec, case_binding)
        if case_source is None:
            case_id = str(case_binding.get("id") or "unknown-case")
            statements.append(
                f"  /* TODO: fixture case {case_id} is not supported by this i32 return draft generator. */\n"
            )
            continue
        statements.append(case_source["statements"])
    return {"declarations": "", "statements": "".join(statements)}


def c_oracle_i32_return_value_case_execution_source(
    spec: dict[str, Any],
    case_binding: dict[str, Any],
) -> dict[str, str] | None:
    case_payload = oracle_fixture_input_payload(spec, case_binding)
    if not isinstance(case_payload, dict):
        return None
    expected_outputs = case_binding.get("expected_outputs")
    if not isinstance(expected_outputs, dict):
        return None
    signature = c_function_signature(spec)
    parameters = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    if len(parameters) != 1:
        return None
    parameter_name = str(parameters[0].get("name") or "value")
    input_value = case_payload.get(parameter_name)
    expected_return = expected_outputs.get("return_value")
    status = expected_outputs.get("status")
    if not is_i32_value(input_value) or not is_i32_value(expected_return) or status != "ok":
        return None

    function_name = required_str(spec, "function_name")
    case_id = str(case_binding.get("id") or "case")
    case_ident = c_safe_ident(case_id)
    actual_name = f"actual_{case_ident}_return_value"
    expected_literal = c_integer_literal("int", int(expected_return))
    input_literal = c_integer_literal("int", int(input_value))
    statements = (
        f"  int {actual_name} = {function_name}({input_literal});\n"
        f"  if ({actual_name} != {expected_literal}) {{\n"
        "    fprintf(stderr, "
        f"{c_string_literal(case_id + ' return_value mismatch: expected ' + str(int(expected_return)) + ' got %d\n')}, "
        f"{actual_name});\n"
        "    return 1;\n"
        "  }\n"
        f"  puts({c_string_literal('fixture case ' + case_id + ' return_value matched')});\n"
        f"  puts({c_string_literal('fixture case ' + case_id + ' status matched')});\n"
    )
    return {"declarations": "", "statements": statements}


def c_oracle_signature_supports_fdb_blob_make_call(
    spec: dict[str, Any],
    signature: dict[str, Any],
) -> bool:
    if required_str(spec, "function_name") != "fdb_blob_make":
        return False
    if normalize_c_type(str(signature.get("return_type") or "")) != "fdb_blob_t":
        return False
    if behavior_fields(spec) != ["return_same_blob", "blob.buf", "blob.size"]:
        return False
    parameters = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    if len(parameters) != 3:
        return False
    expected = [
        ("blob", "fdb_blob_t"),
        ("value_buf", "const void *"),
        ("buf_len", "size_t"),
    ]
    actual = [
        (str(item.get("name") or ""), normalize_c_type(str(item.get("c_type") or "")))
        for item in parameters
    ]
    return actual == expected


