def c_oracle_signature_supports_record_pointer_identity_return_call(
    spec: dict[str, Any],
    signature: dict[str, Any],
) -> bool:
    fields = behavior_fields(spec)
    parameters = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    if len(parameters) != 2 or not fields:
        return False
    input_parameter, output_parameter = parameters
    output_name = str(output_parameter.get("name") or "").strip()
    if not output_name:
        return False
    if normalize_c_type(str(signature.get("return_type") or "")) != normalize_c_type(
        str(output_parameter.get("c_type") or "")
    ):
        return False
    if f"return_same_{output_name}" not in fields:
        return False
    output_prefix = f"{output_name}."
    if any(field != f"return_same_{output_name}" and not field.startswith(output_prefix) for field in fields):
        return False
    if c_record_pointer_struct_type(spec, str(input_parameter.get("c_type") or "")) is None:
        return False
    if c_record_pointer_struct_type(spec, str(output_parameter.get("c_type") or "")) is None:
        return False
    return True


def c_oracle_record_pointer_identity_return_execution_source(
    spec: dict[str, Any],
    signature: dict[str, Any],
    fixture_binding: dict[str, Any],
) -> dict[str, str]:
    statements: list[str] = []
    for case_binding in fixture_binding.get("case_bindings", []):
        if not isinstance(case_binding, dict):
            continue
        case_source = c_oracle_record_pointer_identity_return_case_execution_source(
            spec, signature, case_binding
        )
        if case_source is None:
            case_id = str(case_binding.get("id") or "unknown-case")
            statements.append(
                f"  /* TODO: fixture case {case_id} is not supported by this record-pointer identity-return draft generator. */\n"
            )
            continue
        statements.append(case_source["statements"])
    return {"declarations": "", "statements": "".join(statements)}
