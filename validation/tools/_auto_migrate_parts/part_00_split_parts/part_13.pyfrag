RECORD_U32_FIELD_SCALAR_WRAPPING_ADD_STATE_KIND = (
    "record_u32_field_scalar_wrapping_add_state"
)


def record_u32_field_scalar_wrapping_add_state_replay_supported(
    spec: dict[str, Any], fixture_binding: dict[str, Any] | None = None
) -> bool:
    return record_u32_field_scalar_wrapping_add_state_replay_contract(
        spec, fixture_binding
    ) is not None


def record_u32_field_scalar_wrapping_add_state_replay_contract(
    spec: dict[str, Any], fixture_binding: dict[str, Any] | None = None
) -> dict[str, Any] | None:
    contract = spec.get("replay_contract")
    if not isinstance(contract, dict) or contract.get("kind") != RECORD_U32_FIELD_SCALAR_WRAPPING_ADD_STATE_KIND:
        return None
    if set(contract) != {
        "schema_version", "kind", "entry_arguments", "state_output", "state_update",
        "return", "noalias_required",
    }:
        raise ValueError("record field scalar-add replay contract shape drifted")
    if contract.get("schema_version") != 1:
        raise ValueError("record field scalar-add replay schema_version must be 1")

    entries = contract.get("entry_arguments")
    if not isinstance(entries, list) or len(entries) != 3:
        raise ValueError("record field scalar-add replay requires exactly three entry arguments")
    records: dict[str, dict[str, Any]] = {}
    scalar: dict[str, Any] | None = None
    mutable: dict[str, Any] | None = None
    value_record: dict[str, Any] | None = None
    fixture_fields: list[str] = []
    for index, entry in enumerate(entries):
        if not isinstance(entry, dict):
            raise ValueError(f"record field scalar-add entry argument {index} must be an object")
        parameter = scripted_external_replay_identifier(
            entry.get("parameter"), f"record field scalar-add entry {index} parameter"
        )
        if parameter in records or (scalar and parameter == scalar["parameter"]):
            raise ValueError("record field scalar-add entry parameters must be unique")
        if set(entry) == {
            "parameter", "c_type", "rust_type", "pass_mode", "direction", "initializer",
        }:
            rust_type = scripted_external_replay_identifier(
                entry.get("rust_type"), f"record field scalar-add entry {index} rust_type"
            )
            initializer = scripted_record_validate_initializer(
                entry.get("initializer"), f"record field scalar-add entry {index} initializer"
            )
            if initializer["record_type"] != rust_type:
                raise ValueError("record field scalar-add initializer type drifted")
            fixture_fields.extend(
                field for field, _ in scripted_record_initializer_fixture_paths(initializer)
            )
            if entry.get("pass_mode") == "mutable_ref":
                if mutable is not None or entry.get("direction") != "inout":
                    raise ValueError("record field scalar-add requires one mutable inout record")
                expected_c_type = f"struct {rust_type} *"
                mutable = entry
            elif entry.get("pass_mode") == "value":
                if value_record is not None or entry.get("direction") != "input":
                    raise ValueError("record field scalar-add requires one by-value input record")
                expected_c_type = f"struct {rust_type}"
                value_record = entry
            else:
                raise ValueError("record field scalar-add record pass_mode is unsupported")
            if normalize_c_type(str(entry.get("c_type") or "")) != normalize_c_type(expected_c_type):
                raise ValueError("record field scalar-add record C type drifted")
            records[parameter] = entry
        elif set(entry) == {
            "parameter", "c_type", "rust_type", "pass_mode", "direction", "fixture_field",
        }:
            if scalar is not None:
                raise ValueError("record field scalar-add requires one scalar entry")
            fixture_field = scripted_external_replay_identifier(
                entry.get("fixture_field"), "record field scalar-add scalar fixture_field"
            )
            if (
                normalize_c_type(str(entry.get("c_type") or "")) != "uint32_t"
                or entry.get("rust_type") != "u32"
                or entry.get("pass_mode") != "value"
                or entry.get("direction") != "input"
            ):
                raise ValueError("record field scalar-add scalar entry must be by-value u32")
            scalar = entry
            fixture_fields.append(fixture_field)
        else:
            raise ValueError(f"record field scalar-add entry argument {index} shape drifted")
    if mutable is None or value_record is None or scalar is None:
        raise ValueError("record field scalar-add entry role set is incomplete")

    state = contract.get("state_output")
    if not isinstance(state, dict) or set(state) != {
        "parameter", "field_path", "fixture_field", "rust_type",
    }:
        raise ValueError("record field scalar-add state_output shape drifted")
    state_parameter = scripted_external_replay_identifier(
        state.get("parameter"), "record field scalar-add state parameter"
    )
    state_fixture = scripted_external_replay_identifier(
        state.get("fixture_field"), "record field scalar-add state fixture_field"
    )
    state_path = scripted_record_field_path(state.get("field_path"), "scalar-add state field_path")
    if state.get("rust_type") != "u32" or len(state_path) < 2:
        raise ValueError("record field scalar-add target must be a nested u32 field")
    if state_parameter != mutable["parameter"] or state_path not in dict(
        scripted_record_initializer_fixture_paths(mutable["initializer"])
    ).values():
        raise ValueError("record field scalar-add state target is not initialized")

    update = contract.get("state_update")
    if not isinstance(update, dict) or set(update) != {"operation", "record_field", "scalar"}:
        raise ValueError("record field scalar-add state_update shape drifted")
    if update.get("operation") != "wrapping_add":
        raise ValueError("record field scalar-add operation must be wrapping_add")
    record_field = update.get("record_field")
    if not isinstance(record_field, dict) or set(record_field) != {
        "parameter", "field_path", "rust_type", "mode",
    }:
        raise ValueError("record field scalar-add record_field shape drifted")
    source_parameter = scripted_external_replay_identifier(
        record_field.get("parameter"), "record field scalar-add source parameter"
    )
    source_path = scripted_record_field_path(
        record_field.get("field_path"), "scalar-add source field_path"
    )
    if (
        source_parameter != value_record["parameter"]
        or record_field.get("rust_type") != "u32"
        or record_field.get("mode") != "direct_field_value"
        or len(source_path) != 1
        or source_path not in dict(
            scripted_record_initializer_fixture_paths(value_record["initializer"])
        ).values()
    ):
        raise ValueError("record field scalar-add source must bind one direct initialized u32 field")
    scalar_binding = update.get("scalar")
    if not isinstance(scalar_binding, dict) or set(scalar_binding) != {
        "parameter", "fixture_field", "rust_type", "mode",
    }:
        raise ValueError("record field scalar-add scalar binding shape drifted")
    if (
        scalar_binding.get("parameter") != scalar["parameter"]
        or scalar_binding.get("fixture_field") != scalar["fixture_field"]
        or scalar_binding.get("rust_type") != "u32"
        or scalar_binding.get("mode") != "scalar_value"
    ):
        raise ValueError("record field scalar-add scalar binding drifted")

    result = contract.get("return")
    if not isinstance(result, dict) or set(result) != {"fixture_field", "rust_type", "value"}:
        raise ValueError("record field scalar-add return shape drifted")
    return_fixture = scripted_external_replay_identifier(
        result.get("fixture_field"), "record field scalar-add return fixture_field"
    )
    if result.get("rust_type") != "bool" or type(result.get("value")) is not bool:
        raise ValueError("record field scalar-add return must declare a bool constant")

    declared = scripted_record_noalias_pairs(
        contract.get("noalias_required"), "record field scalar-add noalias_required"
    )
    pointer = spec.get("c_boundary", {}).get("pointer_contract")
    if not isinstance(pointer, dict) or pointer.get("aliasing_proven") is not True:
        raise ValueError("record field scalar-add requires proven pointer metadata")
    boundary = scripted_record_noalias_pairs(
        pointer.get("noalias_required"), "record field scalar-add pointer noalias_required"
    )
    if declared or boundary or declared != boundary:
        raise ValueError("record field scalar-add unique pointer root requires empty noalias pairs")

    outputs = [return_fixture, state_fixture]
    if len([*fixture_fields, *outputs]) != len(set([*fixture_fields, *outputs])):
        raise ValueError("record field scalar-add fixture and output fields must be unique")
    if behavior_fields(spec) != outputs:
        raise ValueError("record field scalar-add observable output mapping drifted")
    validate_record_field_scalar_add_signature(spec, contract)
    if fixture_binding is not None:
        validate_record_field_scalar_add_cases(spec, fixture_binding, contract)
    return contract


def validate_record_field_scalar_add_signature(
    spec: dict[str, Any], contract: dict[str, Any]
) -> None:
    signature = c_function_signature(spec)
    if not signature or signature.get("function") != spec.get("function_name"):
        raise ValueError("record field scalar-add entry signature is missing")
    if normalize_c_type(str(signature.get("return_type") or "")) not in {"bool", "_Bool"}:
        raise ValueError("record field scalar-add entry return type must be bool")
    actual = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    entries = contract["entry_arguments"]
    if [item.get("name") for item in actual] != [item["parameter"] for item in entries]:
        raise ValueError("record field scalar-add entry parameters drifted")
    if [normalize_c_type(str(item.get("c_type") or "")) for item in actual] != [
        normalize_c_type(str(item["c_type"])) for item in entries
    ]:
        raise ValueError("record field scalar-add entry parameter types drifted")
    if [item.get("direction") for item in actual] != [item["direction"] for item in entries]:
        raise ValueError("record field scalar-add entry parameter directions drifted")


def validate_record_field_scalar_add_cases(
    spec: dict[str, Any], fixture_binding: dict[str, Any], contract: dict[str, Any]
) -> None:
    cases = fixture_binding.get("case_bindings")
    if not isinstance(cases, list) or not cases:
        raise ValueError("record field scalar-add fixture cases are missing")
    fields = [contract["return"]["fixture_field"], contract["state_output"]["fixture_field"]]
    for case in cases:
        payload = oracle_fixture_input_payload(spec, case)
        expected = case.get("expected_outputs")
        if not isinstance(payload, dict) or not isinstance(expected, dict) or set(expected) != set(fields):
            raise ValueError("record field scalar-add fixture case is incomplete")
        for entry in contract["entry_arguments"]:
            if "initializer" in entry:
                for fixture_field, _ in scripted_record_initializer_fixture_paths(entry["initializer"]):
                    if not is_uint32_value(payload.get(fixture_field)):
                        raise ValueError("record field scalar-add record fixture field must be u32")
            elif not is_uint32_value(payload.get(entry["fixture_field"])):
                raise ValueError("record field scalar-add scalar fixture field must be u32")
        modeled = record_field_scalar_add_expected_outputs(payload, contract)
        if expected != modeled:
            raise ValueError("record field scalar-add expected outputs drifted")
        if record_field_scalar_sub_state(payload, contract) == modeled[fields[1]]:
            raise ValueError("record field scalar-add fixture does not observe add-to-sub mutation")


def record_field_scalar_add_expected_outputs(
    payload: dict[str, Any], contract: dict[str, Any]
) -> dict[str, Any]:
    update = contract["state_update"]
    source = scripted_record_initial_field_value(
        payload,
        {str(item["parameter"]): item for item in contract["entry_arguments"] if "initializer" in item},
        update["record_field"],
    )
    scalar = int(payload[update["scalar"]["fixture_field"]])
    return {
        str(contract["return"]["fixture_field"]): bool(contract["return"]["value"]),
        str(contract["state_output"]["fixture_field"]): (source + scalar) & 0xFFFFFFFF,
    }


def record_field_scalar_sub_state(payload: dict[str, Any], contract: dict[str, Any]) -> int:
    update = contract["state_update"]
    source = scripted_record_initial_field_value(
        payload,
        {str(item["parameter"]): item for item in contract["entry_arguments"] if "initializer" in item},
        update["record_field"],
    )
    return (source - int(payload[update["scalar"]["fixture_field"]])) & 0xFFFFFFFF
