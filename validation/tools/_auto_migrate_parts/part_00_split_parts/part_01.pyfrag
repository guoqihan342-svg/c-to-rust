    return_type = str(signature.get("return_type") or signature.get("returns") or "")
    return_rust_type = None
    unsupported_reasons: list[str] = []
    if not signature:
        unsupported_reasons.append("missing_signature")
    if primitive_rust_type(return_type) is None:
        unsupported_reasons.append("unsupported_return_type")
    for param in parameters:
        if primitive_rust_type(param["c_type"]) is None:
            unsupported_reasons.append(f"unsupported_parameter_type:{param['name']}")
    if not parameters:
        unsupported_reasons.append("missing_parameters")
    modeled_strlen = is_modeled_strlen_contract(name, return_type, parameters)
    if modeled_strlen:
        unsupported_reasons = []
    accepted_named_slice = accepted_named_slice_evidence_for_callee(spec, item, signature, name)
    if accepted_named_slice:
        unsupported_reasons = []
    scripted_fixture_contract = scripted_external_u32_call_bool_out_external_binding(
        spec,
        name,
        return_type,
        parameters,
    )
    if scripted_fixture_contract is not None:
        unsupported_reasons = []
        return_rust_type = "u32"
        for param, rust_type in zip(parameters, ("u32", "u32", "usize"), strict=True):
            param["rust_type"] = rust_type
    scripted_sequence_fixture_contract = (
        scripted_external_record_u32_sequence_do_while_state_external_binding(
            spec,
            name,
            return_type,
            parameters,
        )
    )
    if scripted_sequence_fixture_contract is not None:
        unsupported_reasons = []
        return_rust_type = "u32"
        entry_by_name = {
            str(entry["parameter"]): entry
            for entry in scripted_sequence_fixture_contract["entry_arguments"]
        }
        for param, observation in zip(
            parameters,
            scripted_sequence_fixture_contract["external_callee"]["arguments"],
            strict=True,
        ):
            param["rust_type"] = scripted_sequence_external_rust_type(
                observation, entry_by_name
            )
    scripted_record_fixture_contract = (
        scripted_external_record_u32_call_bool_state_external_binding(
            spec,
            name,
            return_type,
            parameters,
        )
    )
    if scripted_record_fixture_contract is not None:
        unsupported_reasons = []
        return_rust_type = "u32"
        entry_by_name = {
            str(item["parameter"]): item
            for item in scripted_record_fixture_contract["entry_arguments"]
        }
        for param, observation in zip(
            parameters,
            scripted_record_fixture_contract["external_callee"]["arguments"],
            strict=True,
        ):
            record_type = entry_by_name[str(observation["entry_parameter"])]["rust_type"]
            param["rust_type"] = f"&mut {record_type}"
    declared_external_compile_context = is_declared_external_context_signature(
        item,
        signature,
        name,
        return_type,
        parameters,
    )
    if declared_external_compile_context:
        unsupported_reasons = []
        return_rust_type = declared_external_context_rust_type(return_type, position="return")
        for param in parameters:
            rust_type = declared_external_context_rust_type(param["c_type"], position="param")
            if rust_type is not None:
                param["rust_type"] = rust_type
    stub_kind = "compile_only"
    stub_boundary = item.get("stub_boundary", "compile_only")
    stub_generation = "generated_compile_only"
    model_contract = ""
    if modeled_strlen:
        stub_boundary = "stdlib_readonly_string_model"
        stub_generation = "not_emitted_modeled_stdlib"
        model_contract = "strlen_readonly_nul_terminated"
    if declared_external_compile_context:
        stub_boundary = "declared_external_direct_callee_context_only"
        stub_generation = "not_emitted_declared_signature_context"
        model_contract = "declared_external_direct_callee_signature_context"
    if scripted_fixture_contract is not None:
        stub_boundary = "scripted_fixture_only_no_real_callee_semantics"
        stub_generation = "generated_fixture_only_scripted_external"
        model_contract = "scripted_external_u32_call_bool_out"
    if scripted_record_fixture_contract is not None:
        stub_boundary = "scripted_fixture_only_no_real_callee_semantics"
        stub_generation = "generated_fixture_only_scripted_external"
        model_contract = SCRIPTED_EXTERNAL_RECORD_U32_CALL_BOOL_STATE_KIND
    if accepted_named_slice:
        stub_kind = "accepted_named_slice_evidence"
        stub_boundary = "accepted_named_slice_context_only"
        stub_generation = "not_emitted_named_slice_evidence"
        model_contract = "accepted_named_slice_evidence"
    descriptor = {
        "name": name,
        "signature_ref": signature_ref,
        "source_ref": item.get("source_ref") or signature.get("source_ref") or "",
        "source_files": item.get("source_files") or source_files_for_external_callee(spec, name),
        "header_files": item.get("header_files", []),
        "definition_status": item.get("definition_status") or signature.get("definition_status") or "real_source_bound",
        "stub_kind": stub_kind,
        "stub_boundary": stub_boundary,
        "stub_generation": stub_generation,
        "model_contract": model_contract,
        "semantics_verified": False,
        "parameters": parameters,
        "return_type": return_type,
        "supported": not unsupported_reasons,
        "unsupported_reasons": sorted(set(unsupported_reasons)),
    }
    replay_contract = external_callee_replay_contract(item, signature)
    if replay_contract is not None:
        descriptor["replay_contract"] = replay_contract
    if return_rust_type is not None:
        descriptor["return_rust_type"] = return_rust_type
    if accepted_named_slice:
        descriptor["accepted_named_slice_evidence"] = accepted_named_slice
    return descriptor


def external_callee_replay_contract(
    item: dict[str, Any],
    signature: dict[str, Any],
) -> dict[str, Any] | None:
    contract = item.get("replay_contract")
    if not isinstance(contract, dict):
        contract = signature.get("replay_contract")
    if not isinstance(contract, dict):
        return None
    return dict(contract)


def source_files_for_external_callee(spec: dict[str, Any], name: str) -> list[dict[str, Any]]:
    files = []
    for item in spec.get("c_boundary", {}).get("files", []):
        role = str(item.get("role") or "")
        path = item.get("path")
        if path and (role == "external_direct_callee" or name in str(path)):
            files.append({"path": path, "sha256": item.get("sha256", "")})
    return files


def external_direct_callee_context(
    spec: dict[str, Any],
    call_expressions: list[dict[str, Any]] | None,
) -> dict[str, Any]:
    entry_name = entry_function_name(spec)
    declared_map = declared_external_direct_callee_map(spec)
    callee_names = sorted(
        external_direct_callee_names(
            spec,
            call_expressions,
            entry_name,
            set(declared_map),
        )
    )
    declared = []
    blocked = []
    for name in callee_names:
        descriptor = declared_map.get(name)
        if descriptor is None:
            blocked.append(
                {
                    "name": name,
                    "reason": "missing_declared_external_direct_callee",
                    "stub_kind": "none",
                    "semantics_verified": False,
                }
            )
            continue
        if not descriptor.get("supported"):
            blocked.append(external_callee_block_from_descriptor(name, descriptor))
            continue
        declared.append(descriptor)

    status = "not_applicable"
    if blocked:
        status = "blocked"
    elif declared:
        status = "recorded"
    return {
        "status": status,
        "declarations": [declared_map[name] for name in sorted(declared_map)],
        "declared": declared,
        "blocked": blocked,
        "declared_spec_count": len(declared_map),
        "declared_spec_names": sorted(declared_map),
        "declared_count": len(declared),
        "blocked_count": len(blocked),
    }


def external_callee_block_from_descriptor(name: str, descriptor: dict[str, Any]) -> dict[str, Any]:
    return {
        "name": name,
        "reason": "unsupported_external_direct_callee_signature",
        "signature_ref": descriptor.get("signature_ref", ""),
        "source_ref": descriptor.get("source_ref", ""),
        "definition_status": descriptor.get("definition_status", ""),
        "unsupported_reasons": descriptor.get("unsupported_reasons", []),
        "stub_kind": "none",
        "semantics_verified": False,
    }


def external_direct_callee_names(
    spec: dict[str, Any],
    call_expressions: list[dict[str, Any]] | None,
    entry_name: str,
    declared_names: set[str] | None = None,
) -> set[str]:
    names = {
        str(call.get("callee"))
        for call in (call_expressions or [])
        if call.get("callee") and str(call.get("callee")) != entry_name
    }
    declared_names = declared_names or set()
    for dependency in spec.get("c_boundary", {}).get("direct_dependencies", []):
        if dependency.get("kind") != "callee":
            continue
        name = str(dependency.get("name") or "")
        if name and name != entry_name and name in declared_names:
            names.add(name)
    return names


def external_context_input_ref(evidence_dir: Path, slice_id: str, context: dict[str, Any]) -> dict[str, Any]:
    return {
        "path": rel(evidence_dir / f"l3-{slice_id}-context-pack.json"),
        "status": context["status"],
        "declared_count": context["declared_count"],
        "declared_spec_count": context["declared_spec_count"],
        "declared_spec_names": context["declared_spec_names"],
        "blocked_count": context["blocked_count"],
    }


def bind_external_callee_context(
    call_expressions: list[dict[str, Any]],
    context: dict[str, Any],
) -> list[dict[str, Any]]:
    declared = {item["name"]: item for item in context.get("declared", [])}
    blocked = {item["name"]: item for item in context.get("blocked", [])}
    bound = []
    for call in call_expressions:
        enriched = dict(call)
        callee = str(call.get("callee") or "")
        if callee in declared:
            descriptor = declared[callee]
            enriched.update(
                {
                    "callee_scope": "external_direct_callee",
                    "callee_signature_id": descriptor["signature_ref"],
                    "callee_source_ref": descriptor.get("source_ref", ""),
                    "definition_status": descriptor.get("definition_status", ""),
                    "stub_status": "compile_only",
                }
            )
        elif callee in blocked:
            enriched.update(
                {
                    "callee_scope": "external_direct_callee",
                    "stub_status": "blocked",
                    "blocked_reason": blocked[callee].get("reason", ""),
                }
            )
        bound.append(enriched)
    return bound


def call_edge_to_callee_binding(
    call_expressions: list[dict[str, Any]],
    context: dict[str, Any],
) -> list[dict[str, Any]]:
    bindings = []
    declared = {item["name"]: item for item in context.get("declared", [])}
    for call in call_expressions:
        callee = str(call.get("callee") or "")
        if callee not in declared:
            continue
        descriptor = declared[callee]
        stub_kind = str(descriptor.get("stub_kind") or "compile_only")
        if stub_kind not in {"compile_only", "accepted_named_slice_evidence"}:
            continue
        bindings.append(
            {
                "callee": callee,
                "signature_ref": descriptor["signature_ref"],
                "source_expression": call.get("source_expression", ""),
                "statement_context": call.get("statement_context", ""),
                "stub_kind": stub_kind,
                "semantics_verified": False,
            }
        )
    return bindings


def external_callee_sources(context: dict[str, Any]) -> list[dict[str, Any]]:
    sources = []
    for callee in context.get("declared", []):
        for source in callee.get("source_files", []):
            sources.append(
                {
                    "callee": callee["name"],
                    "path": source.get("path", ""),
                    "sha256": source.get("sha256", ""),
                }
            )
    return sources


def external_signature_bindings(context: dict[str, Any]) -> list[dict[str, Any]]:
    return [
        {
            "callee": callee["name"],
            "signature_ref": callee["signature_ref"],
            "definition_status": callee.get("definition_status", ""),
            "stub_kind": callee["stub_kind"],
            "semantics_verified": False,
        }
        for callee in context.get("declared", [])
    ]


def external_stub_boundaries(context: dict[str, Any]) -> list[dict[str, Any]]:
    return [
        {
            "callee": callee["name"],
            "stub_kind": callee["stub_kind"],
            "allowed_use": (
                "named_slice_evidence_reference_only"
                if callee.get("stub_kind") == "accepted_named_slice_evidence"
                else "fixture_bound_rust_replay_only"
                if callee.get("model_contract")
                in {
                    "scripted_external_u32_call_bool_out",
                    SCRIPTED_EXTERNAL_RECORD_U32_CALL_BOOL_STATE_KIND,
                }
                else "standalone_rust_check_only"
            ),
            "fixture_only": callee.get("model_contract")
            in {
                "scripted_external_u32_call_bool_out",
                SCRIPTED_EXTERNAL_RECORD_U32_CALL_BOOL_STATE_KIND,
            },
            "semantics_verified": False,
        }
        for callee in context.get("declared", [])
    ]


def external_scope_stub_kind(context: dict[str, Any]) -> str:
    kinds = {
        str(callee.get("stub_kind") or "compile_only")
        for callee in context.get("declared", [])
    }
    if not kinds:
        return "none"
    if len(kinds) == 1:
        return next(iter(kinds))
    return "mixed_context"


def external_callee_claim_scope(context: dict[str, Any]) -> dict[str, Any]:
    if context["status"] == "recorded":
        status = "compile_context_only"
    else:
        status = context["status"]
    return {
        "status": status,
        "declared_spec_count": context["declared_spec_count"],
        "declared_spec_names": context["declared_spec_names"],
        "declared_count": context["declared_count"],
        "blocked_count": context["blocked_count"],
        "stub_kind": external_scope_stub_kind(context),
        "semantics_verified": False,
    }


def rust_check_external_context(context: dict[str, Any]) -> dict[str, Any]:
    return {
        "status": context["status"],
        "declared_spec_count": context["declared_spec_count"],
        "declared_spec_names": context["declared_spec_names"],
        "declared_count": context["declared_count"],
        "blocked_count": context["blocked_count"],
        "declared_callees": [
            {
                "name": callee["name"],
                "signature_ref": callee["signature_ref"],
                "stub_kind": callee["stub_kind"],
                "binding_status": rust_check_binding_status(callee),
                "semantics_verified": False,
            }
            for callee in context.get("declared", [])
        ],
        "blocked_callees": context.get("blocked", []),
    }


def load_plan_call_expressions(evidence_dir: Path, slice_id: str) -> list[dict[str, Any]]:
    plan_path = evidence_dir / f"l3-{slice_id}-auto-translation-plan.json"
    if not plan_path.exists():
        return []
    plan = read_json(plan_path)
    return plan.get("translation_summary", {}).get("call_expressions", [])


def rust_check_binding_status(callee: dict[str, Any]) -> str:
    binding = callee.get("rust_check_binding")
    if isinstance(binding, dict) and binding.get("status"):
        return str(binding["status"])
    if callee.get("stub_generation") == "generated_compile_only":
        return "generated_compile_only"
    if str(callee.get("stub_generation") or "").startswith("not_emitted_"):
        return "not_emitted"
    return "unknown"


def mark_rust_check_binding(
    callee: dict[str, Any],
    status: str,
    signature: str,
    *,
    allowed_use: str = "rustc_compile_only",
) -> None:
    callee["rust_check_binding"] = {
        "status": status,
        "allowed_use": allowed_use,
        "signature": signature,
        "semantics_verified": False,
    }


def rust_check_declared_callee_signature(callee: dict[str, Any]) -> str:
    name = rust_identifier(callee["name"])
    params = []
    for index, param in enumerate(callee.get("parameters", [])):
        param_name = rust_identifier(param.get("name") or f"arg{index + 1}")
        rust_type = (
            param.get("rust_type")
            or primitive_rust_type(param.get("c_type", ""))
            or "i32"
        )
        params.append(f"{param_name}: {rust_type}")
    return_type = (
        callee.get("return_rust_type")
        or primitive_rust_type(callee.get("return_type", ""))
        or "i32"
    )
    return f"fn {name}({', '.join(params)}) -> {return_type}"


def rust_function_declared(text: str, name: str) -> bool:
    escaped_name = re.escape(name)
    return (
        re.search(
            rf"(?m)^\s*(?:pub(?:\([^)]*\))?\s+)?(?:unsafe\s+)?fn\s+{escaped_name}\s*\(",
            text,
        )
        is not None
    )


def ignored_non_observable_void_replay_contract(
    callee: dict[str, Any],
    spec: dict[str, Any] | None,
) -> dict[str, Any] | None:
    if not isinstance(spec, dict):
        return None
    contract = callee.get("replay_contract")
    if not isinstance(contract, dict):
        return None
    if contract.get("kind") != "ignored_non_observable_void":
        return None
    return_type = (
        callee.get("return_rust_type")
        or declared_external_context_rust_type(callee.get("return_type", ""), position="return")
    )
    if return_type != "()":
        return None
    contract_outputs = [str(item) for item in contract.get("observable_outputs") or []]
    if not contract_outputs:
        return None
    observed_outputs = set(behavior_fields(spec))
    if not set(contract_outputs).issubset(observed_outputs):
        return None
    return dict(contract)


def rust_check_ignored_non_observable_void_stub(
    callee: dict[str, Any],
    text: str,
    spec: dict[str, Any] | None = None,
) -> str | None:
    contract = ignored_non_observable_void_replay_contract(callee, spec)
    if contract is None:
        return None
    name = rust_identifier(callee["name"])
    signature = rust_check_declared_callee_signature(callee)
    if rust_function_declared(text, name):
        mark_rust_check_binding(
            callee,
            "already_present",
            signature,
            allowed_use="fixture_bound_rust_replay_only",
        )
        callee["rust_check_binding"]["replay_contract_kind"] = contract["kind"]
        return None
    param_names = [
        rust_identifier(param.get("name") or f"arg{index + 1}")
        for index, param in enumerate(callee.get("parameters", []))
    ]
    body_lines = []
    if len(param_names) == 1:
        body_lines.append(f"    let _ = {param_names[0]};")
    elif param_names:
        body_lines.append(f"    let _ = ({', '.join(param_names)});")
    body_lines.append("    // ignored non-observable void external callee per fixture replay_contract")
    mark_rust_check_binding(
        callee,
        "declared_ignored_non_observable_void",
        signature,
        allowed_use="fixture_bound_rust_replay_only",
    )
    callee["rust_check_binding"]["replay_contract_kind"] = contract["kind"]
    return signature + " {\n" + "\n".join(body_lines) + "\n}"


def flashdb_kv_set_fixture_model_allowed(spec: dict[str, Any] | None, name: str) -> bool:
    return (
        isinstance(spec, dict)
        and spec.get("target_id") == "flashdb"
        and spec.get("slice_id") == "real-fdb-kv-set"
        and behavior_fields(spec) == ["return_code"]
        and name in {"fdb_blob_make", "fdb_kv_set_blob", "fdb_kv_del"}
    )


def flashdb_kv_del_fixture_model_allowed(spec: dict[str, Any] | None, name: str) -> bool:
    return (
        isinstance(spec, dict)
        and spec.get("target_id") == "flashdb"
        and spec.get("slice_id") == "real-fdb-kv-del"
        and behavior_fields(spec) == ["return_code"]
        and name in {"db_init_ok", "db_name", "db_lock", "del_kv", "db_unlock"}
    )


def rust_check_harness_only_external_stub(
    callee: dict[str, Any],
    text: str,
    spec: dict[str, Any] | None = None,
) -> str | None:
    name = rust_identifier(callee["name"])
    if flashdb_kv_del_fixture_model_allowed(spec, name):
        signatures = {
            "db_init_ok": "pub fn db_init_ok(db: *mut core::ffi::c_void) -> bool",
            "db_name": (
                "pub fn db_name("
                "db: *mut core::ffi::c_void"
                ") -> *const core::ffi::c_char"
            ),
            "db_lock": "pub fn db_lock(db: *mut core::ffi::c_void)",
            "del_kv": (
                "pub fn del_kv("
                "db: *mut core::ffi::c_void, "
                "key: *const core::ffi::c_void, "
                "old_kv: *mut core::ffi::c_void, "
                "complete_del: bool"
                ") -> i32"
            ),
            "db_unlock": "pub fn db_unlock(db: *mut core::ffi::c_void)",
        }
        signature = signatures.get(name)
        if signature is None:
            return None
        if rust_function_declared(text, name):
            mark_rust_check_binding(
                callee,
                "already_present",
                signature,
                allowed_use="fixture_bound_rust_replay_only",
            )
            return None
        body_lines = {
            "db_init_ok": [
                "    let _ = db;",
                "    false",
            ],
            "db_name": [
                "    let _ = db;",
                '    b"unit-kv\\0".as_ptr().cast::<core::ffi::c_char>()',
            ],
            "db_lock": [
                "    let _ = db;",
                '    unimplemented!("fdb_kv_del fixture model: db_lock is not exercised by uninitialized DB cases")',
            ],
            "del_kv": [
                "    let _ = (db, key, old_kv, complete_del);",
                '    unimplemented!("fdb_kv_del fixture model: del_kv is not exercised by uninitialized DB cases")',
            ],
            "db_unlock": [
                "    let _ = db;",
                '    unimplemented!("fdb_kv_del fixture model: db_unlock is not exercised by uninitialized DB cases")',
            ],
        }[name]
        mark_rust_check_binding(
            callee,
            "fixture_model",
            signature,
            allowed_use="fixture_bound_rust_replay_only",
        )
        return signature + " {\n" + "\n".join(body_lines) + "\n}"
    if "FdbBlob" not in text:
        return None
    signatures = {
        "fdb_blob_make": (
            "pub fn fdb_blob_make("
            "blob: &mut FdbBlob, "
            "value_buf: *const core::ffi::c_void, "
            "buf_len: usize"
            ") -> &mut FdbBlob"
        ),
        "fdb_kv_set_blob": (
            "pub fn fdb_kv_set_blob("
            "db: *mut core::ffi::c_void, "
            "key: *const core::ffi::c_void, "
            "blob: &mut FdbBlob"
            ") -> i32"
        ),
        "fdb_kv_del": (
            "pub fn fdb_kv_del("
            "db: *mut core::ffi::c_void, "
            "key: *const core::ffi::c_void"
            ") -> i32"
        ),
    }
    signature = signatures.get(name)
    if signature is None:
        return None
    if rust_function_declared(text, name):
        mark_rust_check_binding(
            callee,
            "already_present",
            signature,
            allowed_use=(
                "fixture_bound_rust_replay_only"
                if flashdb_kv_set_fixture_model_allowed(spec, name)
                else "rustc_compile_only"
            ),
        )
        return None
    if flashdb_kv_set_fixture_model_allowed(spec, name):
        body_lines = {
            "fdb_blob_make": [
                "    let _ = (value_buf, buf_len);",
                "    blob",
            ],
            "fdb_kv_set_blob": [
                "    let _ = (db, key, blob);",
                "    7i32",
            ],
            "fdb_kv_del": [
                "    let _ = (db, key);",
                "    7i32",
            ],
        }[name]
        mark_rust_check_binding(
            callee,
            "fixture_model",
            signature,
            allowed_use="fixture_bound_rust_replay_only",
        )
        return signature + " {\n" + "\n".join(body_lines) + "\n}"
    body_lines = {
        "fdb_blob_make": [
            "    let _ = (value_buf, buf_len);",
            '    unimplemented!("rust-check harness-only external callee binding: fdb_blob_make")',
        ],
        "fdb_kv_set_blob": [
            "    let _ = (db, key, blob);",
            '    unimplemented!("rust-check harness-only external callee binding: fdb_kv_set_blob")',
        ],
        "fdb_kv_del": [
            "    let _ = (db, key);",
            '    unimplemented!("rust-check harness-only external callee binding: fdb_kv_del")',
        ],
    }[name]
    mark_rust_check_binding(callee, "harness_only", signature)
    return signature + " {\n" + "\n".join(body_lines) + "\n}"


def rust_check_external_binding_report(context: dict[str, Any]) -> dict[str, Any]:
    bindings = []
    for callee in context.get("declared", []):
        if not isinstance(callee.get("rust_check_binding"), dict):
            continue
        binding = {
            "name": callee["name"],
            "status": callee["rust_check_binding"]["status"],
            "allowed_use": callee["rust_check_binding"]["allowed_use"],
            "signature": callee["rust_check_binding"]["signature"],
            "semantics_verified": False,
        }
        if callee["rust_check_binding"].get("replay_contract_kind"):
            binding["replay_contract_kind"] = callee["rust_check_binding"]["replay_contract_kind"]
        if callee["rust_check_binding"].get("fixture_only") is True:
            binding["fixture_only"] = True
        bindings.append(binding)
    allowed_uses = {str(item["allowed_use"]) for item in bindings}
    return {
        "status": "emitted" if bindings else "none",
        "allowed_use": next(iter(allowed_uses)) if len(allowed_uses) == 1 else "mixed",
        "semantics_verified": False,
        "bindings": bindings,
    }


def inject_external_callee_stubs(
    draft_path: Path,
    context: dict[str, Any],
    spec: dict[str, Any] | None = None,
) -> bool:
    callees = context.get("declared", [])
    if not callees:
        return False
    text = draft_path.read_text(encoding="utf-8")
    stubs = []
    for callee in callees:
        scripted_sequence_stub = (
            rust_check_scripted_external_record_u32_sequence_do_while_state_stub(
                callee, text, spec
            )
        )
        if scripted_sequence_stub is not None:
            stubs.append(scripted_sequence_stub)
            continue
        scripted_sequence_binding = callee.get("rust_check_binding")
        if (
            isinstance(scripted_sequence_binding, dict)
            and scripted_sequence_binding.get("replay_contract_kind")
            == SCRIPTED_EXTERNAL_RECORD_U32_SEQUENCE_DO_WHILE_STATE_KIND
        ):
            continue
        scripted_record_stub = rust_check_scripted_external_record_u32_call_bool_state_stub(
            callee, text, spec
        )
        if scripted_record_stub is not None:
            stubs.append(scripted_record_stub)
            continue
        scripted_record_binding = callee.get("rust_check_binding")
        if (
            isinstance(scripted_record_binding, dict)
            and scripted_record_binding.get("replay_contract_kind")
            == SCRIPTED_EXTERNAL_RECORD_U32_CALL_BOOL_STATE_KIND
        ):
            continue
        scripted_stub = rust_check_scripted_external_u32_call_bool_out_stub(callee, text, spec)
        if scripted_stub is not None:
            stubs.append(scripted_stub)
            continue
        scripted_binding = callee.get("rust_check_binding")
        if (
            isinstance(scripted_binding, dict)
            and scripted_binding.get("replay_contract_kind")
            == SCRIPTED_EXTERNAL_U32_CALL_BOOL_OUT_KIND
        ):
            continue
        if callee.get("stub_generation") == "not_emitted_modeled_stdlib":
            continue
        if callee.get("stub_generation") in {
            "not_emitted_named_slice_evidence",
            "not_emitted_declared_signature_context",
            "not_emitted_flashdb_signature_context",
        }:
            stub = rust_check_harness_only_external_stub(callee, text, spec)
            if stub is not None:
                stubs.append(stub)
                continue
            if isinstance(callee.get("rust_check_binding"), dict):
                continue
            if callee.get("stub_generation") != "not_emitted_declared_signature_context":
                continue
        noop_stub = rust_check_ignored_non_observable_void_stub(callee, text, spec)
        if noop_stub is not None:
            stubs.append(noop_stub)
            continue
        signature = rust_check_declared_callee_signature(callee)
        name = rust_identifier(callee["name"])
        if rust_function_declared(text, name):
            mark_rust_check_binding(callee, "already_present", signature)
            continue
        mark_rust_check_binding(callee, "generated_compile_only", signature)
        stubs.append(
            f'{signature} {{ unimplemented!("external callee context stub: {callee["name"]}") }}'
        )
    if not stubs:
        return False
    draft_path.write_text("\n".join(stubs) + "\n\n" + text, encoding="utf-8")
    return True


def translator_feature_set(
    *, emit_clang_dry_run: bool = False, emit_clang_lowering_report: bool = False
) -> list[str]:
    features: list[str] = []
    if emit_clang_dry_run:
        features.append("clang-frontend")
    if emit_clang_lowering_report:
        features.append("clang-lowering-report")
    return features


def run_translator(
    slice_spec: Path,
    evidence_dir: Path,
    *,
    emit_clang_dry_run: bool = False,
    emit_clang_lowering_report: bool = False,
) -> dict[str, Any]:
    cmd = [
        "cargo",
        "run",
        "--quiet",
        "--manifest-path",
        str(TRANSLATOR_MANIFEST),
    ]
    features = translator_feature_set(
        emit_clang_dry_run=emit_clang_dry_run,
        emit_clang_lowering_report=emit_clang_lowering_report,
    )
    if features:
        cmd.extend(["--features", ",".join(features)])
    cmd.extend(
        [
            "--bin",
            "c2r_translate",
