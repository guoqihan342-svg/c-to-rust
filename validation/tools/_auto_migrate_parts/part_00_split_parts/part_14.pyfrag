RECORD_INTERIOR_PROJECTION_U32_CONSTANT_STATE_KIND = (
    "record_interior_projection_u32_constant_state"
)


def record_interior_projection_u32_constant_state_replay_supported(
    spec: dict[str, Any], fixture_binding: dict[str, Any] | None = None
) -> bool:
    return record_interior_projection_u32_constant_state_replay_contract(
        spec, fixture_binding
    ) is not None


def record_interior_projection_u32_constant_state_replay_contract(
    spec: dict[str, Any], fixture_binding: dict[str, Any] | None = None
) -> dict[str, Any] | None:
    contract = spec.get("replay_contract")
    if not isinstance(contract, dict) or contract.get("kind") != (
        RECORD_INTERIOR_PROJECTION_U32_CONSTANT_STATE_KIND
    ):
        return None
    if set(contract) != {
        "schema_version", "kind", "owner", "projection_path", "alias",
        "state_output", "constant_assign", "return", "noalias_required",
    }:
        raise ValueError("interior projection replay contract shape drifted")
    if contract.get("schema_version") != 1:
        raise ValueError("interior projection replay schema_version must be 1")

    owner = contract.get("owner")
    if not isinstance(owner, dict) or set(owner) != {
        "parameter", "c_type", "rust_type", "pass_mode", "direction", "initializer",
    }:
        raise ValueError("interior projection owner shape drifted")
    owner_name = scripted_external_replay_identifier(
        owner.get("parameter"), "interior projection owner parameter"
    )
    owner_type = scripted_external_replay_identifier(
        owner.get("rust_type"), "interior projection owner rust_type"
    )
    if owner.get("pass_mode") != "mutable_ref" or owner.get("direction") != "inout":
        raise ValueError("interior projection owner must be one mutable inout root")
    if normalize_c_type(str(owner.get("c_type") or "")) != normalize_c_type(
        f"struct {owner_type} *"
    ):
        raise ValueError("interior projection owner C type drifted")
    initializer = scripted_record_validate_initializer(
        owner.get("initializer"), "interior projection owner initializer"
    )
    if initializer["record_type"] != owner_type:
        raise ValueError("interior projection owner initializer type drifted")

    projection_path = scripted_record_field_path(
        contract.get("projection_path"), "interior projection path"
    )
    projected = interior_projection_record_at(initializer, projection_path)
    alias = contract.get("alias")
    if not isinstance(alias, dict) or set(alias) != {
        "local", "c_pointer_type", "rust_type",
    }:
        raise ValueError("interior projection alias shape drifted")
    scripted_external_replay_identifier(alias.get("local"), "interior projection alias local")
    scripted_external_replay_identifier(
        alias.get("c_pointer_type"), "interior projection alias c_pointer_type"
    )
    alias_type = scripted_external_replay_identifier(
        alias.get("rust_type"), "interior projection alias rust_type"
    )
    if projected["record_type"] != alias_type:
        raise ValueError("interior projection alias type does not match projected record")

    state = contract.get("state_output")
    if not isinstance(state, dict) or set(state) != {
        "alias_field_path", "owner_field_path", "fixture_field", "rust_type",
    }:
        raise ValueError("interior projection state_output shape drifted")
    alias_state_path = scripted_record_field_path(
        state.get("alias_field_path"), "interior projection alias state path"
    )
    if len(alias_state_path) < 2:
        raise ValueError("interior projection state must be deeper than the projected record")
    owner_state_path = scripted_record_field_path(
        state.get("owner_field_path"), "interior projection owner state path"
    )
    if owner_state_path != projection_path + alias_state_path:
        raise ValueError("interior projection owner state path must extend projection_path")
    state_fixture = scripted_external_replay_identifier(
        state.get("fixture_field"), "interior projection state fixture_field"
    )
    if state.get("rust_type") != "u32":
        raise ValueError("interior projection state rust_type must be u32")
    initialized = dict(scripted_record_initializer_fixture_paths(initializer))
    if owner_state_path not in initialized.values():
        raise ValueError("interior projection state field is not initialized")

    assign = contract.get("constant_assign")
    if assign != {"rust_type": "u32", "value": 0}:
        raise ValueError("interior projection constant_assign must declare u32 zero")
    result = contract.get("return")
    if not isinstance(result, dict) or set(result) != {"fixture_field", "rust_type", "value"}:
        raise ValueError("interior projection return shape drifted")
    return_fixture = scripted_external_replay_identifier(
        result.get("fixture_field"), "interior projection return fixture_field"
    )
    if result.get("rust_type") != "bool" or result.get("value") is not True:
        raise ValueError("interior projection return must declare owner-observed bool true")
    validate_interior_projection_pointer_boundary(spec, contract, owner_name)
    validate_interior_projection_signature(spec, owner)
    fixture_fields = [field for field, _ in scripted_record_initializer_fixture_paths(initializer)]
    outputs = [return_fixture, state_fixture]
    if len([*fixture_fields, *outputs]) != len(set([*fixture_fields, *outputs])):
        raise ValueError("interior projection fixture and output fields must be unique")
    if behavior_fields(spec) != outputs:
        raise ValueError("interior projection observable output mapping drifted")
    from validation.tools.interior_projection_syntax import validate_c_interior_projection_source
    validate_c_interior_projection_source(required_str(spec, "c_source"), contract)
    if fixture_binding is not None:
        validate_interior_projection_cases(spec, fixture_binding, contract)
    return contract


def interior_projection_record_at(
    initializer: dict[str, Any], path: list[str]
) -> dict[str, Any]:
    current = initializer
    for component in path:
        fields = current.get("fields")
        match = next(
            (item for item in fields or [] if isinstance(item, dict) and item.get("name") == component),
            None,
        )
        if not isinstance(match, dict) or not isinstance(match.get("record"), dict):
            raise ValueError("interior projection path must select initialized nested records")
        current = match["record"]
    return current


def validate_interior_projection_pointer_boundary(
    spec: dict[str, Any], contract: dict[str, Any], owner_name: str
) -> None:
    if scripted_record_noalias_pairs(contract.get("noalias_required"), "interior noalias"):
        raise ValueError("interior projection noalias_required must be empty")
    pointer = spec.get("c_boundary", {}).get("pointer_contract")
    if not isinstance(pointer, dict) or pointer.get("aliasing_proven") is not True:
        raise ValueError("interior projection requires one proven pointer root")
    if scripted_record_noalias_pairs(pointer.get("noalias_required"), "pointer noalias"):
        raise ValueError("interior projection pointer noalias_required must be empty")
    signatures = spec.get("c_boundary", {}).get("signatures") or []
    matches = [item for item in signatures if isinstance(item, dict) and item.get("function") == spec.get("function_name")]
    parameters = matches[0].get("parameters", []) if len(matches) == 1 else []
    pointer_roots = [item for item in parameters if isinstance(item, dict) and "*" in str(item.get("c_type") or "")]
    if len(pointer_roots) != 1 or pointer_roots[0].get("name") != owner_name:
        raise ValueError("c_boundary must expose exactly one proven owner pointer root")


def validate_interior_projection_signature(spec: dict[str, Any], owner: dict[str, Any]) -> None:
    signature = c_function_signature(spec)
    if not signature or signature.get("function") != spec.get("function_name"):
        raise ValueError("interior projection entry signature is missing")
    if normalize_c_type(str(signature.get("return_type") or "")) not in {"bool", "_Bool"}:
        raise ValueError("interior projection return type must be bool")
    actual = [item for item in signature.get("parameters", []) if isinstance(item, dict)]
    if len(actual) != 1 or actual[0].get("name") != owner["parameter"]:
        raise ValueError("interior projection signature must contain only the owner parameter")
    if normalize_c_type(str(actual[0].get("c_type") or "")) != normalize_c_type(owner["c_type"]):
        raise ValueError("interior projection owner parameter type drifted")
    if actual[0].get("direction") != "inout":
        raise ValueError("interior projection owner direction drifted")


def validate_interior_projection_cases(
    spec: dict[str, Any], fixture_binding: dict[str, Any], contract: dict[str, Any]
) -> None:
    cases = fixture_binding.get("case_bindings")
    if not isinstance(cases, list) or not cases:
        raise ValueError("interior projection fixture cases are missing")
    fields = [contract["return"]["fixture_field"], contract["state_output"]["fixture_field"]]
    expected_model = {fields[0]: contract["return"]["value"], fields[1]: 0}
    initializer = contract["owner"]["initializer"]
    for case in cases:
        payload = oracle_fixture_input_payload(spec, case)
        expected = case.get("expected_outputs")
        if not isinstance(payload, dict) or not isinstance(expected, dict):
            raise ValueError("interior projection fixture case is incomplete")
        if set(expected) != set(fields) or expected != expected_model:
            raise ValueError("interior projection expected outputs drifted")
        for fixture_field, _ in scripted_record_initializer_fixture_paths(initializer):
            if not is_uint32_value(payload.get(fixture_field)):
                raise ValueError("interior projection fixture field must be u32")


def interior_projection_generated_rust_safety(
    spec: dict[str, Any], draft_path: Path
) -> dict[str, Any] | None:
    contract = record_interior_projection_u32_constant_state_replay_contract(spec)
    if contract is None:
        return None
    from validation.tools.interior_projection_syntax import validate_rust_interior_projection_draft
    return validate_rust_interior_projection_draft(
        draft_path.read_text(encoding="utf-8-sig"), contract
    )
