from pathlib import Path as _C2RPartPath

_C2R_PARTS_DIR = _C2RPartPath(__file__).with_name("_test_judge_milestone_bundle_parts")
for _C2R_PART_NAME in (
    "class_part_00.py",
    "class_part_01.py",
    "class_part_02.py",
    "class_part_03.py",
):
    _C2R_PART_PATH = _C2R_PARTS_DIR / _C2R_PART_NAME
    exec(
        compile(
            _C2R_PART_PATH.read_text(encoding="utf-8"),
            str(_C2R_PART_PATH),
            "exec",
        ),
        globals(),
    )

