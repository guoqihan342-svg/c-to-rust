        "manifest_count": 0,
        "generated_output_count": 0,
        "skipped_without_output_count": 0,
        "compile_attempted_count": 0,
        "compile_passed_count": 0,
        "compile_semantic_pass_count": 0,
        "status_counts": {},
        "output_status_counts": {},
        "compile_status_counts": {},
        "manifests": [],
        "semantic_gate": False,
