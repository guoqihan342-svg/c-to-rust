from __future__ import annotations

import hashlib
import json
from pathlib import Path
import subprocess
import tempfile
import unittest

import jsonschema

from validation.tools import run_competition as runner
from validation.tools import validate_competition_run_summary as validator
from validation.tools._ai_candidate_harness_parts.candidate_cache import (
    agent_definition_sha256,
    cache_key_payload,
    cache_key_sha256,
)
from validation.tools._ai_candidate_harness_parts.prompt_transport import (
    prompt_transport_contract,
)
from validation.tools._ai_candidate_harness_parts.provider import render_prompt
from validation.tools._ai_candidate_harness_parts.provider_receipt import invocation_contract
from validation.tools._ai_candidate_harness_parts.router import REQUIRED_GATES, route_candidates


REPO_ROOT = Path(__file__).resolve().parents[2]


def completed(command: list[str], *, returncode: int = 0, stdout: str = "", stderr: str = ""):
    return subprocess.CompletedProcess(command, returncode, stdout, stderr)


class RecordingRunner:
    def __init__(self, *, fail_auto_migrate: bool = False) -> None:
        self.commands: list[list[str]] = []
        self.fail_auto_migrate = fail_auto_migrate

    def __call__(self, command, **_kwargs):
        command = list(command)
        self.commands.append(command)
        if any(item.replace("\\", "/").endswith("unsafe_budget.py") for item in command):
            return completed(
                command,
                stdout=json.dumps(
                    {
                        "status": "passed",
                        "first_party_non_test_unsafe_count": 0,
                        "unsafe_ratio": 0.0,
                    }
                ),
            )
        if any(item.replace("\\", "/").endswith("auto_migrate.py") for item in command):
            return completed(command, returncode=1 if self.fail_auto_migrate else 0)
        return completed(command)


def write_text(path: Path, text: str) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(text.encode("utf-8"))
    return runner.sha256(path)


def write_json(path: Path, payload: dict) -> str:
    return write_text(path, json.dumps(payload, indent=2, sort_keys=True) + "\n")


def nested_ref(path: Path) -> dict:
    return {"path": path.name, "sha256": runner.sha256(path), "status": "present"}


def runtime() -> dict:
    return {
        "opencode_command": "opencode",
        "model": "zai/glm-5.1",
        "agent": "c2rust-migrator",
        "variant": "max",
        "timeout_seconds": 37,
        "resolution": {
            "opencode_command": "cli",
            "model": "cli",
            "agent": "cli",
            "variant": "cli",
            "timeout_seconds": "cli",
        },
        "competition_exact_contract": False,
    }


def write_generated_ai_chain(
    out_root: Path,
    *,
    accepted_binding: bool = False,
    common_acceptance: bool = False,
    router_source: str | None = None,
    duplicate_source: str | None = None,
    cache_hit: bool = False,
) -> tuple[dict, dict]:
    target_id = "portable-project"
    slice_id = "sum-values"
    evidence_root = out_root / "evidence"
    base = evidence_root / target_id / "auto-translation" / slice_id
    base.mkdir(parents=True)
    context = base / f"l3-{slice_id}-ai-context-pack.json"
    prompt = base / f"l3-{slice_id}-ai-prompt.txt"
    response = base / f"l3-{slice_id}-ai-response.jsonl"
    candidate_path = base / f"l3-{slice_id}-ai-rust-candidate.rs"
    draft = base / f"l3-{slice_id}-rust-draft.rs"
    c_source = "int sum_values(int a, int b) { return a + b; }"
    context_payload = {
        "schema_version": 3,
        "target_id": target_id,
        "slice_id": slice_id,
        "function_name": "sum_values",
        "source_root": {"status": "unavailable"},
        "source": {
            "span": {
                "status": "inline_slice_spec",
                "sha256": hashlib.sha256(c_source.encode("utf-8")).hexdigest(),
                "content": c_source,
            }
        },
        "compile_context": {},
        "c_boundary": {
            "sha256": "b" * 64,
            "truncated": False,
            "payload": {},
            "required_callee_sections": [],
            "missing_required_callee_sections": [],
        },
        "bindings": {"inputs": []},
        "claim_boundary": {"semantic_gate": False},
    }
    write_json(context, context_payload)
    write_text(prompt, render_prompt(context_payload))
    candidate_source = "pub fn sum_values(a: i32, b: i32) -> i32 { a + b }\n"
    response_payload = {
        "schema_version": 1,
        "candidate": {"language": "rust", "source": candidate_source},
        "assumptions": [],
    }
    write_text(
        response,
        json.dumps(
            {
                "type": "message.part.updated",
                "part": {"type": "text", "text": json.dumps(response_payload)},
            }
        )
        + "\n",
    )
    candidate_sha = write_text(candidate_path, candidate_source)
    write_text(draft, candidate_path.read_text(encoding="utf-8"))
    selected_source = router_source if router_source is not None else ("opencode-ai" if common_acceptance else None)

    def router_candidate(candidate_id: str, source: str, artifact_sha: str, passed: bool) -> dict:
        candidate = {
            "candidate_id": candidate_id,
            "source": source,
            "artifact_sha256": artifact_sha,
            "gate_results": {
                gate: {
                    "status": "passed" if passed else "failed",
                    "candidate_sha256": artifact_sha,
                }
                for gate in REQUIRED_GATES
            },
        }
        if source == "opencode-ai":
            candidate.update(
                {
                    "provider": "zai",
                    "logical_model": "GLM-5.1",
                    "resolved_model": "zai/glm-5.1",
                    "competition_eligible": True,
                    "evaluation_scope": "competition-primary",
                    "agent": "c2rust-migrator",
                    "variant": "max",
                }
            )
        return candidate

    router_inputs = [router_candidate("opencode-glm51-1", "opencode-ai", candidate_sha, selected_source == "opencode-ai")]
    deterministic_path = None
    deterministic_sha = None
    if selected_source in {"typed-ir", "c2rust-repair", "c2rust-baseline"}:
        deterministic_path = base / f"l3-{slice_id}-{selected_source}-candidate.rs"
        deterministic_sha = write_text(
            deterministic_path,
            "pub fn sum_values(a: i32, b: i32) -> i32 { a.wrapping_add(b) }\n",
        )
        router_inputs.append(router_candidate(f"{selected_source}:candidate", selected_source, deterministic_sha, True))
        write_text(draft, deterministic_path.read_text(encoding="utf-8"))
    if duplicate_source is not None:
        router_inputs.append(router_candidate(f"{duplicate_source}:duplicate", duplicate_source, candidate_sha, False))
    router_payload = route_candidates(
        router_inputs,
        provider_invocations=0 if cache_hit else 1,
    )
    evidence_keys = {
        "opencode-ai": "ai",
        "typed-ir": "typed_ir",
        "c2rust-repair": "c2rust_repair",
        "c2rust-baseline": "c2rust_baseline",
    }
    candidate_evidence = {}
    for routed in router_payload["candidate_set"]:
        source = routed["source"]
        exact_path = base / f"l3-{slice_id}-{source}-exact-validation.json"
        passed = routed["decision"] in {"selected", "eligible_not_selected"}
        write_json(
            exact_path,
            {
                "schema_version": 1,
                "status": "passed" if passed else "failed",
                "candidate_sha256": routed["artifact_sha256"],
                "semantic_pass": passed,
            },
        )
        candidate_evidence[evidence_keys[source]] = nested_ref(exact_path)
    candidate_source_audit = None
    if selected_source == "c2rust-repair":
        baseline_path = base / f"l3-{slice_id}-c2rust-baseline.rs"
        failure_path = base / f"l3-{slice_id}-c2rust-repair-01-failure-facts.json"
        prompt_path = base / f"l3-{slice_id}-c2rust-repair-01-prompt.txt"
        response_path = base / f"l3-{slice_id}-c2rust-repair-01-response.jsonl"
        repair_path = base / f"l3-{slice_id}-c2rust-repair-01.patch"
        validation_path = base / f"l3-{slice_id}-c2rust-repair-01-validation-result.json"
        write_text(baseline_path, "pub fn sum_values(a: i32, b: i32) -> i32 { a + b }\n")
        write_json(failure_path, {"status": "failed", "failures": [{"kind": "rustc"}]})
        write_text(prompt_path, "repair the c2rust baseline\n")
        write_text(response_path, '{"type":"text","text":"repair"}\n')
        write_text(repair_path, "candidate-only repair\n")
        write_json(validation_path, {"status": "passed", "failures": []})
        report_path = base / f"l3-{slice_id}-c2rust-repair-report.json"
        report_status = "candidate_ready_for_common_validation"
        write_json(
            report_path,
            {
                "schema_version": 3,
                "artifact_label": "c2rust-repair",
                "input_source": "c2rust-baseline",
                "status": report_status,
                "generator": {
                    "tool": "opencode",
                    "provider": "zai",
                    "logical_model": "GLM-5.1",
                    "resolved_model": "zai/glm-5.1",
                    "competition_eligible": True,
                    "evaluation_scope": "competition-primary",
                    "agent": "c2rust-migrator",
                    "variant": "max",
                    "prompt_transport": prompt_transport_contract(),
                },
                "initial_candidate": {
                    "name": baseline_path.name,
                    "sha256": runner.sha256(baseline_path),
                },
                "claim_boundary": {
                    "semantic_gate": False,
                    "semantic_pass": False,
                    "translation_coverage_numerator": 0,
                },
                "rounds": [
                    {
                        "round": 1,
                        "semantic_pass": False,
                        "bindings": {
                            "failure_facts": nested_ref(failure_path),
                            "prompt": nested_ref(prompt_path),
                            "raw_response": nested_ref(response_path),
                            "repair_artifact": nested_ref(repair_path),
                            "candidate": nested_ref(deterministic_path),
                            "validation_result": nested_ref(validation_path),
                        },
                    }
                ],
                "final_candidate": nested_ref(deterministic_path),
            },
        )
        candidate_source_audit = {
            "c2rust_repair": {
                "source": "c2rust-repair",
                "status": "exact_gates_completed",
                "reason": "fresh_exact_gates_passed",
                "base_candidate_sha256": runner.sha256(baseline_path),
                "repair_report": {
                    "path": report_path.name,
                    "sha256": runner.sha256(report_path),
                    "status": report_status,
                    "semantic_pass": False,
                },
                "repair_rounds": 1,
                "final_candidate_sha256": deterministic_sha,
            }
        }
    router_payload.update(
        {
            "candidate_evidence": candidate_evidence,
            "canonical_draft_sha256": runner.sha256(draft),
            "semantic_pass": router_payload["selected_candidate_id"] is not None,
        }
    )
    if candidate_source_audit is not None:
        router_payload["candidate_source_audit"] = candidate_source_audit
    router_path = base / f"l3-{slice_id}-ai-router.json"
    write_json(router_path, router_payload)

    manifest_path = base / f"l3-{slice_id}-ai-candidate-manifest.json"
    candidate_id = "opencode-glm51-1"
    receipt_path = base / f"l3-{slice_id}-ai-invocation-receipt.json"
    if not cache_hit:
        write_json(
            receipt_path,
            {
                "schema_version": 1,
                "source": "runner-contract",
                "session_id": "unavailable",
                "provider_id": "zai",
                "model_id": "glm-5.1",
                "resolved_model": "zai/glm-5.1",
                "agent": "c2rust-migrator",
                "variant": "max",
                "opencode_version": "unattested",
                "prompt_sha256": runner.sha256(prompt),
                "raw_response_sha256": runner.sha256(response),
                "session_ids": [],
                "prompt_transport": prompt_transport_contract(),
                "invocation_contract": invocation_contract(
                    resolved_model="zai/glm-5.1",
                    agent="c2rust-migrator",
                    variant="max",
                ),
            },
        )
    manifest = {
        "schema_version": 7,
        "target_id": target_id,
        "slice_id": slice_id,
        "status": "generated",
        "ai_required_for_default_pipeline": True,
        "provider_invocations": 0 if cache_hit else 1,
        "provider_preflight": {
            "status": "ready",
            "source_span_status": "inline_slice_spec",
        },
        "generator": {
            "tool": "opencode",
            "provider": "zai",
            "logical_model": "GLM-5.1",
            "resolved_model": "zai/glm-5.1",
            "competition_eligible": True,
            "evaluation_scope": "competition-primary",
            "agent": "c2rust-migrator",
            "variant": "max",
            "prompt_transport": prompt_transport_contract(),
        },
        "bindings": {
            "context_pack": {"path": context.name, "sha256": runner.sha256(context)},
            "prompt": {"path": prompt.name, "sha256": runner.sha256(prompt)},
            "raw_response": {"path": response.name, "sha256": runner.sha256(response)},
        },
        "claim_boundary": {
            "semantic_gate": False,
            "translation_coverage_numerator": 0,
            "candidate_requires_common_validation": True,
        },
        "cache_invalidation_keys": [
            f"context_pack:{runner.sha256(context)}",
            f"prompt:{runner.sha256(prompt)}",
            f"raw_response:{runner.sha256(response)}",
        ],
        "candidates": [
            {
                "candidate_id": candidate_id,
                "purpose": "rust_draft",
                "kind": "opencode-ai",
                "provider_label": "zai",
                "model_label": "GLM-5.1",
                "resolved_model": "zai/glm-5.1",
                "competition_eligible": True,
                "evaluation_scope": "competition-primary",
                "prompt_scope": ["slice_spec", "source_spans"],
                "input_artifact_hashes": {
                    "context_pack": runner.sha256(context),
                    "prompt": runner.sha256(prompt),
                },
                "artifact": {"path": candidate_path.name, "sha256": candidate_sha},
                "output_hash": candidate_sha,
                "applied": selected_source not in {"typed-ir", "c2rust-repair", "c2rust-baseline"},
                "semantic_pass": False,
                "accepted_by_gates": [],
                "rejected_by_gates": [],
            }
        ],
    }
    if not cache_hit:
        manifest["bindings"]["invocation_receipt"] = {
            "path": receipt_path.name,
            "sha256": runner.sha256(receipt_path),
        }
    if cache_hit:
        key_payload = cache_key_payload(
            runner.sha256(context),
            prompt_sha256=runner.sha256(prompt),
            resolved_model="zai/glm-5.1",
            agent="c2rust-migrator",
            agent_definition_sha256=agent_definition_sha256(
                "c2rust-migrator",
                REPO_ROOT,
            ),
            variant="max",
        )
        key = cache_key_sha256(key_payload)
        cache_entry_path = base / f"l3-{slice_id}-ai-cache-entry.json"
        write_json(
            cache_entry_path,
            {
                "schema_version": 1,
                "key_sha256": key,
                "key": key_payload,
                "raw_response": {
                    "sha256": runner.sha256(response),
                    "size_bytes": response.stat().st_size,
                },
                "candidate": {
                    "sha256": candidate_sha,
                    "size_bytes": candidate_path.stat().st_size,
                },
            },
        )
        manifest["cache"] = {
            "status": "hit",
            "key_sha256": key,
            "entry_sha256": runner.sha256(cache_entry_path),
            "entry": {
                "path": cache_entry_path.name,
                "sha256": runner.sha256(cache_entry_path),
            },
            "raw_response_sha256": runner.sha256(response),
            "candidate_sha256": candidate_sha,
        }
    else:
        manifest["cache"] = {"status": "disabled"}
    if selected_source not in {"typed-ir", "c2rust-repair", "c2rust-baseline"}:
        manifest["selected_candidate_id"] = candidate_id
        manifest["candidates"][0]["applied_artifact"] = {
            "path": draft.name,
            "sha256": runner.sha256(draft),
        }
        manifest["candidates"][0]["rust_draft_sha256"] = candidate_sha
    write_json(manifest_path, manifest)

    auto_manifest_path = base / f"l3-{slice_id}-auto-translation-manifest.json"
    write_json(
        auto_manifest_path,
        {
            "schema_version": 1,
            "target_id": target_id,
            "slice_id": slice_id,
            "ai_exact_validation": {
                "path": router_path.name,
                "sha256": runner.sha256(router_path),
                "status": "passed" if router_payload["semantic_pass"] else "failed",
                "semantic_pass": router_payload["semantic_pass"],
            },
        },
    )
    ai_entry = {
        "candidate_id": candidate_id,
        "kind": "opencode-ai",
        "status": "generated",
        "role": "ai_primary_rust_draft",
        "applied": True,
        "rust_draft_sha256": candidate_sha,
        "source_artifact": nested_ref(manifest_path),
    }
    generation = {
        "selected_candidate_id": candidate_id,
        "ai": ai_entry,
        "primary_candidate": {"candidate_id": candidate_id, "selected": "opencode-ai"},
    }
    route_path = base / f"l3-{slice_id}-route-decision.json"
    route = {
        "target_id": target_id,
        "slice_id": slice_id,
        "status": "recorded",
        "candidate_generation": generation,
        "source_artifacts": {"ai_candidate_manifest": nested_ref(manifest_path)},
    }
    write_json(route_path, route)
    semantic = accepted_binding or common_acceptance
    acceptance = {
        "status": "passed" if semantic else "blocked",
        "generated_draft_semantic_pass": semantic,
        "selected_candidate_id": candidate_id,
        "accepted_evidence_binding": {"status": "accepted"} if accepted_binding else None,
        "claim_source": (
            "generated_draft_replay_with_accepted_oracle_binding"
            if accepted_binding
            else "generated_draft_replay_with_common_validation"
            if common_acceptance
            else "blocked_generated_draft_acceptance"
        ),
        "rust_check": {"status": "passed"},
        "rust_draft": {"path": draft.name, "sha256": candidate_sha, "status": "candidate"},
    }
    profile_path = base / f"l3-{slice_id}-validation-profile.json"
    profile = {
        "target_id": target_id,
        "slice_id": slice_id,
        "status": "passed" if semantic else "incomplete",
        "accepted_evidence_authoritative": False,
        "candidate_generation": generation,
        "generated_draft_acceptance": acceptance,
        "generated_draft_semantic_pass": semantic,
    }
    write_json(profile_path, profile)
    final_path = base / f"l3-{slice_id}-final-verification.json"
    final = {
        "target_id": target_id,
        "slice_id": slice_id,
        "status": "passed" if semantic else "incomplete",
        "semantic_pass": semantic,
        "rust_check_status": "passed",
        "validation_profile_status": "passed" if semantic else "incomplete",
        "route_decision": nested_ref(route_path),
        "validation_profile": nested_ref(profile_path),
    }
    write_json(final_path, final)

    log_path = out_root / "logs" / "commands.jsonl"
    command = [
        "python3",
        "validation/tools/auto_migrate.py",
        "--slice-spec",
        "validation/slice-specs/portable.json",
        "--ai-first-candidate",
        "--ai-model",
        "zai/glm-5.1",
        "--ai-agent",
        "c2rust-migrator",
        "--ai-variant",
        "max",
        "--ai-timeout-seconds",
        "37",
        "--ai-opencode-command",
        "opencode",
    ]
    write_text(
        log_path,
        json.dumps({"step": f"auto-migrate-{slice_id}", "command": command, "run_id": "ai-run", "canonical": True}) + "\n",
    )
    summary = {
        "schema_version": 2,
        "run_id": "ai-run",
        "proof_class": "local-simulation",
        "slices": {"attempted": 1},
        "command_log": {
            "path": "logs/commands.jsonl",
            "sha256": runner.sha256(log_path),
        },
    }
    descriptor = runner.ai_metric_descriptor(
        target_id=target_id,
        slice_id=slice_id,
        source="direct",
