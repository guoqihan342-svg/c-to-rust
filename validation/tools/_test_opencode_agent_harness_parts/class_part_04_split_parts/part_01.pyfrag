    def test_resume_replay_blocks_passed_preflight_without_resolved_model_id(self) -> None:
        with temp_repo_dir() as tmp:
            preflight = write_passing_opencode_preflight_report(
                Path(tmp) / "competition-out" / "harness" / "opencode-preflight-report.json",
                run_id="run-resume",
            )
            binding = harness.validate_opencode_preflight_report(
                preflight,
                expected_run_id="run-resume",
                opencode_model="GLM-5.1",
                opencode_agent="c2rust-migrator",
                repo_root=REPO_ROOT,
            )
            payload = json.loads(preflight.read_text(encoding="utf-8"))
            payload["opencode_model_availability"].pop("resolved_model_id")
            write_json(preflight, payload)
            binding["sha256"] = harness.sha256_file(preflight)
            binding["opencode_model_availability"].pop("resolved_model_id")

            safety = harness.resume_worker_replay_safety(
                {"worker_id": "worker-001", "opencode_preflight_report": binding},
                mode="opencode",
                repo_root=REPO_ROOT,
            )

            self.assertEqual(safety["status"], "blocked")
            self.assertTrue(
                any("resolved_model_id" in constraint for constraint in safety["missing_constraints"]),
                safety,
            )

