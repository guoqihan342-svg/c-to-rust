def _validate_fixture(spec: dict[str, Any], fixture: dict[str, Any], model: dict[str, Any]) -> None:
    if not isinstance(fixture, dict) or not SHA256_RE.fullmatch(str(fixture.get("sha256") or "")):
        raise ValueError("record buffer fixture binding is invalid")
    cases = fixture.get("cases")
    declared = spec.get("fixture_contract", {}).get("cases")
    if not isinstance(cases, list) or not cases or not isinstance(declared, list):
        raise ValueError("record buffer fixture cases are required")
    ids = [item.get("id") if isinstance(item, dict) else None for item in cases]
    if any(not isinstance(item, str) or not item for item in ids) or len(set(ids)) != len(ids) or [item.get("id") for item in declared] != ids:
        raise ValueError("record buffer fixture case ids drifted")
    record = model["record"]
    buffer = model["buffer"]
    length = model["length"]
    pointer = model["pointer_identity"]
    expected_fields = set(model["observable"])
    for index, case in enumerate(cases):
        if set(case) != {"id", "inputs", "expected"} or not isinstance(case["inputs"], dict) or not isinstance(case["expected"], dict):
            raise ValueError("record buffer fixture case shape drifted")
        inputs = case["inputs"]
        expected = case["expected"]
        if set(expected) != expected_fields or declared[index].get("expected_outputs") != expected:
            raise ValueError("record buffer expected outputs drifted")
        if expected.get(f"return_same_{record['parameter']}") is not True or expected.get(pointer["expected_output"]) != buffer["parameter"]:
            raise ValueError("record buffer identity outputs drifted")
        value_buffer = _value_at(inputs, buffer["fixture_path"])
        if value_buffer is not None and not _byte_list(value_buffer, buffer["maximum_bytes"]):
            raise ValueError("record buffer nullable byte fixture is invalid")
        length_value = _value_at(inputs, length["fixture_path"])
        _usize(length_value, "record buffer length fixture")
        if value_buffer is not None and length_value > len(value_buffer):
            raise ValueError("record buffer retained length exceeds buffer")
        for field in record["fields"]:
            _usize(_value_at(inputs, [*record["fixture_root"], *field["initial_fixture_path"]]), "record initial field")
            expected_value = expected[field["expected_output"]]
            _usize(expected_value, "record expected field")
            if expected_value != length_value:
                raise ValueError("record buffer expected scalar does not match retained length")


def _validate_pointer_contract(spec: dict[str, Any], record: dict[str, Any], buffer: dict[str, Any], length: dict[str, Any]) -> None:
    pointer = spec.get("c_boundary", {}).get("pointer_contract")
    if not isinstance(pointer, dict) or pointer.get("noalias_required") != [] or pointer.get("aliasing_proven") is not False:
        raise ValueError("record buffer pointer noalias contract drifted")
    inputs = pointer.get("input_buffers")
    inouts = pointer.get("inout_pointers")
    if not isinstance(inputs, list) or len(inputs) != 1 or not isinstance(inouts, list) or len(inouts) != 1:
        raise ValueError("record buffer pointer roles are not closed")
    source = inputs[0]
    output = inouts[0]
    if source.get("name") != buffer["parameter"] or source.get("length_companion") != length["parameter"] or source.get("nullability") != "nullable" or source.get("read_effects") != [] or source.get("write_effects") != []:
        raise ValueError("record buffer input pointer contract drifted")
    if output.get("name") != record["parameter"]:
        raise ValueError("record buffer inout pointer contract drifted")


def _validate_c_source(signature: dict[str, Any], record: dict[str, Any], buffer: dict[str, Any], length: dict[str, Any], pointer: dict[str, Any]) -> None:
    source = signature.get("c_source")
    if source is None:
        return
    if not isinstance(source, str):
        raise ValueError("record buffer C source is invalid")
    record_name = re.escape(record["parameter"])
    if re.findall(r"\breturn\s+([A-Za-z_][A-Za-z0-9_]*)\s*;", source) != [record["parameter"]]:
        raise ValueError("record buffer C source return drifted")
    pointer_field = r"\.".join(re.escape(item) for item in pointer["record_field_path"])
    scalar_field = r"\.".join(re.escape(item) for item in record["fields"][0]["rust_field_path"])
    if not re.search(rf"\b{record_name}\s*->\s*{pointer_field}\s*=.*\b{re.escape(buffer['parameter'])}\b\s*;", source, re.S):
        raise ValueError("record buffer C source pointer assignment drifted")
    if not re.search(rf"\b{record_name}\s*->\s*{scalar_field}\s*=\s*{re.escape(length['parameter'])}\s*;", source):
        raise ValueError("record buffer C source length assignment drifted")


def _validate_plan_coverage(plan: dict[str, Any], model: dict[str, Any]) -> None:
    covered = {item["fixture_field"] for item in plan["assertions"]}
    covered.update(item["fixture_field"] for item in plan["identity_assertions"])
    covered.update(item["fixture_field"] for item in plan["pointer_identity_assertions"])
    if covered != set(model["observable"]) or len(covered) != len(plan["assertions"]) + 2:
        raise ValueError("record buffer plan does not cover every observable exactly")


def _matching_signature(spec: dict[str, Any], function_name: str) -> dict[str, Any]:
    matches = [item for item in spec.get("c_boundary", {}).get("signatures") or [] if isinstance(item, dict) and item.get("function") == function_name]
    if len(matches) != 1:
        raise ValueError("record buffer identity requires one matching C signature")
    return matches[0]


def _public_api(spec: dict[str, Any]) -> str:
    entries = [item for item in spec.get("rust_boundary", {}).get("public_api") or [] if isinstance(item, dict)]
    if len(entries) != 1:
        raise ValueError("record buffer identity requires one Rust public API")
    return _ident(entries[0].get("name"), "Rust API")


def _fixture_path(value: Any, allow_empty: bool) -> list[str]:
    if not isinstance(value, list) or (not allow_empty and not value) or any(not isinstance(item, str) or not item or "\x00" in item for item in value):
        raise ValueError("record buffer fixture path is invalid")
    return list(value)


def _rust_path(value: Any) -> list[str]:
    if not isinstance(value, list) or not value:
        raise ValueError("record buffer Rust field path is required")
    return [_ident(item, "Rust field") for item in value]


def _rust_type_path(value: Any) -> list[str]:
    if not isinstance(value, list):
        raise ValueError("record buffer Rust type path is invalid")
    return [_ident(item, "Rust type path") for item in value]


def _fixture_key(value: Any, label: str) -> str:
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*", value):
        raise ValueError(f"record buffer {label} is invalid")
    return value


def _ident(value: Any, label: str) -> str:
    if not isinstance(value, str) or not IDENTIFIER_RE.fullmatch(value) or value in RUST_KEYWORDS:
        raise ValueError(f"record buffer {label} is not a safe identifier")
    return value


def _value_at(value: Any, path: list[str]) -> Any:
    current = value
    for item in path:
        if not isinstance(current, dict) or item not in current:
            raise ValueError("record buffer fixture path is missing")
        current = current[item]
    return current


def _usize(value: Any, label: str) -> None:
    if not isinstance(value, int) or isinstance(value, bool) or value < 0 or value > 0xFFFFFFFFFFFFFFFF:
        raise ValueError(f"{label} is not usize")


def _byte_list(value: Any, maximum: int) -> bool:
    return isinstance(value, list) and len(value) <= maximum and all(isinstance(item, int) and not isinstance(item, bool) and 0 <= item <= 255 for item in value)


def _c_type(value: Any) -> str:
    return re.sub(r"\s+", " ", str(value or "").strip())


def _exact_keys(value: dict[str, Any], expected: set[str], label: str) -> None:
    if set(value) != expected:
        raise ValueError(f"{label} shape drifted")
