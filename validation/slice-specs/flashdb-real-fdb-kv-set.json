  "c_source": "fdb_err_t fdb_kv_set(fdb_kvdb_t db, const char *key, const char *value)\n{\n    struct fdb_blob blob;\n\n    if (value) {\n        return fdb_kv_set_blob(db, key, fdb_blob_make(&blob, value, strlen(value)));\n    } else {\n        return fdb_kv_del(db, key);\n    }\n}",
