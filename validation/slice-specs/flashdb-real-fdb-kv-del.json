  "function_name": "fdb_kv_del",
  "c_source": "fdb_err_t fdb_kv_del(fdb_kvdb_t db, const char *key)\n{\n    fdb_err_t result = FDB_NO_ERR;\n\n    if (!db_init_ok(db)) {\n        FDB_INFO(\"Error: KV (%s) isn't initialize OK.\\n\", db_name(db));\n        return FDB_INIT_FAILED;\n    }\n\n    /* lock the KV cache */\n    db_lock(db);\n\n    result = del_kv(db, key, NULL, true);\n\n    /* unlock the KV cache */\n    db_unlock(db);\n\n    return result;\n}",
