{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Pointer Dependency Graph Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target_id",
    "slice_id",
    "level",
    "status",
    "source_commit",
    "repo_commit",
    "context_pack_ref",
    "applicability",
    "source_boundary",
    "cache_invalidation_keys"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "L2",
        "L3",
        "L2_OR_L3"
      ]
    },
    "status": {
      "enum": [
        "recorded",
        "not_applicable",
        "not_evaluated",
        "stale",
        "incomplete"
      ]
    },
    "not_applicable_reason": {
      "type": "string"
    },
    "not_evaluated_reason": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "minLength": 7
    },
    "repo_commit": {
      "type": "string",
      "minLength": 7
    },
    "context_pack_ref": {
      "type": "string",
      "minLength": 1
    },
    "impact_set_ref": {
      "type": "string"
    },
    "config_profile_ref": {
      "type": "string"
    },
    "applicability": {
      "type": "object",
      "required": [
        "has_pointer_surface",
        "triggers"
      ],
      "properties": {
        "has_pointer_surface": {
          "type": "boolean"
        },
        "triggers": {
          "type": "array",
          "items": {
            "enum": [
              "pointer_parameter",
              "pointer_return",
              "struct_pointer_field",
              "buffer",
              "opaque_handle",
              "callback_context",
              "manual_allocation",
              "global_state",
              "external_mutable_state",
              "alias_sensitive_state",
              "none"
            ]
          }
        }
      }
    },
    "source_boundary": {
      "type": "object",
      "required": [
        "files",
        "functions"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "globals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "direct_call_edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/callEdge"
          }
        }
      }
    },
    "pointer_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/pointerNode"
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dependencyEdge"
      }
    },
    "alias_sets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/aliasSet"
      }
    },
    "external_state": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/externalState"
      }
    },
    "rust_mapping": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rustMapping"
      }
    },
    "validation_coverage": {
      "type": "object",
      "properties": {
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "oracle_reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk_summary": {
      "type": "object",
      "properties": {
        "unsafe_expected": {
          "type": "boolean"
        },
        "blocked_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alias_gate": {
          "$ref": "#/definitions/aliasGateSummary"
        }
      }
    },
    "cache_invalidation_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alias_contract": {
      "$ref": "#/definitions/aliasContract"
    },
    "alias_risks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/aliasRisk"
      }
    },
    "safe_boundary_preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/safeBoundaryPrecondition"
      }
    },
    "effect_graph": {
      "$ref": "#/definitions/effectGraph"
    },
    "pointer_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/pointerDecision"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_applicable"
          }
        }
      },
      "then": {
        "required": [
          "not_applicable_reason"
        ],
        "properties": {
          "not_applicable_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_evaluated"
          }
        }
      },
      "then": {
        "required": [
          "not_evaluated_reason"
        ],
        "properties": {
          "not_evaluated_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "recorded",
              "stale",
              "incomplete"
            ]
          }
        }
      },
      "then": {
        "required": [
          "pointer_nodes",
          "dependency_edges",
          "rust_mapping",
          "risk_summary"
        ]
      }
    }
  ],
  "definitions": {
    "callEdge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        }
      }
    },
    "pointerNode": {
      "type": "object",
      "required": [
        "id",
        "symbol",
        "kind",
        "c_type",
        "mutability",
        "nullability",
        "ownership_role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "raw_pointer",
            "struct_pointer",
            "buffer",
            "opaque_handle",
            "callback_context",
            "global_pointer",
            "derived_pointer",
            "value"
          ]
        },
        "c_type": {
          "type": "string"
        },
        "mutability": {
          "enum": [
            "read_only",
            "write_only",
            "read_write",
            "unknown"
          ]
        },
        "nullability": {
          "enum": [
            "nullable",
            "non_null",
            "unknown"
          ]
        },
        "ownership_role": {
          "enum": [
            "owner",
            "borrowed",
            "observer",
            "out_param",
            "inout_param",
            "global",
            "unknown"
          ]
        },
        "lifetime_owner": {
          "type": "string"
        },
        "cross_file_exposure": {
          "type": "boolean"
        },
        "length_companion": {
          "type": "string"
        },
        "buffer_role": {
          "enum": [
            "input",
            "output",
            "inout",
            "internal",
            "unknown"
          ]
        },
        "boundary_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointerEffect"
          }
        },
        "write_effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointerEffect"
          }
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "relationship",
        "evidence"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relationship": {
          "enum": [
            "owns",
            "borrows",
            "aliases",
            "derives_from",
            "stores",
            "returns",
            "passes_to",
            "reads_through",
            "writes_through",
            "invalidates",
            "callback_captures"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aliasSet": {
      "type": "object",
      "required": [
        "id",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "type": "string"
        },
        "relationship": {
          "enum": [
            "known_distinct",
            "known_overlap",
            "unknown_overlap",
            "shared_mutable_state",
            "borrow_equivalence",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "externalState": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "access"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "global",
            "heap",
            "file",
            "device",
            "flash_sector",
            "allocator",
            "thread_local",
            "unknown"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read_write",
            "unknown"
          ]
        }
      }
    },
    "rustMapping": {
      "type": "object",
      "required": [
        "pointer_node",
        "strategy",
        "unsafe_expected"
      ],
      "properties": {
        "pointer_node": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        },
        "unsafe_expected": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "aliasGateSummary": {
      "type": "object",
      "required": [
        "decision",
        "complete_alias_safety",
        "requires_noalias"
      ],
      "additionalProperties": true,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "requires_noalias_contract",
            "candidate_only",
            "blocked",
            "not_applicable"
          ]
        },
        "complete_alias_safety": {
          "type": "boolean"
        },
        "requires_noalias": {
          "type": "boolean"
        },
        "risk_count": {
          "type": "integer",
          "minimum": 0
        },
        "risk_level": {
          "type": "string"
        },
        "evidence_source": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/safeBoundaryPrecondition"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "aliasContract": {
      "type": "object",
      "required": [
        "decision",
        "proven",
        "requires_noalias",
        "complete_alias_safety"
      ],
      "additionalProperties": true,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "requires_noalias_contract",
            "candidate_only",
            "blocked",
            "not_applicable"
          ]
        },
        "proven": {
          "type": "boolean"
        },
        "requires_noalias": {
          "type": "boolean"
        },
        "complete_alias_safety": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "aliasRisk": {
      "type": "object",
      "required": [
        "id",
        "pointer_nodes",
        "risk_level",
        "evidence_source",
        "gate_decision",
        "requires_noalias"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pointer_nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "risk_level": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source": {
          "type": "string",
          "minLength": 1
        },
        "gate_decision": {
          "enum": [
            "allow",
            "requires_noalias_contract",
            "candidate_only",
            "blocked",
            "not_applicable"
          ]
        },
        "requires_noalias": {
          "type": "boolean"
        },
        "read_effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointerEffect"
          }
        },
        "write_effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointerEffect"
          }
        }
      }
    },
    "safeBoundaryPrecondition": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "applies_to",
        "required",
        "reason"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "noalias",
            "non_null",
            "valid_length",
            "bounds_checked",
            "initialized",
            "aligned",
            "lifetime",
            "external_state_stable",
            "exclusive_fixture_step",
            "single_threaded",
            "external_state_frozen",
            "other"
          ]
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pointerEffect": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "access",
            "expression"
          ],
          "additionalProperties": true,
          "properties": {
            "access": {
              "enum": [
                "read",
                "write",
                "read_write",
                "unknown"
              ]
            },
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "pointer_node": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            }
          }
        }
      ]
    },
    "effectGraph": {
      "type": "object",
      "required": [
        "effects",
        "edges"
      ],
      "additionalProperties": true,
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pointer_node",
              "kind",
              "expression"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "pointer_node": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "read",
                  "write",
                  "read_write",
                  "compute",
                  "call",
                  "external_read",
                  "external_write",
                  "unknown"
                ]
              },
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from_effect",
              "to_effect",
              "relationship"
            ],
            "additionalProperties": true,
            "properties": {
              "from_effect": {
                "type": "string"
              },
              "to_effect": {
                "type": "string"
              },
              "relationship": {
                "enum": [
                  "data_influences",
                  "control_depends",
                  "may_alias",
                  "requires_noalias",
                  "invalidates",
                  "bounds_checked_by",
                  "external_state"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "reads": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "external_state": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alias_sensitive": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "pointerDecision": {
      "type": "object",
      "required": [
        "id",
        "pointer_node",
        "decision",
        "translation_rule_id",
        "unsafe_expected"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "pointer_node": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "translation_rule_id": {
          "type": "string"
        },
        "unsafe_expected": {
          "type": "boolean"
        }
      }
    }
  }
}
